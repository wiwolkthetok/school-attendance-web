---
/**
 * @file src/pages/jadwal.astro
 * @description Halaman Perencanaan Agenda & Jadwal Sekolah (Tandai Tanggal)
 * Fokus pada perencanaan agenda, penandaan tanggal, kalender interaktif,
 * dan tampilan kartu sesi yang ringkas, bersih, dan informatif.
 */
export const prerender = false;

const authSession = Astro.cookies.get('auth_session')?.value;
if (!authSession) {
  return Astro.redirect('/login');
}
if (authSession === 'siswa') {
  return Astro.redirect('/profil-siswa');
}

import Layout from '../layouts/Layout.astro';
---

<Layout title="Jadwal & Agenda" activeNav="jadwal-agenda">
  <!-- Content Container Card -->
  <div class="bg-white rounded-xl p-3.5 sm:p-6 shadow-xs border border-slate-200/80 space-y-4 sm:space-y-6">
    <!-- Top Action Bar: Navigasi Minggu & Tombol Tandai Agenda -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2.5 sm:gap-4 border-b border-slate-100 pb-3.5 sm:pb-4">
      <!-- Week Navigation -->
      <div class="flex items-center gap-2 sm:gap-3 w-full sm:w-auto justify-between sm:justify-start">
        <div class="flex-1 sm:flex-initial flex items-center justify-between gap-1 bg-slate-50 rounded-lg p-1 border border-slate-200/80">
          <button
            type="button"
            id="btn-prev-week"
            class="w-7 h-7 sm:w-8 sm:h-8 rounded-md shrink-0 flex items-center justify-center hover:bg-white text-slate-500 hover:text-slate-800 transition-colors active:scale-95 shadow-2xs cursor-pointer"
            title="Minggu Sebelumnya"
          >
            <span class="material-symbols-outlined text-sm">chevron_left</span>
          </button>
          <span id="current-week-label" class="font-semibold text-slate-800 text-xs sm:text-sm px-1.5 sm:px-3 flex items-center justify-center gap-1.5 truncate">
            <span class="material-symbols-outlined text-blue-600 text-sm sm:text-base shrink-0">calendar_month</span>
            <span id="week-date-range" class="truncate font-mono">Memuat...</span>
          </span>
          <button
            type="button"
            id="btn-next-week"
            class="w-7 h-7 sm:w-8 sm:h-8 rounded-md shrink-0 flex items-center justify-center hover:bg-white text-slate-500 hover:text-slate-800 transition-colors active:scale-95 shadow-2xs cursor-pointer"
            title="Minggu Berikutnya"
          >
            <span class="material-symbols-outlined text-sm">chevron_right</span>
          </button>
        </div>

        <button
          type="button"
          id="btn-today-week"
          class="shrink-0 px-2.5 sm:px-3 py-1.5 text-xs font-semibold text-blue-700 bg-blue-50 hover:bg-blue-100 border border-blue-200/80 rounded-lg transition-colors shadow-2xs cursor-pointer active:scale-95"
        >
          Hari Ini
        </button>
      </div>

      <!-- Action Button: Tandai Agenda Baru -->
      <div class="w-full sm:w-auto flex items-center">
        <button
          type="button"
          id="btn-open-agenda-modal"
          class="w-full sm:w-auto px-4 py-2 rounded-lg bg-blue-600 hover:bg-blue-700 text-white font-semibold text-xs shadow-2xs flex items-center justify-center gap-1.5 transition-colors active:scale-95 cursor-pointer"
        >
          <span class="material-symbols-outlined text-base">bookmark_add</span>
          <span>Tandai Agenda</span>
        </button>
      </div>
    </div>

    <!-- Main Schedule Grid Layout -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-4 sm:gap-6 items-start">
      <!-- Left Column: Mini Calendar & Alert (4 cols on lg, 3 cols on xl) -->
      <div class="lg:col-span-4 xl:col-span-3 space-y-3.5 sm:space-y-4 flex-shrink-0">
        <!-- Upcoming Alert Box (Agenda Hari Ini / Tanggal Terpilih) -->
        <div id="upcoming-alert-box" class="p-3.5 sm:p-4 rounded-xl bg-white border border-slate-200/80 shadow-xs space-y-2">
          <div class="flex items-center justify-between">
            <span id="upcoming-badge" class="text-[10px] font-mono font-bold tracking-wider uppercase text-blue-700 bg-blue-50 border border-blue-200/70 px-2 py-0.5 rounded whitespace-nowrap">
              Agenda Hari Ini
            </span>
            <span id="upcoming-pulse-dot" class="w-2 h-2 rounded-full bg-slate-300"></span>
          </div>

          <div>
            <p id="upcoming-date-label" class="text-xs text-slate-500 font-mono font-medium">
              Rabu, 11 Nov 2026
            </p>
            <h4 id="upcoming-title" class="text-xs sm:text-sm font-semibold text-slate-900 tracking-tight mt-1 line-clamp-2">
              Tidak Ada Agenda Hari Ini
            </h4>
          </div>

          <!-- Content Area (Dinamis: Ada Agenda vs Tidak Ada Agenda) -->
          <div id="upcoming-content-area" class="space-y-1.5">
            <div id="upcoming-time-row" class="hidden items-center gap-1.5 text-xs text-slate-600 font-mono">
              <span class="material-symbols-outlined text-xs text-slate-400">schedule</span>
              <span id="upcoming-time">-</span>
            </div>
            <div id="upcoming-info" class="text-xs text-slate-500 pt-1.5 border-t border-slate-100">
              Belum ada agenda kegiatan yang ditandai untuk hari ini.
            </div>
          </div>
        </div>

        <!-- Mobile Toggle for Mini Calendar -->
        <div class="lg:hidden flex items-center justify-between bg-slate-50 border border-slate-200/80 rounded-lg p-2.5">
          <div class="flex items-center gap-2">
            <span class="material-symbols-outlined text-blue-600 text-base">calendar_month</span>
            <span class="text-xs font-semibold text-slate-800">Kalender Bulanan</span>
          </div>
          <button
            type="button"
            id="btn-toggle-sidebar-mobile"
            class="px-2.5 py-1 rounded-md bg-white hover:bg-slate-100 border border-slate-200 text-xs font-medium text-blue-600 flex items-center gap-1 transition-colors shadow-2xs cursor-pointer"
          >
            <span id="label-toggle-sidebar">Tampilkan</span>
            <span id="icon-toggle-sidebar" class="material-symbols-outlined text-sm transition-transform duration-200">expand_more</span>
          </button>
        </div>

        <!-- Collapsible Wrapper for Mini Calendar on Mobile, always open on lg: -->
        <div id="sidebar-collapsible-wrapper" class="hidden lg:block space-y-4">
          <!-- Mini Month Calendar Interaktif -->
          <div class="p-3 sm:p-4 rounded-xl bg-slate-50/70 border border-slate-200/80 space-y-2">
            <div class="flex items-center justify-between pb-2 border-b border-slate-200/60">
              <h3 id="mini-calendar-title" class="text-xs font-semibold text-slate-800">
                Oktober 2026
              </h3>
              <div class="flex items-center gap-1">
                <button
                  type="button"
                  id="btn-prev-month"
                  class="w-6 h-6 rounded-md text-slate-500 hover:bg-white hover:text-slate-800 flex items-center justify-center transition-colors cursor-pointer"
                  title="Bulan Sebelumnya"
                >
                  <span class="material-symbols-outlined text-xs">chevron_left</span>
                </button>
                <button
                  type="button"
                  id="btn-next-month"
                  class="w-6 h-6 rounded-md text-slate-500 hover:bg-white hover:text-slate-800 flex items-center justify-center transition-colors cursor-pointer"
                  title="Bulan Berikutnya"
                >
                  <span class="material-symbols-outlined text-xs">chevron_right</span>
                </button>
              </div>
            </div>

            <div class="grid grid-cols-7 text-center text-[10px] font-mono font-medium text-slate-400 py-1">
              <span>M</span><span>S</span><span>S</span><span>R</span><span>K</span><span>J</span><span>S</span>
            </div>
            <div id="mini-calendar-grid" class="grid grid-cols-7 text-center text-xs font-mono font-medium gap-y-1 pt-1">
              <!-- Populated via script -->
            </div>
            <p class="text-[10px] text-slate-400 text-center pt-2">
              Klik tanggal untuk memilih hari
            </p>
          </div>
        </div>
      </div>

      <!-- Right Column: Interactive Weekly Timeline (8 cols on lg, 9 cols on xl) -->
      <div class="lg:col-span-8 xl:col-span-9 min-w-0">
        <div class="space-y-3">
          <!-- Horizontal Category Filter Tabs -->
          <div class="flex items-center justify-between gap-2 border-b border-slate-100 pb-2">
            <div class="flex items-center gap-1.5 overflow-x-auto no-scrollbar py-0.5 flex-1 min-w-0" id="category-filter-tabs">
              <button
                type="button"
                data-cat="all"
                class="cat-tab-btn shrink-0 whitespace-nowrap px-2.5 py-1 rounded-md text-xs font-semibold transition-colors bg-slate-900 text-white shadow-2xs cursor-pointer active:scale-95"
              >
                Semua
              </button>
              <button
                type="button"
                data-cat="kbm"
                class="cat-tab-btn shrink-0 whitespace-nowrap px-2.5 py-1 rounded-md text-xs font-medium transition-colors bg-slate-100 text-slate-600 hover:text-slate-900 hover:bg-slate-200/70 border border-slate-200/60 cursor-pointer flex items-center gap-1.5 active:scale-95"
              >
                <span class="w-1.5 h-1.5 rounded-full bg-teal-500 shrink-0"></span>
                <span>KBM & Kejuruan</span>
              </button>
              <button
                type="button"
                data-cat="rapat"
                class="cat-tab-btn shrink-0 whitespace-nowrap px-2.5 py-1 rounded-md text-xs font-medium transition-colors bg-slate-100 text-slate-600 hover:text-slate-900 hover:bg-slate-200/70 border border-slate-200/60 cursor-pointer flex items-center gap-1.5 active:scale-95"
              >
                <span class="w-1.5 h-1.5 rounded-full bg-rose-500 shrink-0"></span>
                <span>Rapat Dinas</span>
              </button>
              <button
                type="button"
                data-cat="lsp"
                class="cat-tab-btn shrink-0 whitespace-nowrap px-2.5 py-1 rounded-md text-xs font-medium transition-colors bg-slate-100 text-slate-600 hover:text-slate-900 hover:bg-slate-200/70 border border-slate-200/60 cursor-pointer flex items-center gap-1.5 active:scale-95"
              >
                <span class="w-1.5 h-1.5 rounded-full bg-purple-500 shrink-0"></span>
                <span>UKK / LSP</span>
              </button>
              <button
                type="button"
                data-cat="khusus"
                class="cat-tab-btn shrink-0 whitespace-nowrap px-2.5 py-1 rounded-md text-xs font-medium transition-colors bg-slate-100 text-slate-600 hover:text-slate-900 hover:bg-slate-200/70 border border-slate-200/60 cursor-pointer flex items-center gap-1.5 active:scale-95"
              >
                <span class="w-1.5 h-1.5 rounded-full bg-amber-500 shrink-0"></span>
                <span>Acara Khusus</span>
              </button>
            </div>
            <span id="total-schedules-badge" class="text-[10px] font-mono font-medium text-slate-400 shrink-0 whitespace-nowrap pl-1">0 Agenda</span>
          </div>

          <!-- Day Headers (Senin s/d Jumat dengan Tanggal Nyata & Tap Navigasi Mobile) -->
          <div class="grid grid-cols-5 gap-1.5 sm:gap-3" id="timeline-day-headers">
            <!-- Populated via script with accurate dates -->
          </div>

          <!-- Dynamic Schedule Column Grid -->
          <div class="flex sm:grid sm:grid-cols-5 gap-2.5 sm:gap-3 items-start min-h-[420px] overflow-x-auto sm:overflow-visible snap-x snap-mandatory scroll-smooth no-scrollbar pb-2" id="timeline-columns-container">
            <!-- Day 0: Senin -->
            <div class="w-[84vw] xs:w-[78vw] sm:w-auto shrink-0 snap-start sm:snap-align-none space-y-2 p-2.5 sm:p-2 bg-slate-50/70 rounded-xl min-h-[300px] flex flex-col justify-between border border-slate-200/60 sm:border-0" id="day-col-senin">
              <div class="space-y-2 items-container" id="day-items-senin"></div>
            </div>
            <!-- Day 1: Selasa -->
            <div class="w-[84vw] xs:w-[78vw] sm:w-auto shrink-0 snap-start sm:snap-align-none space-y-2 p-2.5 sm:p-2 bg-slate-50/70 rounded-xl min-h-[300px] flex flex-col justify-between border border-slate-200/60 sm:border-0" id="day-col-selasa">
              <div class="space-y-2 items-container" id="day-items-selasa"></div>
            </div>
            <!-- Day 2: Rabu -->
            <div class="w-[84vw] xs:w-[78vw] sm:w-auto shrink-0 snap-start sm:snap-align-none space-y-2 p-2.5 sm:p-2 bg-slate-50/70 rounded-xl min-h-[300px] flex flex-col justify-between border border-slate-200/60 sm:border-0" id="day-col-rabu">
              <div class="space-y-2 items-container" id="day-items-rabu"></div>
            </div>
            <!-- Day 3: Kamis -->
            <div class="w-[84vw] xs:w-[78vw] sm:w-auto shrink-0 snap-start sm:snap-align-none space-y-2 p-2.5 sm:p-2 bg-slate-50/70 rounded-xl min-h-[300px] flex flex-col justify-between border border-slate-200/60 sm:border-0" id="day-col-kamis">
              <div class="space-y-2 items-container" id="day-items-kamis"></div>
            </div>
            <!-- Day 4: Jumat -->
            <div class="w-[84vw] xs:w-[78vw] sm:w-auto shrink-0 snap-start sm:snap-align-none space-y-2 p-2.5 sm:p-2 bg-slate-50/70 rounded-xl min-h-[300px] flex flex-col justify-between border border-slate-200/60 sm:border-0" id="day-col-jumat">
              <div class="space-y-2 items-container" id="day-items-jumat"></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Modal Dialog: Buat / Edit Agenda (Multi-Step Form) -->
  <div id="agenda-modal" class="fixed inset-0 z-50 bg-slate-900/60 backdrop-blur-xs hidden items-center justify-center p-3 sm:p-4 overflow-y-auto">
    <div class="bg-white rounded-xl max-w-xl w-full p-4 sm:p-6 shadow-xl border border-slate-200 space-y-4 animate-in fade-in duration-200 my-auto max-h-[92vh] overflow-y-auto">
      <!-- Top Header -->
      <div class="flex items-center justify-between border-b border-slate-100 pb-3">
        <div class="flex items-center gap-2">
          <span class="material-symbols-outlined text-blue-600 text-lg">event_available</span>
          <div>
            <h3 id="modal-agenda-title" class="text-sm font-semibold text-slate-900">Perencanaan Agenda</h3>
            <p class="text-[11px] text-slate-500">SMK Ma'arif Padang Ratu</p>
          </div>
        </div>
        <button id="btn-close-agenda-modal" type="button" class="text-slate-400 hover:text-slate-600 p-1 rounded-lg hover:bg-slate-100 transition" title="Tutup">
          <span class="material-symbols-outlined text-lg">close</span>
        </button>
      </div>

      <!-- Stepper Progress Bar (1 - 2 - 3 - 4) -->
      <div class="px-2">
        <div class="flex items-center justify-between relative">
          <!-- Line connector -->
          <div class="absolute top-3 left-6 right-6 h-0.5 bg-slate-200 -z-10">
            <div id="agenda-stepper-progress-line" class="h-full bg-blue-600 transition-all duration-300" style="width: 0%"></div>
          </div>

          <!-- Step 1 -->
          <div class="agenda-step-indicator flex flex-col items-center gap-1 cursor-pointer" data-step="1">
            <div id="agenda-step-badge-1" class="w-6 h-6 rounded-full bg-blue-600 text-white font-mono font-bold text-xs flex items-center justify-center transition-all">
              1
            </div>
            <span id="agenda-step-label-1" class="text-[10px] font-semibold text-blue-700 whitespace-nowrap">Identitas</span>
          </div>

          <!-- Step 2 -->
          <div class="agenda-step-indicator flex flex-col items-center gap-1 cursor-pointer" data-step="2">
            <div id="agenda-step-badge-2" class="w-6 h-6 rounded-full bg-slate-100 text-slate-400 font-mono font-medium text-xs flex items-center justify-center border border-slate-200 transition-all">
              2
            </div>
            <span id="agenda-step-label-2" class="text-[10px] font-medium text-slate-400 whitespace-nowrap">Privasi</span>
          </div>

          <!-- Step 3 -->
          <div class="agenda-step-indicator flex flex-col items-center gap-1 cursor-pointer" data-step="3">
            <div id="agenda-step-badge-3" class="w-6 h-6 rounded-full bg-slate-100 text-slate-400 font-mono font-medium text-xs flex items-center justify-center border border-slate-200 transition-all">
              3
            </div>
            <span id="agenda-step-label-3" class="text-[10px] font-medium text-slate-400 whitespace-nowrap">Waktu</span>
          </div>

          <!-- Step 4 -->
          <div class="agenda-step-indicator flex flex-col items-center gap-1 cursor-pointer" data-step="4">
            <div id="agenda-step-badge-4" class="w-6 h-6 rounded-full bg-slate-100 text-slate-400 font-mono font-medium text-xs flex items-center justify-center border border-slate-200 transition-all">
              4
            </div>
            <span id="agenda-step-label-4" class="text-[10px] font-medium text-slate-400 whitespace-nowrap">Detail</span>
          </div>
        </div>
      </div>

      <!-- Form Container -->
      <form id="agenda-form" class="space-y-4">
        <input type="hidden" id="agenda-id-input" value="" />
        <input type="hidden" id="agenda-visibility-input" value="public" />
        <input type="hidden" id="agenda-lead-days" value="0" />
        <input type="hidden" id="agenda-duration-mode" value="single" />
        <input type="hidden" id="agenda-category-input" value="kbm" />

        <!-- ================= TAHAP 1: IDENTITAS AGENDA ================= -->
        <div id="agenda-step-panel-1" class="agenda-step-panel space-y-3.5">
          <div class="p-3 rounded-lg bg-blue-50/60 border border-blue-100/80 text-xs text-blue-900">
            <p class="font-semibold flex items-center gap-1">
              <span class="material-symbols-outlined text-sm text-blue-600">category</span>
              <span>Langkah 1: Kategori & Nama Agenda</span>
            </p>
            <p class="text-[11px] text-blue-700/90 mt-0.5">Tentukan jenis kegiatan dan nama rencana agenda sekolah.</p>
          </div>

          <!-- Kategori Cards -->
          <div>
            <label class="block text-xs font-medium text-slate-700 mb-1.5">Pilih Kategori Agenda <span class="text-rose-500">*</span></label>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
              <!-- KBM -->
              <div id="cat-card-kbm" class="agenda-cat-card cursor-pointer p-3 rounded-lg border border-blue-600 bg-blue-50/40 ring-1 ring-blue-600/30 transition-colors relative flex flex-col justify-between" data-cat="kbm">
                <div class="flex items-center justify-between">
                  <div class="flex items-center gap-2">
                    <div class="w-8 h-8 rounded-md bg-teal-50 text-teal-700 border border-teal-200/70 flex items-center justify-center">
                      <span class="material-symbols-outlined text-lg">school</span>
                    </div>
                    <div>
                      <h4 class="text-xs font-semibold text-slate-900">KBM Reguler</h4>
                      <span class="text-[9px] font-mono text-teal-700">Akademik</span>
                    </div>
                  </div>
                  <div id="cat-radio-kbm" class="w-4 h-4 rounded-full border border-blue-600 bg-blue-600 text-white flex items-center justify-center text-[10px] font-mono font-bold">
                    ✓
                  </div>
                </div>
                <p class="mt-2 text-[11px] text-slate-500 leading-normal">
                  Kegiatan belajar mengajar & jam kelas.
                </p>
              </div>

              <!-- Rapat -->
              <div id="cat-card-rapat" class="agenda-cat-card cursor-pointer p-3 rounded-lg border border-slate-200 bg-white hover:border-slate-300 transition-colors relative flex flex-col justify-between" data-cat="rapat">
                <div class="flex items-center justify-between">
                  <div class="flex items-center gap-2">
                    <div class="w-8 h-8 rounded-md bg-rose-50 text-rose-700 border border-rose-200/70 flex items-center justify-center">
                      <span class="material-symbols-outlined text-lg">groups</span>
                    </div>
                    <div>
                      <h4 class="text-xs font-semibold text-slate-900">Rapat & Koordinasi</h4>
                      <span class="text-[9px] font-mono text-rose-700">Rapat</span>
                    </div>
                  </div>
                  <div id="cat-radio-rapat" class="w-4 h-4 rounded-full border border-slate-300 bg-white text-transparent flex items-center justify-center text-[10px] font-mono font-bold">
                    ✓
                  </div>
                </div>
                <p class="mt-2 text-[11px] text-slate-500 leading-normal">
                  Pertemuan dewan guru, wali, dan staf.
                </p>
              </div>

              <!-- UKK / LSP -->
              <div id="cat-card-lsp" class="agenda-cat-card cursor-pointer p-3 rounded-lg border border-slate-200 bg-white hover:border-slate-300 transition-colors relative flex flex-col justify-between" data-cat="lsp">
                <div class="flex items-center justify-between">
                  <div class="flex items-center gap-2">
                    <div class="w-8 h-8 rounded-md bg-purple-50 text-purple-700 border border-purple-200/70 flex items-center justify-center">
                      <span class="material-symbols-outlined text-lg">verified</span>
                    </div>
                    <div>
                      <h4 class="text-xs font-semibold text-slate-900">UKK & Sertifikasi</h4>
                      <span class="text-[9px] font-mono text-purple-700">Kejuruan</span>
                    </div>
                  </div>
                  <div id="cat-radio-lsp" class="w-4 h-4 rounded-full border border-slate-300 bg-white text-transparent flex items-center justify-center text-[10px] font-mono font-bold">
                    ✓
                  </div>
                </div>
                <p class="mt-2 text-[11px] text-slate-500 leading-normal">
                  Uji kompetensi keahlian dan asesmen.
                </p>
              </div>

              <!-- Khusus -->
              <div id="cat-card-khusus" class="agenda-cat-card cursor-pointer p-3 rounded-lg border border-slate-200 bg-white hover:border-slate-300 transition-colors relative flex flex-col justify-between" data-cat="khusus">
                <div class="flex items-center justify-between">
                  <div class="flex items-center gap-2">
                    <div class="w-8 h-8 rounded-md bg-amber-50 text-amber-700 border border-amber-200/70 flex items-center justify-center">
                      <span class="material-symbols-outlined text-lg">event</span>
                    </div>
                    <div>
                      <h4 class="text-xs font-semibold text-slate-900">Agenda Khusus</h4>
                      <span class="text-[9px] font-mono text-amber-700">Event</span>
                    </div>
                  </div>
                  <div id="cat-radio-khusus" class="w-4 h-4 rounded-full border border-slate-300 bg-white text-transparent flex items-center justify-center text-[10px] font-mono font-bold">
                    ✓
                  </div>
                </div>
                <p class="mt-2 text-[11px] text-slate-500 leading-normal">
                  Upacara, peringatan hari besar, & tamu.
                </p>
              </div>
            </div>
          </div>

          <div>
            <label for="agenda-title-input" class="block text-xs font-medium text-slate-700 mb-1">Nama Rencana / Agenda <span class="text-rose-500">*</span></label>
            <input
              id="agenda-title-input"
              required
              placeholder="Contoh: Rapat Koordinasi Kurikulum, UKK Praktik RPL..."
              class="w-full text-xs font-normal text-slate-800 bg-slate-50/80 border border-slate-200 rounded-lg px-3 py-2 focus:bg-white focus:outline-none focus:ring-2 focus:ring-blue-600/30 transition-colors"
            />
          </div>
        </div>

