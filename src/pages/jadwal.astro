              title="Pilih hari ${dayName}"
            >
              <span class="text-[10px] sm:text-[11px] font-medium ${isToday ? 'text-blue-600' : 'text-slate-500'} block truncate">
                <span class="sm:hidden">${shortDay}</span>
                <span class="hidden sm:inline">${dayName}</span>
              </span>
              <div class="flex items-center justify-center gap-1 my-0.5">
                <span class="text-xs sm:base font-semibold font-mono ${isToday ? 'text-blue-800' : 'text-slate-900'}">${d.getDate()}</span>
                <span class="text-[10px] font-mono text-slate-400 hidden md:inline">${monthNames[d.getMonth()].slice(0, 3)}</span>
