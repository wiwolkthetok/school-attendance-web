        if (todayDayCol) {
          const idx = weekDays.indexOf(todayDayCol);
          const dayName = daysList[idx].toLowerCase();
          const targetCol = document.getElementById(`day-col-${dayName}`);
          if (targetCol) {
            setTimeout(() => {
              targetCol.scrollIntoView({ behavior: 'smooth', inline: 'center', block: 'nearest' });
