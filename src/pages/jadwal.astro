        if (items.length === 0) {
          colContainer.innerHTML = `
            ${mobileColHeader}
            <div class="py-8 text-center text-slate-300 font-medium text-xs flex flex-col items-center justify-center">
              <span class="material-symbols-outlined text-base block mb-0.5 opacity-60">calendar_today</span>
              <span class="text-slate-400">Kosong</span>
              <button
                type="button"
                data-date="${dayStr}"
                class="btn-quick-add-col mt-2.5 inline-flex items-center gap-1 text-[11px] font-semibold text-blue-600 hover:text-blue-700 bg-blue-50/70 hover:bg-blue-100/70 border border-blue-200/70 rounded-lg px-2.5 py-1 transition-all active:scale-95 cursor-pointer shadow-2xs"
                title="Tandai agenda pada ${dayName}, ${d.getDate()} ${monthNames[d.getMonth()].slice(0, 3)}"
              >
                <span class="material-symbols-outlined text-[13px]">add</span>
                <span>Tandai</span>
              </button>
            </div>
          `;
        } else {
          colContainer.innerHTML = mobileColHeader + items.map((item) => {
            // Styling ringkas per kategori
            let borderAccent = 'border-l-4 border-l-teal-500 bg-teal-50/40 border-teal-200/80';
            let dotColor = 'bg-teal-500';

            if (item.category === 'rapat') {
              borderAccent = 'border-l-4 border-l-rose-500 bg-rose-50/40 border-rose-200/80';
              dotColor = 'bg-rose-500';
            } else if (item.category === 'lsp') {
              borderAccent = 'border-l-4 border-l-purple-500 bg-purple-50/40 border-purple-200/80';
              dotColor = 'bg-purple-600';
            } else if (item.category === 'khusus') {
              borderAccent = 'border-l-4 border-l-amber-500 bg-amber-50/40 border-amber-200/80';
              dotColor = 'bg-amber-500';
            }

            const isMultiDay = item.startDate && item.endDate && item.startDate !== item.endDate;
            const isGuruVis = item.visibility === 'guru';

            return `
              <div
                data-item='${JSON.stringify(item)}'
                class="agenda-card-item cursor-pointer group relative p-2.5 rounded-lg bg-white border ${borderAccent} hover:shadow-2xs transition-all space-y-1"
                title="Klik untuk melihat detail agenda"
              >
                <!-- Baris 1: Waktu & Ikon Penanda Ringkas -->
                <div class="flex items-center justify-between gap-1 text-[10px] font-mono font-medium text-slate-500">
                  <div class="flex items-center gap-1.5 truncate">
                    <span class="w-1.5 h-1.5 rounded-full ${dotColor}"></span>
                    <span>${item.timeStart} - ${item.timeEnd}</span>
                  </div>
                  <div class="flex items-center gap-1 shrink-0">
                    ${isGuruVis ? '<span class="material-symbols-outlined text-xs text-amber-600" title="Khusus Guru">lock</span>' : ''}
                    ${isMultiDay ? '<span class="text-[8px] font-mono font-bold uppercase text-purple-700 bg-purple-50 px-1 py-0.2 rounded border border-purple-200/60">Multi</span>' : ''}
                    ${(!isGuruVis && item.notifyLeadDays > 0) ? `<span class="text-[8px] font-mono font-bold uppercase text-slate-600 bg-slate-100 px-1 py-0.2 rounded border border-slate-200/60" title="Tampil ke siswa H-${item.notifyLeadDays}">H-${item.notifyLeadDays}</span>` : ''}
                  </div>
                </div>

                <!-- Baris 2: Judul Agenda Inti -->
                <h5 class="text-xs font-semibold text-slate-900 leading-snug line-clamp-2 group-hover:text-blue-600 transition-colors">
                  ${item.title}
                </h5>

                <!-- Baris 3: Lokasi & Teks Bantuan Klik -->
                <div class="flex items-center justify-between text-[10px] text-slate-400 pt-1 border-t border-slate-100">
