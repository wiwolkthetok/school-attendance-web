            if (dayTarget) {
              const targetCol = document.getElementById(`day-col-${dayTarget}`);
              const container = document.getElementById('timeline-columns-container');
              if (targetCol && container) {
                const scrollLeft = targetCol.offsetLeft - container.offsetLeft;
                container.scrollTo({ left: scrollLeft, behavior: 'smooth' });
              }

              // Visual highlight for tapped day
              headerContainer.querySelectorAll('.day-header-pill').forEach((p) => {
                p.classList.remove('ring-2', 'ring-blue-600');
              });
              pill.classList.add('ring-2', 'ring-blue-600');
            }
          });
        });
      }

      // Auto-scroll ke kolom hari ini pada layar mobile (< 640px)
      if (typeof window !== 'undefined' && window.innerWidth < 640) {
        const todayIdx = weekDays.findIndex((d) => toDateString(d) === todayStr);
        if (todayIdx !== -1) {
          const todayCol = document.getElementById(`day-col-${daysList[todayIdx].toLowerCase()}`);
          const container = document.getElementById('timeline-columns-container');
          if (todayCol && container) {
            setTimeout(() => {
              const scrollLeft = todayCol.offsetLeft - container.offsetLeft;
              container.scrollTo({ left: scrollLeft, behavior: 'smooth' });
            }, 100);
          }
        }
      }

      // Render Kolom Agenda Ringkas & Bersih per Hari
      const filtered = allSchedules.filter((s) => activeCategories.has(s.category));

      weekDays.forEach((d, idx) => {
        const dayName = daysList[idx];
        const dayStr = toDateString(d);
        const colContainer = document.getElementById(`day-items-${dayName.toLowerCase()}`);
        if (!colContainer) return;

        // Cocokkan agenda: berdasarkan rentang tanggal (multi-hari) atau tanggal tunggal
        const items = filtered.filter((s) => {
          const sStart = s.startDate || s.date || '';
          const sEnd = s.endDate || sStart;
          if (sStart && sEnd) {
            return dayStr >= sStart && dayStr <= sEnd;
          }
          if (s.date) return s.date === dayStr;
          return s.day && s.day.toLowerCase() === dayName.toLowerCase();
        });

        items.sort((a, b) => (a.timeStart || '').localeCompare(b.timeStart || ''));

        const isToday = dayStr === todayStr;
        const mobileColHeader = `
          <div class="sm:hidden flex items-center justify-between pb-2 mb-1.5 border-b border-slate-200/80">
            <div class="flex items-center gap-1.5">
              <span class="text-xs font-semibold text-slate-800">${dayName}, ${d.getDate()} ${monthNames[d.getMonth()].slice(0, 3)}</span>
              ${isToday ? '<span class="px-1.5 py-0.2 rounded text-white bg-blue-600 font-mono font-bold text-[8px] uppercase">Hari Ini</span>' : ''}
            </div>
            <span class="text-[10px] font-mono text-slate-400">${items.length} Agenda</span>
