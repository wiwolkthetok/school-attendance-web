    const btnCloseModal = document.getElementById('btn-close-agenda-modal');
    const agendaForm = document.getElementById('agenda-form') as HTMLFormElement | null;
    const formError = document.getElementById('agenda-form-error');
    const modalTitle = document.getElementById('modal-agenda-title');

    const idInput = document.getElementById('agenda-id-input') as HTMLInputElement | null;
    const visibilityInput = document.getElementById('agenda-visibility-input') as HTMLInputElement | null;
    const leadDaysInput = document.getElementById('agenda-lead-days') as HTMLInputElement | null;
    const durationModeInput = document.getElementById('agenda-duration-mode') as HTMLInputElement | null;
    const categoryInput = document.getElementById('agenda-category-input') as HTMLInputElement | null;
    const titleInput = document.getElementById('agenda-title-input') as HTMLInputElement | null;
    const dateInput = document.getElementById('agenda-date-input') as HTMLInputElement | null;
    const startDateInput = document.getElementById('agenda-start-date') as HTMLInputElement | null;
    const endDateInput = document.getElementById('agenda-end-date') as HTMLInputElement | null;
    const timeStartInput = document.getElementById('agenda-time-start') as HTMLInputElement | null;
    const timeEndInput = document.getElementById('agenda-time-end') as HTMLInputElement | null;
    const roomInput = document.getElementById('agenda-room-input') as HTMLInputElement | null;
    const classInput = document.getElementById('agenda-class-input') as HTMLInputElement | null;
    const instInput = document.getElementById('agenda-instructor-input') as HTMLInputElement | null;

    const btnAgendaPrev = document.getElementById('btn-agenda-prev');
    const btnAgendaNext = document.getElementById('btn-agenda-next');
    const btnSubmitAgendaFinal = document.getElementById('btn-submit-agenda-final');

    let currentStep = 1;
    let selectedDetailItem: any = null;

    // Helper: cari tanggal Senin dari minggu yang sedang dilihat
    function getMondayOfWeek(d: Date) {
      const date = new Date(d);
      const day = date.getDay();
      const diff = date.getDate() - day + (day === 0 ? -6 : 1);
      return new Date(date.setDate(diff));
    }

    // Helper: format YYYY-MM-DD
    function toDateString(d: Date) {
      const y = d.getFullYear();
      const m = String(d.getMonth() + 1).padStart(2, '0');
      const day = String(d.getDate()).padStart(2, '0');
      return `${y}-${m}-${day}`;
    }

    // Helper: format tanggal Indonesia
    function formatIndoDate(d: Date) {
      const days = ['Minggu', 'Senin', 'Selasa', 'Rabu', 'Kamis', 'Jumat', 'Sabtu'];
      const months = ['Jan', 'Feb', 'Mar', 'Apr', 'Mei', 'Jun', 'Jul', 'Agu', 'Sep', 'Okt', 'Nov', 'Des'];
      return `${days[d.getDay()]}, ${d.getDate()} ${months[d.getMonth()]} ${d.getFullYear()}`;
    }

    // Hitung 5 hari kerja (Senin s/d Jumat) untuk minggu aktif
    function getWeekDays(startDate: Date) {
      const monday = getMondayOfWeek(startDate);
      const days = [];
      for (let i = 0; i < 5; i++) {
        const next = new Date(monday);
        next.setDate(monday.getDate() + i);
        days.push(next);
      }
      return days;
    }

    // 0ms Cache First: Render agenda & jadwal instan dari cache lokal
    function loadCachedSchedules() {
      try {
        const raw = localStorage.getItem('schedules_cache');
        if (raw) {
          const list = JSON.parse(raw);
          if (Array.isArray(list) && list.length > 0) {
            allSchedules = list;
            renderWeekView();
            renderMiniCalendar();
            renderUpcoming();
            updateCountBadge();
          }
        }
      } catch (e) {}
    }
    loadCachedSchedules();

    async function loadSchedules() {
      try {
        const res = await fetch('/api/schedules');
        allSchedules = await res.json();
        try {
          localStorage.setItem('schedules_cache', JSON.stringify(allSchedules));
        } catch (e) {}
        renderWeekView();
        renderMiniCalendar();
        renderUpcoming();
        updateCountBadge();
      } catch (e) {
        console.error('Gagal memuat jadwal:', e);
      }
    }

    function updateCountBadge() {
      const badge = document.getElementById('total-schedules-badge');
      if (badge) badge.textContent = `${allSchedules.length} Agenda`;
    }

    function renderWeekView() {
      const weekDays = getWeekDays(viewingDate);
      const headerContainer = document.getElementById('timeline-day-headers');
      const weekLabel = document.getElementById('week-date-range');

      const firstDay = weekDays[0];
      const lastDay = weekDays[4];

      if (weekLabel) {
        if (firstDay.getMonth() === lastDay.getMonth()) {
          weekLabel.textContent = `${firstDay.getDate()} - ${lastDay.getDate()} ${monthNames[firstDay.getMonth()]} ${lastDay.getFullYear()}`;
        } else {
          weekLabel.textContent = `${firstDay.getDate()} ${monthNames[firstDay.getMonth()].slice(0, 3)} - ${lastDay.getDate()} ${monthNames[lastDay.getMonth()].slice(0, 3)} ${lastDay.getFullYear()}`;
        }
      }

      const today = new Date();
      const todayStr = toDateString(today);

      // Render Header Hari + Tanggal Nyata
      if (headerContainer) {
        headerContainer.innerHTML = weekDays.map((d, idx) => {
          const dStr = toDateString(d);
          const isToday = dStr === todayStr;
          const dayName = daysList[idx];
          const shortDay = dayName.slice(0, 3);

