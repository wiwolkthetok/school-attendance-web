    // Mini Kalender dengan Dot Penanda Agenda & Klik Interaktif
    function renderMiniCalendar() {
      const grid = document.getElementById('mini-calendar-grid');
      const title = document.getElementById('mini-calendar-title');
      if (!grid) return;

      if (title) title.textContent = `${monthNames[miniCalMonth]} ${miniCalYear}`;

      const today = new Date();
      const todayDate = today.getDate();
      const isCurrentMonth = today.getFullYear() === miniCalYear && today.getMonth() === miniCalMonth;

      const firstDay = new Date(miniCalYear, miniCalMonth, 1).getDay();
      const daysInMonth = new Date(miniCalYear, miniCalMonth + 1, 0).getDate();

      // Kumpulan tanggal yang memiliki agenda di bulan ini (termasuk rentang multi-hari)
      const agendaDates = new Set();
      allSchedules.forEach((s) => {
        const sStart = s.startDate || s.date || '';
        const sEnd = s.endDate || sStart;
        if (sStart && sEnd) {
          for (let d = 1; d <= daysInMonth; d++) {
            const checkStr = `${miniCalYear}-${String(miniCalMonth + 1).padStart(2, '0')}-${String(d).padStart(2, '0')}`;
            if (checkStr >= sStart && checkStr <= sEnd) {
              agendaDates.add(d);
            }
          }
        } else if (s.date) {
          const parts = s.date.split('-');
          if (parts.length === 3 && parseInt(parts[0], 10) === miniCalYear && parseInt(parts[1], 10) === miniCalMonth + 1) {
            agendaDates.add(parseInt(parts[2], 10));
          }
        }
      });

      let html = '';
      for (let i = 0; i < firstDay; i++) {
        html += `<span class="text-slate-300 py-1.5">-</span>`;
      }

      for (let d = 1; d <= daysInMonth; d++) {
        const isToday = isCurrentMonth && d === todayDate;
        const hasAgenda = agendaDates.has(d);
        const dateObjStr = `${miniCalYear}-${String(miniCalMonth + 1).padStart(2, '0')}-${String(d).padStart(2, '0')}`;
        const isSelected = toDateString(selectedDateForBox) === dateObjStr;

        let activeClasses = 'text-slate-700 hover:bg-blue-50';
        if (isToday) {
          activeClasses = 'bg-blue-600 text-white font-black shadow-md shadow-blue-500/30';
        } else if (isSelected) {
          activeClasses = 'bg-blue-100 text-blue-800 font-bold ring-2 ring-blue-500';
        }

        html += `
          <div
            data-date="${dateObjStr}"
            class="mini-cal-day relative flex flex-col items-center justify-center py-1 rounded-lg cursor-pointer transition-colors group"
            title="Klik untuk melihat / tandai agenda tanggal ${d} ${monthNames[miniCalMonth]}"
          >
            <span class="w-6 h-6 flex items-center justify-center rounded-full text-xs font-semibold ${activeClasses}">
              ${d}
            </span>
            ${hasAgenda ? '<span class="w-1 h-1 rounded-full bg-blue-600 mt-0.5"></span>' : '<span class="w-1 h-1 mt-0.5"></span>'}
          </div>
        `;
      }

      grid.innerHTML = html;

      // Klik tanggal di mini kalender -> perbarui kotak info tanggal terpilih & sinkronkan tampilan mingguan
      grid.querySelectorAll('.mini-cal-day').forEach((el) => {
        el.addEventListener('click', () => {
          const dStr = (el as HTMLElement).dataset.date;
          if (dStr) {
            const parts = dStr.split('-');
            selectedDateForBox = new Date(parseInt(parts[0], 10), parseInt(parts[1], 10) - 1, parseInt(parts[2], 10));
            viewingDate = new Date(selectedDateForBox);
            renderWeekView();
            renderMiniCalendar();
            renderUpcoming();
          }
        });
      });
    }

    function renderUpcoming() {
      const badgeEl = document.getElementById('upcoming-badge');
      const dateLabelEl = document.getElementById('upcoming-date-label');
      const dotEl = document.getElementById('upcoming-pulse-dot');
      const titleEl = document.getElementById('upcoming-title');
      const timeRowEl = document.getElementById('upcoming-time-row');
      const timeEl = document.getElementById('upcoming-time');
      const infoEl = document.getElementById('upcoming-info');

      const today = new Date();
      const todayStr = toDateString(today);
      const chosenStr = toDateString(selectedDateForBox);
      const isToday = chosenStr === todayStr;

      if (badgeEl) {
        badgeEl.textContent = isToday ? 'Agenda Hari Ini' : 'Agenda Terpilih';
      }
      if (dateLabelEl) {
        dateLabelEl.textContent = formatIndoDate(selectedDateForBox);
      }

      // Cocokkan agenda yang benar-benar terencana pada tanggal ini (termasuk multi-hari)
      const matched = allSchedules.filter((s) => {
        const sStart = s.startDate || s.date || '';
        const sEnd = s.endDate || sStart;
        if (sStart && sEnd) {
          return chosenStr >= sStart && chosenStr <= sEnd;
        }
        return s.date === chosenStr;
      });

      if (matched.length === 0) {
        // Tidak ada agenda pada tanggal ini
        if (dotEl) {
          dotEl.className = 'w-2 h-2 rounded-full bg-slate-300';
        }
        if (titleEl) {
          titleEl.textContent = isToday ? 'Tidak Ada Agenda Hari Ini' : 'Tidak Ada Agenda';
        }
        if (timeRowEl) {
          timeRowEl.classList.add('hidden');
        }
        if (infoEl) {
          infoEl.innerHTML = `
            <p class="text-xs text-slate-400 leading-snug pt-0.5">
              Belum ada agenda kegiatan yang ditandai untuk tanggal ini.
            </p>
          `;
        }
      } else {
        // Ada agenda terencana pada tanggal ini
        const first = matched[0];
        if (dotEl) {
          dotEl.className = 'w-2 h-2 rounded-full bg-emerald-500 ring-2 ring-emerald-500/20';
        }
        if (titleEl) {
          titleEl.textContent = first.title;
        }
        if (timeRowEl) {
          timeRowEl.classList.remove('hidden');
        }
        if (timeEl) {
          timeEl.textContent = `${first.timeStart} - ${first.timeEnd} WIB`;
        }
        if (infoEl) {
          const extraCount = matched.length > 1 ? `<span class="block text-[10px] text-blue-600 mt-0.5 font-medium">(+${matched.length - 1} agenda lainnya di tanggal ini)</span>` : '';
          const visLabel = first.visibility === 'guru' ? 'Khusus Guru' : 'Publik';
          infoEl.innerHTML = `
            <div class="flex items-center justify-between gap-1 text-xs text-slate-600">
              <span class="truncate font-mono">${first.room || 'SMK'} • ${first.classTarget || 'Semua'} • ${visLabel}</span>
              <button
                type="button"
                id="btn-box-add-more"
                class="text-slate-400 hover:text-blue-600 transition-colors shrink-0 p-1"
                title="Tambah agenda lain di tanggal ini"
              >
                <span class="material-symbols-outlined text-sm">add</span>
              </button>
            </div>
            ${extraCount}
          `;
          document.getElementById('btn-box-add-more')?.addEventListener('click', () => {
            openAddModalWithDate(chosenStr);
          });
        }
      }
    }

    // Stepper UI Management (Gaya Desain Konsisten dengan Pendaftaran Civitas)
    function updateStepUI(targetStep: number) {
      currentStep = targetStep;

      // Toggle Panels
      const p1 = document.getElementById('agenda-step-panel-1');
      const p2 = document.getElementById('agenda-step-panel-2');
      const p3 = document.getElementById('agenda-step-panel-3');
      const p4 = document.getElementById('agenda-step-panel-4');
      p1?.classList.toggle('hidden', currentStep !== 1);
      p2?.classList.toggle('hidden', currentStep !== 2);
      p3?.classList.toggle('hidden', currentStep !== 3);
      p4?.classList.toggle('hidden', currentStep !== 4);

      // Update Stepper Progress Line
      const stepperLine = document.getElementById('agenda-stepper-progress-line');
      if (stepperLine) {
        stepperLine.style.width = currentStep === 1 ? '0%' : currentStep === 2 ? '33.3%' : currentStep === 3 ? '66.6%' : '100%';
      }

      // Update Stepper Indicators (1 - 2 - 3 - 4)
      for (let s = 1; s <= 4; s++) {
        const badge = document.getElementById(`agenda-step-badge-${s}`);
        const label = document.getElementById(`agenda-step-label-${s}`);
        if (!badge || !label) continue;

        if (s < currentStep) {
          badge.className = 'w-6 h-6 rounded-full bg-slate-900 text-white font-mono font-bold text-xs flex items-center justify-center transition-all';
          badge.innerHTML = '<span class="material-symbols-outlined text-xs">check</span>';
          label.className = 'text-[10px] font-medium text-slate-800 whitespace-nowrap';
        } else if (s === currentStep) {
          badge.className = 'w-6 h-6 rounded-full bg-blue-600 text-white font-mono font-bold text-xs flex items-center justify-center ring-2 ring-blue-100 transition-all';
          badge.textContent = String(s);
          label.className = 'text-[10px] font-semibold text-blue-700 whitespace-nowrap';
        } else {
          badge.className = 'w-6 h-6 rounded-full bg-slate-100 text-slate-400 font-mono font-medium text-xs flex items-center justify-center border border-slate-200 transition-all';
          badge.textContent = String(s);
          label.className = 'text-[10px] font-medium text-slate-400 whitespace-nowrap';
        }
      }

      // Update Action Buttons
      if (currentStep === 1) {
        btnAgendaPrev?.classList.add('hidden');
        btnAgendaNext?.classList.remove('hidden');
        if (btnAgendaNext) btnAgendaNext.textContent = 'Lanjut ke Privasi →';
        btnSubmitAgendaFinal?.classList.add('hidden');
      } else if (currentStep === 2) {
        btnAgendaPrev?.classList.remove('hidden');
        if (btnAgendaPrev) btnAgendaPrev.textContent = '← Kategori';
        btnAgendaNext?.classList.remove('hidden');
        if (btnAgendaNext) btnAgendaNext.textContent = 'Lanjut ke Waktu →';
        btnSubmitAgendaFinal?.classList.add('hidden');
      } else if (currentStep === 3) {
        btnAgendaPrev?.classList.remove('hidden');
        if (btnAgendaPrev) btnAgendaPrev.textContent = '← Privasi';
        btnAgendaNext?.classList.remove('hidden');
        if (btnAgendaNext) btnAgendaNext.textContent = 'Lanjut ke Detail →';
        btnSubmitAgendaFinal?.classList.add('hidden');
      } else if (currentStep === 4) {
        btnAgendaPrev?.classList.remove('hidden');
        if (btnAgendaPrev) btnAgendaPrev.textContent = '← Waktu';
        btnAgendaNext?.classList.add('hidden');
        btnSubmitAgendaFinal?.classList.remove('hidden');

        // Populate Ringkasan Data
        const sumName = document.getElementById('summary-agenda-name');
        const sumVis = document.getElementById('summary-agenda-vis');
        const sumLead = document.getElementById('summary-agenda-lead');
        const sumDate = document.getElementById('summary-agenda-date');
        const sumTime = document.getElementById('summary-agenda-time');

        if (sumName) sumName.textContent = titleInput?.value.trim() || '-';
        if (sumVis) {
          const cat = categoryInput?.value || 'kbm';
          const catNames: Record<string, string> = { kbm: 'KBM Reguler', rapat: 'Rapat & Staf', lsp: 'UKK / LSP', khusus: 'Agenda Khusus' };
          const visName = visibilityInput?.value === 'guru' ? 'Khusus Guru' : 'Publik';
          sumVis.textContent = `${catNames[cat] || 'KBM'} • ${visName}`;
        }
        if (sumLead) {
          const isGuru = visibilityInput?.value === 'guru';
          if (isGuru) {
            sumLead.textContent = 'Khusus Guru (Tidak tampil)';
          } else {
            const ld = parseInt(leadDaysInput?.value || '0', 10);
            sumLead.textContent = ld === 0 ? 'Langsung Tampil' : `H-${ld} Sebelum Mulai`;
          }
        }
        if (sumDate) {
          if (durationModeInput?.value === 'range' && startDateInput?.value && endDateInput?.value) {
            sumDate.textContent = `${startDateInput.value} s/d ${endDateInput.value}`;
          } else {
            sumDate.textContent = dateInput?.value || '-';
          }
        }
        if (sumTime) {
          sumTime.textContent = `${timeStartInput?.value || '08:00'} - ${timeEndInput?.value || '09:30'} WIB`;
        }
      }
    }

    function validateStep(step: number): boolean {
      if (formError) formError.classList.add('hidden');
      if (step === 1) {
        if (!titleInput?.value.trim()) {
          if (formError) {
            formError.textContent = 'Nama agenda wajib diisi terlebih dahulu.';
            formError.classList.remove('hidden');
          }
          titleInput?.focus();
          return false;
        }
      } else if (step === 3) {
        const isRange = durationModeInput?.value === 'range';
        if (isRange) {
          if (!startDateInput?.value || !endDateInput?.value) {
            if (formError) {
              formError.textContent = 'Tanggal mulai dan selesai wajib dipilih.';
              formError.classList.remove('hidden');
            }
            return false;
          }
          if (startDateInput.value > endDateInput.value) {
            if (formError) {
              formError.textContent = 'Tanggal mulai tidak boleh melebihi tanggal selesai.';
              formError.classList.remove('hidden');
            }
            return false;
          }
        } else {
          if (!dateInput?.value) {
            if (formError) {
              formError.textContent = 'Tanggal pelaksanaan agenda wajib diisi.';
              formError.classList.remove('hidden');
            }
            return false;
          }
        }
      }
      return true;
    }

    function setCategory(cat: string) {
      if (categoryInput) categoryInput.value = cat;
      const cats = ['kbm', 'rapat', 'lsp', 'khusus'];
      cats.forEach((c) => {
        const card = document.getElementById(`cat-card-${c}`);
        const radio = document.getElementById(`cat-radio-${c}`);
        if (c === cat) {
          card?.classList.remove('border-slate-200', 'bg-white');
          card?.classList.add('border-blue-600', 'bg-blue-50/40', 'ring-1', 'ring-blue-600/30');
          radio?.classList.remove('border-slate-300', 'bg-white', 'text-transparent');
          radio?.classList.add('border-blue-600', 'bg-blue-600', 'text-white');
        } else {
          card?.classList.remove('border-blue-600', 'bg-blue-50/40', 'ring-1', 'ring-blue-600/30');
          card?.classList.add('border-slate-200', 'bg-white');
          radio?.classList.remove('border-blue-600', 'bg-blue-600', 'text-white');
          radio?.classList.add('border-slate-300', 'bg-white', 'text-transparent');
        }
      });
    }

    function setVisibility(v: string) {
      if (visibilityInput) visibilityInput.value = v;
      const cardPub = document.getElementById('agenda-vis-card-public');
      const cardGuru = document.getElementById('agenda-vis-card-guru');
      const radPub = document.getElementById('agenda-radio-public');
      const radGuru = document.getElementById('agenda-radio-guru');
      const boxLead = document.getElementById('box-lead-days');

      if (v === 'public') {
        boxLead?.classList.remove('hidden');
        cardPub?.classList.remove('border-slate-200', 'bg-white');
        cardPub?.classList.add('border-blue-600', 'bg-blue-50/40', 'ring-1', 'ring-blue-600/30');
        radPub?.classList.remove('border-slate-300', 'bg-white', 'text-transparent');
        radPub?.classList.add('border-blue-600', 'bg-blue-600', 'text-white');

        cardGuru?.classList.remove('border-blue-600', 'bg-blue-50/40', 'ring-1', 'ring-blue-600/30');
        cardGuru?.classList.add('border-slate-200', 'bg-white');
        radGuru?.classList.remove('border-blue-600', 'bg-blue-600', 'text-white');
        radGuru?.classList.add('border-slate-300', 'bg-white', 'text-transparent');
      } else {
        boxLead?.classList.add('hidden');
        cardGuru?.classList.remove('border-slate-200', 'bg-white');
        cardGuru?.classList.add('border-blue-600', 'bg-blue-50/40', 'ring-1', 'ring-blue-600/30');
        radGuru?.classList.remove('border-slate-300', 'bg-white', 'text-transparent');
        radGuru?.classList.add('border-blue-600', 'bg-blue-600', 'text-white');

        cardPub?.classList.remove('border-blue-600', 'bg-blue-50/40', 'ring-1', 'ring-blue-600/30');
        cardPub?.classList.add('border-slate-200', 'bg-white');
        radPub?.classList.remove('border-blue-600', 'bg-blue-600', 'text-white');
        radPub?.classList.add('border-slate-300', 'bg-white', 'text-transparent');
      }
    }

    function setLeadDays(days: number) {
      if (leadDaysInput) leadDaysInput.value = String(days);
      document.querySelectorAll('.btn-lead-day').forEach((btn) => {
        const d = parseInt((btn as HTMLElement).dataset.days || '0', 10);
        if (d === days) {
          btn.className = 'btn-lead-day py-1.5 px-2.5 rounded-lg border border-blue-600 bg-blue-50 text-blue-800 text-xs font-semibold text-center transition-colors flex flex-col items-center gap-0.5 cursor-pointer';
        } else {
          btn.className = 'btn-lead-day py-1.5 px-2.5 rounded-lg border border-slate-200 bg-white text-slate-600 hover:border-slate-300 text-xs font-medium text-center transition-colors flex flex-col items-center gap-0.5 cursor-pointer';
        }
      });
    }

    function setDurationMode(mode: string) {
      if (durationModeInput) durationModeInput.value = mode;
      const cardSingle = document.getElementById('mode-card-single');
      const cardRange = document.getElementById('mode-card-range');
      const radSingle = document.getElementById('mode-radio-single');
      const radRange = document.getElementById('mode-radio-range');
      const boxSingle = document.getElementById('box-single-date');
      const boxRange = document.getElementById('box-range-date');

      if (mode === 'single') {
        cardSingle?.classList.remove('border-slate-200', 'bg-white');
        cardSingle?.classList.add('border-blue-600', 'bg-blue-50/40', 'ring-1', 'ring-blue-600/30');
        radSingle?.classList.remove('border-slate-300', 'bg-white', 'text-transparent');
        radSingle?.classList.add('border-blue-600', 'bg-blue-600', 'text-white');

        cardRange?.classList.remove('border-blue-600', 'bg-blue-50/40', 'ring-1', 'ring-blue-600/30');
        cardRange?.classList.add('border-slate-200', 'bg-white');
        radRange?.classList.remove('border-blue-600', 'bg-blue-600', 'text-white');
        radRange?.classList.add('border-slate-300', 'bg-white', 'text-transparent');

        boxSingle?.classList.remove('hidden');
        boxRange?.classList.add('hidden');
      } else {
        cardRange?.classList.remove('border-slate-200', 'bg-white');
        cardRange?.classList.add('border-blue-600', 'bg-blue-50/40', 'ring-1', 'ring-blue-600/30');
        radRange?.classList.remove('border-slate-300', 'bg-white', 'text-transparent');
        radRange?.classList.add('border-blue-600', 'bg-blue-600', 'text-white');

        cardSingle?.classList.remove('border-blue-600', 'bg-blue-50/40', 'ring-1', 'ring-blue-600/30');
        cardSingle?.classList.add('border-slate-200', 'bg-white');
        radSingle?.classList.remove('border-blue-600', 'bg-blue-600', 'text-white');
        radSingle?.classList.add('border-slate-300', 'bg-white', 'text-transparent');

        boxSingle?.classList.add('hidden');
        boxRange?.classList.remove('hidden');
      }
    }

    // Step Nav Buttons & Indicators
    btnAgendaNext?.addEventListener('click', () => {
      if (validateStep(currentStep)) {
        updateStepUI(currentStep + 1);
      }
    });

    btnAgendaPrev?.addEventListener('click', () => {
      if (currentStep > 1) {
        if (formError) formError.classList.add('hidden');
        updateStepUI(currentStep - 1);
      }
    });

    document.querySelectorAll('.agenda-step-indicator').forEach((ind) => {
      ind.addEventListener('click', () => {
        const target = parseInt((ind as HTMLElement).dataset.step || '1', 10);
        if (target === currentStep) return;
        if (target > currentStep) {
          for (let s = currentStep; s < target; s++) {
            if (!validateStep(s)) return;
          }
        }
        if (formError) formError.classList.add('hidden');
        updateStepUI(target);
      });
    });

    // Wire Card Click Selections
    ['kbm', 'rapat', 'lsp', 'khusus'].forEach((cat) => {
      document.getElementById(`cat-card-${cat}`)?.addEventListener('click', () => setCategory(cat));
    });

    document.getElementById('agenda-vis-card-public')?.addEventListener('click', () => setVisibility('public'));
    document.getElementById('agenda-vis-card-guru')?.addEventListener('click', () => setVisibility('guru'));

    document.getElementById('mode-card-single')?.addEventListener('click', () => setDurationMode('single'));
    document.getElementById('mode-card-range')?.addEventListener('click', () => setDurationMode('range'));

    document.querySelectorAll('.btn-lead-day').forEach((btn) => {
      btn.addEventListener('click', () => {
        const d = parseInt((btn as HTMLElement).dataset.days || '0', 10);
        setLeadDays(d);
      });
    });

    // Modal Detail Control
    function openDetailModal(item: any) {
      selectedDetailItem = item;
      const catBadge = document.getElementById('detail-category-badge');
      const visBadge = document.getElementById('detail-vis-badge');
      const rangeBadge = document.getElementById('detail-range-badge');
      const title = document.getElementById('detail-agenda-title');
      const date = document.getElementById('detail-agenda-date');
      const time = document.getElementById('detail-agenda-time');
      const room = document.getElementById('detail-agenda-room');
      const cls = document.getElementById('detail-agenda-class');
      const inst = document.getElementById('detail-agenda-instructor');

      if (catBadge) {
        const catMap: Record<string, { label: string; cls: string }> = {
          kbm: { label: 'KBM Reguler', cls: 'bg-teal-50 text-teal-800 border-teal-200/60' },
          rapat: { label: 'Rapat & Staf', cls: 'bg-rose-50 text-rose-800 border-rose-200/60' },
          lsp: { label: 'UKK / LSP', cls: 'bg-purple-50 text-purple-800 border-purple-200/60' },
          khusus: { label: 'Agenda Khusus', cls: 'bg-amber-50 text-amber-800 border-amber-200/60' },
        };
        const c = catMap[item.category] || catMap.kbm;
        catBadge.textContent = c.label;
        catBadge.className = `px-2.5 py-1 rounded-xl text-xs font-bold border ${c.cls}`;
      }

      if (visBadge) {
        const isGuru = item.visibility === 'guru';
        visBadge.textContent = isGuru ? 'Khusus Guru' : 'Publik';
        visBadge.className = isGuru
          ? 'px-2.5 py-1 rounded-xl text-xs font-bold bg-amber-50 text-amber-800 border border-amber-200/60'
          : 'px-2.5 py-1 rounded-xl text-xs font-bold bg-blue-50 text-blue-700 border border-blue-200/60';
      }

      if (rangeBadge) {
        const isMultiDay = item.startDate && item.endDate && item.startDate !== item.endDate;
        if (isMultiDay) {
          rangeBadge.classList.remove('hidden');
        } else {
          rangeBadge.classList.add('hidden');
        }
      }

      if (title) title.textContent = item.title || '-';
      if (date) {
        if (item.startDate && item.endDate && item.startDate !== item.endDate) {
          date.textContent = `${item.startDate} s/d ${item.endDate}`;
        } else {
          date.textContent = item.date || item.startDate || '-';
        }
      }
      if (time) time.textContent = `${item.timeStart || '08:00'} - ${item.timeEnd || '09:30'} WIB`;
      if (room) room.textContent = item.room || 'Ruang KBM';
      if (cls) cls.textContent = item.classTarget || 'Semua Kelas';
      if (inst) inst.textContent = item.instructor || 'Guru Pengampu';

      const leadEl = document.getElementById('detail-agenda-lead');
      const leadRow = document.getElementById('detail-lead-row');
      if (leadEl && leadRow) {
        if (item.visibility === 'guru') {
          leadRow.classList.add('hidden');
        } else {
          leadRow.classList.remove('hidden');
          const ld = Number(item.notifyLeadDays ?? 0);
          leadEl.textContent = ld === 0 ? 'Langsung Tampil' : `Mulai H-${ld} Pelaksanaan`;
        }
      }

      if (detailModal) {
        detailModal.classList.remove('hidden');
        detailModal.classList.add('flex');
      }
    }

    function closeDetailModal() {
      if (detailModal) {
        detailModal.classList.add('hidden');
        detailModal.classList.remove('flex');
      }
    }

    document.getElementById('btn-close-detail-modal')?.addEventListener('click', closeDetailModal);
    document.getElementById('btn-detail-close-action')?.addEventListener('click', closeDetailModal);

    document.getElementById('btn-detail-edit')?.addEventListener('click', () => {
      if (selectedDetailItem) {
        closeDetailModal();
        openEditModal(selectedDetailItem);
      }
    });

    document.getElementById('btn-detail-delete')?.addEventListener('click', () => {
      if (selectedDetailItem && confirm(`Hapus rencana agenda "${selectedDetailItem.title}"?`)) {
        closeDetailModal();
        deleteScheduleItem(selectedDetailItem.id);
      }
    });

    // Modal Agenda Control
    function openAddModalWithDate(specificDate?: string) {
      if (modalTitle) modalTitle.textContent = 'Perencanaan Agenda Baru';
      if (agendaForm) agendaForm.reset();
      if (idInput) idInput.value = '';

      const targetDate = specificDate || toDateString(selectedDateForBox);
      if (dateInput) dateInput.value = targetDate;
      if (startDateInput) startDateInput.value = targetDate;
      if (endDateInput) endDateInput.value = targetDate;

      setCategory('kbm');
      setVisibility('public');
      setLeadDays(0);
      setDurationMode('single');
      updateStepUI(1);

      if (formError) { formError.classList.add('hidden'); formError.textContent = ''; }
      if (modal) {
        modal.classList.remove('hidden');
        modal.classList.add('flex');
      }
    }

    function openEditModal(item: any) {
      if (modalTitle) modalTitle.textContent = 'Edit Rencana Agenda';
      if (idInput) idInput.value = item.id || '';
      if (titleInput) titleInput.value = item.title || '';
      if (timeStartInput) timeStartInput.value = item.timeStart || '08:00';
      if (timeEndInput) timeEndInput.value = item.timeEnd || '09:30';
      if (roomInput) roomInput.value = item.room || '';
      if (classInput) classInput.value = item.classTarget || '';
      if (instInput) instInput.value = item.instructor || '';

      setCategory(item.category || 'kbm');
      setVisibility(item.visibility === 'guru' ? 'guru' : 'public');
      setLeadDays(Number(item.notifyLeadDays ?? 0));

      if (item.startDate && item.endDate && item.startDate !== item.endDate) {
        setDurationMode('range');
        if (startDateInput) startDateInput.value = item.startDate;
        if (endDateInput) endDateInput.value = item.endDate;
        if (dateInput) dateInput.value = item.startDate;
      } else {
        setDurationMode('single');
        const fallbackDate = item.date || item.startDate || toDateString(viewingDate);
        if (dateInput) dateInput.value = fallbackDate;
        if (startDateInput) startDateInput.value = fallbackDate;
        if (endDateInput) endDateInput.value = fallbackDate;
      }

      updateStepUI(1);

      if (formError) { formError.classList.add('hidden'); formError.textContent = ''; }
      if (modal) {
        modal.classList.remove('hidden');
        modal.classList.add('flex');
      }
    }

    function closeModal() {
      if (modal) {
        modal.classList.add('hidden');
        modal.classList.remove('flex');
      }
    }

    btnOpenModal?.addEventListener('click', () => openAddModalWithDate());
    btnCloseModal?.addEventListener('click', closeModal);

    // Save Form
    agendaForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!validateStep(1) || !validateStep(3)) {
        return;
      }
      if (formError) formError.classList.add('hidden');

      const isRange = durationModeInput?.value === 'range';
      const startDateStr = isRange
        ? (startDateInput?.value || toDateString(viewingDate))
        : (dateInput?.value || toDateString(viewingDate));
      const endDateStr = isRange ? (endDateInput?.value || startDateStr) : startDateStr;
      const dateParts = startDateStr.split('-');
      const chosenDate = dateParts.length === 3
        ? new Date(parseInt(dateParts[0], 10), parseInt(dateParts[1], 10) - 1, parseInt(dateParts[2], 10))
        : new Date(startDateStr + 'T00:00:00');
      const dayName = ['Minggu', 'Senin', 'Selasa', 'Rabu', 'Kamis', 'Jumat', 'Sabtu'][chosenDate.getDay()] || 'Senin';

      const payload = {
        id: idInput?.value || undefined,
        title: titleInput?.value?.trim() || '',
        category: categoryInput?.value || 'kbm',
        day: dayName,
        date: startDateStr,
        startDate: startDateStr,
        endDate: endDateStr,
        visibility: visibilityInput?.value === 'guru' ? 'guru' : 'public',
        notifyLeadDays: Number(leadDaysInput?.value || 0),
        timeStart: timeStartInput?.value || '08:00',
        timeEnd: timeEndInput?.value || '09:30',
        room: roomInput?.value?.trim() || 'Ruang KBM',
        classTarget: classInput?.value?.trim() || 'Semua Kelas',
        instructor: instInput?.value?.trim() || 'Guru Pengampu',
      };

      try {
        const res = await fetch('/api/schedules', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        const result = await res.json();
        if (!res.ok) {
          if (formError) {
            formError.textContent = result.message || 'Gagal menyimpan agenda';
            formError.classList.remove('hidden');
          }
          return;
        }
        closeModal();
        const parts = startDateStr.split('-');
        if (parts.length === 3) {
          selectedDateForBox = new Date(parseInt(parts[0], 10), parseInt(parts[1], 10) - 1, parseInt(parts[2], 10));
          viewingDate = new Date(selectedDateForBox);
          miniCalYear = selectedDateForBox.getFullYear();
          miniCalMonth = selectedDateForBox.getMonth();
        }
        await loadSchedules();
      } catch (err: any) {
        if (formError) {
          formError.textContent = err.message || 'Terjadi kesalahan sistem';
          formError.classList.remove('hidden');
        }
      }
    });

    async function deleteScheduleItem(id: string) {
      try {
        const res = await fetch(`/api/schedules?id=${id}`, {
          method: 'DELETE',
        });
        if (res.ok) {
          await loadSchedules();
        }
      } catch (e) {
        console.error('Gagal menghapus agenda:', e);
      }
    }

    // Week navigation controls
    document.getElementById('btn-prev-week')?.addEventListener('click', () => {
      viewingDate.setDate(viewingDate.getDate() - 7);
      renderWeekView();
    });

    document.getElementById('btn-next-week')?.addEventListener('click', () => {
      viewingDate.setDate(viewingDate.getDate() + 7);
      renderWeekView();
    });

    document.getElementById('btn-today-week')?.addEventListener('click', () => {
      viewingDate = new Date();
      selectedDateForBox = new Date();
      miniCalYear = viewingDate.getFullYear();
      miniCalMonth = viewingDate.getMonth();
      renderWeekView();
      renderMiniCalendar();
      renderUpcoming();
    });

    // Month navigation controls
    document.getElementById('btn-prev-month')?.addEventListener('click', () => {
      miniCalMonth--;
      if (miniCalMonth < 0) {
        miniCalMonth = 11;
        miniCalYear--;
      }
      renderMiniCalendar();
    });

    document.getElementById('btn-next-month')?.addEventListener('click', () => {
      miniCalMonth++;
      if (miniCalMonth > 11) {
        miniCalMonth = 0;
        miniCalYear++;
      }
      renderMiniCalendar();
    });

    // Horizontal Category Tab Filters
    const catTabButtons = document.querySelectorAll('.cat-tab-btn');
    catTabButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const cat = (btn as HTMLElement).dataset.cat;
        if (!cat) return;

        catTabButtons.forEach((b) => {
          b.className = 'cat-tab-btn shrink-0 whitespace-nowrap px-2.5 py-1 rounded-md text-xs font-medium transition-colors bg-slate-100 text-slate-600 hover:text-slate-900 hover:bg-slate-200/70 border border-slate-200/60 cursor-pointer flex items-center gap-1.5 active:scale-95';
        });

        if (cat === 'all') {
          activeCategories.clear();
          activeCategories.add('kbm');
          activeCategories.add('rapat');
          activeCategories.add('lsp');
          activeCategories.add('khusus');
          btn.className = 'cat-tab-btn shrink-0 whitespace-nowrap px-2.5 py-1 rounded-md text-xs font-semibold transition-colors bg-slate-900 text-white shadow-2xs cursor-pointer active:scale-95';
        } else {
          activeCategories.clear();
          activeCategories.add(cat);
          btn.className = 'cat-tab-btn shrink-0 whitespace-nowrap px-2.5 py-1 rounded-md text-xs font-semibold transition-colors bg-blue-600 text-white shadow-2xs cursor-pointer flex items-center gap-1.5 active:scale-95';
        }

        renderWeekView();
      });
    });

    // Realtime Listener
    window.addEventListener('attendance-updated', loadSchedules);

    // Dynamic Autocomplete Guru Pengampu dari Data Terdaftar
    fetch('/api/students')
      .then((r) => r.json())
      .then((civitasList) => {
        const instDatalist = document.getElementById('datalist-instructors');
        if (!instDatalist || !Array.isArray(civitasList)) return;
        const teachers = civitasList.filter((c: any) => c.role === 'guru' || c.role === 'admin');
        const teacherOptions = teachers.map((t: any) => `<option value="${t.name}">`).join('');
        instDatalist.innerHTML = teacherOptions + instDatalist.innerHTML;
      })
      .catch(() => {});

    // Mobile Sidebar Toggle (Kalender & Filter Kategori)
    const btnToggleSidebarMobile = document.getElementById('btn-toggle-sidebar-mobile');
    const sidebarCollapsibleWrapper = document.getElementById('sidebar-collapsible-wrapper');
    const labelToggleSidebar = document.getElementById('label-toggle-sidebar');
    const iconToggleSidebar = document.getElementById('icon-toggle-sidebar');

    if (btnToggleSidebarMobile && sidebarCollapsibleWrapper) {
      btnToggleSidebarMobile.addEventListener('click', () => {
        const isHidden = sidebarCollapsibleWrapper.classList.contains('hidden');
        if (isHidden) {
          sidebarCollapsibleWrapper.classList.remove('hidden');
          if (labelToggleSidebar) labelToggleSidebar.textContent = 'Tutup';
          if (iconToggleSidebar) iconToggleSidebar.classList.add('rotate-180');
        } else {
          sidebarCollapsibleWrapper.classList.add('hidden');
          if (labelToggleSidebar) labelToggleSidebar.textContent = 'Tampilkan';
          if (iconToggleSidebar) iconToggleSidebar.classList.remove('rotate-180');
        }
      });
    }

    // Initial Load
    loadSchedules();
  </script>
</Layout>
