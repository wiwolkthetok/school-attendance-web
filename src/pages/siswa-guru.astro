    function validateWhatsApp(phone: string): {
      valid: boolean;
      message: string;
    } {
      const cleaned = phone.replace(/[\s\-\.]/g, "");
      if (!cleaned) {
        return { valid: false, message: "Nomor WhatsApp wajib diisi." };
      }
      if (!/^\+?[0-9]+$/.test(cleaned)) {
        return {
          valid: false,
          message: "Nomor WhatsApp hanya boleh berisi angka.",
        };
      }
      if (cleaned.startsWith("08")) {
        if (cleaned.length < 10) {
          return {
            valid: false,
            message: `Nomor WhatsApp kurang (${cleaned.length} digit). Wajib minimal 10 digit (contoh: 0812345678).`,
          };
        }
        if (cleaned.length > 13) {
          return {
            valid: false,
            message: `Nomor WhatsApp berlebih (${cleaned.length} digit). Maksimal 13 digit (contoh: 082177889900).`,
          };
        }
        return {
          valid: true,
          message: `Nomor WhatsApp valid (${cleaned.length} digit).`,
        };
      } else if (cleaned.startsWith("628")) {
        if (cleaned.length < 11) {
          return {
            valid: false,
            message: `Nomor WhatsApp format 628 kurang (${cleaned.length} digit). Minimal 11 digit.`,
          };
        }
        if (cleaned.length > 14) {
          return {
            valid: false,
            message: `Nomor WhatsApp format 628 berlebih (${cleaned.length} digit). Maksimal 14 digit.`,
          };
        }
        return {
          valid: true,
          message: `Nomor WhatsApp valid (${cleaned.length} digit).`,
        };
      } else if (cleaned.startsWith("+628")) {
        if (cleaned.length < 12) {
          return {
            valid: false,
            message: `Nomor WhatsApp format +628 kurang (${cleaned.length - 1} digit). Minimal 11 digit.`,
          };
        }
        if (cleaned.length > 15) {
          return {
            valid: false,
            message: `Nomor WhatsApp format +628 berlebih (${cleaned.length - 1} digit). Maksimal 14 digit.`,
          };
        }
        return {
          valid: true,
          message: `Nomor WhatsApp valid (${cleaned.length - 1} digit).`,
        };
      } else {
        return {
          valid: false,
          message:
            "Nomor WhatsApp harus diawali 08 atau 628 (contoh: 082177889900).",
        };
      }
    }

    const phoneCounterAdmin = document.getElementById("phone-counter-admin");
    const phoneFeedbackAdmin = document.getElementById("phone-feedback-admin");

    phoneInput?.addEventListener("input", () => {
      const val = phoneInput.value.trim();
      const digitsOnly = val.replace(/[^0-9]/g, "");
      const res = validateWhatsApp(val);

      if (phoneCounterAdmin) {
        phoneCounterAdmin.textContent = `${digitsOnly.length} / 10–13 digit`;
        if (res.valid) {
          phoneCounterAdmin.className =
            "text-[10px] font-mono font-bold text-emerald-600";
        } else if (digitsOnly.length === 0) {
          phoneCounterAdmin.className =
            "text-[10px] font-mono font-bold text-slate-400";
        } else {
          phoneCounterAdmin.className =
            "text-[10px] font-mono font-bold text-rose-500";
        }
      }

      if (phoneFeedbackAdmin) {
        if (!val) {
          phoneFeedbackAdmin.textContent =
            "Wajib diisi nomor WhatsApp aktif (diawali 08 atau 628, panjang 10–13 digit).";
          phoneFeedbackAdmin.className = "text-[10px] text-slate-500 mt-1";
        } else if (res.valid) {
          phoneFeedbackAdmin.textContent = `✓ ${res.message}`;
          phoneFeedbackAdmin.className =
            "text-[10px] text-emerald-600 font-bold mt-1";
        } else {
          phoneFeedbackAdmin.textContent = `⚠ ${res.message}`;
          phoneFeedbackAdmin.className =
            "text-[10px] text-rose-600 font-medium mt-1";
        }
      }
    });

    function validateStep(step: number): boolean {
      if (formError) formError.classList.add("hidden");
      if (step === 1) {
        return true;
      }
      if (step === 2) {
        if (!nameInput?.value.trim()) {
          if (formError) {
            formError.textContent =
              "Mohon isi nama lengkap siswa terlebih dahulu.";
            formError.classList.remove("hidden");
          }
          nameInput?.focus();
          return false;
        }
        if (!identInput?.value.trim()) {
          if (formError) {
            formError.textContent =
              selectedRole === "admin"
                ? "Mohon isi NIP / ID Administrator."
                : selectedRole === "guru"
                  ? "Mohon isi Nomor Induk Pegawai (NIP / NUPTK)."
                  : "Mohon isi Nomor Induk Siswa Nasional (NISN).";
            formError.classList.remove("hidden");
          }
          identInput?.focus();
          return false;
        }
      } else if (step === 3) {
        if (!classInput?.value.trim()) {
          if (formError) {
            formError.textContent =
              selectedRole === "admin"
                ? "Mohon isi jabatan struktural administrator (contoh: Kepala Sekolah / Waka Kesiswaan)."
                : selectedRole === "guru"
                  ? "Mohon isi jabatan / tugas mengajar dewan guru."
                  : "Mohon isi rombel / kelas siswa (contoh: XII RPL).";
            formError.classList.remove("hidden");
          }
          classInput?.focus();
          return false;
        }

        const phoneVal = phoneInput?.value?.trim() || "";
        const phoneCheck = validateWhatsApp(phoneVal);
        if (!phoneCheck.valid) {
          if (formError) {
            formError.textContent = phoneCheck.message;
            formError.classList.remove("hidden");
          }
          phoneInput?.focus();
          return false;
        }
      }
      return true;
    }

    function updateStepUI(targetStep: number) {
      currentStep = targetStep;

      // Toggle Panels
      stepPanel1?.classList.toggle("hidden", currentStep !== 1);
      stepPanel2?.classList.toggle("hidden", currentStep !== 2);
      stepPanel3?.classList.toggle("hidden", currentStep !== 3);
      stepPanel4?.classList.toggle("hidden", currentStep !== 4);

      // Update Stepper Progress Line
      if (stepperLine) {
        stepperLine.style.width =
          currentStep === 1
            ? "0%"
            : currentStep === 2
              ? "33.3%"
              : currentStep === 3
                ? "66.6%"
                : "100%";
      }

      // Update Stepper Indicators (1 - 2 - 3 - 4)
      for (let s = 1; s <= 4; s++) {
        const badge = document.getElementById(`step-badge-${s}`);
        const label = document.getElementById(`step-label-${s}`);
        if (!badge || !label) continue;

        if (s < currentStep) {
          // Selesai
          badge.className =
            "w-7 h-7 rounded-full bg-emerald-500 text-white font-black text-xs flex items-center justify-center shadow-md shadow-emerald-500/20 transition-all";
          badge.innerHTML =
            '<span class="material-symbols-outlined text-sm font-bold">check</span>';
          label.className =
            "text-[10px] font-bold text-emerald-700 whitespace-nowrap";
        } else if (s === currentStep) {
          // Sedang Aktif
          badge.className =
            "w-7 h-7 rounded-full bg-gradient-to-r from-blue-600 to-indigo-600 text-white font-black text-xs flex items-center justify-center shadow-md shadow-blue-500/30 ring-4 ring-blue-100 transition-all";
          badge.textContent = String(s);
          label.className =
            "text-[10px] font-bold text-blue-700 whitespace-nowrap";
        } else {
          // Belum Aktif
          badge.className =
            "w-7 h-7 rounded-full bg-slate-100 text-slate-400 font-bold text-xs flex items-center justify-center transition-all";
          badge.textContent = String(s);
          label.className =
            "text-[10px] font-semibold text-slate-400 whitespace-nowrap";
        }
      }

      // Update Tombol Navigasi Kapsul
      if (currentStep === 1) {
        btnStepPrev?.classList.add("hidden");
        btnStepNext?.classList.remove("hidden");
        if (btnStepNext) btnStepNext.textContent = "Lanjut →";
        btnSubmitStudent?.classList.add("hidden");
      } else if (currentStep === 2) {
        btnStepPrev?.classList.remove("hidden");
        if (btnStepPrev) btnStepPrev.textContent = "← Kembali";
        btnStepNext?.classList.remove("hidden");
        if (btnStepNext) btnStepNext.textContent = "Lanjut →";
        btnSubmitStudent?.classList.add("hidden");
      } else if (currentStep === 3) {
        btnStepPrev?.classList.remove("hidden");
        if (btnStepPrev) btnStepPrev.textContent = "← Kembali";
        btnStepNext?.classList.remove("hidden");
        if (btnStepNext) btnStepNext.textContent = "Lanjut →";
        btnSubmitStudent?.classList.add("hidden");
      } else if (currentStep === 4) {
        btnStepPrev?.classList.remove("hidden");
        if (btnStepPrev) btnStepPrev.textContent = "← Kembali";
        btnStepNext?.classList.add("hidden");
        btnSubmitStudent?.classList.remove("hidden");

        // Isi Ringkasan Civitas pada Langkah 4
        if (summaryName)
          summaryName.textContent = nameInput?.value.trim() || "-";
        if (summaryRole) {
          summaryRole.textContent =
            selectedRole === "admin"
              ? "Administrator Sekolah (Hak Akses Penuh)"
              : selectedRole === "guru"
                ? "Dewan Guru / Tenaga Pendidik"
                : "Siswa Reguler";
        }
        if (summaryClass) {
          summaryClass.textContent = `${classInput?.value.trim() || "-"} (${(catSelect?.value || (selectedRole === "admin" ? "ADMIN" : "RPL")).toUpperCase()})`;
        }
      }
    }

    btnStepNext?.addEventListener("click", () => {
      if (currentStep === 1) {
        if (validateStep(1)) updateStepUI(2);
      } else if (currentStep === 2) {
        if (validateStep(2)) updateStepUI(3);
      } else if (currentStep === 3) {
        if (validateStep(3)) updateStepUI(4);
      }
    });

    btnStepPrev?.addEventListener("click", () => {
      if (currentStep > 1) {
        updateStepUI(currentStep - 1);
      }
    });

    document.querySelectorAll(".step-indicator").forEach((ind) => {
      ind.addEventListener("click", () => {
        const target = parseInt((ind as HTMLElement).dataset.step || "1", 10);
        if (target === currentStep) return;
        if (target > currentStep) {
          if (currentStep === 1 && !validateStep(1)) return;
          if (currentStep === 2 && !validateStep(2)) return;
          if (currentStep === 3 && !validateStep(3)) return;
        }
        updateStepUI(target);
      });
    });

