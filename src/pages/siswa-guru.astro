          >
            Batal
          </button>
          <button
            type="button"
            id="btn-submit-promote"
            class="px-6 py-2.5 rounded-full bg-blue-600 hover:bg-blue-700 text-white font-bold text-xs shadow-md shadow-blue-500/20 active:scale-95 transition-all flex items-center gap-2 cursor-pointer disabled:opacity-50"
          >
            <span class="material-symbols-outlined text-sm">upgrade</span>
            <span>Terapkan Kenaikan Kelas</span>
          </button>
        </div>
      </div>
    </div>
  </div>

  <script>
    let allStudents: any[] = [];
    let currentLogs: any[] = [];
    let currentPermissions: any[] = [];
    let activeFilter = "all";
    let searchQuery = "";

    const tbody = document.getElementById("studentsTableBody");
    const mobileContainer = document.getElementById("studentsMobileList");
    const modal = document.getElementById("student-modal");
    const btnOpenModal = document.getElementById("btn-open-student-modal");
    const btnCloseModal = document.getElementById("btn-close-student-modal");
    const btnCancelModal = document.getElementById("btn-cancel-student-modal");
    const studentForm = document.getElementById(
      "student-form",
    ) as HTMLFormElement | null;
    const formError = document.getElementById("student-form-error");
    const modalTitle = document.getElementById("modal-student-title");

    const idInput = document.getElementById(
      "student-id-input",
    ) as HTMLInputElement | null;
    const nameInput = document.getElementById(
      "student-name-input",
    ) as HTMLInputElement | null;
    const identInput = document.getElementById(
      "student-identifier-input",
    ) as HTMLInputElement | null;
    const catSelect = document.getElementById(
      "student-category-select",
    ) as HTMLSelectElement | null;
    const classInput = document.getElementById(
      "student-class-input",
    ) as HTMLInputElement | null;
    const uidInput = document.getElementById(
      "student-uid-input",
    ) as HTMLInputElement | null;
    const addressInput = document.getElementById(
      "student-address-input",
    ) as HTMLInputElement | null;
    const birthInput = document.getElementById(
      "student-birth-input",
    ) as HTMLInputElement | null;
    const emailInput = document.getElementById(
      "student-email-input",
    ) as HTMLInputElement | null;
    const phoneInput = document.getElementById(
      "student-parent-phone",
    ) as HTMLInputElement | null;
    const btnGenUid = document.getElementById("btn-gen-uid");
    const searchInput = document.getElementById(
      "search-civitas-input",
    ) as HTMLInputElement | null;

    function loadCachedData() {
      try {
        const cached = localStorage.getItem("civitas_data_cache");
        if (cached) {
          const parsed = JSON.parse(cached);
          if (Array.isArray(parsed.students)) {
            allStudents = parsed.students;
            currentLogs = parsed.logs || [];
            currentPermissions = parsed.permissions || [];
            updateCategoryCounts();
            renderTable();
          }
        }
      } catch (e) {}
    }

    async function loadData() {
      try {
        const [sRes, lRes, pRes] = await Promise.all([
          fetch("/api/students"),
          fetch("/api/attendance?t=" + Date.now()),
          fetch("/api/permissions"),
        ]);
        allStudents = await sRes.json();
        currentLogs = await lRes.json();
        currentPermissions = await pRes.json();

        try {
          localStorage.setItem("civitas_data_cache", JSON.stringify({ students: allStudents, logs: currentLogs, permissions: currentPermissions }));
        } catch (e) {}

        updateCategoryCounts();
        renderTable();
      } catch (e) {
        console.error("Gagal memuat civitas:", e);
      }
    }

    loadCachedData();

    function updateCategoryCounts() {
      const isAlumni = (s: any) => s.category === "alumni" || (s.className || "").toLowerCase().includes("alumni") || (s.className || "").toLowerCase().includes("lulus");
      const akl = allStudents.filter((s) => s.category === "akl" && !isAlumni(s)).length;
      const rpl = allStudents.filter((s) => s.category === "rpl" && !isAlumni(s)).length;
      const guru = allStudents.filter(
        (s) => s.role === "guru" || s.category === "guru",
      ).length;

      const setEl = (id: string, val: number) => {
        const el = document.getElementById(id);
        if (el) el.textContent = String(val);
      };

      setEl("stat-count-akl", akl);
      setEl("stat-count-rpl", rpl);
      setEl("stat-count-guru", guru);

      const headerTotal = document.getElementById("header-total-count");
      if (headerTotal)
        headerTotal.textContent = `${allStudents.length} Terdaftar`;
    }

    function renderTable() {
      if (!tbody && !mobileContainer) return;

      const q = searchQuery.toLowerCase().trim();
      const filtered = allStudents.filter((s) => {
        const isAlumniStudent =
          s.category === "alumni" ||
          (s.className || "").toLowerCase().includes("alumni") ||
          (s.className || "").toLowerCase().includes("lulus");

        const matchFilter =
          activeFilter === "all" ||
          (activeFilter === "alumni" && isAlumniStudent) ||
          (activeFilter === "guru" &&
            (s.role === "guru" || s.category === "guru")) ||
          (activeFilter === "admin" &&
            (s.role === "admin" || s.category === "admin")) ||
          (s.category === activeFilter && !isAlumniStudent);

        const matchQuery =
          !q ||
          s.name.toLowerCase().includes(q) ||
          (s.identifier || "").toLowerCase().includes(q) ||
          (s.rfidUid || "").toLowerCase().includes(q) ||
          (s.className || "").toLowerCase().includes(q);

        return matchFilter && matchQuery;
      });

      if (!filtered.length) {
        if (tbody) {
          tbody.innerHTML = `
            <tr>
              <td colspan="5" class="py-10 text-center text-slate-400 font-medium">
                Tidak ada siswa yang sesuai dengan filter pencarian.
              </td>
            </tr>
          `;
        }
        if (mobileContainer) {
          mobileContainer.innerHTML = `
            <div class="py-10 text-center text-slate-400 font-medium text-xs">
              Tidak ada siswa yang sesuai dengan filter pencarian.
            </div>
          `;
        }
        return;
      }

      let tableHtml = "";
      let mobileHtml = "";

      filtered.forEach((item) => {
        const initials = item.name
          .split(" ")
          .map((n: string) => n[0])
          .slice(0, 2)
          .join("");
        const tingkat =
          item.role === "admin"
            ? "ADMIN"
            : item.role === "guru"
              ? "GURU"
              : item.className.split(" ")[0] || "X";

        // Normalisasi pencocokan log ke siswa (kebal leading zero, huruf besar/kecil, atau kecocokan ID/Nama)
        const itemCleanUid = (item.rfidUid || '').trim().toUpperCase().replace(/^0+/, '');
        const itemName = (item.name || '').trim().toLowerCase();
        const itemId = (item.id || '').trim().toUpperCase();

        const studentLogs = currentLogs.filter((l: any) => {
          const lCleanUid = (l.rfidUid || '').trim().toUpperCase().replace(/^0+/, '');
          const lName = (l.name || '').trim().toLowerCase();
          const lId = (l.id || '').trim().toUpperCase();
          return (
            (itemCleanUid && lCleanUid && itemCleanUid === lCleanUid) ||
            (itemId && lId.includes(itemId)) ||
            (itemName && lName === itemName)
          );
        });

        // Prioritas presensi masuk: Utamakan log 'Hadir' atau 'Terlambat' asli di atas tiket 'Alpa' otomatis
        const masukLogs = studentLogs.filter((l: any) => l.type === 'masuk');
        const masukLog = masukLogs.find((l: any) => l.status === 'Hadir' || l.status === 'Terlambat') || masukLogs[0];
        const pulangLog = studentLogs.find((l: any) => l.type === 'pulang');

        // Cek apakah civitas memiliki izin resmi yang disetujui untuk hari ini
        const todayStr = new Date().toLocaleDateString("en-CA", {
          timeZone: "Asia/Jakarta",
        });
        const activePerm = currentPermissions.find((p: any) => {
          const match =
            p.studentId === item.id ||
            (p.name &&
              item.name &&
              p.name.toLowerCase() === item.name.toLowerCase());
          return (
            match &&
            p.status === "Disetujui" &&
            todayStr >= p.startDate &&
            todayStr <= (p.endDate || p.startDate)
          );
        });

        let statusBadgeHtml = "";

        if (activePerm) {
          statusBadgeHtml = `
            <span class="inline-flex items-center gap-1.5 text-[11px] font-bold text-purple-900 bg-purple-100 border border-purple-300 px-2.5 sm:px-3 py-1 rounded-full whitespace-nowrap shadow-xs">
              <span class="w-2 h-2 rounded-full bg-purple-600"></span>
              Izin (${activePerm.categoryLabel || "Sah"})
            </span>
          `;
        } else if (pulangLog && pulangLog.status === "Bolos") {
          statusBadgeHtml = `
            <span class="inline-flex items-center gap-1.5 text-[11px] font-bold text-rose-900 bg-rose-100 border border-rose-300 px-2.5 sm:px-3 py-1 rounded-full whitespace-nowrap shadow-xs animate-pulse">
              <span class="w-2 h-2 rounded-full bg-rose-600"></span>
              Bolos (-20)
            </span>
          `;
        } else if (masukLog && pulangLog) {
          statusBadgeHtml = `
            <div class="flex items-center gap-1.5 flex-wrap">
              <span class="inline-flex items-center gap-1 text-[10px] font-bold ${masukLog.status === "Terlambat" ? "text-amber-800 bg-amber-100 border-amber-300" : (masukLog.status === "Alpa" ? "text-purple-800 bg-purple-100 border-purple-300" : "text-emerald-800 bg-emerald-100 border-emerald-300")} border px-2 sm:px-2.5 py-0.5 rounded-full shadow-xs">
                Masuk ${masukLog.time}
              </span>
              <span class="inline-flex items-center gap-1 text-[10px] font-bold text-blue-800 bg-blue-100 border border-blue-300 px-2 sm:px-2.5 py-0.5 rounded-full shadow-xs">
                Pulang ${pulangLog.time}
              </span>
            </div>
          `;
        } else if (masukLog) {
          const isLate = masukLog.status === "Terlambat";
          const isAlpa = masukLog.status === "Alpa";
          const badgeClass = isAlpa
            ? "text-purple-900 bg-purple-100 border-purple-300"
            : (isLate ? "text-amber-900 bg-amber-100 border-amber-300" : "text-emerald-900 bg-emerald-100 border-emerald-300");
          const dotClass = isAlpa ? "bg-purple-600" : (isLate ? "bg-amber-600" : "bg-emerald-600");
          statusBadgeHtml = `
            <span class="inline-flex items-center gap-1.5 text-[11px] font-bold ${badgeClass} border px-2.5 sm:px-3 py-1 rounded-full whitespace-nowrap shadow-xs">
              <span class="w-2 h-2 rounded-full ${dotClass}"></span>
              ${masukLog.status} (${masukLog.time})
            </span>
          `;
        } else if (pulangLog) {
          statusBadgeHtml = `
            <span class="inline-flex items-center gap-1.5 text-[11px] font-bold text-blue-900 bg-blue-100 border border-blue-300 px-2.5 sm:px-3 py-1 rounded-full whitespace-nowrap shadow-xs">
              <span class="w-2 h-2 rounded-full bg-blue-600"></span>
              Pulang (${pulangLog.time})
            </span>
          `;
        } else {
          const isAlumni =
            item.category === "alumni" ||
            (item.className || "").toLowerCase().includes("alumni") ||
            (item.className || "").toLowerCase().includes("lulus");

          if (isAlumni) {
            statusBadgeHtml = `
              <span class="inline-flex items-center gap-1 text-[11px] font-bold text-slate-500 bg-slate-100 border border-slate-200 px-2.5 sm:px-3 py-1 rounded-full whitespace-nowrap shadow-xs">
                <span class="material-symbols-outlined text-[13px] text-slate-400">school</span>
                Alumni
              </span>
            `;
          } else {
            statusBadgeHtml = `
              <span class="inline-flex items-center gap-1.5 text-[11px] font-bold text-slate-600 bg-slate-100 border border-slate-300 px-2.5 sm:px-3 py-1 rounded-full whitespace-nowrap shadow-xs">
                <span class="w-2 h-2 rounded-full bg-slate-400"></span>
                Belum Hadir
              </span>
            `;
          }
        }

        const avatarClass =
          item.role === "admin"
            ? "bg-purple-100 text-purple-800 border-purple-200"
            : item.role === "guru"
              ? "bg-amber-100 text-amber-800 border-amber-200"
              : "bg-blue-100 text-blue-800 border-blue-200";

        const profileBtnClass =
          item.role === "admin"
            ? "bg-purple-50 hover:bg-purple-600 hover:text-white text-purple-700"
            : item.role === "guru"
              ? "bg-amber-50 hover:bg-amber-600 hover:text-white text-amber-700"
              : "bg-indigo-50 hover:bg-indigo-600 hover:text-white text-indigo-700";

        const roleLabel =
          item.role === "admin"
            ? "Admin"
            : item.role === "guru"
              ? "Guru"
              : "Siswa";

        const tagBadge =
          item.tag === "kepsek"
            ? '<span class="ml-1.5 px-2 py-0.5 rounded-full text-[9px] font-extrabold bg-purple-100 text-purple-800 border border-purple-300 shadow-2xs">Kepala Sekolah</span>'
            : item.tag === "waka"
              ? '<span class="ml-1.5 px-2 py-0.5 rounded-full text-[9px] font-extrabold bg-blue-100 text-blue-800 border border-blue-300 shadow-2xs">Waka Kesiswaan</span>'
              : "";

        const authRole = localStorage.getItem("auth_role");
        const isAdminLoggedIn = authRole === "admin";
        const isItemAdmin = item.role === "admin";

        let rfidBadgeHtml = "";
        if (isItemAdmin) {
          rfidBadgeHtml =
            '<span class="text-slate-400 font-bold">RFID: Terkunci</span>';
        } else if (isAdminLoggedIn) {
          rfidBadgeHtml = `<span class="text-blue-600 font-bold">RFID: ${item.rfidUid || "-"}</span>`;
        } else {
          rfidBadgeHtml =
            '<span class="text-slate-400 font-medium">RFID: Aktif</span>';
        }

        const isItemAlumni = (item.category === "alumni" || (item.className || "").toLowerCase().includes("alumni") || (item.className || "").toLowerCase().includes("lulus")) ? "true" : "false";

        // Desktop Table Row
        tableHtml += `
          <tr class="odd:bg-white even:bg-slate-50/70 hover:bg-blue-50/70 transition-colors duration-150 group">
            <td class="py-3.5 px-4">
              <div class="flex items-center gap-3">
                <div class="w-9 h-9 rounded-xl ${avatarClass} font-extrabold flex items-center justify-center shrink-0 border">
                  ${initials}
                </div>
                <div class="truncate">
                  <a href="/profil-siswa?id=${item.id}" class="font-bold text-slate-900 group-hover:text-blue-700 transition-colors truncate hover:underline block" title="Buka Profil ${roleLabel}">
                    ${item.name}
                  </a>
                  <p class="text-[10px] text-slate-500 font-mono">
                    ID: ${item.identifier || "-"} • ${rfidBadgeHtml}
                  </p>
                </div>
              </div>
            </td>
            <td class="py-3.5 px-3">
              <span class="font-bold text-slate-800">${tingkat}</span>
            </td>
            <td class="py-3.5 px-3 font-bold text-blue-700 truncate">
              <span>${item.className}</span>
              ${tagBadge}
            </td>
            <td class="py-3.5 px-3">${statusBadgeHtml}</td>
            <td class="py-3.5 px-4 text-center">
              <div class="flex items-center justify-center gap-1.5">
                <a
                  href="/profil-siswa?id=${item.id}"
                  class="p-1.5 rounded-lg ${profileBtnClass} text-xs font-bold transition-all"
                  title="Buka Halaman Profil ${roleLabel}"
                >
                  <span class="material-symbols-outlined text-sm">badge</span>
                </a>
                <button
                  type="button"
                  data-uid="${isItemAdmin ? "" : item.rfidUid}"
                  data-is-alumni="${isItemAlumni}"
                  class="btn-row-tap p-1.5 rounded-lg bg-blue-50 hover:bg-blue-600 hover:text-white text-blue-700 text-xs font-bold transition-all cursor-pointer"
                  title="Simulasi Tap RFID"
                >
                  <span class="material-symbols-outlined text-sm">contactless</span>
                </button>
                <button
                  type="button"
                  data-student='${JSON.stringify(item)}'
                  class="btn-row-edit p-1.5 rounded-lg bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-bold transition-all cursor-pointer"
                  title="Edit Data & Pairing Kartu"
                >
                  <span class="material-symbols-outlined text-sm">edit</span>
                </button>
                <button
                  type="button"
                  data-id="${item.id}"
                  data-name="${item.name}"
                  class="btn-row-delete p-1.5 rounded-lg bg-rose-50 hover:bg-rose-100 text-rose-700 text-xs font-bold transition-all cursor-pointer"
                  title="Hapus Siswa"
                >
                  <span class="material-symbols-outlined text-sm">delete</span>
                </button>
              </div>
            </td>
          </tr>
        `;

        // Mobile Card Item
        mobileHtml += `
          <div class="p-3.5 rounded-2xl bg-white border border-slate-200/80 shadow-2xs space-y-3">
            <div class="flex items-start justify-between gap-2.5">
              <div class="flex items-center gap-2.5 min-w-0">
                <div class="w-9 h-9 rounded-xl ${avatarClass} font-extrabold flex items-center justify-center shrink-0 border text-xs">
                  ${initials}
                </div>
                <div class="min-w-0">
                  <a href="/profil-siswa?id=${item.id}" class="font-bold text-slate-900 hover:text-blue-700 transition-colors block truncate text-xs" title="Buka Profil ${roleLabel}">
                    ${item.name}
                  </a>
                  <p class="text-[10px] text-slate-500 font-mono">
                    ID: ${item.identifier || "-"} • ${rfidBadgeHtml}
                  </p>
                </div>
              </div>
              <div class="shrink-0">
                ${statusBadgeHtml}
              </div>
            </div>

            <div class="flex items-center justify-between pt-2 border-t border-slate-100 gap-2">
              <div class="flex items-center gap-1.5 flex-wrap min-w-0">
                <span class="px-2 py-0.5 rounded-md bg-slate-100 text-slate-700 font-bold text-[10px] border border-slate-200">${tingkat}</span>
                <span class="px-2 py-0.5 rounded-md bg-blue-50 text-blue-700 font-bold text-[10px] border border-blue-200/60 truncate max-w-[120px]">${item.className}</span>
                ${tagBadge}
              </div>
              <div class="flex items-center gap-1 shrink-0">
                <a
                  href="/profil-siswa?id=${item.id}"
                  class="p-1.5 rounded-lg ${profileBtnClass} text-xs font-bold transition-all inline-flex items-center justify-center"
                  title="Buka Profil ${roleLabel}"
                >
                  <span class="material-symbols-outlined text-sm">badge</span>
                </a>
                <button
                  type="button"
                  data-uid="${isItemAdmin ? "" : item.rfidUid}"
                  data-is-alumni="${isItemAlumni}"
                  class="btn-row-tap p-1.5 rounded-lg bg-blue-50 hover:bg-blue-600 hover:text-white text-blue-700 text-xs font-bold transition-all cursor-pointer inline-flex items-center justify-center"
                  title="Simulasi Tap RFID"
                >
                  <span class="material-symbols-outlined text-sm">contactless</span>
                </button>
                <button
                  type="button"
                  data-student='${JSON.stringify(item)}'
                  class="btn-row-edit p-1.5 rounded-lg bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-bold transition-all cursor-pointer inline-flex items-center justify-center"
                  title="Edit Data"
                >
                  <span class="material-symbols-outlined text-sm">edit</span>
                </button>
                <button
                  type="button"
                  data-id="${item.id}"
                  data-name="${item.name}"
                  class="btn-row-delete p-1.5 rounded-lg bg-rose-50 hover:bg-rose-100 text-rose-700 text-xs font-bold transition-all cursor-pointer inline-flex items-center justify-center"
                  title="Hapus"
                >
                  <span class="material-symbols-outlined text-sm">delete</span>
                </button>
              </div>
            </div>
          </div>
        `;
      });

      if (tbody) tbody.innerHTML = tableHtml;
      if (mobileContainer) mobileContainer.innerHTML = mobileHtml;

      // Wire Row Buttons
      const wireRowActions = (container: HTMLElement | null) => {
        if (!container) return;
        container.querySelectorAll(".btn-row-tap").forEach((btn) => {
          btn.addEventListener("click", () => {
            const isAlumni = (btn as HTMLElement).dataset.isAlumni === "true";
            if (isAlumni) {
              alert(
                "Presensi ditolak: Siswa ini berstatus Alumni (Lulus). Presensi harian gerbang tidak berlaku untuk Alumni.",
              );
              return;
            }
            const uid = (btn as HTMLElement).dataset.uid;
            if (uid && (window as any).tap) (window as any).tap(uid);
          });
        });

        container.querySelectorAll(".btn-row-edit").forEach((btn) => {
          btn.addEventListener("click", () => {
            const s = JSON.parse((btn as HTMLElement).dataset.student || "{}");
            openEditModal(s);
          });
        });

        container.querySelectorAll(".btn-row-delete").forEach((btn) => {
          btn.addEventListener("click", () => {
            const id = (btn as HTMLElement).dataset.id;
            const name = (btn as HTMLElement).dataset.name;
            if (id && confirm(`Hapus siswa "${name}" dari sistem?`)) {
              deleteStudentItem(id);
            }
          });
        });
      };

      wireRowActions(tbody);
      wireRowActions(mobileContainer);
    }

    // Multi-Step Stepper & Avatar Elements
    let currentStep = 1;
    let selectedRole: "siswa" | "guru" | "admin" = "siswa";

    const stepPanel1 = document.getElementById("step-panel-1");
    const stepPanel2 = document.getElementById("step-panel-2");
    const stepPanel3 = document.getElementById("step-panel-3");
    const stepPanel4 = document.getElementById("step-panel-4");
    const stepperLine = document.getElementById("stepper-progress-line");

    const btnStepPrev = document.getElementById("btn-step-prev");
    const btnStepNext = document.getElementById("btn-step-next");
    const btnSubmitStudent = document.getElementById("btn-submit-student");

    const summaryName = document.getElementById("summary-name");
    const summaryRole = document.getElementById("summary-role");
    const summaryClass = document.getElementById("summary-class");

    const photoInput = document.getElementById(
      "student-photo-input",
    ) as HTMLInputElement | null;
    const avatarBox = document.getElementById("avatar-preview-box");
    const avatarImg = document.getElementById(
      "avatar-preview-img",
    ) as HTMLImageElement | null;
    const avatarIcon = document.getElementById("avatar-default-icon");

    function resetAvatar() {
      if (avatarImg) {
        avatarImg.src = "";
        avatarImg.classList.add("hidden");
      }
      if (avatarIcon) {
        avatarIcon.classList.remove("hidden");
      }
      if (photoInput) {
        photoInput.value = "";
      }
    }

    avatarBox?.addEventListener("click", () => {
      photoInput?.click();
    });

    function compressAvatar(file: File): Promise<string> {
      return new Promise((resolve) => {
        const reader = new FileReader();
        reader.onload = (e) => {
          const img = new Image();
          img.onload = () => {
            let width = img.width;
            let height = img.height;
            const maxDim = 320;
            if (width > maxDim || height > maxDim) {
              if (width > height) {
                height = Math.round((height * maxDim) / width);
                width = maxDim;
              } else {
                width = Math.round((width * maxDim) / height);
                height = maxDim;
              }
            }
            const canvas = document.createElement('canvas');
            canvas.width = width;
            canvas.height = height;
            const ctx = canvas.getContext('2d');
            if (ctx) {
              ctx.drawImage(img, 0, 0, width, height);
              resolve(canvas.toDataURL('image/jpeg', 0.7));
            } else {
              resolve((e.target?.result as string) || '');
            }
          };
          img.onerror = () => resolve((e.target?.result as string) || '');
          img.src = e.target?.result as string;
        };
        reader.onerror = () => resolve('');
        reader.readAsDataURL(file);
      });
    }

    photoInput?.addEventListener("change", async () => {
      const file = photoInput.files?.[0];
