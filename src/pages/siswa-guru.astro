    function openEditModal(student: any) {
      if (modalTitle) modalTitle.textContent = "Edit Data & Ganti Kartu RFID";
      if (idInput) idInput.value = student.id || "";
      if (nameInput) nameInput.value = student.name || "";
      if (identInput) identInput.value = student.identifier || "";
      if (addressInput)
        addressInput.value = student.address || "Padang Ratu, Lampung";
      if (birthInput) birthInput.value = student.birthDate || "";
      if (emailInput) emailInput.value = student.email || "";
      if (phoneInput) phoneInput.value = student.phone || "";
      const r = (
        student.role === "admin"
          ? "admin"
          : student.role === "guru"
            ? "guru"
            : "siswa"
      ) as "siswa" | "guru" | "admin";
      setRole(r, student.tag || "");
      if (catSelect)
        catSelect.value =
          student.category ||
          (r === "admin" ? "admin" : r === "guru" ? "guru" : "rpl");
      if (classInput) classInput.value = student.className || "";
      if (uidInput) {
        if (r === "admin") {
          uidInput.value = "";
          uidInput.placeholder =
            "Terkunci di Database (Hanya bisa dicek via Turso)";
          uidInput.disabled = true;
        } else {
          uidInput.value = student.rfidUid || "";
          uidInput.placeholder = "Tempel kartu RFID atau klik Generate";
          uidInput.disabled = false;
        }
      }
      if (btnGenUid) btnGenUid.classList.toggle("hidden", r === "admin");
      const tagSelect = document.getElementById(
        "student-tag-select",
      ) as HTMLSelectElement;
      if (tagSelect) tagSelect.value = student.tag || "";
      resetAvatar();
      updateStepUI(1);
      if (formError) {
        formError.classList.add("hidden");
        formError.textContent = "";
      }
      if (modal) {
        modal.classList.remove("hidden");
        modal.classList.add("flex");
      }
    }

    function closeModal() {
      if (modal) {
        modal.classList.add("hidden");
        modal.classList.remove("flex");
      }
    }

    btnOpenModal?.addEventListener("click", openAddModal);
    btnCloseModal?.addEventListener("click", closeModal);
    btnCancelModal?.addEventListener("click", closeModal);

    // Generate random 9-digit decimal UID helper
    btnGenUid?.addEventListener("click", () => {
      const rand = Math.floor(100000000 + Math.random() * 900000000).toString();
      if (uidInput) uidInput.value = rand;
    });

    // Submit Form (Save/Edit)
    studentForm?.addEventListener("submit", async (e) => {
      e.preventDefault();
      if (formError) formError.classList.add("hidden");

      const phoneVal = phoneInput?.value?.trim() || "";
      const phoneCheck = validateWhatsApp(phoneVal);
      if (!phoneCheck.valid) {
        if (formError) {
          formError.textContent = phoneCheck.message;
          formError.classList.remove("hidden");
        }
        updateStepUI(3);
        phoneInput?.focus();
        return;
      }

      const uid = uidInput?.value?.trim().toUpperCase() || "";
      const isExistingAdmin = selectedRole === "admin" && !!idInput?.value;
      if (!uid && !isExistingAdmin) {
        if (formError) {
          formError.textContent =
            "Nomor UID Kartu RFID wajib diisi (ketik manual, scan kartu, atau klik Acak UID Test).";
          formError.classList.remove("hidden");
        }
        uidInput?.focus();
        return;
      }

      const payload = {
        id: idInput?.value || undefined,
        name: nameInput?.value?.trim() || "",
        identifier: identInput?.value?.trim() || "",
        role: selectedRole,
        category:
          catSelect?.value ||
          (selectedRole === "admin"
            ? "admin"
            : selectedRole === "guru"
              ? "guru"
              : "rpl"),
        className: classInput?.value?.trim() || "",
        rfidUid: uid,
        tag:
          selectedTag ||
          (document.getElementById("student-tag-select") as HTMLSelectElement)
            ?.value || "",
        address: addressInput?.value?.trim() || "Padang Ratu, Lampung",
        birthDate: birthInput?.value?.trim() || "",
        email: emailInput?.value?.trim() || "",
        phone: phoneInput?.value?.trim() || "",
      };

      try {
        const res = await fetch("/api/students", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(payload),
        });
        const result = await res.json();
        if (!res.ok) {
          if (formError) {
            formError.textContent = result.message || "Gagal menyimpan data";
            formError.classList.remove("hidden");
          }
          return;
        }
        closeModal();
        await loadData();
      } catch (err: any) {
        if (formError) {
          formError.textContent = err.message || "Terjadi kesalahan sistem";
          formError.classList.remove("hidden");
        }
      }
    });

    async function deleteStudentItem(id: string) {
      try {
        const res = await fetch("/api/students", {
          method: "DELETE",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ id }),
        });
        if (res.ok) {
          await loadData();
        }
      } catch (e) {
        console.error("Gagal menghapus civitas:", e);
      }
    }

    // Tab Filters
    document.querySelectorAll(".tab-civitas").forEach((tab) => {
      tab.addEventListener("click", () => {
        document.querySelectorAll(".tab-civitas").forEach((t) => {
          t.className =
            "tab-civitas px-4 py-2 rounded-xl text-xs font-semibold text-slate-600 hover:text-slate-900 transition-all duration-200 whitespace-nowrap focus:outline-none focus:ring-2 focus:ring-blue-600";
        });
        tab.className =
          "tab-civitas px-4 py-2 rounded-xl text-xs font-bold transition-all duration-200 whitespace-nowrap bg-white text-slate-900 shadow-xs focus:outline-none focus:ring-2 focus:ring-blue-600";
        activeFilter = (tab as HTMLElement).dataset.filter || "all";
        renderTable();
      });
    });

    // Stat Cards Filter click
    document
      .getElementById("card-filter-akl")
      ?.addEventListener("click", () => {
        activeFilter = "akl";
        triggerTabStyle("akl");
        renderTable();
      });
    document
      .getElementById("card-filter-rpl")
      ?.addEventListener("click", () => {
        activeFilter = "rpl";
        triggerTabStyle("rpl");
        renderTable();
      });
    document
      .getElementById("card-filter-guru")
      ?.addEventListener("click", () => {
        activeFilter = "guru";
        triggerTabStyle("guru");
        renderTable();
      });

    function triggerTabStyle(filter: string) {
      document.querySelectorAll(".tab-civitas").forEach((t) => {
        const f = (t as HTMLElement).dataset.filter;
        if (f === filter) {
          t.className =
            "tab-civitas px-4 py-2 rounded-xl text-xs font-bold transition-all duration-200 whitespace-nowrap bg-white text-slate-900 shadow-xs focus:outline-none focus:ring-2 focus:ring-blue-600";
        } else {
          t.className =
            "tab-civitas px-4 py-2 rounded-xl text-xs font-semibold text-slate-600 hover:text-slate-900 transition-all duration-200 whitespace-nowrap focus:outline-none focus:ring-2 focus:ring-blue-600";
        }
      });
    }

    // Instant Search
    searchInput?.addEventListener("input", (e) => {
      searchQuery = (e.target as HTMLInputElement).value;
      renderTable();
    });

    // ==========================================
    // FITUR KENAIKAN KELAS SISWA (KEPSEK & WAKA)
    // ==========================================
    const promoteModal = document.getElementById("promote-modal");
    const btnOpenPromoteModal = document.getElementById("btn-open-promote-modal") as HTMLButtonElement | null;
    const btnClosePromoteModal = document.getElementById("btn-close-promote-modal");
    const btnCancelPromoteModal = document.getElementById("btn-cancel-promote-modal");
    const promoteSourceSelect = document.getElementById("promote-source-class") as HTMLSelectElement | null;
    const promoteTargetSelect = document.getElementById("promote-target-class") as HTMLSelectElement | null;
    const promoteStudentsList = document.getElementById("promote-students-list");
    const promoteCountBadge = document.getElementById("promote-student-count-badge");
    const promoteCheckAll = document.getElementById("promote-check-all") as HTMLInputElement | null;
    const promoteResetPoints = document.getElementById("promote-reset-points") as HTMLInputElement | null;
    const btnSubmitPromote = document.getElementById("btn-submit-promote") as HTMLButtonElement | null;
    const promoteErrorMsg = document.getElementById("promote-error-msg");

    function initPromoteAuth() {
      const authRaw = localStorage.getItem("auth_civitas");
      let civ: any = null;
      try { if (authRaw) civ = JSON.parse(authRaw); } catch {}
      const authRole = localStorage.getItem("auth_role") || civ?.role || "";
      const tag = civ?.tag || "";
      const isKepsek = tag === "kepsek" || (civ?.className && civ.className.toLowerCase().includes("kepala sekolah"));
      const isWaka = tag === "waka" || (civ?.className && civ.className.toLowerCase().includes("waka"));
      const isAdmin = authRole === "admin" || sessionStorage.getItem("bypass_login") === "true";
      const canPromote = isKepsek || isWaka || isAdmin;

      if (btnOpenPromoteModal) {
        if (!canPromote) {
          btnOpenPromoteModal.disabled = true;
          btnOpenPromoteModal.title = "Akses ditolak: Hanya Kepala Sekolah & Waka Kesiswaan yang berhak menaikkan kelas.";
        } else {
          btnOpenPromoteModal.disabled = false;
        }
      }
    }

    function openPromoteModal() {
      if (promoteErrorMsg) {
        promoteErrorMsg.classList.add("hidden");
        promoteErrorMsg.textContent = "";
      }

      // Isi dropdown rombel asal
      if (promoteSourceSelect) {
        promoteSourceSelect.innerHTML = '<option value="">Pilih Rombel Asal...</option>';
        const studentClasses = Array.from(
          new Set(
            allStudents
              .filter((s) => s.role === "siswa" && s.className && !s.className.toLowerCase().includes("alumni"))
              .map((s) => s.className.trim())
          )
        ).sort();

        studentClasses.forEach((cls) => {
          const opt = document.createElement("option");
          opt.value = cls;
          opt.textContent = cls;
          promoteSourceSelect.appendChild(opt);
        });
      }

      if (promoteStudentsList) {
        promoteStudentsList.innerHTML = '<p class="text-center text-xs text-slate-400 py-6">Pilih rombel asal di atas untuk memuat siswa...</p>';
      }
      if (promoteCountBadge) {
        promoteCountBadge.textContent = "0 Siswa Terdaftar";
      }

      promoteModal?.classList.remove("hidden");
      promoteModal?.classList.add("flex");
    }

    function closePromoteModal() {
      promoteModal?.classList.add("hidden");
      promoteModal?.classList.remove("flex");
    }

    function onSourceClassChange() {
      if (!promoteSourceSelect || !promoteStudentsList) return;
      const src = promoteSourceSelect.value.trim();
      if (!src) {
        promoteStudentsList.innerHTML = '<p class="text-center text-xs text-slate-400 py-6">Pilih rombel asal di atas untuk memuat siswa...</p>';
        if (promoteCountBadge) promoteCountBadge.textContent = "0 Siswa Terdaftar";
        return;
      }

      // Rekomendasi otomatis rombel tujuan
      if (promoteTargetSelect) {
        let suggestedTarget = "";
        const upper = src.toUpperCase();
        if (upper.startsWith("X ") || upper.startsWith("X-")) {
          suggestedTarget = "XI " + src.slice(2).trim();
        } else if (upper.startsWith("XI ") || upper.startsWith("XI-")) {
          suggestedTarget = "XII " + src.slice(3).trim();
        } else if (upper.startsWith("XII ") || upper.startsWith("XII-")) {
          suggestedTarget = "Alumni (Lulus)";
        }

        if (suggestedTarget) {
          let found = false;
          for (let i = 0; i < promoteTargetSelect.options.length; i++) {
            if (promoteTargetSelect.options[i].value === suggestedTarget) {
              promoteTargetSelect.selectedIndex = i;
              found = true;
              break;
            }
          }
          if (!found) {
            const opt = document.createElement("option");
            opt.value = suggestedTarget;
            opt.textContent = suggestedTarget;
            promoteTargetSelect.appendChild(opt);
            promoteTargetSelect.value = suggestedTarget;
          }
        }
      }

      // Muat daftar siswa rombel asal
      const classStudents = allStudents.filter((s) => s.role === "siswa" && s.className === src);
      if (!classStudents.length) {
        promoteStudentsList.innerHTML = '<p class="text-center text-xs text-slate-400 py-6">Tidak ada siswa terdaftar di rombel ini.</p>';
        if (promoteCountBadge) promoteCountBadge.textContent = "0 Siswa Terdaftar";
        return;
      }

      promoteStudentsList.innerHTML = classStudents.map((s) => {
        const initials = s.name.split(" ").map((n: string) => n[0]).slice(0, 2).join("").toUpperCase();
        return `
          <label class="promote-student-item flex items-center justify-between p-2 rounded-xl hover:bg-white bg-white/70 transition cursor-pointer select-none">
            <div class="flex items-center gap-2.5">
              <input type="checkbox" class="promote-student-chk rounded text-blue-600 focus:ring-blue-500 cursor-pointer" data-id="${s.id}" checked />
              <div class="w-7 h-7 rounded-lg bg-blue-100 text-blue-800 text-[10px] font-bold flex items-center justify-center shrink-0">
                ${initials}
              </div>
              <div>
                <p class="text-xs font-bold text-slate-800 leading-tight">${s.name}</p>
                <p class="text-[10px] text-slate-400">NISN: ${s.identifier || "-"}</p>
              </div>
            </div>
            <span class="promote-status-badge text-[10px] font-bold text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded-full border border-emerald-200">Naik Kelas</span>
          </label>
        `;
      }).join("");

      updatePromoteCount();

      // Pasang listener pada setiap checkbox siswa
      promoteStudentsList.querySelectorAll(".promote-student-chk").forEach((chk) => {
        chk.addEventListener("change", updatePromoteCount);
      });
    }

    function updatePromoteCount() {
      if (!promoteStudentsList || !promoteCountBadge) return;
      const allChk = promoteStudentsList.querySelectorAll(".promote-student-chk") as NodeListOf<HTMLInputElement>;
      const checkedCount = Array.from(allChk).filter((c) => c.checked).length;
      const total = allChk.length;
      const tinggalCount = total - checkedCount;

      allChk.forEach((chk) => {
        const badge = chk.closest(".promote-student-item")?.querySelector(".promote-status-badge");
        if (badge) {
          if (chk.checked) {
            badge.className = "promote-status-badge text-[10px] font-bold text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded-full border border-emerald-200";
            badge.textContent = "Naik Kelas";
          } else {
            badge.className = "promote-status-badge text-[10px] font-bold text-amber-700 bg-amber-50 px-2 py-0.5 rounded-full border border-amber-200";
            badge.textContent = "Tinggal Kelas";
          }
        }
      });

      promoteCountBadge.textContent = `${checkedCount} dari ${total} Siswa Terpilih${tinggalCount > 0 ? ` (${tinggalCount} Tinggal Kelas)` : ""}`;
      if (promoteCheckAll) {
        promoteCheckAll.checked = checkedCount === total && total > 0;
        promoteCheckAll.indeterminate = checkedCount > 0 && checkedCount < total;
      }
    }

    promoteCheckAll?.addEventListener("change", () => {
      if (!promoteStudentsList) return;
      const chks = promoteStudentsList.querySelectorAll(".promote-student-chk") as NodeListOf<HTMLInputElement>;
      const checked = promoteCheckAll.checked;
      chks.forEach((c) => { c.checked = checked; });
      updatePromoteCount();
    });

    promoteSourceSelect?.addEventListener("change", onSourceClassChange);

    btnOpenPromoteModal?.addEventListener("click", () => {
      openPromoteModal();
    });
    btnClosePromoteModal?.addEventListener("click", closePromoteModal);
    btnCancelPromoteModal?.addEventListener("click", closePromoteModal);

    btnSubmitPromote?.addEventListener("click", async () => {
      if (!promoteSourceSelect || !promoteTargetSelect) return;
      const sourceClass = promoteSourceSelect.value.trim();
      const targetClass = promoteTargetSelect.value.trim();

      if (!sourceClass || !targetClass) {
        if (promoteErrorMsg) {
          promoteErrorMsg.textContent = "Pilih rombel asal dan rombel tujuan terlebih dahulu.";
          promoteErrorMsg.classList.remove("hidden");
        }
        return;
      }

      const checkedBoxes = (promoteStudentsList?.querySelectorAll(".promote-student-chk:checked") as NodeListOf<HTMLInputElement>) || [];
      const studentIds = Array.from(checkedBoxes).map((c) => c.dataset.id || "").filter(Boolean);

      if (!studentIds.length) {
        if (promoteErrorMsg) {
          promoteErrorMsg.textContent = "Pilih minimal 1 siswa yang akan dinaikkan kelasnya.";
          promoteErrorMsg.classList.remove("hidden");
        }
        return;
      }

      const resetPts = promoteResetPoints?.checked ?? true;
      const confirmText = `Apakah Anda yakin ingin menaikkan ${studentIds.length} siswa dari ${sourceClass} ke ${targetClass}?\n\n` +
        `• Siswa yang tidak dicentang akan tetap di ${sourceClass}.\n` +
        `• Poin kedisiplinan siswa yang naik kelas akan ${resetPts ? "direset ke 100 Poin penuh." : "dipertahankan."}`;

      if (!confirm(confirmText)) return;

      const origText = btnSubmitPromote.innerHTML;
      btnSubmitPromote.disabled = true;
      btnSubmitPromote.innerHTML = '<span class="material-symbols-outlined text-sm animate-spin">sync</span><span>Memproses...</span>';

      try {
        const res = await fetch("/api/students/promote", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            sourceClass,
            targetClass,
            studentIds,
            resetPoints: resetPts,
          }),
        });

        const result = await res.json();
        if (!res.ok) {
          if (promoteErrorMsg) {
            promoteErrorMsg.textContent = result.message || "Gagal memproses kenaikan kelas";
            promoteErrorMsg.classList.remove("hidden");
          }
          return;
        }

        alert("✅ " + (result.message || "Kenaikan kelas berhasil diterapkan!"));
        closePromoteModal();
        await loadData();
      } catch (err: any) {
        if (promoteErrorMsg) {
          promoteErrorMsg.textContent = err.message || "Terjadi kesalahan sistem";
          promoteErrorMsg.classList.remove("hidden");
        }
      } finally {
        btnSubmitPromote.disabled = false;
        btnSubmitPromote.innerHTML = origText;
      }
    });

    // SSE Realtime Listener
    window.addEventListener("attendance-updated", loadData);

    // Initial Load: Eksekusi instan dari cache lokal (0ms), lalu sinkronisasi background
    initPromoteAuth();
    loadCachedData();
    loadData();
  </script>
</Layout>
