---
/**
 * @file src/pages/siswa-guru.astro
 * @description Halaman Kelola Data Siswa, Guru, dan Pendaftaran Kartu RFID
 */
export const prerender = false;

const authSession = Astro.cookies.get("auth_session")?.value;
if (!authSession) {
  return Astro.redirect("/");
}
if (authSession === "siswa") {
  return Astro.redirect("/profil-siswa");
}

import Layout from "../layouts/Layout.astro";

// Render instan SSR (0ms blokir Turso - data dirender instan via client-side cache)
const aklCount = 0;
const rplCount = 0;
const guruCount = 0;
---

<Layout title="Data Siswa" activeNav="siswa-guru">
  <div class="flex flex-col gap-6">
    <!-- Top Action Bar & Dynamic Metrics Banner -->
    <div
      class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 bg-white/80 backdrop-blur-xl p-4 sm:p-6 rounded-2xl sm:rounded-3xl shadow-xs border border-slate-200/60"
    >
      <div>
        <h1
          class="text-xl sm:text-2xl font-black text-slate-900 tracking-tight"
        >
          Data Siswa
        </h1>
      </div>

      <!-- Quick Global Control -->
      <div class="flex items-center gap-2 flex-wrap w-full sm:w-auto">
        <button
          type="button"
          onclick="window.resetAttendance()"
          class="flex-1 sm:flex-none inline-flex items-center justify-center gap-1.5 px-3 py-2 sm:px-3.5 sm:py-2.5 rounded-2xl bg-rose-50 hover:bg-rose-100 text-rose-700 border border-rose-200 font-bold text-xs shadow-xs transition-all duration-200 hover:scale-[1.02] active:scale-[0.98] focus:outline-none focus:ring-2 focus:ring-rose-500 cursor-pointer"
          title="Reset semua status presensi hari ini kembali ke Belum Absen"
        >
          <span class="material-symbols-outlined text-[16px]">restart_alt</span>
          <span class="whitespace-nowrap">Reset Presensi</span>
        </button>
        <button
          id="btn-open-promote-modal"
          type="button"
          class="flex-1 sm:flex-none inline-flex items-center justify-center gap-1.5 px-3 py-2 sm:px-4 sm:py-2.5 rounded-2xl bg-blue-600 hover:bg-blue-700 text-white font-bold text-xs shadow-md shadow-blue-500/20 transition-all duration-200 hover:scale-[1.02] active:scale-[0.98] focus:outline-none focus:ring-2 focus:ring-blue-600 focus:ring-offset-1 cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed"
          title="Kenaikan Kelas & Tahun Ajaran Baru (Khusus Kepsek & Waka)"
        >
          <span class="material-symbols-outlined text-[18px]">school</span>
          <span class="whitespace-nowrap">Kenaikan Kelas</span>
        </button>
        <button
          id="btn-open-student-modal"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-1.5 px-3 py-2 sm:px-4 sm:py-2.5 rounded-2xl bg-blue-600 hover:bg-blue-700 text-white font-bold text-xs shadow-md shadow-blue-500/20 transition-all duration-200 hover:scale-[1.02] active:scale-[0.98] focus:outline-none focus:ring-2 focus:ring-blue-600 focus:ring-offset-1 cursor-pointer"
          title="Tambah siswa Baru"
        >
          <span class="material-symbols-outlined text-[18px]">person_add</span>
          <span class="whitespace-nowrap">Tambah Siswa</span>
        </button>
      </div>
    </div>

    <!-- Category Stat Strip (Folder Meta Bar) -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 sm:gap-4">
      <!-- Card AKL -->
      <div
        id="card-filter-akl"
        class="category-stat-card p-4 sm:p-5 rounded-2xl sm:rounded-3xl bg-blue-50/90 hover:bg-blue-100/80 border border-blue-200/60 transition-all duration-200 backdrop-blur-md shadow-xs flex items-center justify-between cursor-pointer group hover:scale-[1.01]"
      >
        <div class="flex items-center gap-3.5">
          <div
            class="w-11 h-11 sm:w-12 sm:h-12 rounded-2xl bg-blue-600 text-white flex items-center justify-center shadow-md shadow-blue-600/20 group-hover:scale-105 transition-transform duration-200"
          >
            <span class="material-symbols-outlined text-xl sm:text-2xl"
              >account_balance_wallet</span
            >
          </div>
          <div>
            <p class="text-xs font-bold text-blue-900">AKL</p>
            <p class="text-xl sm:text-2xl font-black text-blue-950">
              <span id="stat-count-akl">{aklCount}</span>
            </p>
          </div>
        </div>
        <span
          class="material-symbols-outlined text-blue-500 group-hover:translate-x-1 transition-transform duration-200 text-xl"
          >arrow_forward</span
        >
      </div>

      <!-- Card RPL -->
      <div
        id="card-filter-rpl"
        class="category-stat-card p-4 sm:p-5 rounded-2xl sm:rounded-3xl bg-slate-900 hover:bg-slate-800 border border-slate-800 transition-all duration-200 text-white shadow-xs flex items-center justify-between cursor-pointer group hover:scale-[1.01]"
      >
        <div class="flex items-center gap-3.5">
          <div
            class="w-11 h-11 sm:w-12 sm:h-12 rounded-2xl bg-slate-800 flex items-center justify-center text-slate-100 shadow-md group-hover:scale-105 transition-transform duration-200"
          >
            <span class="material-symbols-outlined text-xl sm:text-2xl">terminal</span>
          </div>
          <div>
            <p class="text-xs font-bold text-slate-300">RPL</p>
            <p class="text-xl sm:text-2xl font-black text-white">
              <span id="stat-count-rpl">{rplCount}</span>
            </p>
          </div>
        </div>
        <span
          class="material-symbols-outlined text-slate-400 group-hover:translate-x-1 transition-transform duration-200 text-xl"
          >arrow_forward</span
        >
      </div>

      <!-- Card Guru -->
      <div
        id="card-filter-guru"
        class="category-stat-card p-4 sm:p-5 rounded-2xl sm:rounded-3xl bg-amber-50/90 hover:bg-amber-100/80 border border-amber-200/60 transition-all duration-200 backdrop-blur-md shadow-xs flex items-center justify-between cursor-pointer group hover:scale-[1.01]"
      >
        <div class="flex items-center gap-3.5">
          <div
            class="w-11 h-11 sm:w-12 sm:h-12 rounded-2xl bg-amber-500 text-slate-950 flex items-center justify-center font-bold shadow-md shadow-amber-500/20 group-hover:scale-105 transition-transform duration-200"
          >
            <span class="material-symbols-outlined text-xl sm:text-2xl">school</span>
          </div>
          <div>
            <p class="text-xs font-bold text-amber-950">Guru</p>
            <p class="text-xl sm:text-2xl font-black text-amber-950">
              <span id="stat-count-guru">{guruCount}</span>
            </p>
          </div>
        </div>
        <span
          class="material-symbols-outlined text-amber-600 group-hover:translate-x-1 transition-transform duration-200 text-xl"
          >arrow_forward</span
        >
      </div>
    </div>

    <!-- Filters, Segmented Tabs & Instant Search with Accessible Ring-Focus -->
    <div
      class="flex flex-col gap-3.5 sm:gap-4 bg-white/80 backdrop-blur-xl p-4 sm:p-5 rounded-2xl sm:rounded-3xl shadow-xs border border-slate-200/70"
    >
      <div
        class="flex flex-col lg:flex-row items-stretch lg:items-center justify-between gap-3"
      >
        <!-- Segmented Tabs -->
        <div
          class="inline-flex p-1.5 rounded-2xl bg-slate-100/90 max-w-full overflow-x-auto gap-1 border border-slate-200/50 no-scrollbar select-none"
        >
          <button
            data-filter="all"
            class="tab-civitas px-3.5 sm:px-4 py-2 rounded-xl text-xs font-bold transition-all duration-200 whitespace-nowrap bg-white text-slate-900 shadow-xs focus:outline-none focus:ring-2 focus:ring-blue-600 cursor-pointer"
          >
            Semua
          </button>
          <button
            data-filter="akl"
            class="tab-civitas px-3.5 sm:px-4 py-2 rounded-xl text-xs font-semibold text-slate-600 hover:text-slate-900 transition-all duration-200 whitespace-nowrap focus:outline-none focus:ring-2 focus:ring-blue-600 cursor-pointer"
          >
            AKL
          </button>
          <button
            data-filter="rpl"
            class="tab-civitas px-3.5 sm:px-4 py-2 rounded-xl text-xs font-semibold text-slate-600 hover:text-slate-900 transition-all duration-200 whitespace-nowrap focus:outline-none focus:ring-2 focus:ring-blue-600 cursor-pointer"
          >
            RPL
          </button>
          <button
            data-filter="guru"
            class="tab-civitas px-3.5 sm:px-4 py-2 rounded-xl text-xs font-semibold text-slate-600 hover:text-amber-700 transition-all duration-200 whitespace-nowrap focus:outline-none focus:ring-2 focus:ring-blue-600 cursor-pointer"
          >
            Guru
          </button>
          <button
            data-filter="admin"
            class="tab-civitas px-3.5 sm:px-4 py-2 rounded-xl text-xs font-semibold text-slate-600 hover:text-purple-700 transition-all duration-200 whitespace-nowrap focus:outline-none focus:ring-2 focus:ring-blue-600 cursor-pointer"
          >
            Admin
          </button>
          <button
            data-filter="alumni"
            class="tab-civitas px-3.5 sm:px-4 py-2 rounded-xl text-xs font-semibold text-slate-600 hover:text-indigo-700 transition-all duration-200 whitespace-nowrap focus:outline-none focus:ring-2 focus:ring-blue-600 cursor-pointer"
          >
            Alumni
          </button>
        </div>

        <!-- Accessible Real-Time Search Bar -->
        <div class="relative flex-1 w-full lg:max-w-md">
          <label for="search-civitas-input" class="sr-only">Cari Siswa</label>
          <span
            class="material-symbols-outlined absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 text-lg pointer-events-none"
            aria-hidden="true">search</span
          >
          <input
            id="search-civitas-input"
            class="w-full pl-10 pr-4 py-2.5 text-xs rounded-2xl bg-slate-50 text-slate-800 placeholder-slate-400 border border-slate-200 focus:bg-white focus:outline-none focus:ring-2 focus:ring-blue-600 focus:border-blue-600 transition-all duration-200 shadow-inner"
            placeholder="Cari nama, NISN, RFID..."
            type="search"
          />
        </div>
      </div>
    </div>

    <!-- Table of Civitas Akademika (Sticky Header + Zebra Striping + Contrast Badges) -->
    <div
      class="bg-white rounded-2xl sm:rounded-3xl shadow-xs border border-slate-200/80 overflow-hidden"
    >
      <!-- Table Header Bar -->
      <div
        class="p-4 sm:px-6 py-3.5 sm:py-4 border-b border-slate-200/80 bg-slate-50/70 flex items-center justify-between flex-wrap gap-2"
      >
        <div class="flex items-center gap-2">
          <span
            class="material-symbols-outlined text-blue-600 text-xl"
            aria-hidden="true">format_list_bulleted</span
          >
          <h2 class="text-sm font-bold text-slate-900">Daftar Siswa</h2>
          <span
            id="header-total-count"
            class="text-[11px] font-bold text-blue-800 bg-blue-100/90 border border-blue-200 px-2.5 py-0.5 rounded-full"
          >
            0 Terdaftar
          </span>
        </div>
      </div>

      <!-- Desktop View: Scrollable Table (hidden below md) -->
      <div class="hidden md:block overflow-x-auto max-h-[580px] overflow-y-auto">
        <table class="w-full text-left text-xs min-w-[700px] table-fixed">
          <!-- Sticky Header Locked at Top -->
          <thead
            class="sticky top-0 z-10 bg-slate-100/95 backdrop-blur-sm text-slate-700 font-extrabold border-b border-slate-200 shadow-xs text-[11px] uppercase tracking-wider"
          >
            <tr>
              <th scope="col" class="py-3.5 px-4 w-[34%] bg-slate-100/95"
                >Nama & ID</th
              >
              <th scope="col" class="py-3.5 px-3 w-[12%] bg-slate-100/95"
                >Tingkat</th
              >
              <th scope="col" class="py-3.5 px-3 w-[16%] bg-slate-100/95"
                >Jurusan</th
              >
              <th scope="col" class="py-3.5 px-3 w-[22%] bg-slate-100/95"
                >Status</th
              >
              <th
                scope="col"
                class="py-3.5 px-4 text-center w-[16%] bg-slate-100/95">Aksi</th
              >
            </tr>
          </thead>
          <!-- Zebra-striped table rows -->
          <tbody
            class="divide-y divide-slate-100 text-slate-700"
            id="studentsTableBody"
          >
            <tr>
              <td
                colspan="5"
                class="py-8 text-center text-slate-400 font-medium"
                >Memuat data siswa...</td
              >
            </tr>
          </tbody>
        </table>
      </div>

      <!-- Mobile View: Responsive Card List (visible on mobile < md) -->
      <div
        id="studentsMobileList"
        class="md:hidden max-h-[580px] overflow-y-auto p-3 sm:p-4 space-y-2.5 bg-slate-50/40"
      >
        <div class="py-8 text-center text-slate-400 font-medium text-xs">
          Memuat data siswa...
        </div>
      </div>
    </div>
  </div>

  <!-- Modal Dialog: Pendaftaran & Pairing Kartu RFID (Gaya Desain Multi-Step Sesuai Referensi) -->
  <div
    id="student-modal"
    class="fixed inset-0 z-50 bg-slate-900/60 backdrop-blur-md hidden items-center justify-center p-4 overflow-y-auto"
  >
    <div
      class="bg-white rounded-[2.5rem] max-w-xl w-full p-6 sm:p-9 shadow-2xl border border-slate-100 space-y-6 relative overflow-hidden animate-in fade-in zoom-in-95 duration-200 my-8"
    >
      <!-- Decorative Background Orbs Sesuai Foto -->
      <div
        class="absolute -top-14 -right-14 w-40 h-40 rounded-full bg-blue-500/10 blur-2xl pointer-events-none"
      >
      </div>
      <div
        class="absolute -bottom-14 -left-14 w-40 h-40 rounded-full bg-indigo-500/10 blur-2xl pointer-events-none"
      >
      </div>

      <!-- Top Header & Sub-link -->
      <div class="flex items-center justify-between relative z-10">
        <div class="w-8"></div>
        <div class="text-center">
          <h2
            id="modal-student-title"
            class="text-lg sm:text-xl font-black text-slate-900 tracking-tight"
          >
            Pendaftaran Siswa
          </h2>
          <p class="text-[11px] text-slate-400 font-medium">
            SMK Ma'arif Padang Ratu
          </p>
        </div>
        <button
          id="btn-close-student-modal"
          type="button"
          class="w-8 h-8 rounded-full bg-slate-100 hover:bg-slate-200 text-slate-500 flex items-center justify-center transition-colors"
        >
          <span class="material-symbols-outlined text-sm">close</span>
        </button>
      </div>

      <!-- Stepper Progress Bar (1 - 2 - 3 - 4) -->
      <div class="relative z-10 px-2 sm:px-6">
        <div class="flex items-center justify-between relative">
          <!-- Line connector -->
          <div class="absolute top-3.5 left-6 right-6 h-0.5 bg-slate-200 -z-10">
            <div
              id="stepper-progress-line"
              class="h-full bg-blue-600 transition-all duration-300"
              style="width: 0%"
            >
            </div>
          </div>

          <!-- Step 1 -->
          <div
            class="step-indicator flex flex-col items-center gap-1 cursor-pointer"
            data-step="1"
          >
            <div
              id="step-badge-1"
              class="w-7 h-7 rounded-full bg-blue-600 text-white font-black text-xs flex items-center justify-center shadow-md shadow-blue-500/30 transition-all"
            >
              1
            </div>
            <span
              id="step-label-1"
              class="text-[10px] font-bold text-blue-700 whitespace-nowrap"
              >Pilih Peran</span
            >
          </div>

          <!-- Step 2 -->
          <div
            class="step-indicator flex flex-col items-center gap-1 cursor-pointer"
            data-step="2"
          >
            <div
              id="step-badge-2"
              class="w-7 h-7 rounded-full bg-slate-100 text-slate-400 font-bold text-xs flex items-center justify-center transition-all"
            >
              2
            </div>
            <span
              id="step-label-2"
              class="text-[10px] font-semibold text-slate-400 whitespace-nowrap"
              >Data Pokok</span
            >
          </div>

          <!-- Step 3 -->
          <div
            class="step-indicator flex flex-col items-center gap-1 cursor-pointer"
            data-step="3"
          >
            <div
              id="step-badge-3"
              class="w-7 h-7 rounded-full bg-slate-100 text-slate-400 font-bold text-xs flex items-center justify-center transition-all"
            >
              3
            </div>
            <span
              id="step-label-3"
              class="text-[10px] font-semibold text-slate-400 whitespace-nowrap"
              >Rombel / Tugas</span
            >
          </div>

          <!-- Step 4 -->
          <div
            class="step-indicator flex flex-col items-center gap-1 cursor-pointer"
            data-step="4"
          >
            <div
              id="step-badge-4"
              class="w-7 h-7 rounded-full bg-slate-100 text-slate-400 font-bold text-xs flex items-center justify-center transition-all"
            >
              4
            </div>
            <span
              id="step-label-4"
              class="text-[10px] font-semibold text-slate-400 whitespace-nowrap"
              >Pairing RFID</span
            >
          </div>
        </div>
      </div>

      <!-- Form Container -->
      <form id="student-form" class="relative z-10 space-y-5">
        <input type="hidden" id="student-id-input" value="" />

        <!-- ================= TAHAP 1: PILIH PERAN CIVITAS (SISWA / GURU / ADMIN) ================= -->
        <div id="step-panel-1" class="step-panel space-y-4">
          <div class="border-b border-slate-100 pb-3">
            <h3 class="text-sm font-extrabold text-slate-900">Pilih Peran</h3>
            <p class="text-[11px] text-slate-500">
              Siswa, Guru, atau Administrator.
            </p>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3 pt-1">
            <!-- 1. Pilihan Siswa Card -->
            <div
              id="role-card-siswa"
              class="role-selection-card cursor-pointer p-3.5 rounded-2xl border-2 border-blue-600 bg-blue-50/60 hover:bg-blue-50 transition-all duration-200 relative group shadow-sm flex flex-col justify-between"
              data-role="siswa"
              data-tag=""
            >
              <div class="flex items-start justify-between">
                <div
                  class="w-10 h-10 rounded-xl bg-gradient-to-tr from-blue-600 to-indigo-600 text-white flex items-center justify-center shadow-md shadow-blue-500/20 group-hover:scale-105 transition-transform"
                >
                  <span class="material-symbols-outlined text-xl">school</span>
                </div>
                <div
                  id="role-radio-siswa"
                  class="w-5 h-5 rounded-full border-2 border-blue-600 bg-blue-600 text-white flex items-center justify-center text-[10px] font-black"
                >
                  ✓
                </div>
              </div>
              <div class="mt-3">
                <div class="flex items-center gap-1 mb-1">
                  <h4 class="text-xs font-black text-slate-900">Siswa / Siswi</h4>
                  <span class="text-[8px] font-bold text-blue-700 bg-blue-100 px-1.5 py-0.2 rounded-full">Reguler</span>
                </div>
                <p class="text-[10px] text-slate-600 leading-relaxed">
                  Peserta didik aktif dengan NISN dan data wali.
                </p>
              </div>
            </div>

            <!-- 2. Pilihan Guru Biasa Card -->
            <div
              id="role-card-guru"
              class="role-selection-card cursor-pointer p-3.5 rounded-2xl border border-slate-200 bg-white hover:border-slate-300 hover:bg-slate-50/60 transition-all duration-200 relative group flex flex-col justify-between"
              data-role="guru"
              data-tag=""
            >
              <div class="flex items-start justify-between">
                <div
                  class="w-10 h-10 rounded-xl bg-gradient-to-tr from-amber-600 to-amber-700 text-white flex items-center justify-center shadow-md shadow-amber-900/10 group-hover:scale-105 transition-transform"
                >
                  <span class="material-symbols-outlined text-xl">co_present</span>
                </div>
                <div
                  id="role-radio-guru"
                  class="w-5 h-5 rounded-full border-2 border-slate-300 bg-white text-transparent flex items-center justify-center text-[10px] font-black"
                >
                  ✓
                </div>
              </div>
              <div class="mt-3">
                <div class="flex items-center gap-1 mb-1">
                  <h4 class="text-xs font-black text-slate-900">Guru Biasa</h4>
                  <span class="text-[8px] font-bold text-amber-800 bg-amber-100 px-1.5 py-0.2 rounded-full">Pendidik</span>
                </div>
                <p class="text-[10px] text-slate-600 leading-relaxed">
                  Tenaga pendidik pengajar KBM & kejuruan.
                </p>
              </div>
            </div>

            <!-- 3. Pilihan Waka Kesiswaan Card -->
            <div
              id="role-card-waka"
              class="role-selection-card cursor-pointer p-3.5 rounded-2xl border border-slate-200 bg-white hover:border-slate-300 hover:bg-slate-50/60 transition-all duration-200 relative group flex flex-col justify-between"
              data-role="guru"
              data-tag="waka"
            >
              <div class="flex items-start justify-between">
                <div
                  class="w-10 h-10 rounded-xl bg-gradient-to-tr from-indigo-600 to-blue-700 text-white flex items-center justify-center shadow-md shadow-indigo-900/10 group-hover:scale-105 transition-transform"
                >
                  <span class="material-symbols-outlined text-xl">shield_person</span>
                </div>
                <div
                  id="role-radio-waka"
                  class="w-5 h-5 rounded-full border-2 border-slate-300 bg-white text-transparent flex items-center justify-center text-[10px] font-black"
                >
                  ✓
                </div>
              </div>
              <div class="mt-3">
                <div class="flex items-center gap-1 mb-1">
                  <h4 class="text-xs font-black text-slate-900">Waka Kesiswaan</h4>
                  <span class="text-[8px] font-bold text-indigo-700 bg-indigo-100 px-1.5 py-0.2 rounded-full">Akses Admin</span>
                </div>
                <p class="text-[10px] text-slate-600 leading-relaxed">
                  Pendidik dengan hak akses dashboard & reset.
                </p>
              </div>
            </div>

            <!-- 4. Pilihan Kepala Sekolah Card -->
            <div
              id="role-card-kepsek"
              class="role-selection-card cursor-pointer p-3.5 rounded-2xl border border-slate-200 bg-white hover:border-slate-300 hover:bg-slate-50/60 transition-all duration-200 relative group flex flex-col justify-between"
              data-role="guru"
              data-tag="kepsek"
            >
              <div class="flex items-start justify-between">
                <div
                  class="w-10 h-10 rounded-xl bg-gradient-to-tr from-purple-600 to-indigo-800 text-white flex items-center justify-center shadow-md shadow-purple-900/10 group-hover:scale-105 transition-transform"
                >
                  <span class="material-symbols-outlined text-xl">workspace_premium</span>
                </div>
                <div
                  id="role-radio-kepsek"
                  class="w-5 h-5 rounded-full border-2 border-slate-300 bg-white text-transparent flex items-center justify-center text-[10px] font-black"
                >
                  ✓
                </div>
              </div>
              <div class="mt-3">
                <div class="flex items-center gap-1 mb-1">
                  <h4 class="text-xs font-black text-slate-900">Kepala Sekolah</h4>
