---
/**
 * @file src/pages/pengaturan.astro
 * @description Halaman Pengaturan & Konfigurasi Sistem Presensi Sekolah
 * Dilengkapi ring-focus adaptif pada input waktu, select box, dan textarea.
 */
export const prerender = false;

const authSession = Astro.cookies.get("auth_session")?.value;
if (!authSession) {
  return Astro.redirect("/login");
}
if (authSession === "siswa" || authSession === "guru") {
  return Astro.redirect("/profil-siswa");
}

import Layout from "../layouts/Layout.astro";
---

<Layout title="Pengaturan Sistem" activeNav="pengaturan">
  <div class="flex flex-col gap-6 max-w-7xl mx-auto w-full">
    <!-- Top Action Bar -->
    <div
      class="p-5 sm:p-6 bg-white rounded-xl shadow-xs border border-slate-200/80 flex flex-col md:flex-row md:items-center justify-between gap-4"
    >
      <div>
        <div class="flex items-center gap-2 mb-1">
          <span
            class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-emerald-50 text-emerald-800 border border-emerald-200 font-semibold text-[11px]"
          >
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
            Server Online
          </span>
        </div>
        <h1 class="text-lg sm:text-xl font-bold text-slate-900 tracking-tight">
          Pengaturan Sistem
        </h1>
        <p class="text-xs text-slate-400 mt-0.5">
          Konfigurasi jam operasional dan notifikasi presensi.
        </p>
      </div>

      <div class="flex items-center gap-2">
        <button
          id="btn-reset-settings"
          type="button"
          class="px-3.5 py-2 text-xs font-semibold text-slate-700 bg-slate-100 hover:bg-slate-200 rounded-lg transition cursor-pointer"
        >
          Reset Default
        </button>
        <button
          id="btn-save-settings"
          type="button"
          class="px-4 py-2 text-xs font-semibold text-white bg-blue-600 hover:bg-blue-700 rounded-lg shadow-2xs transition cursor-pointer active:scale-95 flex items-center gap-1.5"
        >
          <span class="material-symbols-outlined text-sm">save</span>
          <span>Simpan</span>
        </button>
      </div>
    </div>

    <!-- Grid 1: Operational Hours & Vocational Rules -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 items-stretch">
      <!-- Card 1: Jam Operasional Gerbang -->
      <section
        class="bg-white rounded-xl border border-slate-200/80 shadow-xs p-5 sm:p-6 space-y-4 flex flex-col justify-between"
      >
        <div class="space-y-4">
          <div
            class="flex items-start justify-between border-b border-slate-100 pb-3"
          >
            <div class="flex items-center gap-2.5">
              <div
                class="w-8 h-8 rounded-lg bg-blue-50 text-blue-600 flex items-center justify-center font-bold"
              >
                <span class="material-symbols-outlined text-lg">schedule</span>
              </div>
              <div>
                <h2 class="text-sm font-bold text-slate-900">
                  Jam Operasional
                </h2>
                <p class="text-xs text-slate-400">
                  Waktu gerbang dan toleransi presensi.
                </p>
              </div>
            </div>
            <span
              class="px-2.5 py-0.5 text-[10px] bg-slate-100 text-slate-600 font-semibold rounded-full border border-slate-200/60"
            >
              KBM Reguler
            </span>
          </div>

          <!-- Section Sesi Pagi -->
          <div>
            <span class="text-[10px] uppercase font-mono tracking-wider text-slate-400 block mb-2 font-semibold">
              Sesi Masuk Pagi
            </span>
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
              <div>
                <label
                  for="jam-buka-input"
                  class="block text-[11px] font-medium text-slate-600 mb-1"
                >
                  Buka Gerbang
                </label>
                <input
                  id="jam-buka-input"
                  class="w-full text-xs font-mono font-medium text-slate-800 bg-slate-50 border border-slate-200 rounded-lg px-3 py-2 focus:bg-white focus:outline-none focus:ring-1 focus:ring-blue-600 transition"
                  type="time"
                  value="06:15"
                />
              </div>
              <div>
                <label
                  for="jam-masuk-input"
                  class="block text-[11px] font-medium text-slate-600 mb-1"
                >
                  Bel Masuk (Tepat)
                </label>
                <input
                  id="jam-masuk-input"
                  class="w-full text-xs font-mono font-medium text-slate-800 bg-slate-50 border border-slate-200 rounded-lg px-3 py-2 focus:bg-white focus:outline-none focus:ring-1 focus:ring-blue-600 transition"
                  type="time"
                  value="07:30"
                />
              </div>
              <div>
                <label
                  for="jam-toleransi-input"
                  class="block text-[11px] font-medium text-amber-700 mb-1 flex items-center justify-between"
                >
                  <span>Tutup Toleransi</span>
                  <span class="text-[9px] px-1 rounded bg-amber-50 border border-amber-200 font-mono">Telat</span>
                </label>
                <input
                  id="jam-toleransi-input"
                  class="w-full text-xs font-mono font-semibold text-amber-900 bg-slate-50 border border-slate-200 rounded-lg px-3 py-2 focus:bg-white focus:outline-none focus:ring-1 focus:ring-amber-500 transition"
                  type="time"
                  value="07:40"
                />
              </div>
            </div>
          </div>

          <!-- Section Sesi Pulang -->
          <div class="pt-2 border-t border-slate-100">
            <span class="text-[10px] uppercase font-mono tracking-wider text-slate-400 block mb-2 font-semibold">
              Sesi Kepulangan
            </span>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              <div>
                <label
                  for="jam-pulang-input"
                  class="block text-[11px] font-medium text-slate-600 mb-1"
                >
                  Buka Sesi Pulang
                </label>
                <input
                  id="jam-pulang-input"
                  class="w-full text-xs font-mono font-medium text-slate-800 bg-slate-50 border border-slate-200 rounded-lg px-3 py-2 focus:bg-white focus:outline-none focus:ring-1 focus:ring-blue-600 transition"
                  type="time"
                  value="13:30"
                />
              </div>
              <div>
                <label
                  for="jam-tutup-pulang-input"
                  class="block text-[11px] font-medium text-rose-700 mb-1 flex items-center justify-between"
                >
                  <span>Tutup Pulang</span>
                  <span class="text-[9px] px-1 rounded bg-rose-50 border border-rose-200 font-mono">Batas Bolos</span>
                </label>
                <input
                  id="jam-tutup-pulang-input"
                  class="w-full text-xs font-mono font-semibold text-rose-900 bg-slate-50 border border-slate-200 rounded-lg px-3 py-2 focus:bg-white focus:outline-none focus:ring-1 focus:ring-rose-500 transition"
                  type="time"
                  value="15:00"
                />
              </div>
            </div>
          </div>
        </div>

        <!-- Preset Cepat Demo -->
        <div class="pt-3 border-t border-slate-100 flex flex-wrap items-center justify-between gap-2">
          <span class="text-slate-400 text-[11px] font-medium flex items-center gap-1">
            <span class="material-symbols-outlined text-sm text-blue-600">tune</span>
            <span>Preset Cepat Demo:</span>
          </span>
          <div class="flex flex-wrap gap-1.5">
            <button
              type="button"
              id="btn-preset-resmi"
              class="px-2.5 py-1 text-[11px] font-semibold text-slate-700 bg-slate-100 hover:bg-slate-200 rounded-md transition cursor-pointer"
            >
              Standar
            </button>
            <button
              type="button"
              id="btn-preset-demo-hadir"
              class="px-2.5 py-1 text-[11px] font-semibold text-emerald-700 bg-emerald-50 hover:bg-emerald-100 border border-emerald-200/80 rounded-md transition cursor-pointer"
            >
              Hadir Sekarang
            </button>
            <button
              type="button"
              id="btn-preset-demo-telat"
              class="px-2.5 py-1 text-[11px] font-semibold text-amber-700 bg-amber-50 hover:bg-amber-100 border border-amber-200/80 rounded-md transition cursor-pointer"
            >
              Telat Sekarang
            </button>
            <button
              type="button"
              id="btn-preset-demo-pulang"
              class="px-2.5 py-1 text-[11px] font-semibold text-blue-700 bg-blue-50 hover:bg-blue-100 border border-blue-200/80 rounded-md transition cursor-pointer"
            >
              Pulang Sekarang
            </button>
          </div>
        </div>
      </section>

      <!-- Card 2: Aturan Presensi Jurusan & Batas SP -->
      <section
        class="bg-white rounded-xl border border-slate-200/80 shadow-xs p-5 sm:p-6 space-y-4 flex flex-col justify-between"
      >
        <div class="space-y-4">
          <div
            class="flex items-start justify-between border-b border-slate-100 pb-3"
          >
            <div class="flex items-center gap-2.5">
              <div
                class="w-8 h-8 rounded-lg bg-indigo-50 text-indigo-600 flex items-center justify-center font-bold"
              >
                <span class="material-symbols-outlined text-lg">gavel</span>
              </div>
              <div>
                <h2 class="text-sm font-bold text-slate-900">
                  Batas Peringatan SP
                </h2>
                <p class="text-xs text-slate-400">
                  Kriteria teguran dan panggilan BK.
                </p>
              </div>
            </div>
            <span
              class="px-2.5 py-0.5 text-[10px] bg-indigo-50 text-indigo-700 font-semibold rounded-full border border-indigo-200/60"
            >
              Kedisiplinan
            </span>
          </div>

          <!-- Select Inputs -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
            <div>
              <label
                for="sp-wali-select"
                class="block text-[11px] font-medium text-slate-600 mb-1"
              >
                SP Wali Kelas
              </label>
              <select
                id="sp-wali-select"
                class="w-full text-xs font-medium text-slate-800 bg-slate-50 border border-slate-200 rounded-lg px-3 py-2 focus:bg-white focus:outline-none focus:ring-1 focus:ring-blue-600 transition"
              >
                <option value="3 Hari Terlambat Berturut-turut" selected>3 Hari Telat Berturut</option>
                <option value="5 Hari Terlambat dalam 1 Bulan">5 Hari Telat / Bulan</option>
              </select>
            </div>
            <div>
              <label
                for="sp-bk-select"
                class="block text-[11px] font-medium text-slate-600 mb-1"
              >
                Panggilan BK
              </label>
              <select
                id="sp-bk-select"
                class="w-full text-xs font-medium text-slate-800 bg-slate-50 border border-slate-200 rounded-lg px-3 py-2 focus:bg-white focus:outline-none focus:ring-1 focus:ring-blue-600 transition"
              >
                <option value="Akumulasi 3 Hari Alpa" selected>3 Hari Alpa</option>
                <option value="Akumulasi 5 Hari Alpa dalam 1 Semester">5 Hari Alpa / Semester</option>
              </select>
            </div>
          </div>

          <!-- Information Tiles to Balance Card Height -->
          <div class="space-y-2 pt-1">
            <span class="text-[10px] uppercase font-mono tracking-wider text-slate-400 block font-semibold">
              Skema Konsekuensi Kedisiplinan
            </span>
            <div class="grid grid-cols-1 gap-2 text-xs">
              <div class="p-2.5 rounded-lg bg-slate-50 border border-slate-200/60 flex items-center justify-between">
                <div class="flex items-center gap-2">
                  <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span>
                  <span class="font-medium text-slate-700">Teguran Wali Kelas</span>
                </div>
                <span class="text-[11px] font-mono text-slate-400">Notifikasi WhatsApp</span>
              </div>
              <div class="p-2.5 rounded-lg bg-slate-50 border border-slate-200/60 flex items-center justify-between">
                <div class="flex items-center gap-2">
                  <span class="w-1.5 h-1.5 rounded-full bg-rose-500"></span>
                  <span class="font-medium text-slate-700">Panggilan Orang Tua / BK</span>
                </div>
                <span class="text-[11px] font-mono text-slate-400">Surat Resmi</span>
              </div>
              <div class="p-2.5 rounded-lg bg-slate-50 border border-slate-200/60 flex items-center justify-between">
                <div class="flex items-center gap-2">
                  <span class="w-1.5 h-1.5 rounded-full bg-blue-500"></span>
                  <span class="font-medium text-slate-700">Evaluasi Bolos Siang</span>
                </div>
                <span class="text-[11px] font-mono text-slate-400 font-bold text-rose-600">-10 Poin</span>
              </div>
            </div>
          </div>
        </div>

        <div class="pt-3 border-t border-slate-100 flex items-center justify-between text-[11px] text-slate-400 font-mono">
          <span>Otomatisasi Poin Aktif</span>
          <span class="text-emerald-600 font-semibold flex items-center gap-1">
            <span class="material-symbols-outlined text-xs">check_circle</span>
            Sinkron Realtime
          </span>
        </div>
      </section>
    </div>

    <!-- Card 3: WhatsApp Gateway Integration with Accessible Textarea -->
    <section
      class="bg-white rounded-xl border border-slate-200/80 shadow-xs p-5 sm:p-6 space-y-4"
    >
      <div
        class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-slate-100 pb-3"
      >
        <div class="flex items-center gap-2.5">
          <div
            class="w-8 h-8 rounded-lg bg-emerald-50 text-emerald-600 flex items-center justify-center font-bold"
          >
            <span class="material-symbols-outlined text-lg">chat</span>
          </div>
          <div>
            <h2 class="text-sm font-bold text-slate-900">
              Notifikasi WhatsApp
            </h2>
            <p class="text-xs text-slate-400">
              Kirim presensi otomatis ke nomor wali.
            </p>
          </div>
        </div>
        <div
          class="inline-flex items-center gap-1.5 px-2.5 py-1 bg-emerald-50 border border-emerald-200/80 rounded-full text-xs font-semibold text-emerald-800"
        >
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
          <span>Gateway Aktif</span>
        </div>
      </div>

      <div class="space-y-2">
        <div class="flex items-center justify-between flex-wrap gap-2">
          <label
            for="wa-template-area"
            class="text-[11px] font-medium text-slate-600 uppercase font-mono tracking-wider block"
          >
            Template Pesan
          </label>
          <div class="flex items-center gap-1 text-[10px] font-mono text-slate-400">
            <span>Variabel:</span>
            <code class="px-1.5 py-0.5 rounded bg-slate-100 text-slate-600">&#123;nama_siswa&#125;</code>
            <code class="px-1.5 py-0.5 rounded bg-slate-100 text-slate-600">&#123;kelas&#125;</code>
            <code class="px-1.5 py-0.5 rounded bg-slate-100 text-slate-600">&#123;jam_masuk&#125;</code>
            <code class="px-1.5 py-0.5 rounded bg-slate-100 text-slate-600">&#123;status&#125;</code>
          </div>
        </div>
        <textarea
          id="wa-template-area"
          rows={3}
          class="w-full text-xs font-mono p-3 bg-slate-50 border border-slate-200 rounded-lg leading-relaxed focus:bg-white focus:outline-none focus:ring-1 focus:ring-blue-600 transition"
        >Yth. Bapak/Ibu Wali Murid dari &#123;nama_siswa&#125; (&#123;kelas&#125;). Ananda telah hadir di SMK pada pukul &#123;jam_masuk&#125; WIB dengan status: [&#123;status&#125;].</textarea>
      </div>
    </section>

    <!-- Card 4: Backup Data & Keamanan -->
    <section
      class="bg-white rounded-xl border border-slate-200/80 shadow-xs p-5 sm:p-6"
    >
      <div
        class="flex flex-col sm:flex-row sm:items-center justify-between gap-3"
      >
        <div class="flex items-center gap-2.5">
          <div
            class="w-8 h-8 rounded-lg bg-slate-100 text-slate-600 flex items-center justify-center font-bold"
          >
            <span class="material-symbols-outlined text-lg">database</span>
          </div>
          <div>
            <h2 class="text-sm font-bold text-slate-900">
              Pencadangan Data
            </h2>
            <p class="text-xs text-slate-400">
              Cadangkan rekaman presensi dan konfigurasi ke berkas lokal.
            </p>
          </div>
        </div>
        <button
          type="button"
          id="btn-download-backup"
          class="px-3.5 py-2 text-xs font-semibold text-slate-700 bg-slate-50 hover:bg-slate-100 border border-slate-200 rounded-lg transition inline-flex items-center gap-1.5 cursor-pointer shadow-2xs"
        >
          <span class="material-symbols-outlined text-sm text-slate-600">download</span>
          <span>Unduh Cadangan</span>
        </button>
      </div>
    </section>

    <!-- Card 5: Sesi Akun & Keluar Sistem -->
    <section class="bg-white rounded-xl border border-rose-100/80 shadow-xs p-5 sm:p-6 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-xl bg-rose-50 text-rose-600 flex items-center justify-center font-bold shrink-0">
          <span class="material-symbols-outlined text-xl">logout</span>
        </div>
        <div>
          <h2 class="text-sm font-bold text-slate-900">Sesi Akun & Logout</h2>
          <p class="text-xs text-slate-500">Akhiri sesi login civitas akademik pada perangkat ini secara aman.</p>
        </div>
      </div>
      <button
        type="button"
        id="btn-settings-logout"
        class="px-4 py-2.5 text-xs font-bold text-white bg-rose-600 hover:bg-rose-700 rounded-xl shadow-xs transition inline-flex items-center justify-center gap-1.5 cursor-pointer active:scale-95 shrink-0"
      >
        <span class="material-symbols-outlined text-sm">logout</span>
        <span>Keluar Sistem</span>
      </button>
    </section>
  </div>

  <script>
    const jamBukaInput = document.getElementById(
      "jam-buka-input",
    ) as HTMLInputElement | null;
    const jamMasukInput = document.getElementById(
      "jam-masuk-input",
    ) as HTMLInputElement | null;
    const jamToleransiInput = document.getElementById(
      "jam-toleransi-input",
    ) as HTMLInputElement | null;
    const jamPulangInput = document.getElementById(
      "jam-pulang-input",
    ) as HTMLInputElement | null;
    const jamTutupPulangInput = document.getElementById(
      "jam-tutup-pulang-input",
    ) as HTMLInputElement | null;
    const spWaliSelect = document.getElementById(
      "sp-wali-select",
    ) as HTMLSelectElement | null;
    const spBkSelect = document.getElementById(
      "sp-bk-select",
    ) as HTMLSelectElement | null;
    const waTemplateArea = document.getElementById(
      "wa-template-area",
    ) as HTMLTextAreaElement | null;
    const btnSave = document.getElementById(
      "btn-save-settings",
    ) as HTMLButtonElement | null;
    const btnReset = document.getElementById(
      "btn-reset-settings",
    ) as HTMLButtonElement | null;

    async function loadSettings() {
      try {
        const res = await fetch("/api/settings");
        if (!res.ok) return;
        const data = await res.json();
        if (jamBukaInput && data.jamBuka) jamBukaInput.value = data.jamBuka;
        if (jamMasukInput && data.jamMasuk) jamMasukInput.value = data.jamMasuk;
        if (jamToleransiInput && data.jamToleransi)
          jamToleransiInput.value = data.jamToleransi;
        if (jamPulangInput && data.jamPulang)
          jamPulangInput.value = data.jamPulang;
        if (jamTutupPulangInput && data.jamTutupPulang)
          jamTutupPulangInput.value = data.jamTutupPulang;
        if (spWaliSelect && data.spWali) spWaliSelect.value = data.spWali;
        if (spBkSelect && data.spBk) spBkSelect.value = data.spBk;
        if (waTemplateArea && data.waTemplate)
          waTemplateArea.value = data.waTemplate;
      } catch (e) {
        console.error("Gagal memuat pengaturan:", e);
      }
    }

    function toMinutes(timeStr: string): number {
      const [h, m] = (timeStr || "00:00").split(":").map(Number);
      return (h || 0) * 60 + (m || 0);
    }

    async function saveSettings() {
      if (!btnSave) return;
      const originalText = btnSave.innerHTML;
      const origClass = "px-4 py-2 text-xs font-semibold text-white bg-blue-600 hover:bg-blue-700 rounded-lg shadow-2xs transition cursor-pointer active:scale-95 flex items-center gap-1.5";

      const b = toMinutes(jamBukaInput?.value || "06:15");
      const m = toMinutes(jamMasukInput?.value || "07:30");
      const t = toMinutes(jamToleransiInput?.value || "07:40");
      const p = toMinutes(jamPulangInput?.value || "13:30");
      const tp = toMinutes(jamTutupPulangInput?.value || "15:00");

      if (b >= m) {
        alert("Jam Buka Gerbang harus lebih awal dari Bel Masuk.");
        return;
      }
      if (m >= t) {
        alert("Bel Masuk harus lebih awal dari Tutup Toleransi (Telat).");
        return;
      }
      if (t >= p) {
        alert("Tutup Toleransi Masuk harus lebih awal dari Buka Sesi Pulang.");
        return;
      }
      if (p >= tp) {
        alert("Buka Sesi Pulang harus lebih awal dari Tutup Pulang.");
        return;
      }

      btnSave.disabled = true;
      btnSave.innerHTML = `
        <span class="inline-flex items-center gap-1.5">
          <svg class="animate-spin h-3.5 w-3.5 text-white" viewBox="0 0 24 24" fill="none"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path></svg>
          Menyimpan...
        </span>`;

      const payload = {
        jamBuka: jamBukaInput?.value || "06:15",
        jamMasuk: jamMasukInput?.value || "07:30",
        jamToleransi: jamToleransiInput?.value || "07:40",
        jamPulang: jamPulangInput?.value || "13:30",
        jamTutupPulang: jamTutupPulangInput?.value || "15:00",
        spWali: spWaliSelect?.value || "",
        spBk: spBkSelect?.value || "",
        waTemplate: waTemplateArea?.value || "",
      };

      try {
        const res = await fetch("/api/settings", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(payload),
        });
        if (res.ok) {
          btnSave.className =
            "px-4 py-2 text-xs font-semibold text-white bg-emerald-600 rounded-lg shadow-2xs transition-all flex items-center gap-1.5";
          btnSave.innerHTML = "Tersimpan! ✓";
          setTimeout(() => {
            btnSave.disabled = false;
            btnSave.className = origClass;
            btnSave.innerHTML = originalText;
          }, 2000);
        } else {
          const errData = await res.json().catch(() => ({}));
          alert(errData.message || "Gagal menyimpan pengaturan.");
          btnSave.disabled = false;
          btnSave.className = origClass;
          btnSave.innerHTML = originalText;
        }
      } catch (err: any) {
        alert("Koneksi gagal: " + err.message);
        btnSave.disabled = false;
        btnSave.className = origClass;
        btnSave.innerHTML = originalText;
      }
    }

    async function resetSettings() {
      if (!confirm("Kembalikan semua pengaturan ke standar awal?")) return;
      if (!btnReset) return;
      btnReset.disabled = true;
      try {
        const res = await fetch("/api/settings", { method: "DELETE" });
        if (res.ok) {
          await loadSettings();
        } else {
          const errData = await res.json().catch(() => ({}));
          alert(errData.message || "Gagal mereset pengaturan.");
        }
      } catch (err: any) {
        alert("Gagal mereset: " + err.message);
      } finally {
        btnReset.disabled = false;
      }
    }

    function toHHMM(totalM: number) {
      const normalized = ((totalM % 1440) + 1440) % 1440;
      const h = Math.floor(normalized / 60).toString().padStart(2, "0");
      const m = (normalized % 60).toString().padStart(2, "0");
      return `${h}:${m}`;
    }

    function applyPreset(type: "resmi" | "hadir" | "telat" | "pulang") {
      if (type === "resmi") {
        if (jamBukaInput) jamBukaInput.value = "06:15";
        if (jamMasukInput) jamMasukInput.value = "07:30";
        if (jamToleransiInput) jamToleransiInput.value = "07:40";
        if (jamPulangInput) jamPulangInput.value = "13:30";
        if (jamTutupPulangInput) jamTutupPulangInput.value = "15:00";
      } else {
        const now = new Date();
        const curM = now.getHours() * 60 + now.getMinutes();
        if (type === "hadir") {
          if (jamBukaInput) jamBukaInput.value = toHHMM(curM - 30);
          if (jamMasukInput) jamMasukInput.value = toHHMM(curM + 20);
          if (jamToleransiInput) jamToleransiInput.value = toHHMM(curM + 45);
          if (jamPulangInput) jamPulangInput.value = toHHMM(curM + 180);
          if (jamTutupPulangInput) jamTutupPulangInput.value = "23:59";
        } else if (type === "telat") {
          if (jamBukaInput) jamBukaInput.value = toHHMM(curM - 45);
          if (jamMasukInput) jamMasukInput.value = toHHMM(curM - 10);
          if (jamToleransiInput) jamToleransiInput.value = toHHMM(curM + 30);
          if (jamPulangInput) jamPulangInput.value = toHHMM(curM + 180);
          if (jamTutupPulangInput) jamTutupPulangInput.value = "23:59";
        } else if (type === "pulang") {
          if (jamBukaInput) jamBukaInput.value = "06:00";
          if (jamMasukInput) jamMasukInput.value = toHHMM(curM - 60);
          if (jamToleransiInput) jamToleransiInput.value = toHHMM(curM - 30);
          if (jamPulangInput) jamPulangInput.value = toHHMM(curM - 15);
          if (jamTutupPulangInput) jamTutupPulangInput.value = "23:59";
        }
      }
      saveSettings();
    }

    document.getElementById("btn-preset-resmi")?.addEventListener("click", () => applyPreset("resmi"));
    document.getElementById("btn-preset-demo-hadir")?.addEventListener("click", () => applyPreset("hadir"));
    document.getElementById("btn-preset-demo-telat")?.addEventListener("click", () => applyPreset("telat"));
    document.getElementById("btn-preset-demo-pulang")?.addEventListener("click", () => applyPreset("pulang"));

    document.getElementById("btn-download-backup")?.addEventListener("click", async () => {
      const btn = document.getElementById("btn-download-backup") as HTMLButtonElement | null;
      const origText = btn ? btn.innerHTML : "";
      if (btn) {
        btn.disabled = true;
        btn.innerHTML = '<span class="material-symbols-outlined text-sm animate-spin">sync</span><span>Mencadangkan...</span>';
      }
      try {
        const [stdRes, attRes, prmRes] = await Promise.all([
          fetch('/api/students').then(r => r.json()).catch(() => []),
          fetch('/api/attendance').then(r => r.json()).catch(() => []),
          fetch('/api/permissions').then(r => r.json()).catch(() => [])
        ]);
        const backupData = {
          settings: {
            jamBuka: jamBukaInput?.value,
            jamMasuk: jamMasukInput?.value,
            jamToleransi: jamToleransiInput?.value,
            jamPulang: jamPulangInput?.value,
            jamTutupPulang: jamTutupPulangInput?.value,
            spWali: spWaliSelect?.value,
            spBk: spBkSelect?.value,
            waTemplate: waTemplateArea?.value,
          },
          students: stdRes,
          attendance: attRes,
          permissions: prmRes,
          exportedAt: new Date().toISOString(),
        };
        const dataStr = "data:text/json;charset=utf-8," + encodeURIComponent(JSON.stringify(backupData, null, 2));
        const downloadAnchor = document.createElement("a");
        downloadAnchor.setAttribute("href", dataStr);
        downloadAnchor.setAttribute("download", `backup-absensi-smk-${new Date().toLocaleDateString('en-CA')}.json`);
        document.body.appendChild(downloadAnchor);
        downloadAnchor.click();
        downloadAnchor.remove();
      } finally {
        if (btn) {
          btn.disabled = false;
          btn.innerHTML = origText;
        }
      }
    });

    document.getElementById("btn-settings-logout")?.addEventListener("click", () => {
      if (typeof (window as any).performLogout === "function") {
        (window as any).performLogout();
      } else {
        localStorage.removeItem("auth_civitas");
        localStorage.removeItem("auth_role");
        sessionStorage.removeItem("auth_active");
        sessionStorage.removeItem("bypass_login");
        document.cookie = "auth_session=; Path=/; Max-Age=0; Expires=Thu, 01 Jan 1970 00:00:00 GMT; SameSite=Lax";
        window.location.replace("/login");
      }
    });

    btnSave?.addEventListener("click", saveSettings);
    btnReset?.addEventListener("click", resetSettings);
    loadSettings();
  </script>
</Layout>
