---
/**
 * @file src/pages/profil-siswa.astro
 * @description Halaman Profil Siswa dengan Sidebar Khusus yang Menggantikan Sidebar Utama
 */
export const prerender = false;

const authSession = Astro.cookies.get('auth_session')?.value;
if (!authSession) {
  return Astro.redirect('/');
}

const url = new URL(Astro.request.url);
const paramId = url.searchParams.get('id') || '';
const isGuruInitial = authSession === 'guru' || paramId.startsWith('GUR-');
const isAdminInitial = authSession === 'admin';
const canAccessDashboardInitial = authSession === 'admin';

import Layout from "../layouts/Layout.astro";
---

<Layout title="Profil Siswa & Portofolio" activeNav="siswa-guru">

  <!-- ========================================================
       SIDEBAR KHUSUS SISWA & GURU (MENGGANTIKAN SIDEBAR UTAMA)
       ======================================================== -->
  <aside
    slot="sidebar"
    class="hidden md:flex md:w-64 lg:w-72 bg-gradient-to-b from-[#1e3a8a] via-[#1d4ed8] to-[#1e40af] text-blue-100 flex-col justify-between shrink-0 select-none shadow-xl border-r border-blue-900/40 overflow-y-auto h-auto min-h-[920px] p-5 space-y-6"
    aria-label="Sidebar Khusus Profil Siswa"
  >
    <div class="space-y-6">
      <!-- Tombol Kembali ke Menu Utama Dashboard (Ditampilkan HANYA untuk Admin, Kepsek, & Waka) -->
      <div id="sidebar-back-to-menu" class={`${canAccessDashboardInitial ? '' : 'hidden '}pb-3 border-b border-white/15`}>
        <a
          href="/"
          class="inline-flex items-center gap-2 px-3.5 py-2.5 rounded-2xl bg-white/10 hover:bg-white/20 text-white font-bold text-xs transition duration-200 hover:scale-[1.02] active:scale-[0.98] w-full border border-white/15 shadow-sm"
          title="Kembali ke Menu Utama Dashboard"
        >
          <span class="material-symbols-outlined text-base">arrow_back</span>
          <span>Menu Utama</span>
        </a>
      </div>


      <!-- Mini Profile Civitas Aktif di Sidebar -->
      <div class="p-3.5 rounded-2xl bg-white/10 backdrop-blur-md border border-white/15 space-y-3">
        <div class="flex items-center gap-3">
          <div class="relative shrink-0">
            <div class="w-12 h-12 rounded-full p-0.5 bg-gradient-to-tr from-blue-300 via-indigo-200 to-white shadow-md">
              <img
                id="sidebar-avatar"
                src="/assets/avatar_male.jpg"
                alt="Avatar"
                class="w-full h-full object-cover rounded-full bg-slate-100"
              />
            </div>
            <span
              class="absolute bottom-0 right-0 w-3.5 h-3.5 rounded-full bg-emerald-400 border-2 border-blue-900 shadow-xs"
              title="Aktif"
            ></span>
          </div>
          <div class="min-w-0 flex-1">
            <h3 id="sidebar-name" class="font-black text-sm text-white truncate">Memuat...</h3>
            <p id="sidebar-role" class="text-[11px] font-semibold text-blue-200 truncate mt-0.5">-</p>
          </div>
        </div>

        <!-- Box Poin Disiplin Siswa (Sistem Akumulasi Poin Otomatis) -->
        <div id="sidebar-point-box" class="pt-2 border-t border-white/10 flex items-center justify-between text-xs">
          <span class="text-blue-200 text-[11px] font-medium">Poin Disiplin:</span>
          <span id="sidebar-point-badge" class="px-2 py-0.5 rounded-lg bg-emerald-500/20 text-emerald-300 border border-emerald-400/30 font-black font-mono text-[11px]">
            100 Poin
          </span>
        </div>
      </div>

      <!-- Menu Navigasi Khusus Profil -->
      <nav class="space-y-1.5" id="profile-subnav" aria-label="Navigasi Profil">
        <!-- 1. Biodata -->
        <button
          type="button"
          data-target="sec-biodata"
          class="profile-nav-btn active w-full flex items-center justify-between px-3.5 py-3 rounded-2xl text-xs font-bold transition duration-200 text-left cursor-pointer bg-white text-blue-900 shadow-lg shadow-blue-950/25 border-l-4 border-indigo-700 translate-x-1"
        >
          <span class="flex items-center gap-3">
            <span class="material-symbols-outlined text-lg">badge</span>
            <span>Biodata & Profil</span>
          </span>
          <span class="material-symbols-outlined text-sm opacity-80">chevron_right</span>
        </button>

        <!-- 2. Kartu & Akses RFID -->
        <button
          type="button"
          data-target="sec-card"
          class="profile-nav-btn w-full flex items-center justify-between px-3.5 py-3 rounded-2xl text-xs font-semibold transition duration-200 text-left cursor-pointer text-blue-100/80 hover:text-white hover:bg-white/15 hover:translate-x-0.5"
        >
          <span class="flex items-center gap-3">
            <span class="material-symbols-outlined text-lg">contactless</span>
            <span>Data Kartu & RFID</span>
          </span>
          <span class="material-symbols-outlined text-sm opacity-60">chevron_right</span>
        </button>

        <!-- 3. Linimasa Aktivitas -->
        <button
          type="button"
          data-target="sec-timeline"
          class="profile-nav-btn w-full flex items-center justify-between px-3.5 py-3 rounded-2xl text-xs font-semibold transition duration-200 text-left cursor-pointer text-blue-100/80 hover:text-white hover:bg-white/15 hover:translate-x-0.5"
        >
          <span class="flex items-center gap-3">
            <span class="material-symbols-outlined text-lg">history</span>
            <span>History</span>
          </span>
          <span class="material-symbols-outlined text-sm opacity-60">chevron_right</span>
        </button>

        <!-- 4. Poin Disiplin Otomatis -->
        <button
          type="button"
          data-target="sec-poin"
          class="profile-nav-btn w-full flex items-center justify-between px-3.5 py-3 rounded-2xl text-xs font-semibold transition duration-200 text-left cursor-pointer text-blue-100/80 hover:text-white hover:bg-white/15 hover:translate-x-0.5"
        >
          <span class="flex items-center gap-3">
            <span class="material-symbols-outlined text-lg">sports_score</span>
            <span>Poin & Pelanggaran</span>
          </span>
          <span class="text-[9px] font-black uppercase px-1.5 py-0.5 rounded-md bg-amber-400 text-amber-950">Auto</span>
        </button>

        <!-- 5. Rapor & Kinerja -->
        <button
          type="button"
          data-target="sec-rapor"
          class="profile-nav-btn w-full flex items-center justify-between px-3.5 py-3 rounded-2xl text-xs font-semibold transition duration-200 text-left cursor-pointer text-blue-100/80 hover:text-white hover:bg-white/15 hover:translate-x-0.5"
        >
          <span class="flex items-center gap-3">
            <span class="material-symbols-outlined text-lg">bar_chart</span>
            <span>Rapor Kedisiplinan</span>
          </span>
          <span class="material-symbols-outlined text-sm opacity-60">chevron_right</span>
        </button>

        <!-- 6. Pengajuan Izin / Konfirmasi Izin Siswa -->
        <button
          type="button"
          id="sidebar-nav-izin"
          data-target="sec-izin"
          class="profile-nav-btn w-full flex items-center justify-between px-3.5 py-3 rounded-2xl text-xs font-semibold transition duration-200 text-left cursor-pointer text-blue-100/80 hover:text-white hover:bg-white/15 hover:translate-x-0.5"
        >
          <span class="flex items-center gap-3">
            <span id="sidebar-izin-icon" class="material-symbols-outlined text-lg">{isGuruInitial ? 'verified_user' : 'edit_document'}</span>
            <span id="sidebar-izin-title">{isGuruInitial ? 'Konfirmasi Izin Siswa' : 'Pengajuan Izin'}</span>
          </span>
          <span id="sidebar-izin-badge" class={isGuruInitial ? "text-[9px] font-black uppercase px-1.5 py-0.5 rounded-md bg-amber-400 text-slate-900" : "text-[9px] font-black uppercase px-1.5 py-0.5 rounded-md bg-white/20 text-blue-100"}>
            {isGuruInitial ? 'Guru' : 'Izin'}
          </span>
        </button>
      </nav>
    </div>

    <!-- Bagian Bawah Sidebar Khusus: Tombol Aksi Cepat (Hubungi WA & Cetak) -->
    <div id="sidebar-quick-actions" class="pt-4 border-t border-white/15 space-y-2">
      <a
        id="sidebar-wa-btn"
        href="#"
        target="_blank"
        class="w-full flex items-center justify-center gap-2 py-2.5 px-3.5 rounded-2xl bg-emerald-500 hover:bg-emerald-600 text-white font-bold text-xs transition duration-200 shadow-md shadow-emerald-950/20"
      >
        <span class="material-symbols-outlined text-base">chat</span>
        <span id="sidebar-wa-text">Hubungi via WA</span>
      </a>
      <button
        type="button"
        onclick="window.print()"
        class="w-full flex items-center justify-center gap-2 py-2 px-3 rounded-xl bg-white/10 hover:bg-white/20 text-white font-bold text-xs transition duration-200 cursor-pointer border border-white/10"
      >
        <span class="material-symbols-outlined text-base">print</span>
        <span>Cetak Kartu & Rapor</span>
      </button>
    </div>
  </aside>

  <!-- ========================================================
       NAVIGASI BAWAH KHUSUS PROFIL SISWA & GURU (MOBILE / ANDROID)
       Menempel mentok di dasar layar, menggantikan bottom-nav umum
       ======================================================== -->
  <nav
    slot="bottom-nav"
    aria-label="Navigasi Profil Mobile"
    class="fixed bottom-0 inset-x-0 z-40 w-full bg-white/95 backdrop-blur-xl border-t border-slate-200/90 shadow-[0_-4px_25px_rgba(0,0,0,0.06)] md:hidden select-none safe-bottom transition-all duration-200 touch-manipulation"
  >
    <div class="grid grid-cols-6 items-center px-0.5 py-1 w-full relative touch-manipulation" id="profile-bottom-nav">
      <!-- Sliding Blue Pill (Lingkaran Berpindah Halus) -->
      <div
        id="profile-sliding-pill"
        class="absolute pointer-events-none w-9 h-9 rounded-2xl bg-blue-600 shadow-md shadow-blue-600/35 transition-all duration-300 ease-out z-0 -translate-y-1.5"
        style="left: calc(8.333% - 18px); top: 8px;"
      ></div>

      <!-- 1. Biodata -->
      <button
        type="button"
        data-target="sec-biodata"
        data-index="0"
        class="profile-mobile-nav-btn flex flex-col items-center justify-center py-1 px-0.5 rounded-xl transition-all duration-200 active:scale-95 group relative z-10 cursor-pointer touch-manipulation"
        aria-label="Tab Biodata"
      >
        <div class="bnav-icon-box w-9 h-9 rounded-2xl flex items-center justify-center transition-all duration-300 ease-out text-white -translate-y-1.5">
          <span class="material-symbols-outlined text-[20px]">badge</span>
        </div>
        <span class="bnav-label text-[10px] tracking-tight leading-tight transition-all duration-200 whitespace-nowrap text-blue-600 font-bold -translate-y-0.5">Biodata</span>
      </button>

      <!-- 2. Kartu RFID -->
      <button
        type="button"
        data-target="sec-card"
        data-index="1"
        class="profile-mobile-nav-btn flex flex-col items-center justify-center py-1 px-0.5 rounded-xl transition-all duration-200 active:scale-95 group relative z-10 cursor-pointer touch-manipulation"
        aria-label="Tab Kartu RFID"
      >
        <div class="bnav-icon-box w-9 h-9 rounded-2xl flex items-center justify-center transition-all duration-300 ease-out text-slate-400 group-hover:text-slate-700 translate-y-0">
          <span class="material-symbols-outlined text-[20px]">contactless</span>
        </div>
        <span class="bnav-label text-[10px] tracking-tight leading-tight transition-all duration-200 whitespace-nowrap text-slate-400 font-medium translate-y-0">Kartu</span>
      </button>

      <!-- 3. Riwayat -->
      <button
        type="button"
        data-target="sec-timeline"
        data-index="2"
        class="profile-mobile-nav-btn flex flex-col items-center justify-center py-1 px-0.5 rounded-xl transition-all duration-200 active:scale-95 group relative z-10 cursor-pointer touch-manipulation"
        aria-label="Tab Riwayat"
      >
        <div class="bnav-icon-box w-9 h-9 rounded-2xl flex items-center justify-center transition-all duration-300 ease-out text-slate-400 group-hover:text-slate-700 translate-y-0">
          <span class="material-symbols-outlined text-[20px]">history</span>
        </div>
        <span class="bnav-label text-[10px] tracking-tight leading-tight transition-all duration-200 whitespace-nowrap text-slate-400 font-medium translate-y-0">Riwayat</span>
      </button>

      <!-- 4. Poin -->
      <button
        type="button"
        data-target="sec-poin"
        data-index="3"
        class="profile-mobile-nav-btn flex flex-col items-center justify-center py-1 px-0.5 rounded-xl transition-all duration-200 active:scale-95 group relative z-10 cursor-pointer touch-manipulation"
        aria-label="Tab Poin"
      >
        <div class="bnav-icon-box w-9 h-9 rounded-2xl flex items-center justify-center transition-all duration-300 ease-out text-slate-400 group-hover:text-slate-700 translate-y-0">
          <span class="material-symbols-outlined text-[20px]">sports_score</span>
        </div>
        <span class="bnav-label text-[10px] tracking-tight leading-tight transition-all duration-200 whitespace-nowrap text-slate-400 font-medium translate-y-0">Poin</span>
      </button>

      <!-- 5. Izin -->
      <button
        type="button"
        data-target="sec-izin"
        data-index="4"
        class="profile-mobile-nav-btn flex flex-col items-center justify-center py-1 px-0.5 rounded-xl transition-all duration-200 active:scale-95 group relative z-10 cursor-pointer touch-manipulation"
        aria-label="Tab Izin"
      >
        <div class="bnav-icon-box w-9 h-9 rounded-2xl flex items-center justify-center transition-all duration-300 ease-out text-slate-400 group-hover:text-slate-700 translate-y-0">
          <span class="material-symbols-outlined text-[20px]">description</span>
        </div>
        <span class="bnav-label text-[10px] tracking-tight leading-tight transition-all duration-200 whitespace-nowrap text-slate-400 font-medium translate-y-0">Izin</span>
      </button>

      <!-- 6A. Menu Utama (Khusus Admin, Kepsek, & Waka) -->
      <a
        href="/"
        id="profile-mobile-back-link"
        data-astro-prefetch="load"
        class={`${canAccessDashboardInitial ? '' : 'hidden '}flex flex-col items-center justify-center py-1 px-0.5 rounded-xl transition-all duration-200 active:scale-95 group relative z-10 text-slate-400 hover:text-blue-600 touch-manipulation cursor-pointer`}
        title="Kembali ke Menu Utama"
      >
        <div class="w-9 h-9 rounded-2xl flex items-center justify-center transition-all duration-300 ease-out bg-transparent text-slate-400 group-hover:text-blue-600 translate-y-0">
          <span class="material-symbols-outlined text-[20px]">arrow_back</span>
        </div>
        <span class="text-[10px] tracking-tight leading-tight whitespace-nowrap font-medium text-slate-400">Menu</span>
      </a>

      <!-- 6B. Logout (Khusus Siswa & Guru Biasa di Mobile) -->
      <button
        type="button"
        id="profile-mobile-logout-btn"
        class={`${canAccessDashboardInitial ? 'hidden ' : 'flex '}flex-col items-center justify-center py-1 px-0.5 rounded-xl transition-all duration-200 active:scale-95 group relative z-10 cursor-pointer touch-manipulation`}
        title="Keluar dari Aplikasi"
      >
        <div class="w-9 h-9 rounded-2xl flex items-center justify-center transition-all duration-300 ease-out bg-transparent text-rose-500 group-hover:bg-rose-50 translate-y-0">
          <span class="material-symbols-outlined text-[20px]">logout</span>
        </div>
        <span class="text-[10px] tracking-tight leading-tight whitespace-nowrap font-bold text-rose-500">Keluar</span>
      </button>
    </div>
  </nav>

  <!-- ========================================================
       AREA KONTEN UTAMA (FULL LEBAR TANPA SUB-SIDEBAR GANDA)
       ======================================================== -->
  <div class="flex flex-col gap-6 max-w-7xl mx-auto w-full">
    
    <!-- Top Bar: Switcher Civitas Cepat (Hanya Tampil untuk Administrator, Tersembunyi untuk Guru & Siswa) -->
    <div id="top-civitas-switcher-bar" class={`${isAdminInitial ? '' : 'hidden '}flex flex-col sm:flex-row sm:items-center justify-between gap-4 bg-white/80 backdrop-blur-xl p-4 sm:p-5 rounded-3xl shadow-xs border border-slate-200/70`}>
      <div class="flex items-center gap-3">
        <span class="material-symbols-outlined text-blue-600 text-xl">account_circle</span>
        <div>
          <h2 id="top-breadcrumb-title" class="text-sm font-black text-slate-900">Detail Profil Akademik Siswa</h2>
          <p class="text-xs text-slate-500">Pilih siswa untuk meninjau data profil, kartu RFID, linimasa, dan akumulasi poin.</p>
        </div>
      </div>

      <!-- Quick Switcher Civitas (Siswa & Guru) -->
      <div class="flex items-center gap-2 overflow-x-auto pb-1 sm:pb-0" id="civitas-switcher-container">
        <!-- Render dinamis via JS -->
      </div>
    </div>

    <!-- CONTAINER KONTEN MODULAR DINAMIS -->
    <div class="w-full">

      <!-- ==========================================
           SECTION 1: BIODATA & PROFIL LENGKAP
           ========================================== -->
      <section id="sec-biodata" class="profile-section space-y-6">
        <div class="rounded-3xl bg-white border border-slate-200/80 p-5 sm:p-7 shadow-xs relative overflow-hidden group">
          <div class="absolute -top-16 -right-16 w-52 h-52 bg-gradient-to-br from-blue-100/30 via-indigo-50/10 to-transparent rounded-full blur-2xl pointer-events-none"></div>

          <div class="relative z-10 flex flex-col sm:flex-row items-center sm:items-start gap-5 sm:gap-6">
            <!-- Avatar Circle -->
            <div class="relative shrink-0">
              <div class="w-20 h-20 sm:w-24 sm:h-24 rounded-full p-1 bg-white ring-2 ring-slate-200/80 shadow-sm overflow-hidden">
                <img
                  id="profile-avatar"
                  src="/assets/avatar_male.jpg"
                  alt="Foto Profil"
                  class="w-full h-full object-cover rounded-full bg-slate-50"
                />
              </div>
              <span
                id="profile-active-dot"
                class="absolute bottom-1 right-1 w-4 h-4 rounded-full bg-emerald-500 border-2 border-white shadow-xs"
                title="Status Aktif"
              ></span>
            </div>

            <!-- Biodata & Header Profil -->
            <div class="flex-1 space-y-4 min-w-0 w-full text-center sm:text-left">
              <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                <div class="min-w-0">
                  <h1 id="profile-name" class="text-xl sm:text-2xl font-black text-slate-900 tracking-tight truncate">
                    Memuat data siswa...
                  </h1>
                  <p id="profile-headline" class="text-xs font-semibold text-slate-500 mt-1 truncate">
                    -
                  </p>
                </div>
                <div class="flex items-center gap-2 justify-center sm:justify-end shrink-0">
                  <a
                    id="btn-wa-action"
                    href="#"
                    target="_blank"
                    class="hidden inline-flex items-center gap-1.5 px-3 py-2 rounded-xl bg-emerald-50 hover:bg-emerald-100 text-emerald-700 border border-emerald-200/80 font-bold text-xs transition duration-150 active:scale-95"
                  >
                    <span class="material-symbols-outlined text-sm text-emerald-600">chat</span>
                    <span id="btn-wa-text">WhatsApp</span>
                  </a>
                  <button
                    type="button"
                    id="btn-edit-current-profile"
                    class="inline-flex items-center gap-1 px-3 py-2 rounded-xl text-slate-600 hover:text-blue-600 hover:bg-blue-50 border border-slate-200/80 transition-colors cursor-pointer text-xs font-bold active:scale-95"
                    title="Edit Profil"
                  >
                    <span class="material-symbols-outlined text-base">edit_note</span>
                    <span>Edit</span>
                  </button>
                </div>
              </div>

              <!-- Grid Data Pribadi: Clean Info Tiles -->
              <div id="profile-details-grid" class="grid grid-cols-2 sm:grid-cols-4 gap-2.5 sm:gap-3 text-xs pt-1 text-slate-600">
                <!-- 1. NISN -->
                <div id="row-profile-nisn" class="p-3 rounded-2xl bg-slate-50/80 border border-slate-100 flex flex-col justify-between min-w-0">
                  <span id="profile-nisn-label" class="text-[10px] font-bold uppercase tracking-wider text-slate-400">NISN</span>
                  <span id="profile-nisn" class="font-bold text-slate-800 font-mono text-xs sm:text-sm truncate mt-1">0068472911</span>
                </div>

                <!-- 2. ID RFID -->
                <div id="row-profile-id" class="p-3 rounded-2xl bg-slate-50/80 border border-slate-100 flex flex-col justify-between min-w-0">
                  <span id="profile-id-label" class="text-[10px] font-bold uppercase tracking-wider text-slate-400">ID RFID</span>
                  <span id="profile-custom-id" class="font-bold text-blue-700 font-mono text-xs sm:text-sm truncate mt-1">A1B2C3D4</span>
                </div>

                <!-- 3. Alamat / Domisili -->
                <div id="row-profile-city" class="p-3 rounded-2xl bg-slate-50/80 border border-slate-100 flex flex-col justify-between min-w-0">
                  <span id="profile-city-label" class="text-[10px] font-bold uppercase tracking-wider text-slate-400">Alamat</span>
                  <span id="profile-city" class="font-bold text-slate-800 text-xs sm:text-sm truncate mt-1">Padang Ratu, Lampung</span>
                </div>

                <!-- 4. Nama Lengkap -->
                <div id="row-profile-name" class="p-3 rounded-2xl bg-slate-50/80 border border-slate-100 flex flex-col justify-between min-w-0">
                  <span id="profile-name-label" class="text-[10px] font-bold uppercase tracking-wider text-slate-400">Nama</span>
                  <span id="profile-detail-name" class="font-bold text-slate-800 text-xs sm:text-sm truncate mt-1">Alya Putri Ramadhani</span>
                </div>

                <!-- Data Ekstra (Disembunyikan untuk Siswa, tampil untuk Guru / Admin) -->
                <div id="row-profile-regdate" class="hidden p-3 rounded-2xl bg-slate-50/80 border border-slate-100 flex flex-col justify-between min-w-0">
                  <span id="profile-reg-label" class="text-[10px] font-bold uppercase tracking-wider text-slate-400">Tgl Daftar</span>
                  <span id="profile-regdate" class="font-bold text-slate-800 text-xs truncate mt-1">15 Juli 2024</span>
                </div>

                <div id="row-profile-birth" class="hidden p-3 rounded-2xl bg-slate-50/80 border border-slate-100 flex flex-col justify-between min-w-0">
                  <span class="text-[10px] font-bold uppercase tracking-wider text-slate-400">Tgl Lahir</span>
                  <span id="profile-birth" class="font-bold text-slate-800 text-xs truncate mt-1">12 Mei 2007</span>
                </div>

                <div id="row-profile-email" class="hidden p-3 rounded-2xl bg-slate-50/80 border border-slate-100 flex flex-col justify-between min-w-0">
                  <span id="profile-email-label" class="text-[10px] font-bold uppercase tracking-wider text-slate-400">Email</span>
                  <span id="profile-email" class="font-bold text-slate-800 text-xs truncate mt-1" title="">-</span>
                </div>

                <div id="row-profile-phone" class="hidden p-3 rounded-2xl bg-slate-50/80 border border-slate-100 flex flex-col justify-between min-w-0">
                  <span id="profile-phone-label" class="text-[10px] font-bold uppercase tracking-wider text-slate-400">Kontak</span>
                  <span id="profile-phone" class="font-bold text-slate-800 font-mono text-xs truncate mt-1">+62 821-7788-9900</span>
                </div>
              </div>

              <!-- Badges Status Profil -->
              <div class="flex items-center gap-2 pt-1 flex-wrap justify-center sm:justify-start">
