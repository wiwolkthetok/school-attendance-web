    function setupIzinSectionListeners() {
      const startEl = document.getElementById(
        "form-izin-start-date",
      ) as HTMLInputElement | null;
      const endEl = document.getElementById(
        "form-izin-end-date",
      ) as HTMLInputElement | null;
      const daysText = document.getElementById("form-izin-days-text");
      const photoInput = document.getElementById(
        "form-izin-photo-input",
      ) as HTMLInputElement | null;
      const previewContainer = document.getElementById(
        "form-izin-preview-container",
      );
      const previewImg = document.getElementById(
        "form-izin-preview-img",
      ) as HTMLImageElement | null;
      const btnRemovePhoto = document.getElementById(
        "btn-remove-photo-preview",
      );
      const btnCancelEdit = document.getElementById("btn-cancel-edit-izin");
      const form = document.getElementById(
        "form-izin-mandiri",
      ) as HTMLFormElement | null;
      const alertEl = document.getElementById("form-izin-alert");

      // --- LOGIKA MULTI-STEP WIZARD PENGAJUAN IZIN ---
      const populateSummary = () => {
        const nameInput = document.getElementById(
          "form-izin-name",
        ) as HTMLInputElement | null;
        const classInput = document.getElementById(
          "form-izin-class",
        ) as HTMLInputElement | null;
        const catEl = document.getElementById(
          "form-izin-category-select",
        ) as HTMLSelectElement | null;
        const reasonEl = document.getElementById(
          "form-izin-reason",
        ) as HTMLTextAreaElement | null;
        const cbRpl = document.getElementById(
          "cb-jurusan-rpl",
        ) as HTMLInputElement | null;
        const cbAkl = document.getElementById(
          "cb-jurusan-akl",
        ) as HTMLInputElement | null;

        const isGuru = currentCivitas?.role === "guru";
        const selectedJurusan: string[] = [];
        if (cbRpl?.checked) selectedJurusan.push("RPL");
        if (cbAkl?.checked) selectedJurusan.push("AKL");
        const jurusanText = isGuru ? "" : selectedJurusan.join(", ");

        const sName = document.getElementById("summary-izin-name");
        const sClass = document.getElementById("summary-izin-class");
        const sBadge = document.getElementById("summary-izin-category-badge");
        const sDates = document.getElementById("summary-izin-dates");
        const sDays = document.getElementById("summary-izin-days");
        const sReason = document.getElementById("summary-izin-reason");
        const sPhotoImg = document.getElementById(
          "summary-izin-photo-img",
        ) as HTMLImageElement | null;
        const sPhotoStatus = document.getElementById(
          "summary-izin-photo-status",
        );

        if (sName)
          sName.textContent = nameInput?.value || currentCivitas?.name || "-";
        if (sClass)
          sClass.textContent = isGuru
            ? classInput?.value || "Dewan Guru"
            : `${classInput?.value || ""}${jurusanText ? ` (${jurusanText})` : ""}`;

        const catVal = catEl?.value || "sakit";
        const catLabels: Record<string, string> = {
          sakit: "Sakit",
          dispensasi: "Dispensasi",
          keluarga: "Urusan Keluarga",
        };
        if (sBadge) {
          sBadge.textContent = catLabels[catVal] || "Izin";
          if (catVal === "sakit")
            sBadge.className =
              "px-2 py-0.5 rounded text-[10px] font-bold bg-amber-100 text-amber-800";
          else if (catVal === "dispensasi")
            sBadge.className =
              "px-2 py-0.5 rounded text-[10px] font-bold bg-purple-100 text-purple-800";
          else
            sBadge.className =
              "px-2 py-0.5 rounded text-[10px] font-bold bg-blue-100 text-blue-800";
        }

        if (sDates)
          sDates.textContent = `${startEl?.value || "-"} s/d ${endEl?.value || "-"}`;
        if (sDays) sDays.textContent = daysText?.textContent || "1 Hari";
        if (sReason)
          sReason.textContent =
            reasonEl?.value.trim() || "(Tidak ada rincian keterangan)";

        if (sPhotoImg && sPhotoStatus) {
          const imgSrc = previewImg?.src || "";
          if (
            imgSrc &&
            !imgSrc.endsWith("#") &&
            imgSrc !== window.location.href
          ) {
            sPhotoImg.src = imgSrc;
            sPhotoImg.classList.remove("hidden");
            sPhotoStatus.textContent = "Bukti Surat Terlampir";
            sPhotoStatus.className = "text-xs text-emerald-600 font-semibold";
          } else {
            sPhotoImg.classList.add("hidden");
            sPhotoStatus.textContent = isGuru
              ? "Keterangan Resmi Guru (Tanpa foto)"
              : "Belum ada foto lampiran";
            sPhotoStatus.className = "text-xs text-slate-400 font-medium";
          }
        }
      };

      const updateWizardStep = (step: number) => {
        const step1 = document.getElementById("izin-step-1");
        const step2 = document.getElementById("izin-step-2");
        const step3 = document.getElementById("izin-step-3");
        const badge = document.getElementById("izin-step-badge");
        const bar = document.getElementById("wizard-progress-bar");

        const circle1 = document.getElementById("step-circle-1");
        const circle2 = document.getElementById("step-circle-2");
        const circle3 = document.getElementById("step-circle-3");
        const text1 = document.getElementById("step-text-1");
        const text2 = document.getElementById("step-text-2");
        const text3 = document.getElementById("step-text-3");

        if (badge) badge.textContent = `Langkah ${step} dari 3`;

        if (step1) step1.classList.toggle("hidden", step !== 1);
        if (step2) step2.classList.toggle("hidden", step !== 2);
        if (step3) step3.classList.toggle("hidden", step !== 3);

        if (bar) {
          if (step === 1) bar.style.width = "0%";
          else if (step === 2) bar.style.width = "50%";
          else bar.style.width = "100%";
        }

        const setNode = (
          circle: HTMLElement | null,
          text: HTMLElement | null,
          state: "active" | "done" | "idle",
          num: number,
        ) => {
          if (!circle || !text) return;
          if (state === "active") {
            circle.className =
              "w-7 h-7 rounded-full flex items-center justify-center text-xs font-bold transition-all bg-blue-600 text-white shadow-xs";
            circle.innerHTML = `${num}`;
            text.className = "text-[10px] font-semibold text-blue-600";
          } else if (state === "done") {
            circle.className =
              "w-7 h-7 rounded-full flex items-center justify-center text-xs font-bold transition-all bg-emerald-600 text-white shadow-xs";
            circle.innerHTML =
              '<span class="material-symbols-outlined text-sm">check</span>';
            text.className = "text-[10px] font-medium text-emerald-700";
          } else {
            circle.className =
              "w-7 h-7 rounded-full flex items-center justify-center text-xs font-bold transition-all bg-slate-100 text-slate-500 border border-slate-200";
            circle.innerHTML = `${num}`;
            text.className = "text-[10px] font-medium text-slate-400";
          }
        };

        if (step === 1) {
          setNode(circle1, text1, "active", 1);
          setNode(circle2, text2, "idle", 2);
          setNode(circle3, text3, "idle", 3);
        } else if (step === 2) {
          setNode(circle1, text1, "done", 1);
          setNode(circle2, text2, "active", 2);
          setNode(circle3, text3, "idle", 3);
        } else if (step === 3) {
          setNode(circle1, text1, "done", 1);
          setNode(circle2, text2, "done", 2);
          setNode(circle3, text3, "active", 3);
          populateSummary();
        }
      };

      setIzinStep = updateWizardStep;

      const validateStep1 = (): boolean => {
        if (alertEl) alertEl.classList.add("hidden");
        const isGuru = currentCivitas?.role === "guru";

        if (!isGuru) {
          const cbRpl = document.getElementById(
            "cb-jurusan-rpl",
          ) as HTMLInputElement | null;
          const cbAkl = document.getElementById(
            "cb-jurusan-akl",
          ) as HTMLInputElement | null;
          if (!cbRpl?.checked && !cbAkl?.checked) {
            if (alertEl) {
              alertEl.textContent =
                "Silahkan centang salah satu jurusan (RPL atau AKL)!";
              alertEl.classList.remove("hidden");
            }
            return false;
          }
        }

        const startVal = startEl?.value;
        const endVal = endEl?.value;
        if (!startVal || !endVal) {
          if (alertEl) {
            alertEl.textContent =
              "Tanggal mulai dan tanggal selesai permohonan izin wajib diisi!";
            alertEl.classList.remove("hidden");
          }
          return false;
        }
        return true;
      };

      const validateStep2 = (): boolean => {
        if (alertEl) alertEl.classList.add("hidden");
        const isGuru = currentCivitas?.role === "guru";
        const reasonVal = (
          document.getElementById(
            "form-izin-reason",
          ) as HTMLTextAreaElement | null
        )?.value.trim();
        if (!reasonVal) {
          if (alertEl) {
            alertEl.textContent =
              "Keterangan atau alasan permohonan izin wajib diisi!";
            alertEl.classList.remove("hidden");
          }
          return false;
        }

        const editIdEl = document.getElementById(
          "form-izin-edit-id",
        ) as HTMLInputElement | null;
        const isEdit = Boolean(editIdEl?.value);
        const photoProof = previewImg?.src || "";

        if (
          !isGuru &&
          !isEdit &&
          (!photoProof ||
            photoProof.trim() === "" ||
            photoProof === window.location.href)
        ) {
          if (alertEl) {
            alertEl.textContent =
              "Siswa wajib mengunggah foto bukti surat dokter atau keterangan!";
            alertEl.classList.remove("hidden");
          }
          return false;
        }
        return true;
      };

      // Step Buttons Click Handlers
      document
        .getElementById("step-indicator-1")
        ?.addEventListener("click", () => {
          if (alertEl) alertEl.classList.add("hidden");
          updateWizardStep(1);
        });

      document
        .getElementById("step-indicator-2")
        ?.addEventListener("click", () => {
          if (validateStep1()) updateWizardStep(2);
        });

      document
        .getElementById("step-indicator-3")
        ?.addEventListener("click", () => {
          if (validateStep1() && validateStep2()) updateWizardStep(3);
        });

      document
        .getElementById("btn-step-1-next")
        ?.addEventListener("click", () => {
          if (validateStep1()) updateWizardStep(2);
        });

      document
        .getElementById("btn-step-2-prev")
        ?.addEventListener("click", () => {
          if (alertEl) alertEl.classList.add("hidden");
          updateWizardStep(1);
        });

      document
        .getElementById("btn-step-2-next")
        ?.addEventListener("click", () => {
          if (validateStep2()) updateWizardStep(3);
        });

      document
        .getElementById("btn-step-3-prev")
        ?.addEventListener("click", () => {
          if (alertEl) alertEl.classList.add("hidden");
          updateWizardStep(2);
        });

      // Kalkulasi selisih hari
      const calcDays = () => {
        if (!startEl || !endEl || !daysText) return;
        const s = startEl.value;
        const e = endEl.value;
        if (!s || !e) return;
        try {
          const d1 = new Date(s).getTime();
          const d2 = new Date(e).getTime();
          const days = Math.max(
            1,
            Math.round((d2 - d1) / (1000 * 60 * 60 * 24)) + 1,
          );
          daysText.textContent = `${days} Hari`;
        } catch {
          daysText.textContent = "1 Hari";
        }
      };

      if (startEl) startEl.addEventListener("change", calcDays);
      if (endEl) endEl.addEventListener("change", calcDays);

      // Helper kompresi gambar berbasis canvas (ultra-ringan ~40-60KB, portrait & landscape)
      function compressImage(
        file: File,
        maxDim = 800,
        quality = 0.65,
      ): Promise<string> {
        return new Promise((resolve) => {
          const reader = new FileReader();
          reader.onload = (e) => {
            const img = new Image();
            img.onload = () => {
              let width = img.width;
              let height = img.height;
              if (width > maxDim || height > maxDim) {
                if (width > height) {
                  height = Math.round((height * maxDim) / width);
                  width = maxDim;
                } else {
                  width = Math.round((width * maxDim) / height);
                  height = maxDim;
                }
              }
              const canvas = document.createElement("canvas");
              canvas.width = width;
              canvas.height = height;
              const ctx = canvas.getContext("2d");
              if (ctx) {
                ctx.drawImage(img, 0, 0, width, height);
                resolve(canvas.toDataURL("image/jpeg", quality));
              } else {
                resolve((e.target?.result as string) || "");
              }
            };
            img.onerror = () => resolve((e.target?.result as string) || "");
            img.src = e.target?.result as string;
          };
          reader.onerror = () => resolve("");
          reader.readAsDataURL(file);
        });
      }

      // Foto Bukti Kompresi Otomatis
      if (photoInput) {
        photoInput.addEventListener("change", async () => {
          const file = photoInput.files?.[0];
          if (!file) return;
          if (previewImg && previewContainer) {
            previewContainer.style.display = "inline-block";
            previewContainer.classList.remove("hidden");
          }
          const compressed = await compressImage(file, 800, 0.65);
          if (previewImg) previewImg.src = compressed;
        });
      }

      if (btnRemovePhoto) {
        btnRemovePhoto.addEventListener("click", () => {
          if (photoInput) photoInput.value = "";
          if (previewImg) previewImg.src = "";
          if (previewContainer) {
            previewContainer.style.display = "none";
            previewContainer.classList.add("hidden");
          }
        });
      }

      if (btnCancelEdit) {
        btnCancelEdit.addEventListener("click", cancelEditPerm);
      }

      // Tombol di Tab History membuka Tab Pengajuan Izin
      const btnOpenHistoryIzin = document.getElementById("btn-open-modal-izin");
      if (btnOpenHistoryIzin) {
        btnOpenHistoryIzin.addEventListener("click", () => {
          const navBtnIzin = document.querySelector(
            '[data-target="sec-izin"]',
          ) as HTMLElement | null;
          if (navBtnIzin) navBtnIzin.click();
        });
      }

      // Submit Form Pengajuan Izin Mandiri (Create & Edit)
      if (form) {
        form.addEventListener("submit", async (e) => {
          e.preventDefault();
          if (!currentCivitas) return;
          const isGuru = currentCivitas.role === "guru";

          const editIdEl = document.getElementById(
            "form-izin-edit-id",
          ) as HTMLInputElement | null;
          const editId = editIdEl?.value || "";

          const catEl = document.getElementById(
            "form-izin-category-select",
          ) as HTMLSelectElement | null;
          const category = catEl?.value || "sakit";
          const catLabels: Record<string, string> = {
            sakit: "Sakit",
            dispensasi: "Dispensasi",
            keluarga: "Urusan Keluarga",
          };
          const categoryLabel = catLabels[category] || "Izin";

          const startDate =
            startEl?.value ||
            new Date().toLocaleDateString("en-CA", {
              timeZone: "Asia/Jakarta",
            });
          const endDate = endEl?.value || startDate;

          let daysCount = 1;
          try {
            const d1 = new Date(startDate).getTime();
            const d2 = new Date(endDate).getTime();
            daysCount = Math.max(
              1,
              Math.round((d2 - d1) / (1000 * 60 * 60 * 24)) + 1,
            );
          } catch {}

          const reasonEl = document.getElementById(
            "form-izin-reason",
          ) as HTMLTextAreaElement | null;
          const title = reasonEl?.value.trim() || "Permohonan Izin";

          // Jurusan Checkbox (Wajib jika Siswa)
          let jurusan = "";
          if (!isGuru) {
            const cbRpl = document.getElementById(
              "cb-jurusan-rpl",
            ) as HTMLInputElement | null;
            const cbAkl = document.getElementById(
              "cb-jurusan-akl",
            ) as HTMLInputElement | null;
            const selectedJurusan: string[] = [];
            if (cbRpl?.checked) selectedJurusan.push("RPL");
            if (cbAkl?.checked) selectedJurusan.push("AKL");
            if (selectedJurusan.length === 0) {
              if (alertEl) {
                alertEl.textContent =
                  "Silahkan centang salah satu jurusan (RPL atau AKL)!";
                alertEl.classList.remove("hidden");
              }
              return;
            }
            jurusan = selectedJurusan.join(", ");
          }

          // Foto Bukti (Wajib untuk Siswa jika izin baru, Guru tidak wajib)
          const photoProof = previewImg?.src || "";
          if (!isGuru && !editId && (!photoProof || photoProof.trim() === "")) {
            if (alertEl) {
              alertEl.textContent =
                "Siswa wajib mengunggah foto bukti surat izin atau keterangan dokter!";
              alertEl.classList.remove("hidden");
            }
            return;
          }

          if (alertEl) alertEl.classList.add("hidden");

          try {
            if (editId) {
              // Mode Edit
              const res = await fetch("/api/permissions", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({
                  action: "edit",
                  id: editId,
                  category,
                  categoryLabel,
                  title,
                  startDate,
                  endDate,
                  daysCount,
                  jurusan,
                  photoProof,
                }),
              });
              if (res.ok) {
                cancelEditPerm();
                await loadData();
                alert(
                  "Permohonan izin berhasil diperbarui! Status tetap Menunggu Persetujuan.",
                );
              } else {
                const errData = await res.json().catch(() => ({}));
                alert(errData.message || "Gagal memperbarui permohonan izin.");
              }
            } else {
              // Mode Tambah Baru
              const res = await fetch("/api/permissions", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({
                  studentId: currentCivitas.id,
                  name: currentCivitas.name,
                  className:
                    currentCivitas.className || (isGuru ? "Dewan Guru" : "XII"),
                  category,
                  categoryLabel,
                  title,
                  startDate,
                  endDate,
                  daysCount,
                  status: "Menunggu",
                  jurusan,
                  photoProof,
                  attachmentNote: isGuru
                    ? "Keterangan Resmi Guru"
                    : photoProof
                      ? "Bukti Foto Surat Dokter Terlampir"
                      : "Keterangan",
                }),
              });
              if (res.ok) {
                cancelEditPerm();
                await loadData();
                alert(
                  `Permohonan izin untuk ${currentCivitas.name} berhasil diajukan!\nStatus: Menunggu Persetujuan.`,
                );
              } else {
                alert("Gagal mengirimkan pengajuan izin.");
              }
            }
          } catch (err) {
            console.error("Error simpan izin:", err);
            alert("Terjadi kesalahan jaringan.");
          }
        });
      }
    }

    // Wiring Navigasi Sidebar Khusus
    function setupSubnav() {
      const navBtns = document.querySelectorAll(".profile-nav-btn");
      const mobileNavBtns = document.querySelectorAll(
        ".profile-mobile-nav-btn",
      );
      const sections = document.querySelectorAll(".profile-section");

      function switchTab(targetId: string) {
        navBtns.forEach((btn) => {
          const b = btn as HTMLElement;
          const isTarget = b.dataset.target === targetId;
          const icon = b.querySelector(
            ".material-symbols-outlined:first-child",
          );
          const chev = b.querySelector(".material-symbols-outlined:last-child");
          if (isTarget) {
            b.className =
              "profile-nav-btn active w-full flex items-center justify-between px-3.5 py-2.5 rounded-lg text-xs font-semibold transition-colors text-left cursor-pointer bg-slate-100 text-slate-900 border border-slate-200/80 shadow-2xs";
            if (icon)
              icon.className =
                "material-symbols-outlined text-[17px] text-blue-600";
            if (chev) {
              chev.className =
                "material-symbols-outlined text-xs text-slate-400";
              (chev as HTMLElement).style.opacity = "1";
            }
          } else {
            b.className =
              "profile-nav-btn w-full flex items-center justify-between px-3.5 py-2.5 rounded-lg text-xs font-medium transition-colors text-left cursor-pointer text-slate-600 hover:text-slate-900 hover:bg-slate-50";
            if (icon)
              icon.className =
                "material-symbols-outlined text-[17px] text-slate-500";
            if (chev) {
              chev.className =
                "material-symbols-outlined text-xs text-slate-400";
              (chev as HTMLElement).style.opacity = "0.6";
            }
          }
        });

        sections.forEach((sec) => {
          if (sec.id === targetId) {
            sec.classList.remove("hidden");
          } else {
            sec.classList.add("hidden");
          }
        });

        mobileNavBtns.forEach((btn) => {
          const b = btn as HTMLElement;
          const isTarget = b.dataset.target === targetId;
          const box = b.querySelector(".bnav-icon-box") as HTMLElement | null;
          const label = b.querySelector(".bnav-label") as HTMLElement | null;
          const icon = box?.querySelector(".material-symbols-outlined") as HTMLElement | null;

          if (isTarget) {
            if (box) {
              box.className =
                "bnav-icon-box w-11 h-7 rounded-full flex items-center justify-center transition-all duration-200 bg-blue-100 text-blue-700 shadow-2xs ease-[cubic-bezier(0.32,0.72,0,1)]";
            }
            if (icon) icon.classList.add("font-bold");
            if (label) {
              label.className =
                "bnav-label text-[9.5px] tracking-tight leading-tight transition-colors duration-200 whitespace-nowrap text-blue-700 font-bold mt-1";
            }
          } else {
            if (box) {
              box.className =
                "bnav-icon-box w-11 h-7 rounded-full flex items-center justify-center transition-all duration-200 text-slate-400 group-hover:text-slate-600 group-hover:bg-slate-100 ease-[cubic-bezier(0.32,0.72,0,1)]";
            }
            if (icon) icon.classList.remove("font-bold");
            if (label) {
              label.className =
                "bnav-label text-[9.5px] tracking-tight leading-tight transition-colors duration-200 whitespace-nowrap text-slate-500 font-medium group-hover:text-slate-700 mt-1";
            }
          }
        });
      }

      navBtns.forEach((btn) => {
        btn.addEventListener("click", () => {
          const targetId = (btn as HTMLElement).dataset.target;
          if (targetId) switchTab(targetId);
        });
      });

      // Bundaran dan tab HANYA berpindah saat tombol diklik (bukan saat digeser/slide)
      const profileTabOrder = [
        "sec-biodata",
        "sec-card",
        "sec-timeline",
        "sec-poin",
        "sec-izin",
      ];
      let profIsSwiping = false;

      mobileNavBtns.forEach((btn) => {
        btn.addEventListener("click", (e) => {
          if (profIsSwiping) {
            e.preventDefault();
            return;
          }
          const targetId = (btn as HTMLElement).dataset.target;
          if (targetId) switchTab(targetId);
        });
      });

      // Swipe responsif pada bottom bar untuk ganti tab profil
      const profileNavEl = document.getElementById("profile-bottom-nav");
      let pTouchStartX = 0;
      let pTouchStartY = 0;
      let pTouchStartTime = 0;

      profileNavEl?.addEventListener(
        "touchstart",
        (e) => {
          pTouchStartX = e.touches[0].clientX;
          pTouchStartY = e.touches[0].clientY;
          pTouchStartTime = Date.now();
          profIsSwiping = false;
        },
        { passive: true },
      );

      profileNavEl?.addEventListener(
        "touchmove",
        (e) => {
          const diffX = Math.abs(e.touches[0].clientX - pTouchStartX);
          const diffY = Math.abs(e.touches[0].clientY - pTouchStartY);
          if (diffX > 8 && diffX > diffY) {
            profIsSwiping = true;
          }
        },
        { passive: true },
      );

      profileNavEl?.addEventListener(
        "touchend",
        (e) => {
          const diffX = pTouchStartX - e.changedTouches[0].clientX;
          const elapsed = Date.now() - pTouchStartTime;
          const isFlick = elapsed < 320 && Math.abs(diffX) > 16;
          const isDrag = Math.abs(diffX) > 28;

          if (isFlick || isDrag) {
            const activeSec = Array.from(sections).find(
              (s) => !s.classList.contains("hidden"),
            );
            const currentId = activeSec ? activeSec.id : "sec-biodata";
            const curIdx = profileTabOrder.indexOf(currentId);
            if (diffX > 0 && curIdx < profileTabOrder.length - 1) {
              switchTab(profileTabOrder[curIdx + 1]);
            } else if (diffX < 0 && curIdx > 0) {
              switchTab(profileTabOrder[curIdx - 1]);
            }
          }
          setTimeout(() => {
            profIsSwiping = false;
          }, 80);
        },
        { passive: true },
      );

      // Role check untuk tombol mobile profil & sidebar (Opsi 2: Admin, Kepsek, Waka = Menu, lainnya = Keluar)
      const authRole = localStorage.getItem("auth_role");
      let authCivitasObj: any = null;
      try {
        const raw = localStorage.getItem("auth_civitas");
        if (raw) authCivitasObj = JSON.parse(raw);
      } catch {}
      const isKepsekOrWaka =
        authCivitasObj &&
        (authCivitasObj.tag === "kepsek" || authCivitasObj.tag === "waka");
      const canAccessDashboard = authRole === "admin" || isKepsekOrWaka;

      const sidebarBackToMenu = document.getElementById("sidebar-back-to-menu");
      if (sidebarBackToMenu) {
        if (canAccessDashboard) {
          sidebarBackToMenu.classList.remove("hidden");
        } else {
          sidebarBackToMenu.classList.add("hidden");
        }
      }

      const mobileBackLink = document.getElementById(
        "profile-mobile-back-link",
      );
      const mobileLogoutBtn = document.getElementById(
        "profile-mobile-logout-btn",
      );
      if (canAccessDashboard) {
        if (mobileBackLink) {
          mobileBackLink.classList.remove("hidden");
          mobileBackLink.style.display = "";
        }
        if (mobileLogoutBtn) {
          mobileLogoutBtn.classList.add("hidden");
          mobileLogoutBtn.classList.remove("flex");
          mobileLogoutBtn.style.display = "none";
        }
      } else {
        if (mobileBackLink) {
          mobileBackLink.classList.add("hidden");
          mobileBackLink.style.display = "none";
        }
        if (mobileLogoutBtn) {
          mobileLogoutBtn.classList.remove("hidden");
          mobileLogoutBtn.classList.add("flex");
          mobileLogoutBtn.style.display = "";
        }
      }
      if (mobileLogoutBtn) {
        mobileLogoutBtn.onclick = () => {
          if (typeof (window as any).performLogout === "function") {
            (window as any).performLogout();
          } else {
            localStorage.removeItem("auth_civitas");
            localStorage.removeItem("auth_role");
            sessionStorage.removeItem("auth_active");
            sessionStorage.removeItem("bypass_login");
            document.cookie =
              "auth_session=; Path=/; Max-Age=0; Expires=Thu, 01 Jan 1970 00:00:00 GMT; SameSite=Lax";
            window.location.replace("/login");
          }
        };
      }

      // Buka tab berdasarkan hash atau query jika ada
      const urlParams = new URLSearchParams(window.location.search);
      const tabParam =
        urlParams.get("tab") || window.location.hash.replace("#", "");
      if (tabParam) {
        const fullId = tabParam.startsWith("sec-")
          ? tabParam
          : `sec-${tabParam}`;
        switchTab(fullId);
      }
    }

    // 0ms Cache First: Render profil dari cache lokal saat halaman dimuat
    function loadCachedProfile() {
      try {
        const cached = localStorage.getItem("civitas_data_cache");
        if (cached) {
          const parsed = JSON.parse(cached);
          if (Array.isArray(parsed.students) && parsed.students.length > 0) {
            allCivitas = parsed.students;
            allLogs = parsed.logs || [];
            allPermissions = parsed.permissions || [];
            const urlParams = new URLSearchParams(window.location.search);
            let targetId = urlParams.get("id");
            authRole = localStorage.getItem("auth_role") || "";
            const authCivitasRaw = localStorage.getItem("auth_civitas");
            authCivitas = null;
            try {
              if (authCivitasRaw) authCivitas = JSON.parse(authCivitasRaw);
            } catch {}
            if (
              (authRole === "siswa" || authRole === "guru") &&
              authCivitas?.id
            ) {
              targetId = authCivitas.id;
            }
            if (targetId)
              currentCivitas = allCivitas.find(
                (c: any) => c.id === targetId || c.rfidUid === targetId,
              );
            if (!currentCivitas && authCivitas) currentCivitas = authCivitas;
            if (!currentCivitas && allCivitas.length > 0)
              currentCivitas = allCivitas[0];
            if (currentCivitas) renderProfile();
          }
        }
      } catch (e) {}
    }

    // Dengarkan event push realtime
    window.addEventListener("attendance-updated", loadData);
    setupSubnav();
    setupIzinSectionListeners();
    setupGuruFilterTabs();
    loadCachedProfile();
    loadData();
  </script>
</Layout>
