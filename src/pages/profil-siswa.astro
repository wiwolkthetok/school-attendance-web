        ? "Tersimpan di Database"
        : rawUid.length === 9
          ? rawUid.match(/.{1,3}/g)?.join(" ")
          : rawUid.match(/.{1,4}/g)?.join(" ") || rawUid || "-";

      if (detailNameEl) detailNameEl.textContent = currentCivitas.name;

      if (idLabelEl) idLabelEl.textContent = "ID RFID:";
      if (customIdEl) customIdEl.textContent = formattedUid;

