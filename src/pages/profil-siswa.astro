      if (nisnEl)
        nisnEl.textContent =
          currentCivitas.identifier ||
          (isAdmin
            ? "199001012023011001"
            : isGuru
              ? "198403152009021003"
              : "0068472911");

      if (cityLabelEl) cityLabelEl.textContent = "Alamat:";
      if (cityEl)
