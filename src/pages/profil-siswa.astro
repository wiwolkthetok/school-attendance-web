        <!-- Alert Jika Tidak Ada Foto Bukti -->
        <div id="guru-detail-no-photo" class="hidden p-4 rounded-2xl bg-slate-50 border border-slate-200 text-xs text-slate-600 text-center">
          <span class="material-symbols-outlined text-2xl text-slate-400 mb-1">no_photography</span>
          <p class="font-bold text-slate-700">Tidak ada foto bukti terlampir</p>
          <p class="text-[11px] text-slate-500 mt-0.5">Permohonan diajukan melalui teks keterangan tanpa lampiran foto kamera.</p>
        </div>
      </div>

      <!-- Keterangan Verifikator Resmi jika sudah disetujui / ditolak -->
      <div id="guru-detail-approver-box" class="hidden p-3 rounded-2xl border text-xs">
        <!-- Dynamic content -->
      </div>

      <!-- Action Footer (Setujui / Tolak oleh Guru) -->
      <div class="flex items-center justify-between pt-3 border-t border-slate-100 flex-wrap gap-2">
        <button type="button" id="btn-close-guru-detail-footer" class="px-4 py-2.5 text-xs font-semibold text-slate-600 hover:bg-slate-100 rounded-xl transition-all cursor-pointer">
          Tutup
        </button>
        <div id="guru-detail-action-buttons-group" class="flex items-center gap-2">
          <!-- Dynamic Approve/Reject buttons -->
        </div>
      </div>
