      );

      const todayStr = new Date().toLocaleDateString('en-CA', { timeZone: 'Asia/Jakarta' });
      const activeApprovedPerm = civitasPerms.find((p: any) =>
        p.status === 'Disetujui' && todayStr >= p.startDate && todayStr <= (p.endDate || p.startDate)
