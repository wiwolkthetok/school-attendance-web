          badgeRoleText.textContent = "Administrator";
        } else if (isGuru) {
          badgeRoleTag.className =
            "inline-flex items-center gap-1 px-2.5 py-1.5 rounded-xl bg-amber-50 text-amber-800 font-bold text-[11px] border border-amber-200/80";
          badgeRoleText.textContent = "Guru Kejuruan";
        } else {
          badgeRoleTag.className = isAlumni
            ? "inline-flex items-center gap-1 px-2.5 py-1.5 rounded-xl bg-slate-100 text-slate-700 font-bold text-[11px] border border-slate-200"
            : "inline-flex items-center gap-1 px-2.5 py-1.5 rounded-xl bg-blue-50 text-blue-700 font-bold text-[11px] border border-blue-200/60";
