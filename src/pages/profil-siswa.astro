  <script>
    let allCivitas: any[] = [];
    let allLogs: any[] = [];
    let allPermissions: any[] = [];
    let currentCivitas: any = null;
    let authRole = '';
    let authCivitas: any = null;

    async function loadData() {
      try {
        const [civRes, logsRes, permRes, schRes] = await Promise.all([
          fetch('/api/students'),
          fetch('/api/attendance'),
          fetch('/api/permissions'),
          fetch('/api/schedules'),
        ]);

        if (civRes.ok) allCivitas = await civRes.json();
        if (logsRes.ok) allLogs = await logsRes.json();
        if (permRes.ok) allPermissions = await permRes.json();
        let allSchedules: any[] = [];
        if (schRes.ok) allSchedules = await schRes.json();

        // Target ID dari URL (?id=GUR-001 atau ?id=STD-001)
        const urlParams = new URLSearchParams(window.location.search);
        let targetId = urlParams.get('id');

        authRole = localStorage.getItem('auth_role') || '';
        const authCivitasRaw = localStorage.getItem('auth_civitas');
        authCivitas = null;
        try { if (authCivitasRaw) authCivitas = JSON.parse(authCivitasRaw); } catch {}

        const isKepsekOrWaka = authCivitas && (authCivitas.tag === 'kepsek' || authCivitas.tag === 'waka');
        const canAccessDashboard = authRole === 'admin' || isKepsekOrWaka;

        // OPSI 2: HANYA ADMIN, KEPSEK, DAN WAKA YANG DAPAT MENGAKSES MENU DASHBOARD
        if (!canAccessDashboard) {
          if (authCivitas?.id) targetId = authCivitas.id;
          document.getElementById('sidebar-back-to-menu')?.classList.add('hidden');
          document.getElementById('top-civitas-switcher-bar')?.classList.add('hidden');
        } else {
          document.getElementById('sidebar-back-to-menu')?.classList.remove('hidden');
          if (authRole === 'admin' && !authCivitas) {
            document.getElementById('top-civitas-switcher-bar')?.classList.remove('hidden');
          } else {
            document.getElementById('top-civitas-switcher-bar')?.classList.add('hidden');
          }
        }

        if (targetId) {
          currentCivitas = allCivitas.find((c: any) => c.id === targetId || c.rfidUid === targetId);
        }
        if (!currentCivitas && authCivitas) {
          currentCivitas = authCivitas;
        }
        if (!currentCivitas && allCivitas.length > 0) {
          currentCivitas = allCivitas[0];
        }

        renderSwitcher();
        renderProfile();
        renderAgendas(allSchedules);
      } catch (err) {
        console.error('Gagal memuat profil civitas:', err);
      }
    }

    function renderAgendas(allSchedules: any[]) {
      const container = document.getElementById('profil-agenda-list');
      const badge = document.getElementById('profil-agenda-count-badge');
      if (!container) return;

      const isSiswaViewer = (authRole === 'siswa' || currentCivitas?.role === 'siswa' || (!authRole && currentCivitas?.type === 'siswa'));
      const manageBtn = document.getElementById('btn-manage-agenda-link');
      if (manageBtn) {
        if (isSiswaViewer) {
          manageBtn.classList.add('hidden');
          manageBtn.classList.remove('inline-flex');
        } else {
          manageBtn.classList.remove('hidden');
          manageBtn.classList.add('inline-flex');
        }
      }

      const now = new Date();
      const todayStr = now.toLocaleDateString('en-CA', { timeZone: 'Asia/Jakarta' });
      const todayDate = new Date(todayStr + 'T00:00:00');
      
      // Siswa hanya boleh melihat agenda publik yang sudah masuk rentang notifikasi (H-x)
      const visibleList = allSchedules.filter((s: any) => {
        if (isSiswaViewer) {
          if (s.visibility === 'guru') return false;
          const leadDays = Number(s.notifyLeadDays ?? 0);
          if (leadDays > 0) {
            const startStr = s.startDate || s.date || '';
            if (startStr) {
              const startDate = new Date(startStr + 'T00:00:00');
              const diffDays = Math.ceil((startDate.getTime() - todayDate.getTime()) / (1000 * 60 * 60 * 24));
              if (diffDays > leadDays) return false;
            }
          }
        }
        return true;
      });

      // Pisahkan agenda aktif dan agenda yang sudah selesai di bulan ini
      const activeList: any[] = [];
      const pastList: any[] = [];

      visibleList.forEach((s: any) => {
        const end = s.endDate || s.startDate || s.date || '';
        if (end && end < todayStr) {
          pastList.push(s);
        } else {
          activeList.push(s);
        }
      });

      // Urutkan agenda aktif dari tanggal terdekat, lalu jam mulai
      activeList.sort((a: any, b: any) => {
        const dateA = a.startDate || a.date || '';
        const dateB = b.startDate || b.date || '';
        const comp = dateA.localeCompare(dateB);
        if (comp !== 0) return comp;
        return (a.timeStart || '').localeCompare(b.timeStart || '');
      });

      // Urutkan agenda selesai dari yang paling baru selesai
      pastList.sort((a: any, b: any) => {
        const dateA = a.endDate || a.startDate || a.date || '';
        const dateB = b.endDate || b.startDate || b.date || '';
        const comp = dateB.localeCompare(dateA);
        if (comp !== 0) return comp;
        return (b.timeStart || '').localeCompare(a.timeStart || '');
      });

      const totalCount = activeList.length + pastList.length;
      if (badge) {
        badge.textContent = activeList.length > 0 ? `${activeList.length} Aktif` : `${totalCount} Agenda`;
      }

      if (totalCount === 0) {
        container.innerHTML = `
          <div class="py-6 text-center text-slate-300 font-medium text-xs">
            <span class="material-symbols-outlined text-xl block mb-1 opacity-60">event_available</span>
            <span>Tidak ada agenda kegiatan terdekat</span>
          </div>
        `;
        return;
      }

      const renderCard = (item: any, isPast: boolean) => {
        let catBg = 'bg-teal-50 text-teal-800 border-teal-200/60';
        let catName = 'KBM';
        if (item.category === 'rapat') { catBg = 'bg-rose-50 text-rose-800 border-rose-200/60'; catName = 'Rapat'; }
        else if (item.category === 'lsp') { catBg = 'bg-purple-50 text-purple-800 border-purple-200/60'; catName = 'UKK'; }
        else if (item.category === 'khusus') { catBg = 'bg-amber-50 text-amber-800 border-amber-200/60'; catName = 'Khusus'; }

        const isMultiDay = item.startDate && item.endDate && item.startDate !== item.endDate;
        const dateDisplay = isMultiDay ? `${item.startDate} s/d ${item.endDate}` : (item.date || item.startDate || item.day);
        const isGuruVis = item.visibility === 'guru';

        let countdownBadge = '';
        if (isPast) {
          countdownBadge = '<span class="text-[9px] font-bold px-1.5 py-0.5 rounded-md bg-slate-100 text-slate-500 border border-slate-200">Selesai</span>';
        } else {
          const startStr = item.startDate || item.date || '';
          const endStr = item.endDate || startStr;
          if (startStr) {
            const startDate = new Date(startStr + 'T00:00:00');
            const endDate = new Date((endStr || startStr) + 'T00:00:00');
            const diffStart = Math.ceil((startDate.getTime() - todayDate.getTime()) / (1000 * 60 * 60 * 24));
            const diffEnd = Math.ceil((endDate.getTime() - todayDate.getTime()) / (1000 * 60 * 60 * 24));

            if (diffStart <= 0 && diffEnd >= 0) {
              const label = isMultiDay ? 'Berlangsung' : 'Hari Ini';
              countdownBadge = `<span class="text-[9px] font-black px-1.5 py-0.5 rounded-md bg-emerald-100 text-emerald-800 border border-emerald-200">${label}</span>`;
            } else if (diffStart === 1) {
              countdownBadge = '<span class="text-[9px] font-bold px-1.5 py-0.5 rounded-md bg-blue-100 text-blue-800 border border-blue-200">Besok</span>';
            } else if (diffStart > 1) {
              countdownBadge = `<span class="text-[9px] font-bold px-1.5 py-0.5 rounded-md bg-indigo-50 text-indigo-700 border border-indigo-200">H-${diffStart}</span>`;
            }
          }
        }

        const leadDays = Number(item.notifyLeadDays ?? 0);
        const leadNotice = (!isSiswaViewer && !isGuruVis && leadDays > 0)
          ? `<span class="text-[9px] font-medium px-1.5 py-0.5 rounded-md bg-slate-100 text-slate-600 border border-slate-200/60">H-${leadDays} Siswa</span>`
          : '';

        const cardClass = isPast
          ? 'p-3.5 rounded-2xl bg-slate-50/50 border border-slate-200/60 opacity-75 hover:opacity-100 hover:bg-white hover:border-slate-300 transition-all space-y-1.5'
          : 'p-3.5 rounded-2xl bg-slate-50/80 border border-slate-200/70 hover:bg-white hover:border-slate-300 hover:shadow-xs transition-all space-y-1.5';

        const titleClass = isPast
          ? 'text-xs font-semibold text-slate-600 leading-snug'
          : 'text-xs font-bold text-slate-900 leading-snug';

        return `
          <div class="${cardClass}">
            <div class="flex items-center justify-between gap-2 flex-wrap">
              <div class="flex items-center gap-1.5">
                <span class="text-[9px] font-bold px-2 py-0.5 rounded-md border ${catBg}">
                  ${catName}
                </span>
                ${countdownBadge}
                ${!isSiswaViewer ? (isGuruVis
                  ? '<span class="text-[9px] font-bold px-1.5 py-0.5 rounded-md bg-amber-100 text-amber-900 border border-amber-200/60 flex items-center gap-0.5"><span class="material-symbols-outlined text-[10px]">lock</span>Khusus Guru</span>'
                  : '<span class="text-[9px] font-bold px-1.5 py-0.5 rounded-md bg-blue-50 text-blue-800 border border-blue-200/60">Publik</span>') : ''}
                ${leadNotice}
                ${isMultiDay ? '<span class="text-[9px] font-bold px-1.5 py-0.5 rounded-md bg-purple-50 text-purple-800 border border-purple-200/60">Multi Hari</span>' : ''}
              </div>
              <span class="text-[11px] font-mono font-bold text-slate-500">
                ${item.timeStart} - ${item.timeEnd} WIB
              </span>
            </div>
            <h4 class="${titleClass}">
              ${item.title}
            </h4>
            <div class="text-[11px] text-slate-500 flex items-center gap-2 pt-0.5">
              <span class="font-medium">📅 ${dateDisplay}</span>
              <span class="text-slate-300">•</span>
              <span class="truncate">📍 ${item.room || 'SMK'}</span>
              <span class="text-slate-300">•</span>
              <span class="font-bold text-slate-700 truncate">${item.classTarget || 'Semua'}</span>
            </div>
          </div>
        `;
      };

      let html = activeList.map((item) => renderCard(item, false)).join('');

      if (pastList.length > 0) {
        if (activeList.length > 0) {
          html += `
            <div class="pt-2 pb-1 flex items-center gap-2 text-[10px] font-bold text-slate-400">
              <div class="h-px bg-slate-200/70 flex-1"></div>
              <span>Agenda Selesai</span>
              <div class="h-px bg-slate-200/70 flex-1"></div>
            </div>
          `;
        }
        html += pastList.map((item) => renderCard(item, true)).join('');
      }

      container.innerHTML = html;
    }

    function renderSwitcher() {
      const topBar = document.getElementById('top-civitas-switcher-bar');
      const container = document.getElementById('civitas-switcher-container');

      // Khusus Guru & Siswa: Sembunyikan top bar switcher civitas sepenuhnya (hanya buka profil pribadi)
      if (authRole === 'siswa' || authRole === 'guru') {
        if (topBar) topBar.classList.add('hidden');
        return;
      }

      // Jika bukan admin, pastikan top bar tersembunyi
      if (authRole !== 'admin') {
        if (topBar) topBar.classList.add('hidden');
        return;
      }

      // Khusus Administrator: Tampilkan switcher civitas untuk meninjau data civitas
      if (topBar) topBar.classList.remove('hidden');
      if (!container) return;

      // 2. Mode Guru atau Umum (Tampilkan Switcher Civitas + Tombol Login/Logout)
      let buttonsHtml = allCivitas.map((c) => {
        const isCurrent = currentCivitas && (currentCivitas.id === c.id);
        const isGuru = c.role === 'guru';
        const isAdmin = c.role === 'admin';

        let btnClass = 'bg-slate-100 text-slate-700 hover:bg-slate-200 font-medium';
        if (isCurrent) {
          btnClass = isAdmin
            ? 'bg-purple-600 text-white font-bold shadow-md shadow-purple-500/20'
            : (isGuru
              ? 'bg-amber-600 text-white font-bold shadow-md shadow-amber-500/20'
              : 'bg-blue-600 text-white font-bold shadow-md shadow-blue-500/20');
        }

        const tagText = isAdmin ? 'Admin' : (isGuru ? 'Guru' : (c.className || 'Siswa'));
        return `
          <button
            type="button"
            data-id="${c.id}"
            class="btn-switch-civitas px-3 py-1.5 rounded-xl text-xs transition duration-200 whitespace-nowrap cursor-pointer ${btnClass}"
          >
            ${c.name.split(' ')[0]} (${tagText})
          </button>
        `;
      }).join('');

      container.innerHTML = buttonsHtml;

      container.querySelectorAll('.btn-switch-civitas').forEach((btn) => {
        btn.addEventListener('click', () => {
          const cid = (btn as HTMLElement).dataset.id;
          const found = allCivitas.find((c) => c.id === cid);
          if (found) {
            currentCivitas = found;
            const newUrl = new URL(window.location.href);
            newUrl.searchParams.set('id', found.id);
            window.history.replaceState({}, '', newUrl.toString());

            renderSwitcher();
            renderProfile();
          }
        });
      });
    }

    function renderProfile() {
      if (!currentCivitas) return;

      const isGuru = currentCivitas.role === 'guru';
      const isAdmin = currentCivitas.role === 'admin';
      const isStaff = isGuru || isAdmin;
      const isAlumni = (currentCivitas.className && (currentCivitas.className.toLowerCase().includes('alumni') || currentCivitas.className.toLowerCase().includes('lulus'))) || currentCivitas.category === 'alumni';
      const authRole = localStorage.getItem('auth_role');
      const isSiswaLoggedIn = authRole === 'siswa';
      const isStaffLoggedIn = authRole === 'guru' || authRole === 'admin';

