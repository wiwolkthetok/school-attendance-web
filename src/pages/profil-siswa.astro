    function setupIzinSectionListeners() {
      const startEl = document.getElementById('form-izin-start-date') as HTMLInputElement | null;
      const endEl = document.getElementById('form-izin-end-date') as HTMLInputElement | null;
      const daysText = document.getElementById('form-izin-days-text');
      const photoInput = document.getElementById('form-izin-photo-input') as HTMLInputElement | null;
      const previewContainer = document.getElementById('form-izin-preview-container');
      const previewImg = document.getElementById('form-izin-preview-img') as HTMLImageElement | null;
      const btnRemovePhoto = document.getElementById('btn-remove-photo-preview');
      const btnCancelEdit = document.getElementById('btn-cancel-edit-izin');
      const form = document.getElementById('form-izin-mandiri') as HTMLFormElement | null;
      const alertEl = document.getElementById('form-izin-alert');

      // Kalkulasi selisih hari
      const calcDays = () => {
        if (!startEl || !endEl || !daysText) return;
        const s = startEl.value;
        const e = endEl.value;
        if (!s || !e) return;
        try {
          const d1 = new Date(s).getTime();
          const d2 = new Date(e).getTime();
          const days = Math.max(1, Math.round((d2 - d1) / (1000 * 60 * 60 * 24)) + 1);
          daysText.textContent = `${days} Hari`;
        } catch {
          daysText.textContent = '1 Hari';
        }
      };

      if (startEl) startEl.addEventListener('change', calcDays);
      if (endEl) endEl.addEventListener('change', calcDays);

      // Helper kompresi gambar berbasis canvas (ultra-ringan ~40-60KB, portrait & landscape)
      function compressImage(file: File, maxDim = 800, quality = 0.65): Promise<string> {
        return new Promise((resolve) => {
          const reader = new FileReader();
          reader.onload = (e) => {
            const img = new Image();
            img.onload = () => {
              let width = img.width;
              let height = img.height;
              if (width > maxDim || height > maxDim) {
                if (width > height) {
                  height = Math.round((height * maxDim) / width);
                  width = maxDim;
                } else {
                  width = Math.round((width * maxDim) / height);
                  height = maxDim;
                }
              }
              const canvas = document.createElement('canvas');
              canvas.width = width;
              canvas.height = height;
              const ctx = canvas.getContext('2d');
              if (ctx) {
                ctx.drawImage(img, 0, 0, width, height);
                resolve(canvas.toDataURL('image/jpeg', quality));
              } else {
                resolve((e.target?.result as string) || '');
              }
            };
            img.onerror = () => resolve((e.target?.result as string) || '');
            img.src = e.target?.result as string;
          };
          reader.onerror = () => resolve('');
          reader.readAsDataURL(file);
        });
      }

      // Foto Bukti Kompresi Otomatis
      if (photoInput) {
        photoInput.addEventListener('change', async () => {
          const file = photoInput.files?.[0];
          if (!file) return;
          if (previewImg && previewContainer) {
            previewContainer.style.display = 'inline-block';
            previewContainer.classList.remove('hidden');
          }
          const compressed = await compressImage(file, 800, 0.65);
          if (previewImg) previewImg.src = compressed;
        });
      }

      if (btnRemovePhoto) {
        btnRemovePhoto.addEventListener('click', () => {
          if (photoInput) photoInput.value = '';
          if (previewImg) previewImg.src = '';
          if (previewContainer) {
            previewContainer.style.display = 'none';
            previewContainer.classList.add('hidden');
          }
        });
      }

      if (btnCancelEdit) {
        btnCancelEdit.addEventListener('click', cancelEditPerm);
      }

      // Tombol di Tab History membuka Tab Pengajuan Izin
      const btnOpenHistoryIzin = document.getElementById('btn-open-modal-izin');
      if (btnOpenHistoryIzin) {
        btnOpenHistoryIzin.addEventListener('click', () => {
          const navBtnIzin = document.querySelector('[data-target="sec-izin"]') as HTMLElement | null;
          if (navBtnIzin) navBtnIzin.click();
        });
      }

      // Submit Form Pengajuan Izin Mandiri (Create & Edit)
      if (form) {
        form.addEventListener('submit', async (e) => {
          e.preventDefault();
          if (!currentCivitas) return;
          const isGuru = currentCivitas.role === 'guru';

          const editIdEl = document.getElementById('form-izin-edit-id') as HTMLInputElement | null;
          const editId = editIdEl?.value || '';

          const catEl = document.getElementById('form-izin-category-select') as HTMLSelectElement | null;
          const category = catEl?.value || 'sakit';
          const catLabels: Record<string, string> = {
            sakit: 'Sakit',
            dispensasi: 'Dispensasi',
            keluarga: 'Urusan Keluarga',
          };
          const categoryLabel = catLabels[category] || 'Izin';

          const startDate = startEl?.value || new Date().toLocaleDateString('en-CA', { timeZone: 'Asia/Jakarta' });
          const endDate = endEl?.value || startDate;

          let daysCount = 1;
          try {
            const d1 = new Date(startDate).getTime();
            const d2 = new Date(endDate).getTime();
            daysCount = Math.max(1, Math.round((d2 - d1) / (1000 * 60 * 60 * 24)) + 1);
          } catch {}

          const reasonEl = document.getElementById('form-izin-reason') as HTMLTextAreaElement | null;
          const title = reasonEl?.value.trim() || 'Permohonan Izin';

          // Jurusan Checkbox (Wajib jika Siswa)
          let jurusan = '';
          if (!isGuru) {
            const cbRpl = document.getElementById('cb-jurusan-rpl') as HTMLInputElement | null;
            const cbAkl = document.getElementById('cb-jurusan-akl') as HTMLInputElement | null;
            const selectedJurusan: string[] = [];
            if (cbRpl?.checked) selectedJurusan.push('RPL');
            if (cbAkl?.checked) selectedJurusan.push('AKL');
            if (selectedJurusan.length === 0) {
              if (alertEl) {
                alertEl.textContent = 'Silahkan centang salah satu jurusan (RPL atau AKL)!';
                alertEl.classList.remove('hidden');
              }
              return;
            }
            jurusan = selectedJurusan.join(', ');
          }

          // Foto Bukti (Wajib untuk Siswa jika izin baru, Guru tidak wajib)
          const photoProof = previewImg?.src || '';
          if (!isGuru && !editId && (!photoProof || photoProof.trim() === '')) {
            if (alertEl) {
              alertEl.textContent = 'Siswa wajib mengunggah foto bukti surat izin atau keterangan dokter!';
              alertEl.classList.remove('hidden');
            }
            return;
          }

          if (alertEl) alertEl.classList.add('hidden');

          try {
            if (editId) {
              // Mode Edit
              const res = await fetch('/api/permissions', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                  action: 'edit',
                  id: editId,
                  category,
                  categoryLabel,
                  title,
                  startDate,
                  endDate,
                  daysCount,
                  jurusan,
                  photoProof,
                }),
              });
              if (res.ok) {
                cancelEditPerm();
                await loadData();
                alert('Permohonan izin berhasil diperbarui! Status tetap Menunggu Persetujuan.');
              } else {
                const errData = await res.json().catch(() => ({}));
                alert(errData.message || 'Gagal memperbarui permohonan izin.');
              }
            } else {
              // Mode Tambah Baru
              const res = await fetch('/api/permissions', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                  studentId: currentCivitas.id,
                  name: currentCivitas.name,
                  className: currentCivitas.className || (isGuru ? 'Dewan Guru' : 'XII'),
                  category,
                  categoryLabel,
                  title,
                  startDate,
                  endDate,
                  daysCount,
                  status: 'Menunggu',
                  jurusan,
                  photoProof,
                  attachmentNote: isGuru ? 'Keterangan Resmi Guru' : (photoProof ? 'Bukti Foto Surat Dokter Terlampir' : 'Keterangan'),
                }),
              });
              if (res.ok) {
                cancelEditPerm();
                await loadData();
                alert(`Permohonan izin untuk ${currentCivitas.name} berhasil diajukan!\nStatus: Menunggu Persetujuan.`);
              } else {
                alert('Gagal mengirimkan pengajuan izin.');
              }
            }
          } catch (err) {
            console.error('Error simpan izin:', err);
            alert('Terjadi kesalahan jaringan.');
          }
        });
      }
    }

    // Wiring Navigasi Sidebar Khusus
    function setupSubnav() {
      const navBtns = document.querySelectorAll('.profile-nav-btn');
      const mobileNavBtns = document.querySelectorAll('.profile-mobile-nav-btn');
      const sections = document.querySelectorAll('.profile-section');

      function switchTab(targetId: string) {
        navBtns.forEach((b) => {
          const isTarget = (b as HTMLElement).dataset.target === targetId;
          if (isTarget) {
            b.classList.add('bg-white', 'text-blue-900', 'font-bold', 'shadow-lg', 'shadow-blue-950/25', 'border-l-4', 'border-indigo-700', 'translate-x-1');
            b.classList.remove('text-blue-100/80', 'hover:text-white', 'hover:bg-white/15', 'hover:translate-x-0.5');
            const activeChev = b.querySelector('.material-symbols-outlined:last-child');
            if (activeChev) (activeChev as HTMLElement).style.opacity = '1';
          } else {
            b.classList.remove('bg-white', 'text-blue-900', 'font-bold', 'shadow-lg', 'shadow-blue-950/25', 'border-l-4', 'border-indigo-700', 'translate-x-1');
            b.classList.add('text-blue-100/80', 'hover:text-white', 'hover:bg-white/15', 'hover:translate-x-0.5');
            const chev = b.querySelector('.material-symbols-outlined:last-child');
            if (chev) (chev as HTMLElement).style.opacity = '0.6';
          }
        });

        sections.forEach((sec) => {
          if (sec.id === targetId) {
            sec.classList.remove('hidden');
          } else {
            sec.classList.add('hidden');
          }
        });

        const profilePill = document.getElementById('profile-sliding-pill');
        const targetBtn = Array.from(mobileNavBtns).find(
          (b) => (b as HTMLElement).dataset.target === targetId
        ) as HTMLElement | undefined;
        if (targetBtn && profilePill) {
          const idx = parseInt(targetBtn.dataset.index || '0', 10);
          profilePill.style.left = `calc(${idx * (100 / 6) + (100 / 12)}% - 18px)`;
        }

        mobileNavBtns.forEach((btn) => {
          const b = btn as HTMLElement;
          const isTarget = b.dataset.target === targetId;
          const box = b.querySelector('.bnav-icon-box') as HTMLElement | null;
          const label = b.querySelector('.bnav-label') as HTMLElement | null;

          if (isTarget) {
            if (box) {
              box.className = 'bnav-icon-box w-9 h-9 rounded-2xl flex items-center justify-center transition-all duration-300 ease-out text-white -translate-y-1.5';
            }
            if (label) {
              label.className = 'bnav-label text-[10px] tracking-tight leading-tight transition-all duration-200 whitespace-nowrap text-blue-600 font-bold -translate-y-0.5';
            }
          } else {
            if (box) {
              box.className = 'bnav-icon-box w-9 h-9 rounded-2xl flex items-center justify-center transition-all duration-300 ease-out text-slate-400 group-hover:text-slate-700 translate-y-0';
            }
            if (label) {
              label.className = 'bnav-label text-[10px] tracking-tight leading-tight transition-all duration-200 whitespace-nowrap text-slate-400 font-medium translate-y-0';
            }
          }
        });
      }

      navBtns.forEach((btn) => {
        btn.addEventListener('click', () => {
          const targetId = (btn as HTMLElement).dataset.target;
          if (targetId) switchTab(targetId);
        });
      });

      // Bundaran dan tab HANYA berpindah saat tombol diklik (bukan saat digeser/slide)
      const profileTabOrder = ['sec-biodata', 'sec-card', 'sec-timeline', 'sec-poin', 'sec-izin'];
      let profIsSwiping = false;

      mobileNavBtns.forEach((btn) => {
        btn.addEventListener('click', (e) => {
          if (profIsSwiping) {
            e.preventDefault();
            return;
          }
          const targetId = (btn as HTMLElement).dataset.target;
          if (targetId) switchTab(targetId);
        });
      });

      // Swipe responsif pada bottom bar untuk ganti tab profil
      const profileNavEl = document.getElementById('profile-bottom-nav');
      let pTouchStartX = 0;
      let pTouchStartY = 0;
      let pTouchStartTime = 0;

      profileNavEl?.addEventListener('touchstart', (e) => {
        pTouchStartX = e.touches[0].clientX;
        pTouchStartY = e.touches[0].clientY;
        pTouchStartTime = Date.now();
        profIsSwiping = false;
      }, { passive: true });

      profileNavEl?.addEventListener('touchmove', (e) => {
        const diffX = Math.abs(e.touches[0].clientX - pTouchStartX);
        const diffY = Math.abs(e.touches[0].clientY - pTouchStartY);
        if (diffX > 8 && diffX > diffY) {
          profIsSwiping = true;
        }
      }, { passive: true });

      profileNavEl?.addEventListener('touchend', (e) => {
        const diffX = pTouchStartX - e.changedTouches[0].clientX;
        const elapsed = Date.now() - pTouchStartTime;
        const isFlick = elapsed < 320 && Math.abs(diffX) > 16;
        const isDrag = Math.abs(diffX) > 28;

        if (isFlick || isDrag) {
          const activeSec = Array.from(sections).find((s) => !s.classList.contains('hidden'));
          const currentId = activeSec ? activeSec.id : 'sec-biodata';
          const curIdx = profileTabOrder.indexOf(currentId);
          if (diffX > 0 && curIdx < profileTabOrder.length - 1) {
            switchTab(profileTabOrder[curIdx + 1]);
          } else if (diffX < 0 && curIdx > 0) {
            switchTab(profileTabOrder[curIdx - 1]);
          }
        }
        setTimeout(() => { profIsSwiping = false; }, 80);
      }, { passive: true });

      // Role check untuk tombol mobile profil & sidebar (Opsi 2: Admin, Kepsek, Waka = Menu, lainnya = Keluar)
      const authRole = localStorage.getItem('auth_role');
      let authCivitasObj: any = null;
      try {
        const raw = localStorage.getItem('auth_civitas');
        if (raw) authCivitasObj = JSON.parse(raw);
      } catch {}
      const isKepsekOrWaka = authCivitasObj && (authCivitasObj.tag === 'kepsek' || authCivitasObj.tag === 'waka');
      const canAccessDashboard = authRole === 'admin' || isKepsekOrWaka;

      const sidebarBackToMenu = document.getElementById('sidebar-back-to-menu');
      if (sidebarBackToMenu) {
        if (canAccessDashboard) {
          sidebarBackToMenu.classList.remove('hidden');
        } else {
          sidebarBackToMenu.classList.add('hidden');
        }
      }

      const mobileBackLink = document.getElementById('profile-mobile-back-link');
      const mobileLogoutBtn = document.getElementById('profile-mobile-logout-btn');
      if (canAccessDashboard) {
        if (mobileBackLink) {
          mobileBackLink.classList.remove('hidden');
          mobileBackLink.style.display = '';
        }
        if (mobileLogoutBtn) {
          mobileLogoutBtn.classList.add('hidden');
          mobileLogoutBtn.classList.remove('flex');
          mobileLogoutBtn.style.display = 'none';
        }
      } else {
        if (mobileBackLink) {
          mobileBackLink.classList.add('hidden');
          mobileBackLink.style.display = 'none';
        }
        if (mobileLogoutBtn) {
          mobileLogoutBtn.classList.remove('hidden');
          mobileLogoutBtn.classList.add('flex');
          mobileLogoutBtn.style.display = '';
        }
      }
      if (mobileLogoutBtn) {
        mobileLogoutBtn.onclick = () => {
          localStorage.removeItem('auth_civitas');
          localStorage.removeItem('auth_role');
          sessionStorage.removeItem('auth_active');
          sessionStorage.removeItem('bypass_login');
          document.cookie = 'auth_session=; path=/; expires=Thu, 01 Jan 1970 00:00:00 GMT; SameSite=Lax';
          window.location.replace('/');
        };
      }

      // Buka tab berdasarkan hash atau query jika ada
      const urlParams = new URLSearchParams(window.location.search);
      const tabParam = urlParams.get('tab') || window.location.hash.replace('#', '');
      if (tabParam) {
        const fullId = tabParam.startsWith('sec-') ? tabParam : `sec-${tabParam}`;
        switchTab(fullId);
      }
    }

    // 0ms Cache First: Render profil dari cache lokal saat halaman dimuat
    function loadCachedProfile() {
      try {
        const cached = localStorage.getItem('civitas_data_cache');
        if (cached) {
          const parsed = JSON.parse(cached);
          if (Array.isArray(parsed.students) && parsed.students.length > 0) {
            allCivitas = parsed.students;
            allLogs = parsed.logs || [];
            allPermissions = parsed.permissions || [];
            const urlParams = new URLSearchParams(window.location.search);
            let targetId = urlParams.get('id');
            authRole = localStorage.getItem('auth_role') || '';
            const authCivitasRaw = localStorage.getItem('auth_civitas');
            authCivitas = null;
            try { if (authCivitasRaw) authCivitas = JSON.parse(authCivitasRaw); } catch {}
            if ((authRole === 'siswa' || authRole === 'guru') && authCivitas?.id) {
              targetId = authCivitas.id;
            }
            if (targetId) currentCivitas = allCivitas.find((c: any) => c.id === targetId || c.rfidUid === targetId);
            if (!currentCivitas && authCivitas) currentCivitas = authCivitas;
            if (!currentCivitas && allCivitas.length > 0) currentCivitas = allCivitas[0];
            if (currentCivitas) renderProfile();
          }
        }
      } catch (e) {}
    }

    // Dengarkan event push realtime
    window.addEventListener('attendance-updated', loadData);
    setupSubnav();
    setupIzinSectionListeners();
    setupGuruFilterTabs();
    loadCachedProfile();
    loadData();
  </script>
</Layout>
