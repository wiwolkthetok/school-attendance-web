          ).replace(/[^0-9]/g, "");
          if (isAdmin) {
            btnWaText.textContent = "WhatsApp";
            btnWaAction.href = `https://wa.me/${targetPhone}?text=Halo%20Admin%20${encodeURIComponent(currentCivitas.name)}`;
          } else if (isGuru) {
            btnWaText.textContent = "WhatsApp";
            btnWaAction.href = `https://wa.me/${targetPhone}?text=Halo%20Bapak%2FIbu%20${encodeURIComponent(currentCivitas.name)}`;
          } else {
            btnWaText.textContent = "WhatsApp Wali";
            btnWaAction.href = `https://wa.me/${targetPhone}?text=Halo%20Wali%20Murid%20dari%20${encodeURIComponent(currentCivitas.name)}`;
