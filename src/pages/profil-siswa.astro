          if (isAdmin) {
            btnWaText.textContent = 'Hubungi Admin via WhatsApp';
            btnWaAction.href = `https://wa.me/${targetPhone}?text=Halo%20Admin%20${encodeURIComponent(currentCivitas.name)}`;
          } else if (isGuru) {
            btnWaText.textContent = 'Hubungi Guru via WhatsApp';
            btnWaAction.href = `https://wa.me/${targetPhone}?text=Halo%20Bapak%2FIbu%20${encodeURIComponent(currentCivitas.name)}`;
          } else {
            btnWaText.textContent = 'Hubungi Wali Murid via WhatsApp';
