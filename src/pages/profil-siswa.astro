              <div class="flex items-center gap-1.5 text-[11px] font-semibold text-slate-700">
                <span>Status Verifikasi Sekolah:</span>
                <span class="font-bold px-2 py-0.5 rounded-md ${
                  status === 'Disetujui'
                    ? 'bg-emerald-100 text-emerald-800'
                    : (status === 'Selesai' ? 'bg-slate-100 text-slate-800' : (status === 'Ditolak' ? 'bg-rose-100 text-rose-800' : 'bg-amber-100 text-amber-800'))
                }">
                  ${status === 'Disetujui' ? '✓ Diterima (Disetujui)' : (status === 'Selesai' ? '✓ Izin Telah Selesai & Diarsipkan' : (status === 'Ditolak' ? '✗ Tidak Diterima / Ditolak' : '⏳ Menunggu Persetujuan Guru'))}
                </span>
              </div>
              <div class="flex items-center gap-1">
                ${status === 'Disetujui' ? `
                  <button
                    type="button"
                    class="btn-toggle-perm-status px-2.5 py-1 rounded-lg bg-slate-100 hover:bg-slate-200 text-slate-800 border border-slate-300 text-[10px] font-bold cursor-pointer transition"
                    data-id="${p.id}"
                    data-status="Selesai"
                    title="Akhiri masa izin dan arsipkan ke riwayat"
                  >
                    ⏹ Selesaikan Izin
                  </button>
                ` : `
                  <button
                    type="button"
                    class="btn-toggle-perm-status px-2.5 py-1 rounded-lg bg-emerald-50 hover:bg-emerald-100 text-emerald-800 border border-emerald-200 text-[10px] font-bold cursor-pointer transition"
                    data-id="${p.id}"
                    data-status="Disetujui"
                  >
                    ✓ Terima Izin
                  </button>
                `}
                <button
                  type="button"
                  class="btn-toggle-perm-status px-2.5 py-1 rounded-lg bg-rose-50 hover:bg-rose-100 text-rose-800 border border-rose-200 text-[10px] font-bold cursor-pointer transition"
                  data-id="${p.id}"
                  data-status="Ditolak"
                >
                  ✗ Tolak Izin
                </button>
              </div>
            `;

            timelineIzinActionsBox.querySelectorAll('.btn-toggle-perm-status').forEach((btn) => {
              btn.addEventListener('click', async () => {
                const pid = (btn as HTMLElement).dataset.id;
                const newStatus = (btn as HTMLElement).dataset.status;
                try {
                  const res = await fetch('/api/permissions', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ action: 'update_status', id: pid, status: newStatus }),
                  });
                  if (res.ok) {
                    await loadData();
                  }
                } catch (err) {
                  console.error('Gagal update status izin:', err);
                }
              });
            });
          }
        } else {
          if (timelineIzinBadge) {
            timelineIzinBadge.textContent = 'Nihil Izin';
            timelineIzinBadge.className = 'px-2 py-0.5 rounded-md text-[10px] font-black uppercase tracking-wider bg-slate-300 text-slate-700';
          }
          if (timelineIzinDesc) {
            timelineIzinDesc.textContent = 'Tidak ada catatan izin aktif. Siswa aktif hadir di kelas.';
          }
          if (timelineItem2Sub) {
            timelineItem2Sub.textContent = 'Klik tombol "+ Ajukan Izin" di atas jika berhalangan hadir.';
          }
          if (timelineIzinActionsBox) {
            timelineIzinActionsBox.innerHTML = `
              <span class="text-[11px] text-slate-500">Belum ada pengajuan izin minggu ini.</span>
            `;
          }
        }
      }

      // Render Item 4: Riwayat Jejak Presensi Real Siswa Ini
      const tlHistoryTitle = document.getElementById('timeline-history-title');
      const tlHistoryBadge = document.getElementById('timeline-history-badge');
      const tlHistoryList = document.getElementById('timeline-history-list');

      if (tlHistoryTitle) {
        tlHistoryTitle.textContent = isGuru
          ? 'Riwayat Presensi Mengajar & Kehadiran Pendidik'
          : `Riwayat Jejak Presensi Gerbang (${currentCivitas.name.split(' ')[0]})`;
      }

      if (tlHistoryBadge) {
        tlHistoryBadge.textContent = civitasLogs.length > 0
          ? `${civitasLogs.length} Log Presensi`
          : 'Nihil Presensi';
        tlHistoryBadge.className = civitasLogs.length > 0
          ? 'px-2 py-0.5 rounded-md text-[10px] font-black uppercase tracking-wider bg-blue-100 text-blue-800 border border-blue-200'
          : 'px-2 py-0.5 rounded-md text-[10px] font-black uppercase tracking-wider bg-slate-200 text-slate-700';
      }

      if (tlHistoryList) {
        if (civitasLogs.length === 0) {
          tlHistoryList.innerHTML = `
            <div class="p-3.5 rounded-xl bg-white border border-slate-200/80 text-xs text-slate-600 flex items-center gap-3">
              <div class="w-8 h-8 rounded-lg bg-slate-100 text-slate-500 flex items-center justify-center shrink-0">
                <span class="material-symbols-outlined text-lg">event_busy</span>
              </div>
              <div>
                <p class="font-bold text-slate-800">Belum Ada Riwayat Presensi</p>
                <p class="text-[11px] text-slate-500">Siswa ini belum memiliki log pemindaian kartu RFID. Data riwayat presensi masuk dan keterlambatan hanya akan tercatat di akun siswa ini saat kartu di-tap.</p>
              </div>
            </div>
          `;
        } else {
          const reversedLogs = [...civitasLogs].reverse();
          tlHistoryList.innerHTML = reversedLogs.map((log: any, idx: number) => {
            const isBolos = log.status === 'Bolos';
            const isLate = log.status === 'Terlambat';
            const isMasuk = log.type === 'masuk';

            let borderBg = 'border-slate-200';
            if (isBolos) borderBg = 'border-rose-300 bg-rose-50/40';
            else if (isLate) borderBg = 'border-amber-300 bg-amber-50/30';

            let badgeHtml = '';
            if (isBolos) {
              badgeHtml = '<span class="px-2.5 py-1 rounded-lg text-[10px] font-black uppercase tracking-wider bg-rose-600 text-white shadow-xs">🚫 Bolos (-10 Poin)</span>';
            } else if (isLate) {
              badgeHtml = '<span class="px-2.5 py-1 rounded-lg text-[10px] font-black uppercase tracking-wider bg-rose-100 text-rose-800 border border-rose-200">⚠️ Terlambat</span>';
            } else {
              badgeHtml = '<span class="px-2.5 py-1 rounded-lg text-[10px] font-black uppercase tracking-wider bg-emerald-100 text-emerald-800 border border-emerald-200">✓ Hadir Tepat Waktu</span>';
            }

            return `
              <div class="p-3 rounded-xl bg-white border ${borderBg} flex items-center justify-between gap-3 text-xs flex-wrap">
                <div class="flex items-center gap-2.5">
                  <span class="w-6 h-6 rounded-lg ${isBolos ? 'bg-rose-100 text-rose-800' : (isLate ? 'bg-amber-100 text-amber-800' : 'bg-emerald-100 text-emerald-800')} text-[11px] font-black flex items-center justify-center">
                    #${civitasLogs.length - idx}
                  </span>
                  <div>
                    <div class="flex items-center gap-2">
                      <span class="font-bold text-slate-800">${log.date}</span>
                      <span class="font-mono text-slate-500 text-[11px] font-semibold">${log.time} WIB</span>
                    </div>
                    <p class="text-[11px] text-slate-500">
                      Sesi: <span class="font-semibold text-slate-700 uppercase">${isMasuk ? 'Presensi Masuk (Pagi)' : 'Presensi Pulang'}</span> • ID: <span class="font-mono text-slate-400">${log.id}</span>
                    </p>
                  </div>
                </div>
                <div class="flex items-center gap-1.5">
                  ${badgeHtml}
                </div>
              </div>
            `;
          }).join('');
        }
      }

      // 6. Section 4: Poin Disiplin Siswa (Sesuai ide.txt)
      updatePointsDisplay();

      // 7. Section 5 (Rapor)
      const raporCategoryTag = document.getElementById('rapor-category-tag');
      const raporTitle = document.getElementById('rapor-title');
      const raporSubtitle = document.getElementById('rapor-subtitle');
      const raporStatsContainer = document.getElementById('rapor-stats-container');
      const raporActionText = document.getElementById('rapor-action-text');

      if (isGuru) {
        if (raporCategoryTag) raporCategoryTag.textContent = 'Rapor Kinerja & Presensi Guru';
        if (raporTitle) raporTitle.textContent = 'Indikator Kinerja Pendidik Profesional';
        if (raporSubtitle) raporSubtitle.textContent = 'Catatan kehadiran dan kedisiplinan mengajar semester berjalan.';
        if (raporActionText) raporActionText.textContent = 'Cetak Rapor Kinerja & Kartu Pendidik';

        const teacherTotal = civitasLogs.length;
        const teacherOnTime = civitasLogs.filter((l: any) => l.status === 'Hadir').length;
        const teacherLate = civitasLogs.filter((l: any) => l.status === 'Terlambat').length;
        const teacherRatio = teacherTotal > 0 ? Math.round((teacherOnTime / teacherTotal) * 100) : 100;

        if (raporStatsContainer) {
          raporStatsContainer.innerHTML = `
            <div class="p-4 rounded-2xl bg-white/10 border border-white/10 flex items-center gap-3">
              <span class="w-2.5 h-2.5 rounded-full bg-emerald-400 shrink-0"></span>
              <div>
                <p class="text-[11px] text-blue-200">Rasio Kehadiran Mengajar</p>
                <p class="text-sm font-black text-white">${teacherRatio}% (${teacherRatio === 100 ? 'Sangat Baik' : 'Cukup'})</p>
              </div>
            </div>
            <div class="p-4 rounded-2xl bg-white/10 border border-white/10 flex items-center gap-3">
              <span class="w-2.5 h-2.5 rounded-full bg-emerald-400 shrink-0"></span>
              <div>
                <p class="text-[11px] text-blue-200">Presensi Tepat Waktu</p>
                <p class="text-sm font-black text-white">${teacherOnTime} Hari</p>
              </div>
            </div>
            <div class="p-4 rounded-2xl bg-white/10 border border-white/10 flex items-center gap-3">
              <span class="w-2.5 h-2.5 rounded-full bg-blue-300 shrink-0"></span>
              <div>
                <p class="text-[11px] text-blue-200">Keterlambatan</p>
                <p class="text-sm font-black text-white">${teacherLate} Hari</p>
              </div>
            </div>
            <div class="p-4 rounded-2xl bg-white/10 border border-white/10 flex items-center gap-3">
              <span class="w-2.5 h-2.5 rounded-full bg-purple-300 shrink-0"></span>
              <div>
                <p class="text-[11px] text-blue-200">Surat Tugas / Perizinan</p>
                <p class="text-sm font-black text-white">${civitasPerms.length} Berkas</p>
              </div>
            </div>
          `;
        }
      } else {
        if (raporCategoryTag) raporCategoryTag.textContent = 'Rapor Kehadiran & Prestasi';
        if (raporTitle) raporTitle.textContent = 'Indikator Portofolio Siswa Berprestasi';
        if (raporSubtitle) raporSubtitle.textContent = 'Catatan kedisiplinan semester berjalan di SMK Ma\'arif 1 Padang Ratu.';
        if (raporActionText) raporActionText.textContent = 'Cetak Rapor & Kartu Siswa';

        const totalLogs = civitasLogs.length;
        const onTimeCount = civitasLogs.filter((l: any) => l.status === 'Hadir').length;
        const lateCount = civitasLogs.filter((l: any) => l.status === 'Terlambat').length;
        const ratio = totalLogs > 0 ? Math.round((onTimeCount / totalLogs) * 100) : 100;

        if (raporStatsContainer) {
          raporStatsContainer.innerHTML = `
            <div class="p-4 rounded-2xl bg-white/10 border border-white/10 flex items-center gap-3">
              <span class="w-2.5 h-2.5 rounded-full bg-emerald-400 shrink-0"></span>
              <div>
                <p class="text-[11px] text-blue-200">Rasio Kehadiran</p>
                <p class="text-sm font-black text-white">${ratio}% (${ratio === 100 ? 'Sangat Baik' : 'Perlu Evaluasi'})</p>
              </div>
            </div>
            <div class="p-4 rounded-2xl bg-white/10 border border-white/10 flex items-center gap-3">
              <span class="w-2.5 h-2.5 rounded-full bg-emerald-400 shrink-0"></span>
              <div>
                <p class="text-[11px] text-blue-200">Hadir Tepat Waktu</p>
                <p class="text-sm font-black text-white">${onTimeCount} Hari</p>
              </div>
            </div>
            <div class="p-4 rounded-2xl bg-white/10 border border-white/10 flex items-center gap-3">
              <span class="w-2.5 h-2.5 rounded-full bg-blue-300 shrink-0"></span>
              <div>
                <p class="text-[11px] text-blue-200">Keterlambatan</p>
                <p class="text-sm font-black text-white">${lateCount} Hari</p>
              </div>
            </div>
            <div class="p-4 rounded-2xl bg-white/10 border border-white/10 flex items-center gap-3">
              <span class="w-2.5 h-2.5 rounded-full bg-purple-300 shrink-0"></span>
              <div>
                <p class="text-[11px] text-blue-200">Izin Sah / Dispensasi</p>
                <p class="text-sm font-black text-white">${civitasPerms.length} Berkas</p>
              </div>
            </div>
          `;
        }
      }

      // 8. Section 6: Pengajuan Permohonan Izin & Riwayat Permohonan Izin Saya
      renderIzinSection(isGuru, civitasPerms);
    }

    async function updatePointsDisplay() {
      if (!currentCivitas) return;
      const isGuru = currentCivitas.role === 'guru';
      const isAdmin = currentCivitas.role === 'admin';
      const isStaff = isGuru || isAdmin;

      const studentView = document.getElementById('poin-student-view');
      const guruView = document.getElementById('poin-guru-view');
      const sbPointBox = document.getElementById('sidebar-point-box');
      const sbPointBadge = document.getElementById('sidebar-point-badge');
      const poinDisplayVal = document.getElementById('poin-display-val');
      const circleContainer = document.getElementById('poin-circle-container');
      const poinStatusPill = document.getElementById('poin-status-pill');
      const poinHistoryCount = document.getElementById('poin-history-count');
      const poinHistoryContainer = document.getElementById('poin-history-container');

      if (isStaff) {
        if (sbPointBox) sbPointBox.classList.add('hidden');
        if (studentView) studentView.classList.add('hidden');
        if (guruView) guruView.classList.remove('hidden');
        return;
      }

      if (sbPointBox) sbPointBox.classList.remove('hidden');
      if (studentView) studentView.classList.remove('hidden');
      if (guruView) guruView.classList.add('hidden');

      try {
        const res = await fetch(`/api/points?studentId=${currentCivitas.id}&rfid=${currentCivitas.rfidUid}`);
        const summary = await res.json();
        const points = Number(summary.totalPoints ?? 100);
        const deductions = summary.deductions || [];

        // 1. Update Sidebar Badge
        if (sbPointBadge) {
          sbPointBadge.textContent = `${points} Poin`;
          if (points >= 50) {
            sbPointBadge.className = 'px-2 py-0.5 rounded-lg bg-emerald-500/20 text-emerald-300 border border-emerald-400/30 font-black font-mono text-[11px]';
          } else if (points >= 10) {
            sbPointBadge.className = 'px-2 py-0.5 rounded-lg bg-amber-500/20 text-amber-300 border border-amber-400/30 font-black font-mono text-[11px]';
          } else {
            sbPointBadge.className = 'px-2 py-0.5 rounded-lg bg-rose-500/20 text-rose-300 border border-rose-400/30 font-black font-mono text-[11px] animate-pulse';
          }
        }

        // 2. Update Big Points Circle
        if (poinDisplayVal) poinDisplayVal.textContent = String(points);
        if (circleContainer) {
          if (points >= 50) {
            circleContainer.className = 'w-32 h-32 rounded-full border-8 border-emerald-500/30 flex flex-col items-center justify-center bg-emerald-50/50 relative transition-all';
            if (poinDisplayVal) poinDisplayVal.className = 'text-4xl font-black text-emerald-600 font-mono';
          } else if (points >= 10) {
            circleContainer.className = 'w-32 h-32 rounded-full border-8 border-amber-500/30 flex flex-col items-center justify-center bg-amber-50/50 relative transition-all';
            if (poinDisplayVal) poinDisplayVal.className = 'text-4xl font-black text-amber-600 font-mono';
          } else {
            circleContainer.className = 'w-32 h-32 rounded-full border-8 border-rose-500/30 flex flex-col items-center justify-center bg-rose-50/50 relative transition-all';
            if (poinDisplayVal) poinDisplayVal.className = 'text-4xl font-black text-rose-600 font-mono animate-pulse';
          }
        }

        // 3. Update Status Pill
        if (poinStatusPill) {
          if (points === 100) {
            poinStatusPill.className = 'mt-4 px-3 py-1 rounded-full text-xs font-black bg-emerald-100 text-emerald-800 border border-emerald-300';
            poinStatusPill.textContent = 'Status: Disiplin & Aman (100 Poin)';
          } else if (points >= 50) {
            poinStatusPill.className = 'mt-4 px-3 py-1 rounded-full text-xs font-black bg-blue-100 text-blue-800 border border-blue-300';
            poinStatusPill.textContent = `Status: Aktif (${points} Poin)`;
          } else if (points >= 10) {
            poinStatusPill.className = 'mt-4 px-3 py-1 rounded-full text-xs font-black bg-amber-100 text-amber-800 border border-amber-300';
            poinStatusPill.textContent = `Peringatan: Perlu Pembinaan (${points} Poin)`;
          } else if (points > 0) {
            poinStatusPill.className = 'mt-4 px-3 py-1 rounded-full text-xs font-black bg-rose-100 text-rose-800 border border-rose-300 animate-pulse';
            poinStatusPill.textContent = `Peringatan Kritis! (${points} Poin) - Temui Guru`;
          } else {
            poinStatusPill.className = 'mt-4 px-3 py-1 rounded-full text-xs font-black bg-rose-600 text-white border border-rose-700 shadow-md animate-bounce';
            poinStatusPill.textContent = 'Akses Terkunci! Wajib Reset Wakasis';
          }
        }

        // 4. Update History Count
        if (poinHistoryCount) {
          poinHistoryCount.textContent = deductions.length > 0
            ? `${deductions.length} Kali Pengurangan Poin`
            : '0 Pelanggaran (Bersih)';
        }

        // 5. Render History List
        if (poinHistoryContainer) {
          if (deductions.length === 0) {
            poinHistoryContainer.innerHTML = `
              <div class="p-4 rounded-2xl bg-emerald-50/70 border border-emerald-200/80 flex items-start gap-3.5">
                <div class="w-8 h-8 rounded-xl bg-emerald-100 text-emerald-700 flex items-center justify-center shrink-0 mt-0.5">
                  <span class="material-symbols-outlined text-lg">verified</span>
                </div>
                <div class="text-xs space-y-0.5">
                  <p class="font-bold text-emerald-900">Catatan Poin Bersih (100 Poin Utuh)</p>
                  <p class="text-emerald-700 text-[11px] leading-relaxed">
                    Siswa ini senantiasa hadir tepat waktu dan belum memiliki catatan pengurangan poin keterlambatan pada presensi pagi gerbang.
                  </p>
                </div>
              </div>
            `;
          } else {
            poinHistoryContainer.innerHTML = deductions.map((d: any, idx: number) => {
              let formattedDate = d.date;
              try {
                const parts = d.date.split('-');
                if (parts.length === 3) {
                  const dObj = new Date(Number(parts[0]), Number(parts[1]) - 1, Number(parts[2]));
                  formattedDate = dObj.toLocaleDateString('id-ID', {
                    weekday: 'long',
                    year: 'numeric',
                    month: 'short',
                    day: 'numeric',
                  });
                }
              } catch {}

              return `
                <div class="p-4 rounded-2xl bg-white border border-slate-200/90 hover:border-blue-300 hover:shadow-xs transition-all space-y-2.5">
                  <div class="flex items-center justify-between gap-2 flex-wrap">
                    <div class="flex items-center gap-2">
                      <span class="w-6 h-6 rounded-lg bg-rose-100 text-rose-700 text-xs font-black flex items-center justify-center">
                        #${deductions.length - idx}
                      </span>
                      <span class="text-xs font-bold text-slate-800">${formattedDate}</span>
                      <span class="text-[11px] font-mono text-slate-500 font-semibold">• ${d.time} WIB</span>
                    </div>
                    <div class="flex items-center gap-1.5">
                      <span class="px-2 py-0.5 rounded-md text-[10px] font-bold ${d.minutesLate > 0 ? 'bg-amber-50 text-amber-800 border border-amber-200' : 'bg-rose-50 text-rose-800 border border-rose-200'}">
                        ${d.minutesLate > 0 ? `Telat ${d.minutesLate} Menit` : 'Bolos Kepulangan'}
                      </span>
                      <span class="px-2.5 py-0.5 rounded-md text-xs font-black bg-rose-100 text-rose-700 border border-rose-200">
                        -${d.pointsDeducted} Poin
                      </span>
                      <span class="px-2 py-0.5 rounded-md text-[10px] font-bold bg-slate-100 text-slate-700 border border-slate-200 font-mono">
                        Sisa ${d.remainingPoints ?? '-'} Poin
                      </span>
                    </div>
                  </div>

                  <!-- Alasan / Keterangan Sebab Poin Berkurang -->
                  <div class="p-2.5 rounded-xl bg-slate-50 border border-slate-200/60 text-xs text-slate-700 flex items-start gap-2">
                    <span class="material-symbols-outlined text-rose-500 text-base shrink-0 mt-0.5">report_problem</span>
                    <div class="min-w-0">
                      <span class="font-bold text-slate-900 block text-[11px] uppercase tracking-wide">Keterangan Sebab Pengurangan:</span>
                      <p class="text-xs text-slate-700 leading-relaxed">${d.reason}</p>
                    </div>
                  </div>
                </div>
              `;
            }).join('');
          }
        }

        // 6. Render Item Linimasa Presensi (Section yang Dipilih User)
        const tlPoinNode = document.getElementById('timeline-item-poin-node');
        const tlPoinCard = document.getElementById('timeline-poin-card');
        const tlPoinDot = document.getElementById('timeline-poin-dot');
        const tlPoinDotInner = document.getElementById('timeline-poin-dot-inner');
        const tlPoinBadge = document.getElementById('timeline-poin-badge');
        const tlPoinRemaining = document.getElementById('timeline-poin-remaining');
        const tlPoinDetailBox = document.getElementById('timeline-poin-detail-box');

        if (tlPoinNode) {
          if (isGuru) {
            tlPoinNode.classList.add('hidden');
          } else {
            tlPoinNode.classList.remove('hidden');

            if (tlPoinRemaining) {
              tlPoinRemaining.textContent = `Sisa ${points} / 100 Poin`;
            }

            if (deductions.length === 0) {
              if (tlPoinDot) tlPoinDot.className = 'absolute -left-6 sm:-left-8 top-5 w-5 h-5 rounded-full bg-white border-3 border-emerald-500 shadow-md group-hover:scale-125 transition-transform duration-200 -translate-x-1/2 flex items-center justify-center';
              if (tlPoinDotInner) tlPoinDotInner.className = 'w-1.5 h-1.5 rounded-full bg-emerald-500';
              if (tlPoinCard) tlPoinCard.className = 'p-4 sm:p-5 rounded-2xl bg-emerald-50/60 border border-emerald-200/70 hover:bg-emerald-50 hover:shadow-md transition-all duration-200 space-y-3';
              if (tlPoinBadge) {
                tlPoinBadge.textContent = '100 Poin Utuh (Disiplin)';
                tlPoinBadge.className = 'px-2 py-0.5 rounded-md text-[10px] font-black uppercase tracking-wider bg-emerald-600 text-white';
              }
              if (tlPoinDetailBox) {
                tlPoinDetailBox.innerHTML = `
                  <div class="p-3.5 rounded-xl bg-white border border-emerald-200/80 shadow-xs flex items-center gap-3">
                    <div class="w-8 h-8 rounded-lg bg-emerald-100 text-emerald-700 flex items-center justify-center shrink-0">
                      <span class="material-symbols-outlined text-lg">verified</span>
                    </div>
                    <div class="text-xs">
                      <p class="font-bold text-emerald-900">Catatan Poin Bersih (100 Poin Utuh)</p>
                      <p class="text-emerald-700 text-[11px]">Siswa selalu hadir tepat waktu pada gerbang pagi. Akumulasi poin saat ini utuh 100 poin tanpa catatan pelanggaran.</p>
                    </div>
                  </div>
                `;
              }
            } else {
              const latest = deductions[0];
              if (tlPoinDot) tlPoinDot.className = 'absolute -left-6 sm:-left-8 top-5 w-5 h-5 rounded-full bg-white border-3 border-rose-500 shadow-md group-hover:scale-125 transition-transform duration-200 -translate-x-1/2 flex items-center justify-center';
              if (tlPoinDotInner) tlPoinDotInner.className = 'w-1.5 h-1.5 rounded-full bg-rose-500';
              if (tlPoinCard) tlPoinCard.className = 'p-4 sm:p-5 rounded-2xl bg-rose-50/60 border border-rose-200/70 hover:bg-rose-50 hover:shadow-md transition-all duration-200 space-y-3';
              if (tlPoinBadge) {
                tlPoinBadge.textContent = `-${latest.pointsDeducted} Poin (Telat ${latest.minutesLate} Mnt)`;
                tlPoinBadge.className = 'px-2 py-0.5 rounded-md text-[10px] font-black uppercase tracking-wider bg-rose-600 text-white';
              }

              let statusAlert = '';
              if (points === 0) {
                statusAlert = `
                  <div class="p-2.5 rounded-xl bg-rose-600 text-white text-xs font-bold flex items-center gap-2 shadow-xs">
                    <span class="material-symbols-outlined text-sm">block</span>
                    <span>Akses Ditolak: Poin siswa 0 (Terkunci). Silahkan temui Guru Piket atau Wakasis untuk reset poin!</span>
                  </div>
                `;
              } else if (points < 10) {
                statusAlert = `
                  <div class="p-2.5 rounded-xl bg-amber-500 text-white text-xs font-bold flex items-center gap-2 shadow-xs animate-pulse">
                    <span class="material-symbols-outlined text-sm">warning</span>
                    <span>Peringatan LCD: Anda berhasil absen namun poin Anda kurang dari 10. Silahkan temui guru terlebih dahulu!</span>
                  </div>
                `;
              }

              if (tlPoinDetailBox) {
                tlPoinDetailBox.innerHTML = `
                  ${statusAlert}
                  ${deductions.map((d: any) => {
                    let formattedDate = d.date;
                    try {
                      const parts = d.date.split('-');
                      if (parts.length === 3) {
                        const dObj = new Date(Number(parts[0]), Number(parts[1]) - 1, Number(parts[2]));
                        formattedDate = dObj.toLocaleDateString('id-ID', {
                          weekday: 'long',
                          year: 'numeric',
                          month: 'short',
                          day: 'numeric',
                        });
                      }
                    } catch {}

                    return `
                      <div class="p-3.5 rounded-xl bg-white border border-rose-200 shadow-xs space-y-2">
                        <div class="flex items-center justify-between gap-2 flex-wrap text-xs">
                          <div class="flex items-center gap-2">
                            <span class="px-2 py-0.5 rounded-md bg-rose-100 text-rose-700 font-black text-xs">
                              -${d.pointsDeducted} Poin
                            </span>
                            <span class="font-bold text-slate-800">${formattedDate}</span>
                            <span class="text-slate-500 font-mono text-[11px]">• ${d.time} WIB</span>
                          </div>
                          <div class="flex items-center gap-1.5">
                            <span class="px-2 py-0.5 rounded-md bg-amber-50 text-amber-800 border border-amber-200 font-bold text-[11px]">
                              Telat ${d.minutesLate} Menit
                            </span>
                            <span class="px-2 py-0.5 rounded-md bg-slate-100 text-slate-700 font-bold text-[11px] font-mono">
                              Sisa ${d.remainingPoints ?? '-'} Poin
                            </span>
                          </div>
                        </div>

                        <!-- Sebab Pengurangan Poin Sesuai ide.txt -->
                        <div class="p-2.5 rounded-lg bg-rose-50/70 border border-rose-200/60 text-xs text-slate-700 flex items-start gap-2">
                          <span class="material-symbols-outlined text-rose-500 text-base shrink-0 mt-0.5">report_problem</span>
                          <div class="min-w-0">
                            <span class="font-bold text-slate-900 block text-[11px] uppercase tracking-wide">Keterangan Sebab Pengurangan:</span>
                            <p class="text-xs text-slate-800 leading-relaxed font-medium">${d.reason}</p>
                          </div>
                        </div>
                      </div>
                    `;
                  }).join('')}
                `;
              }
            }
          }
        }
      } catch (err) {
        console.error('Gagal memuat rangkuman poin:', err);
      }
    }

    function renderIzinSection(isGuru: boolean, civitasPerms: any[]) {
      if (!currentCivitas) return;

      const isGuruLoggedIn = authRole === 'guru';
      const isTeacherMode = isGuru || isGuruLoggedIn;

      // Update sidebar nav label for Izin
      const sidebarIzinIcon = document.getElementById('sidebar-izin-icon');
      const sidebarIzinTitle = document.getElementById('sidebar-izin-title');
      const sidebarIzinBadge = document.getElementById('sidebar-izin-badge');

      if (sidebarIzinTitle && sidebarIzinIcon && sidebarIzinBadge) {
        if (isTeacherMode) {
          sidebarIzinIcon.textContent = 'verified_user';
          sidebarIzinTitle.textContent = 'Konfirmasi Izin Siswa';
          sidebarIzinBadge.textContent = 'Guru';
          sidebarIzinBadge.className = 'text-[9px] font-black uppercase px-1.5 py-0.5 rounded-md bg-amber-400 text-slate-900';
        } else {
          sidebarIzinIcon.textContent = 'edit_document';
          sidebarIzinTitle.textContent = 'Pengajuan Izin';
          sidebarIzinBadge.textContent = 'Izin';
          sidebarIzinBadge.className = 'text-[9px] font-black uppercase px-1.5 py-0.5 rounded-md bg-white/20 text-blue-100';
        }
      }

      const panelGuru = document.getElementById('panel-guru-konfirmasi-izin');
      const panelForm = document.getElementById('panel-form-izin-mandiri');
      const panelHist = document.getElementById('panel-my-permissions');

      if (isTeacherMode) {
        if (panelGuru) panelGuru.classList.remove('hidden');
        if (panelForm) panelForm.classList.add('hidden');
        if (panelHist) panelHist.classList.add('hidden');
        renderGuruPermissionsList();
      } else {
        if (panelGuru) panelGuru.classList.add('hidden');
        if (panelForm) panelForm.classList.remove('hidden');
        if (panelHist) panelHist.classList.remove('hidden');
      }

      const nameInput = document.getElementById('form-izin-name') as HTMLInputElement | null;
      const classInput = document.getElementById('form-izin-class') as HTMLInputElement | null;
      const jurusanBox = document.getElementById('form-izin-jurusan-box');
      const photoBox = document.getElementById('form-izin-photo-box');
      const headerTitle = document.getElementById('izin-form-header-title');
      const startEl = document.getElementById('form-izin-start-date') as HTMLInputElement | null;
      const endEl = document.getElementById('form-izin-end-date') as HTMLInputElement | null;
      const daysText = document.getElementById('form-izin-days-text');

      if (nameInput) nameInput.value = currentCivitas.name;
      if (classInput) classInput.value = currentCivitas.className || (isGuru ? 'Dewan Guru' : 'XII');
      if (headerTitle) headerTitle.textContent = isGuru ? 'Formulir Pengajuan Izin Pendidik' : 'Formulir Pengajuan Izin Siswa';

      if (isGuru) {
        if (jurusanBox) jurusanBox.classList.add('hidden');
        if (photoBox) photoBox.classList.add('hidden');
      } else {
        if (jurusanBox) jurusanBox.classList.remove('hidden');
        if (photoBox) photoBox.classList.remove('hidden');

        // Preset jurusan checkbox berdasarkan rombel civitas jika belum ada yang terpilih
        const cbRpl = document.getElementById('cb-jurusan-rpl') as HTMLInputElement | null;
        const cbAkl = document.getElementById('cb-jurusan-akl') as HTMLInputElement | null;
        const cat = (currentCivitas.category || currentCivitas.className || '').toLowerCase();
        if (cbRpl && cbAkl && !cbRpl.checked && !cbAkl.checked) {
          if (cat.includes('rpl')) cbRpl.checked = true;
          else if (cat.includes('akl')) cbAkl.checked = true;
        }
      }

      const todayStr = new Date().toLocaleDateString('en-CA', { timeZone: 'Asia/Jakarta' });
      if (startEl && !startEl.value) startEl.value = todayStr;
      if (endEl && !endEl.value) endEl.value = todayStr;
      if (daysText && !daysText.textContent) daysText.textContent = '1 Hari';

      // Render Riwayat Pengajuan Izin Civitas Ini
      const myPermContainer = document.getElementById('my-permissions-container');
      if (myPermContainer) {
        if (civitasPerms.length === 0) {
          myPermContainer.innerHTML = `
            <div class="p-6 rounded-2xl bg-slate-50 border border-slate-200/80 text-center text-xs text-slate-500">
              <span class="material-symbols-outlined text-3xl text-slate-400 block mb-1">note_alt</span>
              Belum ada riwayat permohonan izin yang diajukan. Silahkan isi formulir di atas untuk mengajukan izin baru.
            </div>
          `;
        } else {
          myPermContainer.innerHTML = civitasPerms.map((p: any) => {
            const isMenunggu = (p.status || 'Menunggu') === 'Menunggu';
            const isDisetujui = p.status === 'Disetujui';
            const isDitolak = p.status === 'Ditolak';

            let badgeClass = 'bg-amber-100 text-amber-800 border-amber-300 animate-pulse';
            let badgeText = '⏳ Menunggu Persetujuan';
            if (isDisetujui) {
              badgeClass = 'bg-emerald-100 text-emerald-800 border-emerald-300';
              badgeText = '✓ Disetujui';
            } else if (isDitolak) {
              badgeClass = 'bg-rose-100 text-rose-800 border-rose-300';
              badgeText = '✗ Ditolak';
            }

            return `
              <div class="p-4 sm:p-5 rounded-2xl bg-white border border-slate-200/90 hover:border-blue-300 hover:shadow-xs transition-all space-y-3" id="perm-card-${p.id}">
                <div class="flex items-start justify-between gap-3 flex-wrap">
                  <div class="space-y-1">
                    <div class="flex items-center gap-2 flex-wrap">
                      <span class="font-mono text-[11px] font-bold text-slate-400">${p.id}</span>
                      <span class="px-2.5 py-0.5 rounded-lg text-[10px] font-black border ${badgeClass}">
                        ${badgeText}
                      </span>
                      ${p.approvedBy ? `
                        <span class="px-2.5 py-0.5 rounded-lg text-[10px] font-bold ${isDisetujui ? 'bg-emerald-50 text-emerald-800 border border-emerald-200' : 'bg-rose-50 text-rose-800 border border-rose-200'} flex items-center gap-1">
                          <span class="material-symbols-outlined text-[13px]">${isDisetujui ? 'verified' : 'cancel'}</span>
                          <span>${isDisetujui ? 'Disetujui oleh:' : 'Ditolak oleh:'} <strong>${p.approvedBy}</strong></span>
                        </span>
                      ` : ''}
                      ${p.jurusan ? `<span class="px-2 py-0.5 rounded-lg text-[10px] font-black bg-blue-50 text-blue-700 border border-blue-200 uppercase">Jurusan: ${p.jurusan}</span>` : ''}
                    </div>
                    <h4 class="text-xs font-black text-slate-900">${p.title || 'Alasan Permohonan Izin'}</h4>
                    <p class="text-[11px] text-slate-500">
                      Kategori: <strong class="text-slate-700">${p.categoryLabel || p.category || 'Izin'}</strong> • Rentang: <strong>${p.startDate}</strong> s/d <strong>${p.endDate || p.startDate}</strong> (${p.daysCount || 1} Hari)
                    </p>
                  </div>

                  <!-- Aksi: Edit & Batalkan/Hapus khusus status Menunggu -->
                  <div class="flex items-center gap-1.5 shrink-0">
                    ${isMenunggu ? `
                      <button
                        type="button"
                        class="btn-edit-my-perm px-3 py-1.5 rounded-xl bg-blue-50 hover:bg-blue-100 text-blue-700 border border-blue-200 text-xs font-bold transition flex items-center gap-1 cursor-pointer"
                        data-id="${p.id}"
                      >
                        <span class="material-symbols-outlined text-sm">edit</span>
                        <span>Edit</span>
                      </button>
                      <button
                        type="button"
                        class="btn-delete-my-perm px-3 py-1.5 rounded-xl bg-rose-50 hover:bg-rose-100 text-rose-700 border border-rose-200 text-xs font-bold transition flex items-center gap-1 cursor-pointer"
                        data-id="${p.id}"
                      >
                        <span class="material-symbols-outlined text-sm">delete</span>
                        <span>Batalkan / Hapus</span>
                      </button>
                    ` : `
                      <span class="text-[11px] font-bold text-slate-400 bg-slate-100 px-2.5 py-1 rounded-lg">
                        🔒 Status Terkunci
                      </span>
                    `}
                  </div>
                </div>

                <!-- Info Verifikator Guru Resmi -->
                ${p.approvedBy ? `
                  <div class="p-2.5 rounded-xl ${isDisetujui ? 'bg-emerald-50/70 border border-emerald-200/80 text-emerald-900' : 'bg-rose-50/70 border border-rose-200/80 text-rose-900'} text-xs font-semibold flex items-center justify-between gap-2 flex-wrap">
                    <div class="flex items-center gap-1.5">
                      <span class="material-symbols-outlined text-sm ${isDisetujui ? 'text-emerald-600' : 'text-rose-600'}">${isDisetujui ? 'verified' : 'cancel'}</span>
                      <span>${isDisetujui ? 'Permohonan ini telah disetujui oleh:' : 'Permohonan ditolak oleh:'} <strong class="font-black text-slate-900 underline decoration-slate-300 underline-offset-2">${p.approvedBy}</strong></span>
                    </div>
                    ${p.approvedAt ? `<span class="text-[10px] font-normal text-slate-500">${new Date(p.approvedAt).toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' })} WIB</span>` : ''}
                  </div>
                ` : isMenunggu ? `
                  <div class="p-2.5 rounded-xl bg-amber-50/70 border border-amber-200/70 text-amber-900 text-xs font-medium flex items-center gap-1.5">
                    <span class="material-symbols-outlined text-sm text-amber-600">hourglass_top</span>
                    <span>Menunggu peninjauan dan persetujuan dari dewan guru / wali kelas.</span>
                  </div>
                ` : ''}

                ${p.photoProof ? `
                  <div class="pt-2 border-t border-slate-100 flex items-center gap-3">
                    <a href="${p.photoProof}" target="_blank" class="block shrink-0 rounded-lg overflow-hidden border border-slate-200 w-16 h-12 bg-slate-100 hover:opacity-80 transition" title="Lihat Foto Bukti">
                      <img src="${p.photoProof}" alt="Bukti Surat" class="w-full h-full object-cover" />
                    </a>
                    <div class="text-[11px] text-slate-500">
                      <p class="font-bold text-slate-700">Foto Surat Bukti / Dispensasi Terlampir</p>
                      <a href="${p.photoProof}" target="_blank" class="text-blue-600 hover:underline">Perbesar / Unduh Berkas Bukti ↗</a>
                    </div>
                  </div>
                ` : ''}
              </div>
            `;
          }).join('');

          // Pasang handler tombol edit & delete
          myPermContainer.querySelectorAll('.btn-edit-my-perm').forEach((btn) => {
            btn.addEventListener('click', () => {
              const pid = (btn as HTMLElement).dataset.id;
              const targetPerm = civitasPerms.find((x: any) => x.id === pid);
              if (targetPerm) startEditPerm(targetPerm);
            });
          });

          myPermContainer.querySelectorAll('.btn-delete-my-perm').forEach((btn) => {
            btn.addEventListener('click', async () => {
              const pid = (btn as HTMLElement).dataset.id;
              if (!confirm(`Batalkan dan hapus permohonan izin dengan ID ${pid}?`)) return;
              try {
                const res = await fetch(`/api/permissions?id=${pid}`, { method: 'DELETE' });
                if (res.ok) {
                  await loadData();
                  alert('Permohonan izin berhasil dibatalkan / dihapus.');
                } else {
                  alert('Gagal membatalkan permohonan izin.');
                }
              } catch (err) {
                console.error('Gagal hapus izin:', err);
                alert('Terjadi kesalahan saat membatalkan izin.');
              }
            });
          });
        }
      }
    }

    let activeCategoryGuru = 'all';
    let searchQueryGuru = '';

    function renderGuruPermissionsList() {
      const container = document.getElementById('guru-permissions-confirm-list');
      const pendingBadge = document.getElementById('badge-guru-pending-count');
      const approvedBadge = document.getElementById('badge-guru-approved-count');
      if (!container) return;

      // Ambil permohonan siswa (non-guru)
      const allStudentPerms = allPermissions.filter((p: any) => {
        const civ = allCivitas.find((c: any) => c.id === p.studentId);
        return !civ || civ.role !== 'guru';
      });

      // Update counters
      const pendingCount = allStudentPerms.filter((p: any) => p.status === 'Menunggu').length;
      const approvedCount = allStudentPerms.filter((p: any) => p.status === 'Disetujui').length;
      if (pendingBadge) {
        pendingBadge.textContent = `${pendingCount} Menunggu`;
        pendingBadge.className = pendingCount > 0
          ? 'text-xs font-bold text-amber-800 bg-amber-100 border border-amber-300 px-3 py-1.5 rounded-xl animate-pulse'
          : 'text-xs font-bold text-emerald-800 bg-emerald-100 border border-emerald-300 px-3 py-1.5 rounded-xl';
      }
      if (approvedBadge) {
        approvedBadge.textContent = `${approvedCount} Disetujui`;
      }

      // Kategori counters
      const countAll = allStudentPerms.length;
      const countSakit = allStudentPerms.filter((p: any) => p.category === 'sakit').length;
      const countDisp = allStudentPerms.filter((p: any) => p.category === 'dispensasi').length;
      const countKel = allStudentPerms.filter((p: any) => p.category === 'keluarga' || p.category === 'izin').length;

      const elCountAll = document.getElementById('cat-count-all');
      const elCountSakit = document.getElementById('cat-count-sakit');
      const elCountDisp = document.getElementById('cat-count-dispensasi');
      const elCountKel = document.getElementById('cat-count-keluarga');
      if (elCountAll) elCountAll.textContent = String(countAll);
      if (elCountSakit) elCountSakit.textContent = String(countSakit);
      if (elCountDisp) elCountDisp.textContent = String(countDisp);
      if (elCountKel) elCountKel.textContent = String(countKel);

      // Filter berdasarkan kategori & search
      const q = searchQueryGuru.toLowerCase().trim();
      const filtered = allStudentPerms.filter((p: any) => {
        const matchCat = activeCategoryGuru === 'all'
          ? true
          : (activeCategoryGuru === 'keluarga' ? (p.category === 'keluarga' || p.category === 'izin') : p.category === activeCategoryGuru);
        const matchSearch = !q
          || (p.name || '').toLowerCase().includes(q)
          || (p.title || '').toLowerCase().includes(q)
          || (p.className || '').toLowerCase().includes(q);
        return matchCat && matchSearch;
      }).sort((a: any, b: any) => {
        if (a.status === 'Menunggu' && b.status !== 'Menunggu') return -1;
        if (a.status !== 'Menunggu' && b.status === 'Menunggu') return 1;
        return (b.startDate || '').localeCompare(a.startDate || '');
      });

      if (filtered.length === 0) {
        container.innerHTML = `
          <div class="bg-white rounded-2xl p-8 text-center text-slate-400 border border-slate-200/80">
            <span class="material-symbols-outlined text-4xl mb-2 text-slate-300 block">inbox</span>
            <p class="text-xs font-semibold text-slate-600">Tidak ada permohonan izin siswa yang sesuai.</p>
            <p class="text-[11px] text-slate-400 mt-1">Coba ubah tab kategori atau kata kunci pencarian di atas.</p>
          </div>
        `;
        return;
      }

      container.innerHTML = filtered.map((item: any) => {
        const isMenunggu = item.status === 'Menunggu';
        const isDisetujui = item.status === 'Disetujui';
        const isSelesai = item.status === 'Selesai';
        const isDitolak = item.status === 'Ditolak';

        // Badge status akurat (persis panel admin)
        const statusBadge = isMenunggu
          ? '<span class="px-3 py-0.5 rounded-full text-[11px] font-bold bg-amber-100 text-amber-900 border border-amber-300">Menunggu Persetujuan</span>'
          : isDisetujui
          ? '<span class="px-3 py-0.5 rounded-full text-[11px] font-bold bg-emerald-100 text-emerald-900 border border-emerald-300">Disetujui Sah</span>'
          : isSelesai
          ? '<span class="px-3 py-0.5 rounded-full text-[11px] font-bold bg-slate-100 text-slate-700 border border-slate-300">Selesai (Arsip)</span>'
          : '<span class="px-3 py-0.5 rounded-full text-[11px] font-bold bg-rose-100 text-rose-900 border border-rose-300">Ditolak</span>';

        const borderLeftColor = isMenunggu ? 'border-l-amber-500' : isDisetujui ? 'border-l-emerald-500' : isSelesai ? 'border-l-slate-400' : 'border-l-rose-500';

        // Category icon & gradient
        const isSakit = item.category === 'sakit';
        const isKeluarga = item.category === 'keluarga' || item.category === 'izin';
        const badgeGrad = isSakit ? 'from-emerald-500 to-teal-700' : isKeluarga ? 'from-indigo-500 to-purple-700' : 'from-blue-600 via-indigo-600 to-purple-600';
        const badgeTag = isSakit ? 'MEDIS' : isKeluarga ? 'IZIN' : 'DISPENSASI';

        // Action buttons: Opsi Setujui atau Tolak untuk Guru (persis panel admin)
        let actionHtml = '';
        if (isMenunggu) {
          actionHtml = `
            <div class="flex items-center gap-2">
              <button type="button" data-action="reject" data-id="${item.id}" class="btn-guru-action-reject px-3.5 py-2 rounded-xl bg-rose-50 hover:bg-rose-100 text-rose-800 border border-rose-200 text-xs font-bold transition-all duration-200 active:scale-95 flex items-center gap-1 cursor-pointer">
                <span class="material-symbols-outlined text-sm">cancel</span>
                <span>Tolak</span>
              </button>
              <button type="button" data-action="approve" data-id="${item.id}" class="btn-guru-action-approve px-4 py-2 rounded-xl bg-blue-600 hover:bg-blue-700 text-white text-xs font-bold transition-all duration-200 shadow-md shadow-blue-500/20 active:scale-95 flex items-center gap-1 cursor-pointer">
                <span class="material-symbols-outlined text-sm">check_circle</span>
                <span>Setujui</span>
              </button>
            </div>
          `;
        } else if (isDisetujui) {
          actionHtml = `
            <div class="flex items-center gap-2">
              <span class="px-3 py-1.5 rounded-xl bg-emerald-100 text-emerald-900 border border-emerald-300 text-xs font-bold flex items-center gap-1.5">
                <span class="material-symbols-outlined text-sm text-emerald-700">check_circle</span>
                <span>Disetujui Sah</span>
              </span>
              <button type="button" data-action="reject" data-id="${item.id}" class="btn-guru-action-reject px-3 py-1.5 rounded-xl bg-slate-100 hover:bg-rose-50 hover:text-rose-700 hover:border-rose-300 text-slate-600 border border-slate-200 text-xs font-semibold transition-all duration-200 active:scale-95 flex items-center gap-1 cursor-pointer" title="Batalkan dan ubah status ke Ditolak">
                <span class="material-symbols-outlined text-xs">close</span>
                <span>Tolak</span>
              </button>
            </div>
          `;
        } else if (isDitolak) {
          actionHtml = `
            <div class="flex items-center gap-2">
              <span class="px-3 py-1.5 rounded-xl bg-rose-100 text-rose-900 border border-rose-300 text-xs font-bold flex items-center gap-1.5">
                <span class="material-symbols-outlined text-sm text-rose-700">cancel</span>
                <span>Ditolak</span>
              </span>
              <button type="button" data-action="approve" data-id="${item.id}" class="btn-guru-action-approve px-3 py-1.5 rounded-xl bg-emerald-50 hover:bg-emerald-100 text-emerald-800 border border-emerald-300 text-xs font-bold transition-all duration-200 active:scale-95 flex items-center gap-1 cursor-pointer" title="Ubah status ke Disetujui">
                <span class="material-symbols-outlined text-xs">check_circle</span>
                <span>Setujui</span>
              </button>
            </div>
          `;
        } else {
          actionHtml = `
            <div class="flex items-center gap-2">
              <span class="px-3 py-1.5 rounded-xl bg-slate-100 text-slate-700 border border-slate-300 text-xs font-bold flex items-center gap-1.5">
                <span class="material-symbols-outlined text-sm text-slate-500">inventory_2</span>
                <span>Selesai (Arsip)</span>
              </span>
            </div>
          `;
        }

        return `
          <article class="bg-white rounded-2xl p-4 sm:p-5 shadow-xs hover:shadow-md transition-all duration-200 flex flex-col lg:flex-row lg:items-center justify-between gap-4 border-l-4 ${borderLeftColor} border border-slate-200/70" id="card-perm-${item.id}">
            <div class="flex items-start sm:items-center gap-4">
              <div class="w-16 h-16 sm:w-20 sm:h-20 rounded-2xl bg-gradient-to-br ${badgeGrad} p-2 text-white flex flex-col items-center justify-center text-center shrink-0 shadow-md">
                <span class="text-[9px] font-black uppercase tracking-wider text-white/90">${badgeTag}</span>
