          : isGuru
            ? "Detail Profil Pendidik & Rekap Mengajar"
            : "Detail Profil Akademik Siswa";
      }

      // 2. Data Sidebar Utama Khusus Siswa / Guru / Admin
      const sbAvatar = document.getElementById(
        "sidebar-avatar",
      ) as HTMLImageElement | null;
      const sbName = document.getElementById("sidebar-name");
      const sbRole = document.getElementById("sidebar-role");
      const sbWaBtn = document.getElementById(
        "sidebar-wa-btn",
      ) as HTMLAnchorElement | null;
      const sbWaText = document.getElementById("sidebar-wa-text");
      const sbPointBox = document.getElementById("sidebar-point-box");
      const sbPointBadge = document.getElementById("sidebar-point-badge");

      const isFemale =
        currentCivitas.gender === "P" || currentCivitas.gender === "Perempuan";
      const avatarSrc = isFemale
        ? "/assets/avatar_female.jpg"
        : "/assets/avatar_male.jpg";

      if (sbAvatar) sbAvatar.src = avatarSrc;
      if (sbName) sbName.textContent = currentCivitas.name;
      if (sbRole)
        sbRole.textContent = isAdmin
          ? "Administrator"
          : isGuru
            ? "Dewan Guru"
            : currentCivitas.className || "Siswa";

      // Tampilkan atau sesuaikan poin disiplin di sidebar (hanya siswa)
      if (sbPointBox && sbPointBadge) {
        if (isStaff) {
          sbPointBox.classList.add("hidden");
        } else {
          sbPointBox.classList.remove("hidden");
          sbPointBadge.textContent = "100 Poin";
        }
      }

      if (sbWaBtn && sbWaText) {
        if (isAdmin) {
          sbWaText.textContent = "Hubungi Admin via WA";
          sbWaBtn.href = `https://wa.me/6281234567890?text=Halo%20Admin%20${encodeURIComponent(currentCivitas.name)}`;
        } else if (isGuru) {
          sbWaText.textContent = "Hubungi Guru via WA";
          sbWaBtn.href = `https://wa.me/6281369014432?text=Halo%20Bapak%2FIbu%20${encodeURIComponent(currentCivitas.name)}`;
        } else {
          sbWaText.textContent = "Hubungi Wali via WA";
          sbWaBtn.href = `https://wa.me/6282177889900?text=Halo%20Wali%20Murid%20dari%20${encodeURIComponent(currentCivitas.name)}`;
        }
      }

      // 3. Section 1 (Biodata)
      const avatarEl = document.getElementById(
        "profile-avatar",
      ) as HTMLImageElement | null;
      const nameEl = document.getElementById("profile-name");
      const headlineEl = document.getElementById("profile-headline");
      const idLabelEl = document.getElementById("profile-id-label");
      const nisnEl = document.getElementById("profile-nisn");
      const regLabelEl = document.getElementById("profile-reg-label");
      const regDateEl = document.getElementById("profile-regdate");
      const birthEl = document.getElementById("profile-birth");
      const emailEl = document.getElementById("profile-email");
      const phoneLabelEl = document.getElementById("profile-phone-label");
      const phoneEl = document.getElementById("profile-phone");
      const btnWaAction = document.getElementById(
        "btn-wa-action",
      ) as HTMLAnchorElement | null;
      const btnWaText = document.getElementById("btn-wa-text");
      const badgeRoleTag = document.getElementById("badge-role-tag");
      const badgeRoleText = document.getElementById("badge-role-text");
      const badgeVerifTag = document.getElementById("badge-verif-tag");
