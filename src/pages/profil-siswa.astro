          : isGuru
            ? `${currentCivitas.className || "Dewan Guru"} • SMK Ma'arif 1 Padang Ratu`
            : `${currentCivitas.className || "Kelas Siswa"} • SMK Ma'arif 1 Padang Ratu`;
      }

      const customIdEl = document.getElementById("profile-custom-id");
      const nisnLabelEl = document.getElementById("profile-nisn-label");
      const cityLabelEl = document.getElementById("profile-city-label");
      const cityEl = document.getElementById("profile-city");
      const detailNameEl = document.getElementById("profile-detail-name");

      // Ambil data asli RFID UID dari database (Siswa tetap melihat UID miliknya; Admin terkunci hanya di database)
      const rawUid = (currentCivitas.rfidUid || "").trim().toUpperCase();
