        if (noPhotoAlert) noPhotoAlert.classList.add("hidden");
      } else {
        if (photoTag) photoTag.textContent = "Tanpa Berkas";
        if (photoContainer) photoContainer.classList.add("hidden");
        if (noPhotoAlert) noPhotoAlert.classList.remove("hidden");
      }

      // Approver info box
      if (approverBox) {
        if (item.approvedBy) {
          approverBox.className = `p-2.5 rounded-xl border text-xs font-semibold flex items-center justify-between gap-2 flex-wrap ${isDisetujui ? "bg-emerald-50/80 border-emerald-200 text-emerald-900" : "bg-rose-50/80 border-rose-200 text-rose-900"}`;
          approverBox.innerHTML = `
            <div class="flex items-center gap-1.5">
              <span class="material-symbols-outlined text-base ${isDisetujui ? "text-emerald-600" : "text-rose-600"}">${isDisetujui ? "verified" : "cancel"}</span>
              <span>${isDisetujui ? "Disetujui oleh:" : "Ditolak oleh:"} <strong class="text-slate-900">${item.approvedBy}</strong></span>
            </div>
            ${item.approvedAt ? `<span class="text-[10px] font-normal text-slate-500">${new Date(item.approvedAt).toLocaleDateString("id-ID", { day: "numeric", month: "short", hour: "2-digit", minute: "2-digit" })} WIB</span>` : ""}
          `;
          approverBox.classList.remove("hidden");
        } else {
          approverBox.classList.add("hidden");
        }
      }

      // Action buttons in modal footer
      if (actionGroup) {
        if (isMenunggu) {
          actionGroup.innerHTML = `
            <button type="button" id="btn-modal-reject" class="px-3 py-1.5 rounded-lg bg-rose-50 hover:bg-rose-100 text-rose-700 border border-rose-200 text-xs font-semibold transition flex items-center gap-1 cursor-pointer">
              <span class="material-symbols-outlined text-sm">close</span>
              <span>Tolak</span>
            </button>
            <button type="button" id="btn-modal-approve" class="px-3.5 py-1.5 rounded-lg bg-blue-600 hover:bg-blue-700 text-white text-xs font-semibold shadow-2xs transition flex items-center gap-1 cursor-pointer active:scale-95">
              <span class="material-symbols-outlined text-sm">check</span>
              <span>Setujui</span>
            </button>
          `;
          document
            .getElementById("btn-modal-reject")
            ?.addEventListener("click", () =>
              handleGuruUpdateStatus(item.id, "Ditolak"),
            );
          document
            .getElementById("btn-modal-approve")
            ?.addEventListener("click", () =>
              handleGuruUpdateStatus(item.id, "Disetujui"),
            );
        } else if (isDisetujui) {
          actionGroup.innerHTML = `
            <button type="button" id="btn-modal-reject" class="px-3 py-1.5 rounded-lg bg-rose-50 hover:bg-rose-100 text-rose-700 border border-rose-200 text-xs font-semibold transition flex items-center gap-1 cursor-pointer">
              <span class="material-symbols-outlined text-sm">close</span>
              <span>Batalkan</span>
            </button>
          `;
          document
            .getElementById("btn-modal-reject")
            ?.addEventListener("click", () =>
              handleGuruUpdateStatus(item.id, "Ditolak"),
            );
        } else {
          actionGroup.innerHTML = `
            <button type="button" id="btn-modal-approve" class="px-3.5 py-1.5 rounded-lg bg-blue-600 hover:bg-blue-700 text-white text-xs font-semibold shadow-2xs transition flex items-center gap-1 cursor-pointer">
              <span class="material-symbols-outlined text-sm">check</span>
              <span>Setujui</span>
            </button>
          `;
          document
            .getElementById("btn-modal-approve")
            ?.addEventListener("click", () =>
              handleGuruUpdateStatus(item.id, "Disetujui"),
            );
        }
      }

      modal.classList.remove("hidden");
    }

