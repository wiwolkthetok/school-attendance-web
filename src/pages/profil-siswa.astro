            type="text"
            id="form-izin-student"
            class="w-full p-2.5 rounded-xl bg-slate-100 border border-slate-200 text-slate-700 font-bold"
            readonly
          />
        </div>

        <div>
          <label class="block font-bold text-slate-700 mb-1">Jenis / Kategori Izin:</label>
          <select
            id="form-izin-category"
            class="w-full p-2.5 rounded-xl bg-white border border-slate-200 text-slate-800 font-semibold focus:ring-2 focus:ring-purple-500 focus:outline-hidden"
