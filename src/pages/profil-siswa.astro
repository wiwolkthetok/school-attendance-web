    async function handleGuruUpdateStatus(id: string, status: 'Disetujui' | 'Ditolak', triggerBtn?: HTMLButtonElement) {
      const currentTeacher = authCivitas?.name || currentCivitas?.name || 'Dewan Guru';
      if (triggerBtn) triggerBtn.disabled = true;

      try {
        const res = await fetch('/api/permissions', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            action: 'update_status',
            id,
            status,
            approvedBy: currentTeacher,
          }),
        });

        if (res.ok) {
          await loadData();
          closeGuruDetailModal();
          if ((window as any).showToast) {
            (window as any).showToast(`Permohonan berhasil ${status === 'Disetujui' ? 'disetujui sah' : 'ditolak'} oleh ${currentTeacher}`, 'success');
          } else {
            alert(`Permohonan izin siswa telah ${status === 'Disetujui' ? 'disetujui' : 'ditolak'} oleh ${currentTeacher}!`);
          }
        } else {
          alert('Gagal memperbarui status permohonan.');
          if (triggerBtn) triggerBtn.disabled = false;
        }
      } catch (err) {
        console.error('Error update izin oleh guru:', err);
        alert('Terjadi kesalahan jaringan.');
        if (triggerBtn) triggerBtn.disabled = false;
      }
    }

