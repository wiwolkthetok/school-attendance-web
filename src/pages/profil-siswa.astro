      if (badgeVerifTag && badgeVerifText) {
        if (isAdmin) {
          badgeVerifTag.className =
            "inline-flex items-center gap-1 px-2.5 py-1.5 rounded-xl bg-emerald-50 text-emerald-800 font-bold text-[11px] border border-emerald-200/80";
          badgeVerifText.textContent = "Admin Terverifikasi";
        } else if (isGuru) {
          badgeVerifTag.className =
            "inline-flex items-center gap-1 px-2.5 py-1.5 rounded-xl bg-emerald-50 text-emerald-800 font-bold text-[11px] border border-emerald-200/80";
          badgeVerifText.textContent = "NUPTK Terverifikasi";
        } else {
          badgeVerifTag.className = isAlumni
            ? "inline-flex items-center gap-1 px-2.5 py-1.5 rounded-xl bg-slate-100 text-slate-700 font-bold text-[11px] border border-slate-200"
            : "inline-flex items-center gap-1 px-2.5 py-1.5 rounded-xl bg-purple-50 text-purple-700 font-bold text-[11px] border border-purple-200/60";
          badgeVerifText.textContent = isAlumni
            ? "Alumni Terverifikasi"
            : "Terverifikasi Rombel";
        }
      }

      // Snapshot tiles
      const bioCardStatus = document.getElementById("bio-card-status");
      const bioClassStatus = document.getElementById("bio-class-status");
      const bioPresensiStatus = document.getElementById("bio-presensi-status");
      if (bioCardStatus) bioCardStatus.textContent = formattedUid;
      if (bioClassStatus)
        bioClassStatus.textContent =
          currentCivitas.className ||
          (isAdmin ? "Administrator" : isGuru ? "Dewan Guru" : "Siswa");

      // 4. Section 2 (Kartu RFID Asli)
      const cardUidEl = document.getElementById("card-uid-display");
      const cardMockupUid = document.getElementById("card-mockup-uid");
      const cardMockupName = document.getElementById("card-mockup-name");
      const cardMockupType = document.getElementById("card-mockup-type");
      const cardMockupRoleBadge = document.getElementById(
        "card-mockup-role-badge",
      );

      if (cardUidEl) cardUidEl.textContent = formattedUid;
      if (cardMockupUid)
        cardMockupUid.textContent = isAdmin
          ? "Admin Key (Database Only)"
          : `${formattedUid} (RFID)`;
      if (cardMockupName) cardMockupName.textContent = currentCivitas.name;

      if (cardMockupType) {
        cardMockupType.textContent = isAdmin
          ? "KARTU AKSES ADMINISTRATOR"
          : isGuru
            ? "KARTU AKSES DEWAN GURU"
            : "KARTU AKSES CERDAS SISWA";
      }

      if (cardMockupRoleBadge) {
        cardMockupRoleBadge.textContent = isAdmin
          ? "ADMIN 13.56 MHz"
          : isGuru
            ? "GURU 13.56 MHz"
            : "RFID 13.56 MHz";
      }

      // 5. Section 3 (Linimasa) & Status Presensi Harian
      const civitasLogs = allLogs.filter(
        (l: any) =>
          (l.rfidUid &&
            currentCivitas.rfidUid &&
            l.rfidUid.toUpperCase() === currentCivitas.rfidUid.toUpperCase()) ||
          l.name === currentCivitas.name,
      );
      const civitasPerms = allPermissions.filter(
        (p: any) =>
          p.studentId === currentCivitas.id ||
          (p.name &&
            currentCivitas.name &&
            p.name.toLowerCase() === currentCivitas.name.toLowerCase()),
      );

      const todayStr = new Date().toLocaleDateString("en-CA", {
        timeZone: "Asia/Jakarta",
      });
      const activeApprovedPerm = civitasPerms.find(
        (p: any) =>
          p.status === "Disetujui" &&
          todayStr >= p.startDate &&
          todayStr <= (p.endDate || p.startDate),
      );

      // Status Presensi Snapshot di Bio
      if (bioPresensiStatus) {
        if (activeApprovedPerm) {
          bioPresensiStatus.textContent = `Izin (${activeApprovedPerm.categoryLabel || "Izin"})`;
          bioPresensiStatus.className = "text-xs font-black text-purple-700";
        } else if (civitasLogs.length > 0) {
          const latest = civitasLogs[civitasLogs.length - 1];
          if (latest.status === "Bolos") {
            bioPresensiStatus.textContent = "Bolos (-10 Poin)";
            bioPresensiStatus.className =
              "text-xs font-black text-rose-600 animate-pulse";
          } else if (latest.status === "Hadir") {
            bioPresensiStatus.textContent =
              latest.type === "pulang" ? "Sudah Pulang" : "Hadir Tepat Waktu";
            bioPresensiStatus.className = "text-xs font-black text-emerald-600";
          } else {
            bioPresensiStatus.textContent = latest.status;
            bioPresensiStatus.className = "text-xs font-black text-amber-600";
          }
        } else {
          const isHol =
            typeof (window as any).isSchoolHoliday === "function"
              ? (window as any).isSchoolHoliday()
              : new Date().getDay() === 0;
          if (isHol) {
            bioPresensiStatus.textContent = "Libur Sekolah (Minggu)";
            bioPresensiStatus.className = "text-xs font-black text-indigo-600";
          } else {
            bioPresensiStatus.textContent = isAlumni
              ? "Alumni (Lulus)"
              : "Belum Hadir";
            bioPresensiStatus.className = "text-xs font-black text-slate-500";
          }
        }
      }

      const timelineTitleText = document.getElementById("timeline-title-text");
      const timelineCardDesc = document.getElementById("timeline-card-desc");
      const timelineItem1Title = document.getElementById(
        "timeline-item1-title",
      );
      const timelinePresensiBadge = document.getElementById(
        "timeline-presensi-badge",
      );
      const timelinePresensiDesc = document.getElementById(
        "timeline-presensi-desc",
      );
      const timelinePresensiId = document.getElementById(
        "timeline-presensi-id",
      );

      const timelineItem2Title = document.getElementById(
        "timeline-item2-title",
      );
      const timelineIzinBadge = document.getElementById("timeline-izin-badge");
      const timelineIzinDesc = document.getElementById("timeline-izin-desc");
      const timelineItem2Sub = document.getElementById("timeline-item2-sub");

      if (timelineTitleText)
        timelineTitleText.textContent = isGuru
          ? "History Aktivitas & Catatan Pendidik"
          : "History Aktivitas & Catatan Siswa";
      if (timelineCardDesc)
        timelineCardDesc.textContent = isGuru
          ? "Jejak presensi gerbang, verifikasi perizinan, dan riwayat kedatangan."
          : "Jejak presensi gerbang, verifikasi perizinan, dan riwayat presensi kartu.";
      if (timelineItem1Title)
        timelineItem1Title.textContent = isGuru
          ? "Presensi Pendidik Hari Ini"
          : "Presensi Gerbang Hari Ini";

      if (activeApprovedPerm) {
        if (timelinePresensiBadge) {
          timelinePresensiBadge.textContent = `Izin (${activeApprovedPerm.categoryLabel || "Sah"})`;
          timelinePresensiBadge.className =
            "px-2 py-0.5 rounded-md text-[10px] font-black uppercase tracking-wider bg-purple-600 text-white";
        }
        if (timelinePresensiDesc) {
          timelinePresensiDesc.textContent = `Status Presensi Hari Ini: Izin Resmi (${activeApprovedPerm.categoryLabel || "Izin"}) • Alasan: "${activeApprovedPerm.title}". Terkunci seharian sebagai izin sah.`;
        }
        if (timelinePresensiId)
          timelinePresensiId.textContent = activeApprovedPerm.id;
      } else if (civitasLogs.length > 0) {
        const latest = civitasLogs[civitasLogs.length - 1];
        if (timelinePresensiBadge) {
          timelinePresensiBadge.textContent = latest.status || "Hadir";
          if (latest.status === "Bolos") {
            timelinePresensiBadge.className =
              "px-2 py-0.5 rounded text-[10px] font-mono font-medium uppercase bg-rose-50 text-rose-700 border border-rose-200";
          } else if (latest.status === "Hadir") {
            timelinePresensiBadge.className =
              "px-2 py-0.5 rounded text-[10px] font-mono font-medium uppercase bg-emerald-50 text-emerald-700 border border-emerald-200";
          } else {
            timelinePresensiBadge.className =
              "px-2 py-0.5 rounded text-[10px] font-mono font-medium uppercase bg-amber-50 text-amber-700 border border-amber-200";
          }
        }
        if (timelinePresensiDesc) {
          if (latest.status === "Bolos") {
            timelinePresensiDesc.textContent = `Tercatat presensi masuk pagi namun TIDAK melakukan presensi kepulangan (Bolos • Poin berkurang -20).`;
          } else {
            timelinePresensiDesc.textContent = `Tap ${latest.type || "masuk"} pada pukul ${latest.time} WIB • Status: ${latest.status} (Gerbang Utama)`;
          }
        }
        if (timelinePresensiId) timelinePresensiId.textContent = latest.id;
      } else {
        const isHol =
          typeof (window as any).isSchoolHoliday === "function"
            ? (window as any).isSchoolHoliday()
            : new Date().getDay() === 0;
        if (timelinePresensiBadge) {
          timelinePresensiBadge.textContent = isHol ? "Libur" : "Belum Hadir";
          timelinePresensiBadge.className = isHol
            ? "px-2 py-0.5 rounded text-[10px] font-mono font-medium uppercase bg-slate-100 text-slate-600 border border-slate-200"
            : "px-2 py-0.5 rounded text-[10px] font-mono font-medium uppercase bg-slate-100 text-slate-600 border border-slate-200";
        }
        if (timelinePresensiDesc) {
          timelinePresensiDesc.textContent = isHol
            ? "Hari ini adalah hari Minggu (Libur Sekolah Akhir Pekan). Siswa dan guru tidak ada jadwal KBM."
            : isGuru
              ? "Belum ada pemindaian kartu RFID guru pada hari ini."
              : "Belum ada pemindaian kartu RFID siswa pada hari ini.";
        }
        if (timelinePresensiId)
          timelinePresensiId.textContent = isHol
            ? "LIBUR-AKHIR-PEKAN"
            : "MENUNGGU-SCAN";
      }

      if (isGuru) {
        if (timelineItem2Title)
          timelineItem2Title.textContent = "Status Kehadiran & Tugas Pendidik";
        if (timelineIzinBadge) {
          timelineIzinBadge.textContent = "Aktif Bertugas";
          timelineIzinBadge.className =
            "px-2 py-0.5 rounded-md text-[10px] font-black uppercase tracking-wider bg-emerald-600 text-white";
        }
        if (timelineIzinDesc)
          timelineIzinDesc.textContent =
            "Guru aktif bertugas mengajar KBM dan bimbingan kejuruan di sekolah.";
        if (timelineItem2Sub)
          timelineItem2Sub.textContent =
            "Status kedisiplinan guru dipantau melalui Rapor Kinerja Pendidik.";
        const timelineIzinActionsBox = document.getElementById(
          "timeline-izin-actions-box",
        );
        if (timelineIzinActionsBox) {
          timelineIzinActionsBox.innerHTML =
            '<span class="text-[11px] text-slate-500">Presensi pendidik berlaku 1 kali per hari kerja.</span>';
        }
      } else {
        if (timelineItem2Title)
          timelineItem2Title.textContent = "Status Perizinan & Pengajuan Izin";
        const timelineIzinActionsBox = document.getElementById(
          "timeline-izin-actions-box",
        );

        if (civitasPerms.length > 0) {
          const p = civitasPerms[0];
          const status = p.status || "Menunggu";

          if (timelineIzinBadge) {
            if (status === "Disetujui") {
              timelineIzinBadge.textContent = "Disetujui (Aktif)";
              timelineIzinBadge.className =
                "px-2 py-0.5 rounded-md text-[10px] font-black uppercase tracking-wider bg-emerald-600 text-white";
            } else if (status === "Selesai") {
              timelineIzinBadge.textContent = "Selesai (Diarsipkan)";
              timelineIzinBadge.className =
                "px-2 py-0.5 rounded-md text-[10px] font-black uppercase tracking-wider bg-slate-600 text-white";
            } else if (status === "Ditolak") {
              timelineIzinBadge.textContent = "Ditolak";
              timelineIzinBadge.className =
                "px-2 py-0.5 rounded-md text-[10px] font-black uppercase tracking-wider bg-rose-600 text-white";
            } else {
              timelineIzinBadge.textContent = "Menunggu Persetujuan";
              timelineIzinBadge.className =
                "px-2 py-0.5 rounded-md text-[10px] font-black uppercase tracking-wider bg-amber-500 text-white animate-pulse";
            }
          }

          if (timelineIzinDesc) {
            timelineIzinDesc.textContent = `${p.title || "Izin"} • ${p.categoryLabel || "Keterangan"} (${p.daysCount || 1} Hari: ${p.startDate} s/d ${p.endDate})`;
          }

          if (timelineItem2Sub) {
            timelineItem2Sub.textContent = `Lampiran: ${p.attachmentNote || "Surat Resmi Sekolah"}`;
          }

          if (timelineIzinActionsBox) {
            timelineIzinActionsBox.innerHTML = `
              <div class="flex items-center gap-1.5 text-[11px] font-semibold text-slate-700">
                <span>Status Verifikasi Sekolah:</span>
                <span class="font-bold px-2 py-0.5 rounded-md ${
                  status === "Disetujui"
                    ? "bg-emerald-100 text-emerald-800"
                    : status === "Selesai"
                      ? "bg-slate-100 text-slate-800"
                      : status === "Ditolak"
                        ? "bg-rose-100 text-rose-800"
                        : "bg-amber-100 text-amber-800"
                }">
                  ${status === "Disetujui" ? "✓ Diterima (Disetujui)" : status === "Selesai" ? "✓ Izin Telah Selesai & Diarsipkan" : status === "Ditolak" ? "✗ Tidak Diterima / Ditolak" : "⏳ Menunggu Persetujuan Guru"}
                </span>
              </div>
              <div class="flex items-center gap-1">
                ${
                  status === "Disetujui"
                    ? `
                  <button
                    type="button"
                    class="btn-toggle-perm-status px-2.5 py-1 rounded-lg bg-slate-100 hover:bg-slate-200 text-slate-800 border border-slate-300 text-[10px] font-bold cursor-pointer transition"
                    data-id="${p.id}"
                    data-status="Selesai"
                    title="Akhiri masa izin dan arsipkan ke riwayat"
                  >
                    ⏹ Selesaikan Izin
                  </button>
                `
                    : `
                  <button
                    type="button"
                    class="btn-toggle-perm-status px-2.5 py-1 rounded-lg bg-emerald-50 hover:bg-emerald-100 text-emerald-800 border border-emerald-200 text-[10px] font-bold cursor-pointer transition"
                    data-id="${p.id}"
                    data-status="Disetujui"
                  >
                    ✓ Terima Izin
                  </button>
                `
                }
                <button
                  type="button"
                  class="btn-toggle-perm-status px-2.5 py-1 rounded-lg bg-rose-50 hover:bg-rose-100 text-rose-800 border border-rose-200 text-[10px] font-bold cursor-pointer transition"
                  data-id="${p.id}"
                  data-status="Ditolak"
                >
                  ✗ Tolak Izin
                </button>
              </div>
            `;

            timelineIzinActionsBox
              .querySelectorAll(".btn-toggle-perm-status")
              .forEach((btn) => {
                btn.addEventListener("click", async () => {
                  const pid = (btn as HTMLElement).dataset.id;
                  const newStatus = (btn as HTMLElement).dataset.status;
                  try {
                    const res = await fetch("/api/permissions", {
                      method: "POST",
                      headers: { "Content-Type": "application/json" },
                      body: JSON.stringify({
                        action: "update_status",
                        id: pid,
                        status: newStatus,
                      }),
                    });
                    if (res.ok) {
                      await loadData();
                    }
                  } catch (err) {
                    console.error("Gagal update status izin:", err);
                  }
                });
              });
          }
        } else {
          if (timelineIzinBadge) {
            timelineIzinBadge.textContent = "Nihil Izin";
            timelineIzinBadge.className =
              "px-2 py-0.5 rounded text-[10px] font-mono font-medium uppercase bg-slate-100 text-slate-600 border border-slate-200";
          }
          if (timelineIzinDesc) {
            timelineIzinDesc.textContent =
              "Tidak ada catatan izin aktif. Siswa aktif hadir di kelas.";
          }
          if (timelineItem2Sub) {
            timelineItem2Sub.textContent = "";
            timelineItem2Sub.className = "hidden";
          }
          if (timelineIzinActionsBox) {
            timelineIzinActionsBox.innerHTML = "";
          }
        }
      }

      // Render Item 4: Riwayat Jejak Presensi Real Siswa Ini
      const tlHistoryTitle = document.getElementById("timeline-history-title");
      const tlHistoryBadge = document.getElementById("timeline-history-badge");
      const tlHistoryList = document.getElementById("timeline-history-list");

      if (tlHistoryTitle) {
        tlHistoryTitle.textContent = isGuru
          ? "Riwayat Presensi Mengajar & Kehadiran Pendidik"
          : `Riwayat Jejak Presensi Gerbang (${currentCivitas.name.split(" ")[0]})`;
      }

      if (tlHistoryBadge) {
        tlHistoryBadge.textContent =
          civitasLogs.length > 0 ? `${civitasLogs.length} Log` : "0 Log";
        tlHistoryBadge.className =
          "px-2 py-0.5 rounded text-[10px] font-mono font-medium uppercase bg-slate-100 text-slate-600 border border-slate-200";
      }

      if (tlHistoryList) {
        if (civitasLogs.length === 0) {
          tlHistoryList.innerHTML = `
            <div class="p-3.5 rounded-xl bg-white border border-slate-200/80 text-xs text-slate-600 flex items-center gap-3">
              <div class="w-8 h-8 rounded-lg bg-slate-100 text-slate-500 flex items-center justify-center shrink-0">
                <span class="material-symbols-outlined text-lg">event_busy</span>
              </div>
              <div>
                <p class="font-bold text-slate-800">Belum Ada Riwayat Presensi</p>
                <p class="text-[11px] text-slate-500">Siswa ini belum memiliki log pemindaian kartu RFID. Data riwayat presensi masuk dan keterlambatan hanya akan tercatat di akun siswa ini saat kartu di-tap.</p>
              </div>
            </div>
          `;
        } else {
          const reversedLogs = [...civitasLogs].reverse();
          tlHistoryList.innerHTML = reversedLogs
            .map((log: any, idx: number) => {
              const isBolos = log.status === "Bolos";
              const isLate = log.status === "Terlambat";
              const isMasuk = log.type === "masuk";

              let borderBg = "border-slate-200";
              if (isBolos) borderBg = "border-rose-300 bg-rose-50/40";
              else if (isLate) borderBg = "border-amber-300 bg-amber-50/30";

              let badgeHtml = "";
              if (isBolos) {
                badgeHtml =
                  '<span class="px-2 py-0.5 rounded border text-[10px] font-mono font-bold tracking-wider uppercase bg-rose-50 text-rose-700 border-rose-200 shrink-0">BOLOS</span>';
              } else if (isLate) {
                badgeHtml =
                  '<span class="px-2 py-0.5 rounded border text-[10px] font-mono font-bold tracking-wider uppercase bg-amber-50 text-amber-700 border-amber-200 shrink-0">TERLAMBAT</span>';
              } else {
                badgeHtml =
                  '<span class="px-2 py-0.5 rounded border text-[10px] font-mono font-bold tracking-wider uppercase bg-emerald-50 text-emerald-700 border-emerald-200 shrink-0">HADIR</span>';
              }

              return `
              <div class="p-3 rounded-xl bg-white border ${borderBg} flex items-center justify-between gap-3 text-xs flex-wrap">
                <div class="flex items-center gap-2.5">
                  <span class="w-6 h-6 rounded-lg ${isBolos ? "bg-rose-100 text-rose-800" : isLate ? "bg-amber-100 text-amber-800" : "bg-emerald-100 text-emerald-800"} text-[11px] font-black flex items-center justify-center">
                    #${civitasLogs.length - idx}
                  </span>
                  <div>
                    <div class="flex items-center gap-2">
                      <span class="font-bold text-slate-800">${log.date}</span>
                      <span class="font-mono text-slate-500 text-[11px] font-semibold">${log.time} WIB</span>
                    </div>
                    <p class="text-[11px] text-slate-500">
                      Sesi: <span class="font-semibold text-slate-700 uppercase">${isMasuk ? "Presensi Masuk (Pagi)" : "Presensi Pulang"}</span> • ID: <span class="font-mono text-slate-400">${log.id}</span>
                    </p>
                  </div>
                </div>
                <div class="flex items-center gap-1.5">
                  ${badgeHtml}
                </div>
              </div>
            `;
            })
            .join("");
        }
      }

      // 6. Section 4: Poin Disiplin Siswa (Sesuai ide.txt)
      updatePointsDisplay();

      // 7. Section 5 (Rapor)
      const raporCategoryTag = document.getElementById("rapor-category-tag");
      const raporTitle = document.getElementById("rapor-title");
      const raporSubtitle = document.getElementById("rapor-subtitle");
      const raporStatsContainer = document.getElementById(
        "rapor-stats-container",
      );
      const raporActionText = document.getElementById("rapor-action-text");

      if (isGuru) {
        if (raporCategoryTag)
          raporCategoryTag.textContent = "Rapor Kinerja & Presensi Guru";
        if (raporTitle)
          raporTitle.textContent = "Indikator Kinerja Pendidik Profesional";
        if (raporSubtitle)
          raporSubtitle.textContent =
            "Catatan kehadiran dan kedisiplinan mengajar semester berjalan.";
        if (raporActionText)
          raporActionText.textContent = "Cetak Rapor Kinerja & Kartu Pendidik";

        const teacherTotal = civitasLogs.length;
        const teacherOnTime = civitasLogs.filter(
          (l: any) => l.status === "Hadir",
        ).length;
        const teacherLate = civitasLogs.filter(
          (l: any) => l.status === "Terlambat",
        ).length;
        const teacherRatio =
          teacherTotal > 0
            ? Math.round((teacherOnTime / teacherTotal) * 100)
            : 100;

        if (raporStatsContainer) {
          raporStatsContainer.innerHTML = `
            <div class="p-3 rounded-lg bg-slate-50 border border-slate-200/60 flex items-center gap-3">
              <span class="w-2 h-2 rounded-full bg-emerald-500 shrink-0"></span>
              <div>
                <p class="text-[10px] font-mono text-slate-400 uppercase tracking-wider">Rasio Mengajar</p>
                <p class="text-xs sm:text-sm font-bold text-slate-900 mt-0.5">${teacherRatio}% (${teacherRatio === 100 ? "Sangat Baik" : "Cukup"})</p>
              </div>
            </div>
            <div class="p-3 rounded-lg bg-slate-50 border border-slate-200/60 flex items-center gap-3">
              <span class="w-2 h-2 rounded-full bg-emerald-500 shrink-0"></span>
              <div>
                <p class="text-[10px] font-mono text-slate-400 uppercase tracking-wider">Tepat Waktu</p>
                <p class="text-xs sm:text-sm font-bold text-slate-900 mt-0.5">${teacherOnTime} Hari</p>
              </div>
            </div>
            <div class="p-3 rounded-lg bg-slate-50 border border-slate-200/60 flex items-center gap-3">
              <span class="w-2 h-2 rounded-full bg-amber-500 shrink-0"></span>
              <div>
                <p class="text-[10px] font-mono text-slate-400 uppercase tracking-wider">Keterlambatan</p>
                <p class="text-xs sm:text-sm font-bold text-slate-900 mt-0.5">${teacherLate} Hari</p>
              </div>
            </div>
            <div class="p-3 rounded-lg bg-slate-50 border border-slate-200/60 flex items-center gap-3">
              <span class="w-2 h-2 rounded-full bg-blue-500 shrink-0"></span>
              <div>
                <p class="text-[10px] font-mono text-slate-400 uppercase tracking-wider">Surat Tugas / Izin</p>
                <p class="text-xs sm:text-sm font-bold text-slate-900 mt-0.5">${civitasPerms.length} Berkas</p>
              </div>
            </div>
          `;
        }
      } else {
        if (raporCategoryTag)
          raporCategoryTag.textContent = "Rapor Kehadiran & Prestasi";
        if (raporTitle)
          raporTitle.textContent = "Indikator Portofolio Siswa Berprestasi";
        if (raporSubtitle)
          raporSubtitle.textContent =
            "Catatan kedisiplinan semester berjalan di SMK Ma'arif 1 Padang Ratu.";
        if (raporActionText)
          raporActionText.textContent = "Cetak Rapor & Kartu";

        const totalLogs = civitasLogs.length;
        const onTimeCount = civitasLogs.filter(
          (l: any) => l.status === "Hadir",
        ).length;
        const lateCount = civitasLogs.filter(
          (l: any) => l.status === "Terlambat",
        ).length;
        const ratio =
          totalLogs > 0 ? Math.round((onTimeCount / totalLogs) * 100) : 100;

        if (raporStatsContainer) {
          raporStatsContainer.innerHTML = `
            <div class="p-3 rounded-lg bg-slate-50 border border-slate-200/60 flex items-center gap-3">
              <span class="w-2 h-2 rounded-full bg-emerald-500 shrink-0"></span>
              <div>
                <p class="text-[10px] font-mono text-slate-400 uppercase tracking-wider">Rasio Kehadiran</p>
                <p class="text-xs sm:text-sm font-bold text-slate-900 mt-0.5">${ratio}% (${ratio === 100 ? "Sangat Baik" : "Perlu Evaluasi"})</p>
              </div>
            </div>
            <div class="p-3 rounded-lg bg-slate-50 border border-slate-200/60 flex items-center gap-3">
              <span class="w-2 h-2 rounded-full bg-emerald-500 shrink-0"></span>
              <div>
                <p class="text-[10px] font-mono text-slate-400 uppercase tracking-wider">Hadir Tepat Waktu</p>
                <p class="text-xs sm:text-sm font-bold text-slate-900 mt-0.5">${onTimeCount} Hari</p>
              </div>
            </div>
            <div class="p-3 rounded-lg bg-slate-50 border border-slate-200/60 flex items-center gap-3">
              <span class="w-2 h-2 rounded-full bg-amber-500 shrink-0"></span>
              <div>
                <p class="text-[10px] font-mono text-slate-400 uppercase tracking-wider">Keterlambatan</p>
                <p class="text-xs sm:text-sm font-bold text-slate-900 mt-0.5">${lateCount} Hari</p>
              </div>
            </div>
            <div class="p-3 rounded-lg bg-slate-50 border border-slate-200/60 flex items-center gap-3">
              <span class="w-2 h-2 rounded-full bg-purple-500 shrink-0"></span>
              <div>
                <p class="text-[10px] font-mono text-slate-400 uppercase tracking-wider">Izin Sah / Dispensasi</p>
                <p class="text-xs sm:text-sm font-bold text-slate-900 mt-0.5">${civitasPerms.length} Berkas</p>
              </div>
            </div>
          `;
        }
      }

      // 8. Section 6: Pengajuan Permohonan Izin & Riwayat Permohonan Izin Saya
      renderIzinSection(isGuru, civitasPerms);
    }

    async function updatePointsDisplay() {
      if (!currentCivitas) return;
      const isGuru = currentCivitas.role === "guru";
      const isAdmin = currentCivitas.role === "admin";
      const isStaff = isGuru || isAdmin;

      const studentView = document.getElementById("poin-student-view");
      const guruView = document.getElementById("poin-guru-view");
      const sbPointBox = document.getElementById("sidebar-point-box");
      const sbPointBadge = document.getElementById("sidebar-point-badge");
      const poinDisplayVal = document.getElementById("poin-display-val");
      const circleContainer = document.getElementById("poin-circle-container");
      const poinStatusPill = document.getElementById("poin-status-pill");
      const poinHistoryCount = document.getElementById("poin-history-count");
      const poinHistoryContainer = document.getElementById(
        "poin-history-container",
      );

      if (isStaff) {
        if (sbPointBox) sbPointBox.classList.add("hidden");
        if (studentView) studentView.classList.add("hidden");
        if (guruView) guruView.classList.remove("hidden");
        return;
      }

      if (sbPointBox) sbPointBox.classList.remove("hidden");
      if (studentView) studentView.classList.remove("hidden");
      if (guruView) guruView.classList.add("hidden");

      try {
        const res = await fetch(
          `/api/points?studentId=${currentCivitas.id}&rfid=${currentCivitas.rfidUid}`,
        );
        const summary = await res.json();
        const points = Number(summary.totalPoints ?? 100);
        const deductions = summary.deductions || [];

        // 1. Update Sidebar Badge
        if (sbPointBadge) {
          sbPointBadge.textContent = `${points} Poin`;
          if (points >= 50) {
            sbPointBadge.className =
              "px-2 py-0.5 rounded-md bg-emerald-50 text-emerald-700 border border-emerald-200 font-mono font-bold text-[11px]";
          } else if (points >= 10) {
            sbPointBadge.className =
              "px-2 py-0.5 rounded-md bg-amber-50 text-amber-700 border border-amber-200 font-mono font-bold text-[11px]";
          } else {
            sbPointBadge.className =
              "px-2 py-0.5 rounded-md bg-rose-50 text-rose-700 border border-rose-200 font-mono font-bold text-[11px] animate-pulse";
          }
        }

        // 2. Update Big Points Circle
        if (poinDisplayVal) poinDisplayVal.textContent = String(points);
        if (circleContainer) {
          if (points >= 50) {
            circleContainer.className =
              "w-28 h-28 rounded-full border-4 border-emerald-500/20 flex flex-col items-center justify-center bg-emerald-50/40 relative transition-all mx-auto my-2";
            if (poinDisplayVal)
              poinDisplayVal.className =
                "text-3xl font-bold text-emerald-600 font-mono";
          } else if (points >= 10) {
            circleContainer.className =
              "w-28 h-28 rounded-full border-4 border-amber-500/20 flex flex-col items-center justify-center bg-amber-50/40 relative transition-all mx-auto my-2";
            if (poinDisplayVal)
              poinDisplayVal.className =
                "text-3xl font-bold text-amber-600 font-mono";
          } else {
            circleContainer.className =
              "w-28 h-28 rounded-full border-4 border-rose-500/20 flex flex-col items-center justify-center bg-rose-50/40 relative transition-all mx-auto my-2";
            if (poinDisplayVal)
              poinDisplayVal.className =
                "text-3xl font-bold text-rose-600 font-mono animate-pulse";
          }
        }

        // 3. Update Status Pill
        if (poinStatusPill) {
          if (points === 100) {
            poinStatusPill.className =
              "px-2.5 py-0.5 rounded text-[11px] font-mono font-medium bg-emerald-50 text-emerald-700 border border-emerald-200 inline-block";
            poinStatusPill.textContent = "Status: Disiplin (100 Poin)";
          } else if (points >= 50) {
            poinStatusPill.className =
              "px-2.5 py-0.5 rounded text-[11px] font-mono font-medium bg-blue-50 text-blue-700 border border-blue-200 inline-block";
            poinStatusPill.textContent = `Status: Aktif (${points} Poin)`;
          } else if (points >= 10) {
            poinStatusPill.className =
              "px-2.5 py-0.5 rounded text-[11px] font-mono font-medium bg-amber-50 text-amber-700 border border-amber-200 inline-block";
            poinStatusPill.textContent = `Peringatan (${points} Poin)`;
          } else if (points > 0) {
            poinStatusPill.className =
              "px-2.5 py-0.5 rounded text-[11px] font-mono font-medium bg-rose-50 text-rose-700 border border-rose-200 inline-block animate-pulse";
            poinStatusPill.textContent = `Kritis (${points} Poin)`;
          } else {
            poinStatusPill.className =
              "px-2.5 py-0.5 rounded text-[11px] font-mono font-bold bg-rose-600 text-white inline-block";
            poinStatusPill.textContent = "Akses Terkunci";
          }
        }

        // 4. Update History Count
        if (poinHistoryCount) {
          poinHistoryCount.textContent =
            deductions.length > 0
              ? `${deductions.length} Kali Pengurangan Poin`
              : "0 Pelanggaran (Bersih)";
        }

        // 5. Render History List
        if (poinHistoryContainer) {
          if (deductions.length === 0) {
            poinHistoryContainer.innerHTML = `
              <div class="p-3.5 rounded-lg bg-slate-50/70 border border-slate-200/60 flex items-center gap-3">
                <div class="w-8 h-8 rounded-lg bg-emerald-50 text-emerald-600 border border-emerald-100 flex items-center justify-center shrink-0">
                  <span class="material-symbols-outlined text-base">verified</span>
                </div>
                <div class="text-xs space-y-0.5">
                  <p class="font-bold text-slate-800">Catatan Poin Bersih</p>
                  <p class="text-slate-500 text-[11px]">Siswa hadir tepat waktu tanpa catatan pengurangan poin semester ini.</p>
                </div>
              </div>
            `;
          } else {
            poinHistoryContainer.innerHTML = deductions
              .map((d: any, idx: number) => {
                let formattedDate = d.date;
                try {
                  const parts = d.date.split("-");
                  if (parts.length === 3) {
                    const dObj = new Date(
                      Number(parts[0]),
                      Number(parts[1]) - 1,
                      Number(parts[2]),
                    );
                    formattedDate = dObj.toLocaleDateString("id-ID", {
                      weekday: "long",
                      year: "numeric",
                      month: "short",
                      day: "numeric",
                    });
                  }
                } catch {}

                return `
                <div class="p-3.5 rounded-lg bg-white border border-slate-200/80 shadow-2xs hover:border-slate-300 transition-colors space-y-2">
                  <div class="flex items-center justify-between gap-2 flex-wrap">
                    <div class="flex items-center gap-2">
                      <span class="w-6 h-6 rounded-md bg-rose-50 text-rose-700 border border-rose-200 text-xs font-mono font-bold flex items-center justify-center">
                        #${deductions.length - idx}
                      </span>
                      <span class="text-xs font-bold text-slate-800">${formattedDate}</span>
                      <span class="text-[11px] font-mono text-slate-400">• ${d.time} WIB</span>
                    </div>
                    <div class="flex items-center gap-1.5">
                      <span class="px-2 py-0.5 rounded text-[10px] font-mono font-medium ${d.minutesLate > 0 ? "bg-amber-50 text-amber-700 border border-amber-200" : "bg-rose-50 text-rose-700 border border-rose-200"}">
                        ${d.minutesLate > 0 ? `Telat ${d.minutesLate} Mnt` : "Bolos"}
                      </span>
                      <span class="px-2 py-0.5 rounded text-[10px] font-mono font-bold bg-rose-50 text-rose-700 border border-rose-200">
                        -${d.pointsDeducted} Poin
                      </span>
                      <span class="px-2 py-0.5 rounded text-[10px] font-mono font-medium bg-slate-100 text-slate-600 border border-slate-200">
                        Sisa ${d.remainingPoints ?? "-"} Poin
                      </span>
                    </div>
                  </div>

                  <!-- Alasan / Keterangan Sebab Poin Berkurang -->
                  <div class="p-2 rounded-md bg-slate-50 border border-slate-200/60 text-xs text-slate-600 flex items-start gap-2">
                    <span class="material-symbols-outlined text-rose-500 text-sm shrink-0 mt-0.5">report_problem</span>
                    <div class="min-w-0">
                      <p class="text-[11px] text-slate-600">${d.reason}</p>
                    </div>
                  </div>
                </div>
              `;
              })
              .join("");
          }
        }

        // 6. Render Item Linimasa Presensi (Section yang Dipilih User)
        const tlPoinNode = document.getElementById("timeline-item-poin-node");
        const tlPoinCard = document.getElementById("timeline-poin-card");
        const tlPoinDot = document.getElementById("timeline-poin-dot");
        const tlPoinDotInner = document.getElementById(
          "timeline-poin-dot-inner",
        );
        const tlPoinBadge = document.getElementById("timeline-poin-badge");
        const tlPoinRemaining = document.getElementById(
          "timeline-poin-remaining",
        );
        const tlPoinDetailBox = document.getElementById(
          "timeline-poin-detail-box",
        );

        if (tlPoinNode) {
          if (isGuru) {
            tlPoinNode.classList.add("hidden");
          } else {
            tlPoinNode.classList.remove("hidden");

            if (tlPoinRemaining) {
              tlPoinRemaining.textContent = `Sisa ${points} / 100 Poin`;
            }

            if (deductions.length === 0) {
              if (tlPoinDot)
                tlPoinDot.className =
                  "absolute -left-6 top-4 w-4 h-4 rounded-full bg-white border-2 border-emerald-500 shadow-2xs -translate-x-1/2 flex items-center justify-center";
              if (tlPoinDotInner)
                tlPoinDotInner.className =
                  "w-1.5 h-1.5 rounded-full bg-emerald-500";
              if (tlPoinCard)
                tlPoinCard.className =
                  "p-4 rounded-xl bg-white border border-slate-200/80 shadow-2xs space-y-2 hover:border-slate-300 transition-colors";
              if (tlPoinBadge) {
                tlPoinBadge.textContent = "100 Poin (Utuh)";
                tlPoinBadge.className =
                  "px-2 py-0.5 rounded text-[10px] font-mono font-medium uppercase bg-emerald-50 text-emerald-700 border border-emerald-200";
              }
              if (tlPoinDetailBox) {
                tlPoinDetailBox.innerHTML = `
                  <div class="flex items-center gap-1.5 text-xs text-slate-500 pt-0.5">
                    <span class="material-symbols-outlined text-sm text-emerald-600">check_circle</span>
                    <span>Kehadiran tepat waktu di gerbang tanpa catatan keterlambatan.</span>
                  </div>
                `;
              }
            } else {
              const latest = deductions[0];
              if (tlPoinDot)
                tlPoinDot.className =
                  "absolute -left-6 top-4 w-4 h-4 rounded-full bg-white border-2 border-rose-500 shadow-2xs -translate-x-1/2 flex items-center justify-center";
              if (tlPoinDotInner)
                tlPoinDotInner.className =
                  "w-1.5 h-1.5 rounded-full bg-rose-500";
              if (tlPoinCard)
                tlPoinCard.className =
                  "p-4 rounded-xl bg-white border border-slate-200/80 shadow-2xs space-y-2 hover:border-slate-300 transition-colors";
              if (tlPoinBadge) {
                tlPoinBadge.textContent = `-${latest.pointsDeducted} Poin`;
                tlPoinBadge.className =
                  "px-2 py-0.5 rounded text-[10px] font-mono font-medium uppercase bg-rose-50 text-rose-700 border border-rose-200";
              }

              let statusAlert = "";
              if (points === 0) {
                statusAlert = `
                  <div class="p-2.5 rounded-xl bg-rose-600 text-white text-xs font-bold flex items-center gap-2 shadow-xs">
                    <span class="material-symbols-outlined text-sm">block</span>
                    <span>Akses Ditolak: Poin siswa 0 (Terkunci). Silahkan temui Guru Piket atau Wakasis untuk reset poin!</span>
                  </div>
                `;
              } else if (points < 10) {
                statusAlert = `
                  <div class="p-2.5 rounded-xl bg-amber-500 text-white text-xs font-bold flex items-center gap-2 shadow-xs animate-pulse">
                    <span class="material-symbols-outlined text-sm">warning</span>
                    <span>Peringatan LCD: Anda berhasil absen namun poin Anda kurang dari 10. Silahkan temui guru terlebih dahulu!</span>
                  </div>
                `;
              }

              if (tlPoinDetailBox) {
                tlPoinDetailBox.innerHTML = `
                  ${statusAlert}
                  ${deductions
                    .map((d: any) => {
                      let formattedDate = d.date;
                      try {
                        const parts = d.date.split("-");
                        if (parts.length === 3) {
                          const dObj = new Date(
                            Number(parts[0]),
                            Number(parts[1]) - 1,
                            Number(parts[2]),
                          );
                          formattedDate = dObj.toLocaleDateString("id-ID", {
                            weekday: "long",
                            year: "numeric",
                            month: "short",
                            day: "numeric",
                          });
                        }
                      } catch {}

                      return `
                      <div class="p-3.5 rounded-xl bg-white border border-rose-200 shadow-xs space-y-2">
                        <div class="flex items-center justify-between gap-2 flex-wrap text-xs">
                          <div class="flex items-center gap-2">
                            <span class="px-2 py-0.5 rounded-md bg-rose-100 text-rose-700 font-black text-xs">
                              -${d.pointsDeducted} Poin
                            </span>
                            <span class="font-bold text-slate-800">${formattedDate}</span>
                            <span class="text-slate-500 font-mono text-[11px]">• ${d.time} WIB</span>
                          </div>
                          <div class="flex items-center gap-1.5">
                            <span class="px-2 py-0.5 rounded-md bg-amber-50 text-amber-800 border border-amber-200 font-bold text-[11px]">
                              Telat ${d.minutesLate} Menit
                            </span>
                            <span class="px-2 py-0.5 rounded-md bg-slate-100 text-slate-700 font-bold text-[11px] font-mono">
                              Sisa ${d.remainingPoints ?? "-"} Poin
                            </span>
                          </div>
                        </div>

                        <!-- Sebab Pengurangan Poin Sesuai ide.txt -->
                        <div class="p-2.5 rounded-lg bg-rose-50/70 border border-rose-200/60 text-xs text-slate-700 flex items-start gap-2">
                          <span class="material-symbols-outlined text-rose-500 text-base shrink-0 mt-0.5">report_problem</span>
                          <div class="min-w-0">
                            <span class="font-bold text-slate-900 block text-[11px] uppercase tracking-wide">Keterangan Sebab Pengurangan:</span>
                            <p class="text-xs text-slate-800 leading-relaxed font-medium">${d.reason}</p>
                          </div>
                        </div>
                      </div>
                    `;
                    })
                    .join("")}
                `;
              }
            }
          }
        }
      } catch (err) {
        console.error("Gagal memuat rangkuman poin:", err);
      }
    }

    function renderIzinSection(isGuru: boolean, civitasPerms: any[]) {
      if (!currentCivitas) return;

      const isGuruLoggedIn = authRole === "guru";
      const isTeacherMode = isGuru || isGuruLoggedIn;

      // Update sidebar nav label for Izin
      const sidebarIzinIcon = document.getElementById("sidebar-izin-icon");
      const sidebarIzinTitle = document.getElementById("sidebar-izin-title");
      const sidebarIzinBadge = document.getElementById("sidebar-izin-badge");

      if (sidebarIzinTitle && sidebarIzinIcon && sidebarIzinBadge) {
        if (isTeacherMode) {
          sidebarIzinIcon.textContent = "verified_user";
          sidebarIzinTitle.textContent = "Konfirmasi Izin Siswa";
          sidebarIzinBadge.textContent = "Guru";
          sidebarIzinBadge.className =
            "text-[9px] font-mono font-bold uppercase px-1.5 py-0.5 rounded bg-blue-50 text-blue-700 border border-blue-200";
        } else {
          sidebarIzinIcon.textContent = "edit_document";
          sidebarIzinTitle.textContent = "Pengajuan Izin";
          sidebarIzinBadge.textContent = "Izin";
          sidebarIzinBadge.className =
            "text-[9px] font-mono font-bold uppercase px-1.5 py-0.5 rounded bg-slate-100 text-slate-600 border border-slate-200";
        }
      }

      const panelGuru = document.getElementById("panel-guru-konfirmasi-izin");
      const panelForm = document.getElementById("panel-form-izin-mandiri");
      const panelHist = document.getElementById("panel-my-permissions");

      if (isTeacherMode) {
        if (panelGuru) panelGuru.classList.remove("hidden");
        if (panelForm) panelForm.classList.add("hidden");
        if (panelHist) panelHist.classList.add("hidden");
        renderGuruPermissionsList();
      } else {
        if (panelGuru) panelGuru.classList.add("hidden");
        if (panelForm) panelForm.classList.remove("hidden");
        if (panelHist) panelHist.classList.remove("hidden");
      }

      const nameInput = document.getElementById(
        "form-izin-name",
      ) as HTMLInputElement | null;
      const classInput = document.getElementById(
        "form-izin-class",
      ) as HTMLInputElement | null;
      const jurusanBox = document.getElementById("form-izin-jurusan-box");
      const photoBox = document.getElementById("form-izin-photo-box");
      const headerTitle = document.getElementById("izin-form-header-title");
      const startEl = document.getElementById(
        "form-izin-start-date",
      ) as HTMLInputElement | null;
      const endEl = document.getElementById(
        "form-izin-end-date",
      ) as HTMLInputElement | null;
      const daysText = document.getElementById("form-izin-days-text");

      if (nameInput) nameInput.value = currentCivitas.name;
      if (classInput)
        classInput.value =
          currentCivitas.className || (isGuru ? "Dewan Guru" : "XII");
      if (headerTitle)
        headerTitle.textContent = isGuru
          ? "Formulir Pengajuan Izin Pendidik"
          : "Formulir Pengajuan Izin Siswa";

      if (isGuru) {
        if (jurusanBox) jurusanBox.classList.add("hidden");
        if (photoBox) photoBox.classList.add("hidden");
      } else {
        if (jurusanBox) jurusanBox.classList.remove("hidden");
        if (photoBox) photoBox.classList.remove("hidden");

        // Preset jurusan checkbox berdasarkan rombel civitas jika belum ada yang terpilih
        const cbRpl = document.getElementById(
          "cb-jurusan-rpl",
        ) as HTMLInputElement | null;
        const cbAkl = document.getElementById(
          "cb-jurusan-akl",
        ) as HTMLInputElement | null;
        const cat = (
          currentCivitas.category ||
          currentCivitas.className ||
          ""
        ).toLowerCase();
        if (cbRpl && cbAkl && !cbRpl.checked && !cbAkl.checked) {
          if (cat.includes("rpl")) cbRpl.checked = true;
          else if (cat.includes("akl")) cbAkl.checked = true;
        }
      }

      const todayStr = new Date().toLocaleDateString("en-CA", {
        timeZone: "Asia/Jakarta",
      });
      if (startEl && !startEl.value) startEl.value = todayStr;
      if (endEl && !endEl.value) endEl.value = todayStr;
      if (daysText && !daysText.textContent) daysText.textContent = "1 Hari";

      // Render Riwayat Pengajuan Izin Civitas Ini
      const myPermContainer = document.getElementById(
        "my-permissions-container",
      );
      if (myPermContainer) {
        if (civitasPerms.length === 0) {
          myPermContainer.innerHTML = `
            <div class="p-6 rounded-xl bg-slate-50 border border-slate-200/80 text-center text-xs text-slate-500">
              <span class="material-symbols-outlined text-3xl text-slate-400 block mb-1">note_alt</span>
              Belum ada riwayat permohonan izin yang diajukan. Silahkan isi formulir di atas untuk mengajukan izin baru.
            </div>
          `;
        } else {
          myPermContainer.innerHTML = civitasPerms
            .map((p: any) => {
              const isMenunggu = (p.status || "Menunggu") === "Menunggu";
              const isDisetujui = p.status === "Disetujui";

              const statusBadge = isMenunggu
                ? '<span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[10px] font-semibold bg-amber-50 text-amber-800 border border-amber-200"><span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span>Menunggu Persetujuan</span>'
                : isDisetujui
                  ? '<span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[10px] font-semibold bg-emerald-50 text-emerald-800 border border-emerald-200"><span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>Disetujui Sah</span>'
                  : '<span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[10px] font-semibold bg-rose-50 text-rose-800 border border-rose-200"><span class="w-1.5 h-1.5 rounded-full bg-rose-500"></span>Ditolak</span>';

              const isSakit = p.category === "sakit";
              const isDisp = p.category === "dispensasi";
              const catIcon = isSakit
                ? "medical_services"
                : isDisp
                  ? "assignment_turned_in"
                  : "family_restroom";
              const catBadgeBg = isSakit
                ? "bg-amber-50 text-amber-700 border-amber-200/80"
                : isDisp
                  ? "bg-purple-50 text-purple-700 border-purple-200/80"
                  : "bg-blue-50 text-blue-700 border-blue-200/80";
              const catLabel = isSakit
                ? "Sakit"
                : isDisp
                  ? "Dispensasi"
