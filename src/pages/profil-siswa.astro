      }

      if (badgeVerifTag && badgeVerifText) {
        if (isAdmin) {
          badgeVerifTag.className = 'inline-flex items-center gap-1 px-2.5 py-1.5 rounded-xl bg-emerald-50 text-emerald-800 font-bold text-[11px] border border-emerald-200/80';
