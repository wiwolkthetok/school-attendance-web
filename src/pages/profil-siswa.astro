---
/**
 * @file src/pages/profil-siswa.astro
 * @description Halaman Profil Siswa dengan Sidebar Khusus yang Menggantikan Sidebar Utama
 */
export const prerender = false;

const authSession = Astro.cookies.get("auth_session")?.value;
if (!authSession) {
  return Astro.redirect("/login");
}

const url = new URL(Astro.request.url);
const paramId = url.searchParams.get("id") || "";
const isGuruInitial = authSession === "guru" || paramId.startsWith("GUR-");
const canAccessDashboardInitial = authSession === "admin";

import Layout from "../layouts/Layout.astro";
---

<Layout title="Profil Siswa & Portofolio" activeNav="siswa-guru">
  <!-- ========================================================
       SIDEBAR KHUSUS SISWA & GURU (MENGGANTIKAN SIDEBAR UTAMA)
       ======================================================== -->
  <aside
    slot="sidebar"
    class="hidden md:flex md:w-64 lg:w-72 bg-white text-slate-700 flex-col justify-between shrink-0 select-none border-r border-slate-200/80 overflow-y-auto h-auto min-h-[920px] p-4 sm:p-5 space-y-6"
    aria-label="Sidebar Khusus Profil Siswa"
  >
    <div class="space-y-6">
      <!-- Tombol Kembali ke Menu Utama Dashboard (Ditampilkan HANYA untuk Admin, Kepsek, & Waka) -->
      <div
        id="sidebar-back-to-menu"
        class={`${canAccessDashboardInitial ? "" : "hidden "}pb-3 border-b border-slate-100`}
      >
        <a
          href="/"
          class="inline-flex items-center gap-2 px-3 py-2 rounded-lg bg-slate-50 hover:bg-slate-100 text-slate-700 font-semibold text-xs transition duration-150 w-full border border-slate-200/80 shadow-2xs"
          title="Kembali ke Menu Utama Dashboard"
        >
          <span class="material-symbols-outlined text-base text-slate-500">
            arrow_back
          </span>
          <span>Kembali ke Menu Utama</span>
        </a>
      </div>

      <!-- Mini Profile Civitas Aktif di Sidebar -->
      <div class="p-3.5 rounded-xl bg-slate-50/80 border border-slate-200/80 space-y-3">
        <div class="flex items-center gap-3">
          <div class="relative shrink-0">
            <div class="w-11 h-11 rounded-full p-0.5 bg-white border border-slate-200/80 shadow-2xs">
              <img
                id="sidebar-avatar"
                src="/assets/avatar_male.jpg"
                alt="Avatar"
                class="w-full h-full object-cover rounded-full bg-slate-100"
              />
            </div>
            <span
              class="absolute bottom-0 right-0 w-3 h-3 rounded-full bg-emerald-500 border-2 border-white shadow-2xs"
              title="Aktif"
            ></span>
          </div>
          <div class="min-w-0 flex-1">
            <h3
              id="sidebar-name"
              class="font-bold text-xs text-slate-900 truncate"
            >
              Memuat...
            </h3>
            <p
              id="sidebar-role"
              class="text-[11px] text-slate-500 truncate mt-0.5"
            >
              -
            </p>
          </div>
        </div>

        <!-- Box Poin Disiplin Siswa (Sistem Akumulasi Poin Otomatis) -->
        <div
          id="sidebar-point-box"
          class="pt-2.5 border-t border-slate-200/60 flex items-center justify-between text-xs"
        >
          <span class="text-slate-500 text-[11px] font-medium">
            Poin Disiplin:
          </span>
          <span
            id="sidebar-point-badge"
            class="px-2 py-0.5 rounded-md bg-emerald-50 text-emerald-700 border border-emerald-200 font-mono font-bold text-[11px]"
          >
            100 Poin
          </span>
        </div>
      </div>

      <!-- Menu Navigasi Khusus Profil -->
      <nav class="space-y-1" id="profile-subnav" aria-label="Navigasi Profil">
        <!-- 1. Biodata -->
        <button
          type="button"
          data-target="sec-biodata"
          class="profile-nav-btn active w-full flex items-center justify-between px-3.5 py-2.5 rounded-lg text-xs font-semibold transition-colors text-left cursor-pointer bg-slate-100 text-slate-900 border border-slate-200/80 shadow-2xs"
        >
          <span class="flex items-center gap-2.5">
            <span class="material-symbols-outlined text-[17px] text-blue-600">
              badge
            </span>
            <span>Biodata & Profil</span>
          </span>
          <span class="material-symbols-outlined text-xs text-slate-400">
            chevron_right
          </span>
        </button>

        <!-- 2. Kartu & Akses RFID -->
        <button
          type="button"
          data-target="sec-card"
          class="profile-nav-btn w-full flex items-center justify-between px-3.5 py-2.5 rounded-lg text-xs font-medium transition-colors text-left cursor-pointer text-slate-600 hover:text-slate-900 hover:bg-slate-50"
        >
          <span class="flex items-center gap-2.5">
            <span class="material-symbols-outlined text-[17px] text-slate-500">
              contactless
            </span>
            <span>Data Kartu & RFID</span>
          </span>
          <span class="material-symbols-outlined text-xs text-slate-400">
            chevron_right
          </span>
        </button>

        <!-- 3. Linimasa Aktivitas -->
        <button
          type="button"
          data-target="sec-timeline"
          class="profile-nav-btn w-full flex items-center justify-between px-3.5 py-2.5 rounded-lg text-xs font-medium transition-colors text-left cursor-pointer text-slate-600 hover:text-slate-900 hover:bg-slate-50"
        >
          <span class="flex items-center gap-2.5">
            <span class="material-symbols-outlined text-[17px] text-slate-500">
              history
            </span>
            <span>History</span>
          </span>
          <span class="material-symbols-outlined text-xs text-slate-400">
            chevron_right
          </span>
        </button>

        <!-- 4. Poin Disiplin Otomatis -->
        <button
          type="button"
          data-target="sec-poin"
          class="profile-nav-btn w-full flex items-center justify-between px-3.5 py-2.5 rounded-lg text-xs font-medium transition-colors text-left cursor-pointer text-slate-600 hover:text-slate-900 hover:bg-slate-50"
        >
          <span class="flex items-center gap-2.5">
            <span class="material-symbols-outlined text-[17px] text-slate-500">
              sports_score
            </span>
            <span>Poin & Pelanggaran</span>
          </span>
          <span class="text-[9px] font-bold uppercase px-1.5 py-0.5 rounded bg-amber-50 text-amber-700 border border-amber-200 font-mono">
            Auto
          </span>
        </button>

        <!-- 5. Rapor & Kinerja -->
        <button
          type="button"
          data-target="sec-rapor"
          class="profile-nav-btn w-full flex items-center justify-between px-3.5 py-2.5 rounded-lg text-xs font-medium transition-colors text-left cursor-pointer text-slate-600 hover:text-slate-900 hover:bg-slate-50"
        >
          <span class="flex items-center gap-2.5">
            <span class="material-symbols-outlined text-[17px] text-slate-500">
              bar_chart
            </span>
            <span>Rapor Kedisiplinan</span>
          </span>
          <span class="material-symbols-outlined text-xs text-slate-400">
            chevron_right
          </span>
        </button>

        <!-- 6. Pengajuan Izin / Konfirmasi Izin Siswa -->
        <button
          type="button"
          id="sidebar-nav-izin"
          data-target="sec-izin"
          class="profile-nav-btn w-full flex items-center justify-between px-3.5 py-2.5 rounded-lg text-xs font-medium transition-colors text-left cursor-pointer text-slate-600 hover:text-slate-900 hover:bg-slate-50"
        >
          <span class="flex items-center gap-2.5">
            <span
              id="sidebar-izin-icon"
              class="material-symbols-outlined text-[17px] text-slate-500"
            >
              {isGuruInitial ? "verified_user" : "edit_document"}
            </span>
            <span id="sidebar-izin-title">
              {isGuruInitial ? "Konfirmasi Izin" : "Pengajuan Izin"}
            </span>
          </span>
          <span
            id="sidebar-izin-badge"
            class={
              isGuruInitial
                ? "text-[9px] font-bold uppercase px-1.5 py-0.5 rounded bg-blue-50 text-blue-700 border border-blue-200 font-mono"
                : "text-[9px] font-bold uppercase px-1.5 py-0.5 rounded bg-slate-100 text-slate-600 border border-slate-200 font-mono"
            }
          >
            {isGuruInitial ? "Guru" : "Izin"}
          </span>
        </button>
      </nav>
    </div>

    <!-- Bagian Bawah Sidebar Khusus: Tombol Aksi Cepat (Hubungi WA & Cetak) -->
    <div
      id="sidebar-quick-actions"
      class="pt-4 border-t border-slate-100 space-y-2"
    >
      <a
        id="sidebar-wa-btn"
        href="#"
        target="_blank"
        class="w-full flex items-center justify-center gap-2 py-2 px-3.5 rounded-lg bg-emerald-600 hover:bg-emerald-700 text-white font-semibold text-xs transition duration-150 shadow-2xs"
      >
        <span class="material-symbols-outlined text-base">chat</span>
        <span id="sidebar-wa-text">Hubungi via WA</span>
      </a>
      <button
        type="button"
        onclick="window.print()"
        class="w-full flex items-center justify-center gap-2 py-2 px-3 rounded-lg bg-slate-50 hover:bg-slate-100 text-slate-700 font-semibold text-xs transition duration-150 cursor-pointer border border-slate-200/80 shadow-2xs"
      >
        <span class="material-symbols-outlined text-base text-slate-500">
          print
        </span>
        <span>Cetak Kartu & Rapor</span>
      </button>
    </div>
  </aside>

  <!-- ========================================================
       NAVIGASI BAWAH KHUSUS PROFIL SISWA & GURU (MOBILE / ANDROID)
       Menempel mentok di dasar layar, menggantikan bottom-nav umum
       ======================================================== -->
  <nav
    slot="bottom-nav"
    aria-label="Navigasi Profil Mobile"
    class="fixed bottom-0 inset-x-0 z-40 w-full bg-white/95 backdrop-blur-xl border-t border-slate-200/90 shadow-[0_-4px_25px_rgba(0,0,0,0.06)] md:hidden select-none safe-bottom transition-all duration-200 touch-manipulation"
  >
    <div
      class="grid grid-cols-6 items-center px-1 py-1.5 w-full relative touch-manipulation"
      id="profile-bottom-nav"
    >
      <!-- 1. Biodata -->
      <button
        type="button"
        data-target="sec-biodata"
        data-index="0"
        class="profile-mobile-nav-btn flex flex-col items-center justify-center py-1 px-0.5 rounded-xl transition-all duration-200 active:scale-95 group relative touch-manipulation cursor-pointer"
        aria-label="Tab Biodata"
      >
        <div class="bnav-icon-box w-11 h-7 rounded-full flex items-center justify-center transition-all duration-200 bg-blue-100 text-blue-700 shadow-2xs ease-[cubic-bezier(0.32,0.72,0,1)]">
          <span class="material-symbols-outlined text-[20px] font-bold">badge</span>
        </div>
        <span class="bnav-label text-[9.5px] tracking-tight leading-tight transition-colors duration-200 whitespace-nowrap text-blue-700 font-bold mt-1">
          Biodata
        </span>
      </button>

      <!-- 2. Kartu RFID -->
      <button
        type="button"
        data-target="sec-card"
        data-index="1"
        class="profile-mobile-nav-btn flex flex-col items-center justify-center py-1 px-0.5 rounded-xl transition-all duration-200 active:scale-95 group relative touch-manipulation cursor-pointer"
        aria-label="Tab Kartu RFID"
      >
        <div class="bnav-icon-box w-11 h-7 rounded-full flex items-center justify-center transition-all duration-200 text-slate-400 group-hover:text-slate-600 group-hover:bg-slate-100 ease-[cubic-bezier(0.32,0.72,0,1)]">
          <span class="material-symbols-outlined text-[20px]">contactless</span>
        </div>
        <span class="bnav-label text-[9.5px] tracking-tight leading-tight transition-colors duration-200 whitespace-nowrap text-slate-500 font-medium group-hover:text-slate-700 mt-1">
          Kartu
        </span>
      </button>

      <!-- 3. Riwayat -->
      <button
        type="button"
        data-target="sec-timeline"
        data-index="2"
        class="profile-mobile-nav-btn flex flex-col items-center justify-center py-1 px-0.5 rounded-xl transition-all duration-200 active:scale-95 group relative touch-manipulation cursor-pointer"
        aria-label="Tab Riwayat"
      >
        <div class="bnav-icon-box w-11 h-7 rounded-full flex items-center justify-center transition-all duration-200 text-slate-400 group-hover:text-slate-600 group-hover:bg-slate-100 ease-[cubic-bezier(0.32,0.72,0,1)]">
          <span class="material-symbols-outlined text-[20px]">history</span>
        </div>
        <span class="bnav-label text-[9.5px] tracking-tight leading-tight transition-colors duration-200 whitespace-nowrap text-slate-500 font-medium group-hover:text-slate-700 mt-1">
          Riwayat
        </span>
      </button>

      <!-- 4. Poin -->
      <button
        type="button"
        data-target="sec-poin"
        data-index="3"
        class="profile-mobile-nav-btn flex flex-col items-center justify-center py-1 px-0.5 rounded-xl transition-all duration-200 active:scale-95 group relative touch-manipulation cursor-pointer"
        aria-label="Tab Poin"
      >
        <div class="bnav-icon-box w-11 h-7 rounded-full flex items-center justify-center transition-all duration-200 text-slate-400 group-hover:text-slate-600 group-hover:bg-slate-100 ease-[cubic-bezier(0.32,0.72,0,1)]">
          <span class="material-symbols-outlined text-[20px]">sports_score</span>
        </div>
        <span class="bnav-label text-[9.5px] tracking-tight leading-tight transition-colors duration-200 whitespace-nowrap text-slate-500 font-medium group-hover:text-slate-700 mt-1">
          Poin
        </span>
      </button>

      <!-- 5. Izin -->
      <button
        type="button"
        data-target="sec-izin"
        data-index="4"
        class="profile-mobile-nav-btn flex flex-col items-center justify-center py-1 px-0.5 rounded-xl transition-all duration-200 active:scale-95 group relative touch-manipulation cursor-pointer"
        aria-label="Tab Izin"
      >
        <div class="bnav-icon-box w-11 h-7 rounded-full flex items-center justify-center transition-all duration-200 text-slate-400 group-hover:text-slate-600 group-hover:bg-slate-100 ease-[cubic-bezier(0.32,0.72,0,1)]">
          <span class="material-symbols-outlined text-[20px]">description</span>
        </div>
        <span class="bnav-label text-[9.5px] tracking-tight leading-tight transition-colors duration-200 whitespace-nowrap text-slate-500 font-medium group-hover:text-slate-700 mt-1">
          Izin
        </span>
      </button>

      <!-- 6A. Menu Utama (Khusus Admin, Kepsek, & Waka) -->
      <a
        href="/"
        id="profile-mobile-back-link"
        data-astro-prefetch="load"
        class={`${canAccessDashboardInitial ? "" : "hidden "}flex flex-col items-center justify-center py-1 px-0.5 rounded-xl transition-all duration-200 active:scale-95 group relative text-slate-400 hover:text-blue-600 touch-manipulation cursor-pointer`}
        title="Kembali ke Menu Utama"
      >
        <div class="w-11 h-7 rounded-full flex items-center justify-center transition-all duration-200 text-slate-400 group-hover:text-blue-600 group-hover:bg-slate-100 ease-[cubic-bezier(0.32,0.72,0,1)]">
          <span class="material-symbols-outlined text-[20px]">arrow_back</span>
        </div>
        <span class="text-[9.5px] tracking-tight leading-tight whitespace-nowrap text-slate-500 font-medium group-hover:text-blue-600 mt-1">
          Menu
        </span>
      </a>

      <!-- 6B. Logout (Khusus Siswa & Guru Biasa di Mobile) -->
      <button
        type="button"
        id="profile-mobile-logout-btn"
        class={`${canAccessDashboardInitial ? "hidden " : "flex "}flex-col items-center justify-center py-1 px-0.5 rounded-xl transition-all duration-200 active:scale-95 group relative cursor-pointer touch-manipulation`}
        title="Keluar dari Aplikasi"
      >
        <div class="w-11 h-7 rounded-full flex items-center justify-center transition-all duration-200 text-rose-500 group-hover:bg-rose-50 ease-[cubic-bezier(0.32,0.72,0,1)]">
          <span class="material-symbols-outlined text-[20px]">logout</span>
        </div>
        <span class="text-[9.5px] tracking-tight leading-tight whitespace-nowrap font-bold text-rose-500 mt-1">
          Keluar
        </span>
      </button>
    </div>
  </nav>

  <!-- ========================================================
       AREA KONTEN UTAMA (FULL LEBAR TANPA SUB-SIDEBAR GANDA)
       ======================================================== -->
  <div class="flex flex-col gap-6 max-w-7xl mx-auto w-full">
    <!-- CONTAINER KONTEN MODULAR DINAMIS -->
    <div class="w-full">
      <!-- ==========================================
           SECTION 1: BIODATA & PROFIL LENGKAP
           ========================================== -->
      <section id="sec-biodata" class="profile-section space-y-6">
        <!-- Top Profile Card -->
        <div class="rounded-xl bg-white border border-slate-200/80 p-5 sm:p-6 shadow-xs space-y-5">
          <!-- Header Row: Avatar, Identity, and Action Buttons -->
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
            <div class="flex items-center gap-4 min-w-0">
              <!-- Avatar Circle with Active Dot -->
              <div class="relative shrink-0">
                <div class="w-16 h-16 sm:w-20 sm:h-20 rounded-full p-1 bg-white border border-slate-200/80 shadow-2xs overflow-hidden">
                  <img
                    id="profile-avatar"
                    src="/assets/avatar_male.jpg"
                    alt="Foto Profil"
                    class="w-full h-full object-cover rounded-full bg-slate-50"
                  />
                </div>
                <span
                  id="profile-active-dot"
                  class="absolute bottom-0.5 right-0.5 w-3.5 h-3.5 rounded-full bg-emerald-500 border-2 border-white shadow-2xs"
                  title="Status Aktif"
                ></span>
              </div>

              <!-- Name, Headline & Badges -->
              <div class="min-w-0 flex-1">
                <h1
                  id="profile-name"
                  class="text-xl sm:text-2xl font-bold text-slate-900 tracking-tight truncate"
                >
                  Memuat data siswa...
                </h1>
                <p
                  id="profile-headline"
                  class="text-xs font-medium text-slate-500 mt-0.5 truncate"
                >
                  -
                </p>
                <div class="flex items-center gap-2 pt-2 flex-wrap">
                  <span
                    id="badge-role-tag"
                    class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-md bg-blue-50 text-blue-700 font-medium text-[11px] border border-blue-200/60"
                  >
                    <span class="material-symbols-outlined text-sm">badge</span>
                    <span id="badge-role-text">Siswa Reguler</span>
                  </span>
                  <span
                    id="badge-verif-tag"
                    class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-md bg-purple-50 text-purple-700 font-medium text-[11px] border border-purple-200/60"
                  >
                    <span class="material-symbols-outlined text-sm">
                      verified
                    </span>
                    <span id="badge-verif-text">Terverifikasi Rombel</span>
                  </span>
                </div>
              </div>
            </div>

            <!-- Action Buttons -->
            <div class="flex items-center gap-2 shrink-0 self-start sm:self-center">
              <a
                id="btn-wa-action"
                href="#"
                target="_blank"
                class="hidden inline-flex items-center gap-1.5 px-3 py-2 rounded-lg bg-emerald-50 hover:bg-emerald-100 text-emerald-700 border border-emerald-200/80 font-semibold text-xs transition duration-150 shadow-2xs"
              >
                <span class="material-symbols-outlined text-sm text-emerald-600">
                  chat
                </span>
                <span id="btn-wa-text">WhatsApp</span>
              </a>
              <button
                type="button"
                id="btn-edit-current-profile"
                class="inline-flex items-center gap-1.5 px-3 py-2 rounded-lg bg-slate-50 hover:bg-slate-100 text-slate-700 border border-slate-200/80 font-semibold text-xs transition duration-150 cursor-pointer shadow-2xs"
                title="Edit Profil"
              >
                <span class="material-symbols-outlined text-sm text-slate-500">
                  edit
                </span>
                <span>Edit</span>
              </button>
            </div>
          </div>

          <!-- Divider -->
          <div class="border-t border-slate-100"></div>

          <!-- Grid Data Pribadi: Clean Info Tiles -->
          <div
            id="profile-details-grid"
            class="grid grid-cols-2 sm:grid-cols-4 gap-2.5 sm:gap-3 text-xs"
          >
            <!-- 1. NISN -->
            <div
              id="row-profile-nisn"
              class="p-3 rounded-lg bg-slate-50/80 border border-slate-200/60 flex flex-col justify-between min-w-0"
            >
              <span
                id="profile-nisn-label"
                class="text-[10px] font-mono font-medium uppercase tracking-wider text-slate-400"
              >
                NISN
              </span>
              <span
                id="profile-nisn"
                class="font-semibold text-slate-900 font-mono text-xs sm:text-sm truncate mt-1"
              >
                0068472911
              </span>
            </div>

            <!-- 2. ID RFID -->
            <div
              id="row-profile-id"
              class="p-3 rounded-lg bg-slate-50/80 border border-slate-200/60 flex flex-col justify-between min-w-0"
            >
              <span
                id="profile-id-label"
                class="text-[10px] font-mono font-medium uppercase tracking-wider text-slate-400"
              >
                ID RFID
              </span>
              <span
                id="profile-custom-id"
                class="font-semibold text-blue-700 font-mono text-xs sm:text-sm truncate mt-1"
              >
                A1B2C3D4
              </span>
            </div>

            <!-- 3. Alamat / Domisili -->
            <div
              id="row-profile-city"
              class="p-3 rounded-lg bg-slate-50/80 border border-slate-200/60 flex flex-col justify-between min-w-0"
            >
              <span
                id="profile-city-label"
                class="text-[10px] font-mono font-medium uppercase tracking-wider text-slate-400"
              >
                Alamat
              </span>
              <span
                id="profile-city"
                class="font-semibold text-slate-900 text-xs sm:text-sm truncate mt-1"
              >
                Padang Ratu, Lampung
              </span>
            </div>

            <!-- 4. Nama Lengkap -->
            <div
              id="row-profile-name"
              class="p-3 rounded-lg bg-slate-50/80 border border-slate-200/60 flex flex-col justify-between min-w-0"
            >
              <span
                id="profile-name-label"
                class="text-[10px] font-mono font-medium uppercase tracking-wider text-slate-400"
              >
                Nama
              </span>
              <span
                id="profile-detail-name"
                class="font-semibold text-slate-900 text-xs sm:text-sm truncate mt-1"
              >
                Alya Putri Ramadhani
              </span>
            </div>

            <!-- Data Ekstra (Disembunyikan untuk Siswa, tampil untuk Guru / Admin) -->
            <div
              id="row-profile-regdate"
              class="hidden p-3 rounded-lg bg-slate-50/80 border border-slate-200/60 flex flex-col justify-between min-w-0"
            >
              <span
                id="profile-reg-label"
                class="text-[10px] font-mono font-medium uppercase tracking-wider text-slate-400"
              >
                Tgl Daftar
              </span>
              <span
                id="profile-regdate"
                class="font-semibold text-slate-900 text-xs truncate mt-1"
              >
                15 Juli 2024
              </span>
            </div>

            <div
              id="row-profile-birth"
