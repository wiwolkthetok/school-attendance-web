      <!-- Bukti Foto Surat / Dispensasi -->
      <div class="space-y-2 pt-1 border-t border-slate-100">
        <div class="flex items-center justify-between">
          <label class="text-xs font-bold text-slate-700 flex items-center gap-1.5">
            <span class="material-symbols-outlined text-sm text-blue-600">image</span>
            <span>Foto Bukti Surat / Keterangan Dokter:</span>
          </label>
          <span id="guru-detail-photo-tag" class="text-[10px] font-bold text-blue-600 bg-blue-50 px-2 py-0.5 rounded-md"></span>
        </div>

        <!-- Preview Container Jika Ada Foto -->
        <div id="guru-detail-photo-container" class="rounded-2xl border border-slate-200 overflow-hidden bg-slate-900/5 p-3 flex flex-col items-center justify-center">
          <img id="guru-detail-photo-img" src="" alt="Foto Bukti Izin" class="max-h-72 rounded-xl object-contain shadow-sm cursor-pointer hover:opacity-95 transition" title="Klik untuk membuka di tab baru" />
          <div class="mt-3 flex items-center gap-2.5 flex-wrap">
            <a id="guru-detail-photo-link" href="#" target="_blank" class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-xl bg-blue-600 hover:bg-blue-700 text-white text-xs font-bold transition shadow-xs">
              <span class="material-symbols-outlined text-sm">open_in_new</span>
              <span>Buka Gambar Penuh ↗</span>
            </a>
            <a id="guru-detail-photo-download" href="#" download="bukti-izin-siswa.jpg" class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-800 text-xs font-bold border border-slate-200 transition">
              <span class="material-symbols-outlined text-sm">download</span>
              <span>Unduh Foto</span>
            </a>
          </div>
