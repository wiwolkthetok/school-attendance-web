            async function prepareOfficialDocument() {
      // 1. Ambil rekaman logs sesuai opsi yang dipilih:
      // Opsi "Hari Ini" mengambil data presensi hari ini (/api/attendance)
      // Opsi "1 Minggu / 1 Bulan / 1 Tahun" mengambil data dari tabel arsip (/api/attendance/archive)
      let activeLogs: any[] = [];
      if (genTime === 'today') {
        try {
          const res = await fetch('/api/attendance');
          activeLogs = await res.json().catch(() => []);
        } catch {
          activeLogs = [];
        }
      } else {
        try {
          const res = await fetch(`/api/attendance/archive?filter=${genTime}`);
          activeLogs = await res.json().catch(() => []);
        } catch {
          activeLogs = [];
        }
      }

      // Lookup data siswa cepat untuk NISN & Poin
      const studentByRfid: Record<string, any> = {};
      const studentByName: Record<string, any> = {};
      cachedStudents.forEach((s: any) => {
        if (s.rfidUid) studentByRfid[s.rfidUid.trim().toUpperCase()] = s;
        if (s.name) studentByName[s.name.trim().toLowerCase()] = s;
      });

      // 2. Filter HANYA SISWA (role === 'siswa' - mengecualikan guru & admin)
      let filteredLogs = activeLogs.filter((l: any) => l.role === 'siswa');
      if (genDept === 'rpl') filteredLogs = filteredLogs.filter((l: any) => l.className && l.className.includes('RPL'));
      if (genDept === 'akl') filteredLogs = filteredLogs.filter((l: any) => l.className && l.className.includes('AKL'));
      if (genClass !== 'all' && genClass !== 'guru') filteredLogs = filteredLogs.filter((l: any) => l.className === genClass);

      // Khusus opsi "Hari Ini": sertakan juga surat izin sah yang disetujui hari ini
      if (genTime === 'today') {
        const todayStr = new Date().toLocaleDateString('en-CA', { timeZone: 'Asia/Jakarta' });
        const todayPermits = cachedPermits.filter(
          (p: any) => p.status === 'Disetujui' && p.startDate <= todayStr && (p.endDate || p.startDate) >= todayStr
        );
        todayPermits.forEach((p: any) => {
          let matchDept = true;
          if (genDept === 'rpl') matchDept = p.className && p.className.includes('RPL');
          if (genDept === 'akl') matchDept = p.className && p.className.includes('AKL');
          if (genDept === 'guru') matchDept = false;

          let matchClass = true;
          if (genClass !== 'all' && genClass !== 'guru') matchClass = p.className === genClass;

          if (matchDept && matchClass) {
            const alreadyInLog = filteredLogs.some((l: any) => l.name === p.name);
            if (!alreadyInLog) {
              filteredLogs.push({
                id: p.id,
                name: p.name,
                className: p.className,
                role: 'siswa',
                type: 'izin',
                time: p.createdAt ? p.createdAt.split('T')[1]?.slice(0, 5) || '07:00' : '07:00',
                status: p.type || 'Izin',
                isPermit: true,
                reason: p.reason
              });
            }
          }
        });
      }

      // 3. Cek apakah hari ini Hari Libur Sekolah (Hari Minggu atau simulasi Sunday)
      const isHoliday = (typeof (window as any).isSchoolHoliday === 'function')
        ? (window as any).isSchoolHoliday()
        : (new Date().getDay() === 0);
      const isTodayHoliday = genTime === 'today' && isHoliday;

      // Filter Siswa Target Sesuai Jurusan & Kelas (kecualikan alumni kecuali jika sengaja memilih kelas Alumni)
      const isAlumniSelected = genClass.toLowerCase().includes('alumni');
      let targetStudents = cachedStudents.filter(
        (s: any) =>
          s.role === 'siswa' &&
          (isAlumniSelected || (!s.className?.toLowerCase().includes('alumni') && !s.className?.toLowerCase().includes('lulus')))
      );
      if (genDept === 'rpl') targetStudents = targetStudents.filter((s: any) => s.className && s.className.includes('RPL'));
      if (genDept === 'akl') targetStudents = targetStudents.filter((s: any) => s.className && s.className.includes('AKL'));
      if (genClass !== 'all' && genClass !== 'guru') targetStudents = targetStudents.filter((s: any) => s.className === genClass);

      let studentItems: any[] = [];
      let hadirCount = 0;
      let telatCount = 0;
      let izinCount = 0;
      let bolosCount = 0;
      let liburCount = 0;

      if (isTodayHoliday) {
        // Mode Hari Libur: Seluruh siswa tercatat status "Libur", jam presensi "-", poin tetap aman (100 Poin)
        studentItems = targetStudents.map((s: any) => {
          const pts = getStudentPoints(s.rfidUid, s.id, 'siswa');
          const ptsText = pts >= 100 ? '100 Poin' : (pts >= 75 ? `${pts} P (SP-1)` : `${pts} P (SP-2)`);
          return {
            id: s.id,
            rfidUid: s.rfidUid,
            nisn: s.identifier || '-',
            name: s.name,
            className: s.className || '-',
            time: '-',
            status: 'Libur',
            pts,
            ptsText,
            statusPoinText: `Libur • ${ptsText}`
          };
        });
        liburCount = studentItems.length;
      } else if (genTime === 'today') {
        // Mode Hari Ini (Hari Sekolah Aktif)
        const now = new Date();
        const curMinutes = now.getHours() * 60 + now.getMinutes();
        const [pulangH, pulangM] = (cachedSettings?.jamPulang || '13:30').split(':').map(Number);
        const [tutupH, tutupM] = (cachedSettings?.jamTutupPulang || '15:00').split(':').map(Number);
        const isAfternoonReached = curMinutes >= (pulangH * 60 + pulangM);
        const afternoonClosed = curMinutes >= (tutupH * 60 + tutupM);

        const todayStr = new Date().toLocaleDateString('en-CA', { timeZone: 'Asia/Jakarta' });
        const approvedPermits = cachedPermits.filter(
          (p: any) => p.status === 'Disetujui' && p.startDate <= todayStr && (p.endDate || p.startDate) >= todayStr
        );
        const permitStudentIds = new Set(approvedPermits.map((p: any) => p.studentId));
        const permitByStudentId = new Map(approvedPermits.map((p: any) => [p.studentId, p]));

        // Kelompokkan rekaman presensi hari ini per siswa
        const logMap = new Map<string, any[]>();
        filteredLogs.forEach((l: any) => {
          const key = (l.rfidUid || l.name || '').trim().toUpperCase();
          if (!logMap.has(key)) logMap.set(key, []);
          logMap.get(key)!.push(l);
        });

        studentItems = targetStudents.map((s: any) => {
          const keyRfid = (s.rfidUid || '').trim().toUpperCase();
          const keyName = (s.name || '').trim().toUpperCase();
          const sLogs = logMap.get(keyRfid) || logMap.get(keyName) || [];
          const masukLog = sLogs.find((l: any) => l.type === 'masuk');
          const pulangLog = sLogs.find((l: any) => l.type === 'pulang');

          const hasPermit = permitStudentIds.has(s.id);
          const studentPermit = permitByStudentId.get(s.id);

          const pts = getStudentPoints(s.rfidUid, s.id, 'siswa');
          const ptsText = pts >= 100 ? '100 Poin' : (pts >= 75 ? `${pts} P (SP-1)` : `${pts} P (SP-2)`);

          let status = 'Hadir';
          let timeText = '-';

          if (hasPermit) {
            // Siswa memiliki surat izin/dispensasi sah yang disetujui
            status = studentPermit?.type || 'Izin';
            timeText = `${status} Resmi`;
          } else if (masukLog) {
            // Siswa melakukan absen pagi
            timeText = `${masukLog.time.slice(0, 5)} WIB (masuk)`;
            if (pulangLog) {
              // Absen Pagi ADA + Absen Siang ADA (Kunci label Terlambat jika pagi terlambat)
              status = masukLog.status === 'Terlambat' ? 'Terlambat' : 'Hadir';
              timeText = `${masukLog.time.slice(0, 5)} - ${pulangLog.time.slice(0, 5)} WIB`;
            } else if (afternoonClosed || masukLog.status === 'Bolos') {
              // Absen Pagi ADA + Siang Belum & Jam Siang Berakhir -> Status: BOLOS
              status = 'Bolos';
            } else {
              status = masukLog.status === 'Terlambat' ? 'Terlambat' : 'Hadir';
            }
          } else if (pulangLog && pulangLog.status === 'Alpa') {
            // Siswa tidak absen pagi namun tap di siang hari -> Status tetap ALPA (Opsi B)
            status = 'Alpa';
            timeText = `${pulangLog.time.slice(0, 5)} WIB (siang)`;
          } else {
            // Siswa tidak ada rekaman absen pagi
            if (isAfternoonReached) {
              // Jadwal siang sudah dibuka (lewat 13:30 WIB) -> Status otomatis ALPA
              status = 'Alpa';
            } else {
              status = 'Belum Hadir';
            }
          }

          const statusDisplay = status === 'Bolos' ? 'Bolos (-10P)' : status;

          return {
            id: s.id,
            rfidUid: s.rfidUid,
            nisn: s.identifier || '-',
            name: s.name,
            className: s.className || '-',
            time: timeText,
            status,
            statusDisplay,
            pts,
            ptsText,
            statusPoinText: `${statusDisplay} • ${ptsText}`
          };
        });

        hadirCount = studentItems.filter((it: any) => it.status === 'Hadir').length;
        telatCount = studentItems.filter((it: any) => it.status === 'Terlambat').length;
        izinCount = studentItems.filter((it: any) => it.status === 'Izin' || it.status === 'Sakit' || it.status === 'Dispensasi').length;
        bolosCount = studentItems.filter((it: any) => it.status === 'Bolos').length;
      } else {
        // Mode Arsip (1 Minggu, 1 Bulan, 1 Tahun)
        studentItems = filteredLogs.map((l: any) => {
          const st = (l.rfidUid && studentByRfid[l.rfidUid.trim().toUpperCase()]) || (l.name && studentByName[l.name.trim().toLowerCase()]);
          const nisn = st?.identifier || '-';
          const pts = getStudentPoints(l.rfidUid, st?.id, 'siswa');
          let ptsText = pts >= 100 ? '100 Poin' : (pts >= 75 ? `${pts} P (SP-1)` : `${pts} P (SP-2)`);

          const timeText = `${l.date ? l.date.split('-').slice(1).join('/') + ' ' : ''}${l.time ? l.time.slice(0, 5) : '-'} WIB (${l.type || 'masuk'})`;
          const statusText = l.status === 'Bolos' ? 'Bolos (-10P)' : (l.status || 'Hadir');

          return {
            id: st?.id,
            rfidUid: l.rfidUid,
            nisn,
            name: l.name,
            className: l.className || '-',
            time: timeText,
            status: l.status || 'Hadir',
            statusDisplay: statusText,
            pts,
            ptsText,
            statusPoinText: `${statusText} • ${ptsText}`
          };
        });

        hadirCount = studentItems.filter((it: any) => it.status === 'Hadir').length;
        telatCount = studentItems.filter((it: any) => it.status === 'Terlambat').length;
        izinCount = studentItems.filter((it: any) => it.status === 'Izin' || it.status === 'Sakit' || it.status === 'Dispensasi').length;
        bolosCount = studentItems.filter((it: any) => it.status === 'Bolos').length;
      }

      const alpaCount = studentItems.filter((it: any) => it.status === 'Alpa').length;

      // Update Angka Statistik Lembar Cetak
      const statHadir = document.getElementById('print-stat-hadir');
      const statTelat = document.getElementById('print-stat-terlambat');
      const statIzin = document.getElementById('print-stat-izin');
      const statBolos = document.getElementById('print-stat-bolos');
      const statCol4Header = document.getElementById('print-stat-col4-header');
      if (statCol4Header) statCol4Header.textContent = isTodayHoliday ? 'LIBUR SEKOLAH' : 'ALPA / BOLOS';
      if (statHadir) statHadir.textContent = `${hadirCount} Siswa`;
      if (statTelat) statTelat.textContent = `${telatCount} Siswa`;
      if (statIzin) statIzin.textContent = `${izinCount} Siswa`;
      if (statBolos) statBolos.textContent = isTodayHoliday ? `${liburCount} Siswa` : (alpaCount > 0 ? `${bolosCount} Bolos, ${alpaCount} Alpa` : `${bolosCount} Siswa`);

      // Header Dokumen Lembar Cetak
      const now = new Date();
      const options: Intl.DateTimeFormatOptions = { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' };
      const dateStr = now.toLocaleDateString('id-ID', options);
      const docDateEl = document.getElementById('print-doc-date');
      const signDateEl = document.getElementById('print-sign-date');
      if (docDateEl) docDateEl.textContent = dateStr;
      if (signDateEl) signDateEl.textContent = dateStr;

      const deptLabel = genDept === 'all' ? 'SEMUA JURUSAN' : (genDept === 'guru' ? 'DEWAN GURU' : `JURUSAN ${genDept.toUpperCase()}`);
      const classLabel = genClass === 'all' ? 'SEMUA KELAS' : genClass.toUpperCase();
      const timeLabel = genTime === 'today'
        ? (isTodayHoliday ? 'HARI INI (LIBUR AKHIR PEKAN)' : 'HARI INI')
        : (genTime === 'week' ? '7 HARI TERAKHIR' : (genTime === 'month' ? 'BULAN INI' : 'SEMUA ARSIP'));

      const targetEl = document.getElementById('print-doc-target');
      if (targetEl) targetEl.textContent = `SASARAN: ${deptLabel} (${classLabel}) • PERIODE: ${timeLabel}`;

      const titleEl = document.getElementById('print-doc-title');
      if (titleEl) titleEl.textContent = `BERITA ACARA REKAPITULASI PRESENSI & KEDISIPLINAN SISWA`;

      const tableTitleEl = document.getElementById('print-table-title');
      if (tableTitleEl) tableTitleEl.textContent = `Rincian Data Kehadiran (${studentItems.length} Data):`;

      // Pejabat Pengesah Dinamis
      const kepsekCivitas = cachedStudents.find((s: any) => 
        s.tag === 'kepsek' || 
        (s.className && s.className.toLowerCase().includes('kepala sekolah'))
      ) || cachedStudents.find((s: any) => s.role === 'guru');
      const wakaCivitas = cachedStudents.find((s: any) => 
        s.tag === 'waka' || 
        (s.className && (s.className.toLowerCase().includes('kesiswaan') || s.className.toLowerCase().includes('waka')))
      );
      const kName = kepsekCivitas?.name || 'Kepala Sekolah';
      const kNipRaw = kepsekCivitas?.identifier || '-';
      const kNip = kNipRaw.startsWith('NIP') ? kNipRaw : (kNipRaw !== '-' ? `NIP. ${kNipRaw}` : '-');
      const wName = wakaCivitas?.name || 'Waka Kesiswaan';
      const wNipRaw = wakaCivitas?.identifier || '-';
      const wNip = wNipRaw.startsWith('NIP') ? wNipRaw : (wNipRaw !== '-' ? `NIP. ${wNipRaw}` : '-');

      const printKepsekName = document.getElementById('print-kepsek-name');
      const printKepsekNip = document.getElementById('print-kepsek-nip');
      const printWakaName = document.getElementById('print-waka-name');
      const printWakaNip = document.getElementById('print-waka-nip');
      if (printKepsekName) printKepsekName.textContent = kName;
      if (printKepsekNip) printKepsekNip.textContent = kNip;
      if (printWakaName) printWakaName.textContent = wName;
      if (printWakaNip) printWakaNip.textContent = wNip;

      // 5. Buat Baris Tabel 7 Kolom (Status & Poin Dipisah)
      const emptyMsg = genTime === 'today' ? 'Tidak ada rekaman presensi siswa untuk hari ini.' : 'Tidak ada rekaman arsip presensi siswa pada periode ini.';
      let rowsHtml = '';
      if (!studentItems.length) {
        rowsHtml = `<tr><td colspan="7" class="py-6 text-center italic text-slate-400">${emptyMsg}</td></tr>`;
      } else {
        rowsHtml = studentItems.map((item: any, idx: number) => {
          return `
            <tr class="border-b border-slate-200 text-xs hover:bg-slate-50">
              <td class="py-2 px-1 text-center border-r border-slate-200 text-slate-600">${idx + 1}</td>
              <td class="py-2 px-2 font-mono text-center border-r border-slate-200 text-slate-700">${item.nisn}</td>
              <td class="py-2 px-3 font-bold border-r border-slate-200 text-slate-900">${item.name}</td>
              <td class="py-2 px-2 text-center border-r border-slate-200 text-slate-700">${item.className}</td>
              <td class="py-2 px-2 text-center font-mono border-r border-slate-200 text-slate-700">${item.time}</td>
              <td class="py-2 px-2 text-center font-semibold text-slate-800 border-r border-slate-200">${item.status}</td>
              <td class="py-2 px-2 text-center font-semibold ${item.pts < 75 ? 'text-rose-600 font-bold' : 'text-slate-700'}">${item.ptsText}</td>
            </tr>
          `;
        }).join('');
      }

      const printTbody = document.getElementById('print-table-body');
      if (printTbody) printTbody.innerHTML = rowsHtml;

      return { 
        studentItems,
        filtered: studentItems,
        hadirCount, 
        telatCount, 
        bolosCount, 
        izinCount, 
        liburCount,
        isTodayHoliday,
        alpaCount: studentItems.filter((it: any) => it.status === 'Alpa').length, 
        belumCount: studentItems.filter((it: any) => it.status === 'Belum Hadir').length,
        kName,
        kNip,
        wName,
        wNip,
        dateStr,
        deptLabel,
        classLabel,
        timeLabel
      };
    }

