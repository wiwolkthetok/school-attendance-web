  <!-- ========================================================
       4. CLIENT SCRIPT (TAB SWITCHING & DATA BINDING)
       ======================================================== -->
  <script>
    let cachedLogs: any[] = [];
    let cachedStudents: any[] = [];
    let cachedPermits: any[] = [];
    let cachedDeductions: any[] = [];
    let cachedSettings: any = null;
    let currentFilter: 'today' | 'week' | 'month' | 'all' = 'today';
    let selectedClass: string = 'all';
    let searchQuery: string = '';

    const filterTitles: Record<string, string> = {
      today: 'Riwayat Presensi Hari Ini (Realtime Turso Cloud)',
      week: 'Arsip Presensi 7 Hari Terakhir (Turso Cloud)',
      month: 'Arsip Presensi 30 Hari Terakhir (Turso Cloud)',
      all: 'Seluruh Riwayat & Arsip Presensi (Turso Cloud)',
    };

    // Sub-nav Tab Switcher untuk Sidebar Khusus Rekap
    function setupRekapSubnav() {
      const navBtns = document.querySelectorAll('.rekap-nav-btn');
      const sections = document.querySelectorAll('.rekap-section');
      const titleEl = document.getElementById('rekap-current-tab-title');
      const descEl = document.getElementById('rekap-current-tab-desc');

      function switchTab(targetId: string) {
        navBtns.forEach((btn) => {
          const b = btn as HTMLElement;
          const isTarget = b.dataset.target === targetId;
          const chev = b.querySelector('.material-symbols-outlined:last-child') as HTMLElement | null;

          if (isTarget) {
            b.className = 'rekap-nav-btn active w-full flex items-center justify-between px-3.5 py-2.5 rounded-lg text-xs font-semibold transition-colors text-left cursor-pointer bg-slate-100 text-slate-900 border border-slate-200/80 shadow-2xs';
            const icon = b.querySelector('.material-symbols-outlined:first-child');
            if (icon) icon.className = 'material-symbols-outlined text-[17px] text-blue-600';
            if (chev) chev.className = 'material-symbols-outlined text-xs text-slate-600';

            if (titleEl && b.dataset.title) titleEl.textContent = b.dataset.title;
            if (descEl && b.dataset.desc) descEl.textContent = b.dataset.desc;
          } else {
            b.className = 'rekap-nav-btn w-full flex items-center justify-between px-3.5 py-2.5 rounded-lg text-xs font-medium transition-colors text-left cursor-pointer text-slate-600 hover:text-slate-900 hover:bg-slate-50';
            const icon = b.querySelector('.material-symbols-outlined:first-child');
            if (icon) icon.className = 'material-symbols-outlined text-[17px] text-slate-500';
            if (chev) chev.className = 'material-symbols-outlined text-xs text-slate-400';
          }
        });

        document.querySelectorAll('.rekap-bottom-nav-btn').forEach((btn) => {
          const b = btn as HTMLElement;
          const isTarget = b.dataset.target === targetId;
          const box = b.querySelector('.bnav-icon-box') as HTMLElement | null;
          const label = b.querySelector('.bnav-label') as HTMLElement | null;
          const icon = box?.querySelector('.material-symbols-outlined') as HTMLElement | null;

          if (isTarget) {
            if (box) {
              box.className = 'bnav-icon-box w-11 h-7 rounded-full flex items-center justify-center transition-all duration-200 bg-blue-100 text-blue-700 shadow-2xs ease-[cubic-bezier(0.32,0.72,0,1)]';
            }
            if (icon) icon.classList.add('font-bold');
            if (label) {
              label.className = 'bnav-label text-[10px] tracking-tight leading-tight transition-colors duration-200 whitespace-nowrap text-blue-700 font-bold mt-1';
            }
          } else {
            if (box) {
              box.className = 'bnav-icon-box w-11 h-7 rounded-full flex items-center justify-center transition-all duration-200 text-slate-400 group-hover:text-slate-600 group-hover:bg-slate-100 ease-[cubic-bezier(0.32,0.72,0,1)]';
            }
            if (icon) icon.classList.remove('font-bold');
            if (label) {
              label.className = 'bnav-label text-[10px] tracking-tight leading-tight transition-colors duration-200 whitespace-nowrap text-slate-500 font-medium group-hover:text-slate-700 mt-1';
            }
          }
        });

        sections.forEach((sec) => {
          if (sec.id === targetId) {
            sec.classList.remove('hidden');
            if (targetId === 'sec-statistik' || targetId === 'sec-otomatisasi') {
              calculateTrendData();
            }
          } else {
            sec.classList.add('hidden');
          }
        });
      }

      navBtns.forEach((btn) => {
        btn.addEventListener('click', () => {
          const targetId = (btn as HTMLElement).dataset.target;
          if (targetId) switchTab(targetId);
        });
      });

      // Bundaran dan tab HANYA berpindah saat tombol diklik (bukan saat digeser/slide)
      const rekapTabOrder = ['sec-statistik', 'sec-dokumen', 'sec-riwayat', 'sec-otomatisasi'];
      let rekapIsSwiping = false;

      document.querySelectorAll('.rekap-bottom-nav-btn').forEach((btn) => {
        btn.addEventListener('click', (e) => {
          if (rekapIsSwiping) {
            e.preventDefault();
            return;
          }
          const targetId = (btn as HTMLElement).dataset.target;
          if (targetId) switchTab(targetId);
        });
      });

      // Swipe responsif pada bottom bar untuk ganti tab rekap
      const rekapNavEl = document.getElementById('rekap-bottom-nav');
      let rTouchStartX = 0;
      let rTouchStartY = 0;
      let rTouchStartTime = 0;

      rekapNavEl?.addEventListener('touchstart', (e) => {
        rTouchStartX = e.touches[0].clientX;
        rTouchStartY = e.touches[0].clientY;
        rTouchStartTime = Date.now();
        rekapIsSwiping = false;
      }, { passive: true });

      rekapNavEl?.addEventListener('touchmove', (e) => {
        const diffX = Math.abs(e.touches[0].clientX - rTouchStartX);
        const diffY = Math.abs(e.touches[0].clientY - rTouchStartY);
        if (diffX > 8 && diffX > diffY) {
          rekapIsSwiping = true;
        }
      }, { passive: true });

      rekapNavEl?.addEventListener('touchend', (e) => {
        const diffX = rTouchStartX - e.changedTouches[0].clientX;
        const elapsed = Date.now() - rTouchStartTime;
        const isFlick = elapsed < 320 && Math.abs(diffX) > 16;
        const isDrag = Math.abs(diffX) > 28;

        if (isFlick || isDrag) {
          const activeSec = Array.from(sections).find((s) => !s.classList.contains('hidden'));
          const currentId = activeSec ? activeSec.id : 'sec-statistik';
          const curIdx = rekapTabOrder.indexOf(currentId);
          if (diffX > 0 && curIdx < rekapTabOrder.length - 1) {
            switchTab(rekapTabOrder[curIdx + 1]);
          } else if (diffX < 0 && curIdx > 0) {
            switchTab(rekapTabOrder[curIdx - 1]);
          }
        }
        setTimeout(() => { rekapIsSwiping = false; }, 80);
      }, { passive: true });
    }

    let studentByRfid: Record<string, any> = {};
    let studentByName: Record<string, any> = {};

    function getStudentPoints(rfidUid?: string, studentId?: string, role?: string): number {
      if (role === 'guru' || role === 'admin') return 100;
      let totalDed = 0;
      const cleanRfid = (rfidUid || '').trim().toUpperCase();
      const cleanSid = (studentId || '').trim().toUpperCase();

      if (Array.isArray(cachedDeductions)) {
        cachedDeductions.forEach((d: any) => {
          const dRfid = (d.rfidUid || '').trim().toUpperCase();
          const dSid = (d.studentId || '').trim().toUpperCase();
          if ((cleanRfid && dRfid === cleanRfid) || (cleanSid && dSid === cleanSid)) {
            totalDed += Number(d.pointsDeducted) || 0;
          }
        });
      }
      return Math.max(0, 100 - totalDed);
    }

    function getFilteredLogs(): any[] {
      let logs = cachedLogs;
      if (selectedClass !== 'all') {
        if (selectedClass === 'guru') {
          logs = logs.filter((l: any) => 
            l.role === 'guru' || 
            (l.className && (l.className.toLowerCase().includes('guru') || l.className.toLowerCase().includes('kepala')))
          );
        } else {
          logs = logs.filter((l: any) => l.className === selectedClass);
        }
      }
      if (searchQuery.trim()) {
        const q = searchQuery.toLowerCase().trim();
        logs = logs.filter((l: any) => {
          const name = (l.name || '').toLowerCase();
          const rfid = (l.rfidUid || '').toLowerCase();
          const cls = (l.className || '').toLowerCase();
          const st = (l.rfidUid && studentByRfid[l.rfidUid.trim().toUpperCase()]) || (l.name && studentByName[l.name.trim().toLowerCase()]);
          const ident = (st?.identifier || '').toLowerCase();
          return name.includes(q) || rfid.includes(q) || cls.includes(q) || ident.includes(q);
        });
      }
      return logs;
    }

    // 0ms Cache First: Render rekapitulasi instan dari cache lokal
    function loadCachedRekap() {
      try {
        const raw = localStorage.getItem('rekap_cache');
        if (raw) {
          const data = JSON.parse(raw);
          if (Array.isArray(data.students) && data.students.length > 0) {
            cachedStudents = data.students;
            cachedPermits = data.permits || [];
            cachedDeductions = data.deductions || [];
            renderRekapFromData(data.todayLogs || []);
          }
        }
      } catch (e) {}
    }

    async function updateRekapStats() {
      try {
        const [sRes, pRes, ptRes, lRes, setRes] = await Promise.all([
          fetch('/api/students'),
          fetch('/api/permissions'),
          fetch('/api/points'),
          fetch('/api/attendance'),
          fetch('/api/settings'),
        ]);
        cachedStudents = await sRes.json().catch(() => []);
        cachedPermits = await pRes.json().catch(() => []);
        cachedDeductions = await ptRes.json().catch(() => []);
        const todayLogs = await lRes.json().catch(() => []);
        cachedSettings = await setRes.json().catch(() => null);

        try {
          localStorage.setItem('rekap_cache', JSON.stringify({
            students: cachedStudents,
            permits: cachedPermits,
            deductions: cachedDeductions,
            todayLogs
          }));
        } catch (e) {}

        await renderRekapFromData(todayLogs);
      } catch (e) { console.error(e); }
    }

    async function renderRekapFromData(todayLogs: any[]) {
      try {
        // Bangun kamus student berdasarkan RFID dan Nama untuk lookup cepat & filter NISN
        studentByRfid = {};
        studentByName = {};
        cachedStudents.forEach((s: any) => {
          if (s.rfidUid) studentByRfid[s.rfidUid.trim().toUpperCase()] = s;
          if (s.name) studentByName[s.name.trim().toLowerCase()] = s;
        });

        // Fetch logs according to active filter for Riwayat & Dokumen
        if (currentFilter === 'today') {
          cachedLogs = todayLogs;
        } else {
          const aRes = await fetch(`/api/attendance/archive?filter=${currentFilter}`);
          cachedLogs = await aRes.json().catch(() => []);
        }

        const displayLogs = getFilteredLogs();

        // Tanggal Hari Ini Standar WIB (Asia/Jakarta)
        const todayStr = new Date().toLocaleDateString('en-CA', { timeZone: 'Asia/Jakarta' });
        const approvedPermits = cachedPermits.filter(
          (p: any) => p.status === 'Disetujui' && p.startDate <= todayStr && (p.endDate || p.startDate) >= todayStr
        );
        const permitStudentIds = new Set(approvedPermits.map((p: any) => p.studentId));

        // 1. Perhitungan Statistik Menu 1 (Presensi Hari Ini Lengkap & Akurat)
        const isHol = typeof (window as any).isSchoolHoliday === 'function' ? (window as any).isSchoolHoliday() : (new Date().getDay() === 0);
        const now = new Date();
        const curMinutes = now.getHours() * 60 + now.getMinutes();
        const [pulangH, pulangM] = (cachedSettings?.jamPulang || '13:30').split(':').map(Number);
        const [tutupH, tutupM] = (cachedSettings?.jamTutupPulang || '15:00').split(':').map(Number);
        const isAfternoonReached = curMinutes >= (pulangH * 60 + pulangM);
        const afternoonClosed = curMinutes >= (tutupH * 60 + tutupM);

        // Siswa dan log harian (khusus siswa aktif, kecualikan alumni)
        const siswaList = cachedStudents.filter((s: any) => s.role === 'siswa' && !s.className?.toLowerCase().includes('alumni') && !s.className?.toLowerCase().includes('lulus'));
        const logMap = new Map<string, any[]>();
        todayLogs.forEach((l: any) => {
          const key = (l.rfidUid || l.name || '').trim().toUpperCase();
          if (!logMap.has(key)) logMap.set(key, []);
          logMap.get(key)!.push(l);
        });

        let siswaHadirTepat = 0;
        let siswaTerlambat = 0;
        let siswaBolos = 0;
        let siswaAlpa = 0;
        let siswaBelum = 0;
        let siswaIzin = approvedPermits.length;

        if (isHol) {
          siswaBelum = siswaList.length;
        } else {
          siswaList.forEach((s: any) => {
            const keyRfid = (s.rfidUid || '').trim().toUpperCase();
            const keyName = (s.name || '').trim().toUpperCase();
            const sLogs = logMap.get(keyRfid) || logMap.get(keyName) || [];
            const masukLog = sLogs.find((l: any) => l.type === 'masuk');
            const pulangLog = sLogs.find((l: any) => l.type === 'pulang');
            const hasPermit = permitStudentIds.has(s.id);

            if (hasPermit) {
              // Izin sudah dihitung dari approvedPermits
            } else if (masukLog) {
              if (pulangLog) {
                if (masukLog.status === 'Terlambat') siswaTerlambat++;
                else siswaHadirTepat++;
              } else if (afternoonClosed || masukLog.status === 'Bolos') {
                siswaBolos++;
              } else {
                if (masukLog.status === 'Terlambat') siswaTerlambat++;
                else siswaHadirTepat++;
              }
            } else if (pulangLog && pulangLog.status === 'Alpa') {
              siswaAlpa++;
            } else {
              if (isAfternoonReached) {
                siswaAlpa++;
              } else {
                siswaBelum++;
              }
            }
          });
        }

        // Guru Hadir (guru tap 1x sehari di sesi masuk atau siang)
        const guruLogs = todayLogs.filter((l: any) => l.role === 'guru');
        const guruHadirUids = new Set(guruLogs.map((l: any) => (l.rfidUid || '').trim().toUpperCase()));
        const guruHadirCount = isHol ? 0 : guruHadirUids.size;

        const hadir = siswaHadirTepat + guruHadirCount;
        const terlambat = siswaTerlambat;
        const bolos = siswaBolos;
        const izin = siswaIzin;
        const alpa = siswaAlpa;
        const belum = siswaBelum;
        const pulang = todayLogs.filter((l: any) => l.type === 'pulang').length;

        const el = (id: string) => document.getElementById(id);
        const set = (id: string, v: string) => { const e = el(id); if (e) e.textContent = v; };

        // Bind 6 Kartu Metrik Menu 1
        set('rekap-hadir', String(hadir));
        set('rekap-terlambat', String(terlambat));
        set('rekap-bolos', String(bolos));
        set('rekap-izin', String(izin));
        set('rekap-alpa', String(alpa));
        set('rekap-belum', isHol ? `${siswaList.length} (Libur)` : String(belum));
        set('rekap-stat-total-badge', `${todayLogs.length} Data Tercatat`);

        // Bind Metrik di Menu 3 (Riwayat Log)
        const filteredHadirCount = displayLogs.filter((l: any) => l.status === 'Hadir' || l.status === 'Terlambat' || l.type === 'masuk').length;
        set('rekap-log-count', `${displayLogs.length} Data`);
        set('log-stat-count', `${displayLogs.length} Data`);
        set('log-stat-hadir', `${filteredHadirCount} Siswa`);
        set('rekap-log-footer-text', `Menampilkan ${displayLogs.length} data presensi (${filterTitles[currentFilter] || currentFilter})`);

        // Update 3 Bar Kehadiran per Jurusan & Guru Hari Ini
        const absenUids = new Set(
          todayLogs
            .filter((l: any) => l.status === 'Hadir' || l.status === 'Terlambat' || l.status === 'Pulang')
            .map((l: any) => (l.rfidUid || '').trim().toUpperCase())
        );
        const aklTotal = cachedStudents.filter((s: any) => s.role !== 'guru' && s.className && s.className.includes('AKL') && !s.className.toLowerCase().includes('alumni') && !s.className.toLowerCase().includes('lulus'));
        const aklHadir = aklTotal.filter((s: any) => absenUids.has((s.rfidUid || '').trim().toUpperCase()));
        const aklPct = aklTotal.length ? Math.round((aklHadir.length / aklTotal.length) * 100) : 0;
        set('jurusan-akl-ratio', `${aklHadir.length}/${aklTotal.length} Siswa`);
        set('jurusan-akl-pct', `${aklPct}%`);
        const aklBar = el('jurusan-akl-bar');
        if (aklBar) aklBar.style.width = `${aklPct}%`;

        const rplTotal = cachedStudents.filter((s: any) => s.role !== 'guru' && s.className && s.className.includes('RPL') && !s.className.toLowerCase().includes('alumni') && !s.className.toLowerCase().includes('lulus'));
        const rplHadir = rplTotal.filter((s: any) => absenUids.has((s.rfidUid || '').trim().toUpperCase()));
        const rplPct = rplTotal.length ? Math.round((rplHadir.length / rplTotal.length) * 100) : 0;
        set('jurusan-rpl-ratio', `${rplHadir.length}/${rplTotal.length} Siswa`);
        set('jurusan-rpl-pct', `${rplPct}%`);
        const rplBar = el('jurusan-rpl-bar');
        if (rplBar) rplBar.style.width = `${rplPct}%`;

        const guruTotal = cachedStudents.filter((s: any) => s.role === 'guru');
        const guruHadir = guruTotal.filter((s: any) => absenUids.has((s.rfidUid || '').trim().toUpperCase()));
        const guruPct = guruTotal.length ? Math.round((guruHadir.length / guruTotal.length) * 100) : 0;
        set('jurusan-guru-ratio', `${guruHadir.length}/${guruTotal.length} Guru`);
        set('jurusan-guru-pct', `${guruPct}%`);
        const guruBar = el('jurusan-guru-bar');
        if (guruBar) guruBar.style.width = `${guruPct}%`;

        // Update KPI Summary Bar
        const totalCivitas = aklTotal.length + rplTotal.length + guruTotal.length;
        const totalHadirCivitas = aklHadir.length + rplHadir.length + guruHadir.length;
        const totalPctCivitas = totalCivitas ? Math.round((totalHadirCivitas / totalCivitas) * 100) : 0;
        set('jurusan-summary-pct', `${totalPctCivitas}%`);
        set('jurusan-summary-ratio', `${totalHadirCivitas}/${totalCivitas} Civitas`);

        const isTargetMet = totalPctCivitas >= 90;
        const targetBadge = el('jurusan-summary-target-badge');
        if (targetBadge) {
          targetBadge.textContent = isTargetMet ? 'Optimal (≥90%)' : 'Di Bawah Target';
          targetBadge.className = isTargetMet
            ? 'px-2 py-0.5 rounded text-[10px] font-mono font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200'
            : 'px-2 py-0.5 rounded text-[10px] font-mono font-semibold bg-amber-50 text-amber-700 border border-amber-200';
        }

        const aklStatusEl = el('jurusan-akl-status');
        if (aklStatusEl) {
          aklStatusEl.textContent = aklPct >= 90 ? 'Memenuhi Target' : 'Perlu Perhatian';
          aklStatusEl.className = aklPct >= 90
            ? 'px-1.5 py-0.5 rounded text-[10px] font-mono font-medium bg-emerald-50 text-emerald-700 border border-emerald-200/80'
            : 'px-1.5 py-0.5 rounded text-[10px] font-mono font-medium bg-amber-50 text-amber-700 border border-amber-200/80';
        }

        const rplStatusEl = el('jurusan-rpl-status');
        if (rplStatusEl) {
          rplStatusEl.textContent = rplPct >= 90 ? 'Memenuhi Target' : 'Perlu Perhatian';
          rplStatusEl.className = rplPct >= 90
            ? 'px-1.5 py-0.5 rounded text-[10px] font-mono font-medium bg-emerald-50 text-emerald-700 border border-emerald-200/80'
            : 'px-1.5 py-0.5 rounded text-[10px] font-mono font-medium bg-amber-50 text-amber-700 border border-amber-200/80';
        }

        const guruStatusEl = el('jurusan-guru-status');
        if (guruStatusEl) {
          guruStatusEl.textContent = guruPct >= 90 ? 'Memenuhi Target' : 'Perlu Perhatian';
          guruStatusEl.className = guruPct >= 90
            ? 'px-1.5 py-0.5 rounded text-[10px] font-mono font-medium bg-emerald-50 text-emerald-700 border border-emerald-200/80'
            : 'px-1.5 py-0.5 rounded text-[10px] font-mono font-medium bg-amber-50 text-amber-700 border border-amber-200/80';
        }

        let bestJurusan = 'Belum Ada Kehadiran';
        if (aklPct > 0 || rplPct > 0 || guruPct > 0) {
          if (aklPct >= rplPct && aklPct >= guruPct) bestJurusan = '🏆 AKL Terdepan (' + aklPct + '%)';
          else if (rplPct >= aklPct && rplPct >= guruPct) bestJurusan = '🏆 RPL Terdepan (' + rplPct + '%)';
          else bestJurusan = '🏆 Dewan Guru Terdepan (' + guruPct + '%)';
        }
        set('jurusan-top-badge', bestJurusan);

        // Update Feed 5 Tap Kartu Terbaru (Langsung Ambil 5 Tap Paling Baru)
        const recentTapsEl = el('rekap-recent-taps');
        if (recentTapsEl) {
          const recentLogs = [...todayLogs].reverse().slice(0, 5);
          if (!recentLogs.length) {
            recentTapsEl.innerHTML = '<div class="py-6 text-center text-slate-400 text-xs font-medium">Belum ada tap kartu RFID hari ini.</div>';
          } else {
            recentTapsEl.innerHTML = recentLogs.map((t: any) => {
              const badgeColor = t.status === 'Bolos' ? 'bg-rose-50 text-rose-700 border-rose-200'
                : t.status === 'Terlambat' ? 'bg-amber-50 text-amber-700 border-amber-200'
                : t.status === 'Pulang' ? 'bg-sky-50 text-sky-700 border-sky-200'
                : 'bg-emerald-50 text-emerald-700 border-emerald-200';
              return `
                <div class="flex items-center justify-between p-2 rounded-lg bg-slate-50/70 hover:bg-slate-100/70 border border-slate-200/60 transition-colors">
                  <div class="flex items-center gap-2.5 min-w-0">
                    <div class="w-7 h-7 rounded-md bg-slate-100 text-slate-700 font-mono flex items-center justify-center font-semibold text-xs shrink-0 border border-slate-200">
                      ${(t.name || '?')[0].toUpperCase()}
                    </div>
                    <div class="min-w-0">
                      <p class="font-semibold text-slate-900 text-xs truncate leading-tight">${t.name}</p>
                      <p class="text-[10px] text-slate-400 font-mono truncate mt-0.5">${t.className} • ${t.time ? t.time.slice(0, 5) : "-"} WIB</p>
                    </div>
                  </div>
                  <span class="px-2 py-0.5 rounded border text-[10px] font-mono font-semibold tracking-wider uppercase ${badgeColor} shrink-0">
                    ${t.status}
                  </span>
                </div>
              `;
            }).join('');
          }
        }


        // Filter Izin berdasarkan rombel aktif
        const filteredPermits = selectedClass === 'all'
          ? approvedPermits
          : (selectedClass === 'guru' ? [] : approvedPermits.filter((p: any) => p.className === selectedClass));

        // Update Print Header & Stat
        const targetLabel = selectedClass === 'all'
          ? 'SASARAN: SEMUA ROMBEL & DEWAN GURU'
          : (selectedClass === 'guru' ? 'SASARAN: DEWAN GURU & STAF' : `SASARAN: ROMBEL KELAS ${selectedClass.toUpperCase()}`);
        set('print-doc-target', targetLabel);
        set('print-stat-hadir', String(hadir));
        set('print-stat-terlambat', String(terlambat));
        set('print-stat-bolos', String(bolos));
        set('print-stat-izin', String(filteredPermits.length));
        set('print-stat-pulang', String(pulang));
        set('print-stat-belum', String(belum));

        // Ambil Data Pejabat Pengesah Dinamis dari Database Civitas
        const kepsekCivitas = cachedStudents.find((s: any) => 
          s.tag === 'kepsek' || 
          (s.className && s.className.toLowerCase().includes('kepala sekolah'))
        ) || cachedStudents.find((s: any) => s.role === 'guru');
        const wakaCivitas = cachedStudents.find((s: any) => 
          s.tag === 'waka' || 
          (s.className && (s.className.toLowerCase().includes('kesiswaan') || s.className.toLowerCase().includes('waka')))
        );

        const kepsekName = kepsekCivitas?.name || 'Kepala Sekolah';
        const kepsekNipRaw = kepsekCivitas?.identifier || '-';
        const kepsekNip = kepsekNipRaw.startsWith('NIP') ? kepsekNipRaw : (kepsekNipRaw !== '-' ? `NIP. ${kepsekNipRaw}` : '-');

        const wakaName = wakaCivitas?.name || 'Waka Kesiswaan';
        const wakaNipRaw = wakaCivitas?.identifier || '-';
        const wakaNip = wakaNipRaw.startsWith('NIP') ? wakaNipRaw : (wakaNipRaw !== '-' ? `NIP. ${wakaNipRaw}` : '-');

        // Pasang ke Layar Pratinjau Pejabat Menu 2
        set('screen-kepsek-name', kepsekName);
        set('screen-kepsek-nip', `Kepala Sekolah • ${kepsekNip}`);
        set('screen-waka-name', wakaName);
        set('screen-waka-nip', `Waka Kesiswaan • ${wakaNip}`);

        // Pasang ke Lembar Cetak Dokumen Resmi
        set('print-kepsek-name', kepsekName);
        set('print-kepsek-nip', kepsekNip);
        set('print-waka-name', wakaName);
        set('print-waka-nip', wakaNip);

        const tbody = el('rekap-log-body');
        if (!tbody) return;
        if (!displayLogs.length) {
          tbody.innerHTML = `
            <tr>
              <td colspan="6" class="py-14 text-center">
                <div class="max-w-xs mx-auto flex flex-col items-center justify-center space-y-2">
                  <div class="w-12 h-12 rounded-2xl bg-slate-100 border border-slate-200/80 flex items-center justify-center text-slate-400 mb-1">
                    <span class="material-symbols-outlined text-2xl">history_toggle_off</span>
                  </div>
                  <p class="text-sm font-bold text-slate-800">Belum Ada Riwayat</p>
                  <p class="text-xs text-slate-400 leading-relaxed">Belum ada catatan presensi pada filter ini. Lakukan tap kartu atau coba simulator IoT.</p>
                  <div class="flex items-center gap-2 mt-2">
                    <button type="button" onclick="document.querySelector('[data-target=\'sec-otomatisasi\']')?.click()" class="px-3 py-1.5 rounded-xl bg-blue-50 hover:bg-blue-100 text-blue-700 font-bold text-xs border border-blue-200 inline-flex items-center gap-1.5 transition active:scale-95 cursor-pointer">
                      <span class="material-symbols-outlined text-sm">tune</span>
                      <span>Pusat Otomatisasi</span>
                    </button>
                    <a href="/" class="px-3 py-1.5 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold text-xs border border-slate-200 inline-flex items-center gap-1.5 transition">
                      <span class="material-symbols-outlined text-sm">contactless</span>
                      <span>Beranda Tap</span>
                    </a>
                  </div>
                </div>
              </td>
            </tr>
          `;
          return;
        }

        tbody.innerHTML = displayLogs.map((l: any) => {
          const st = (l.rfidUid && studentByRfid[l.rfidUid.trim().toUpperCase()]) || (l.name && studentByName[l.name.trim().toLowerCase()]);
          const nisn = st?.identifier || (l.role === 'guru' ? 'NIP Guru' : 'NISN. -');
          const pts = getStudentPoints(l.rfidUid, st?.id, l.role);

          const bc = l.status === 'Bolos' ? 'bg-rose-50 text-rose-700 border-rose-200'
            : l.status === 'Terlambat' ? 'bg-amber-50 text-amber-700 border-amber-200'
            : l.status === 'Pulang' ? 'bg-sky-50 text-sky-700 border-sky-200'
            : 'bg-emerald-50 text-emerald-700 border-emerald-200';
          const badgeText = l.status ? l.status.toUpperCase() : 'HADIR';

          let pointBadge = `<span class="inline-flex items-center gap-1 font-mono font-semibold text-emerald-700 bg-emerald-50 border border-emerald-200/70 px-2 py-0.5 rounded text-[11px]">${pts} Poin</span>`;
          if (l.role === 'guru') {
            pointBadge = `<span class="text-slate-500 font-medium text-[11px]">Pendidik</span>`;
          } else if (pts === 0) {
            pointBadge = `<span class="inline-flex items-center gap-1 font-mono font-bold text-rose-800 bg-rose-50 border border-rose-200 px-2 py-0.5 rounded text-[11px]">0 Poin</span>`;
          } else if (pts < 75) {
            pointBadge = `<span class="inline-flex items-center gap-1 font-mono font-semibold text-rose-700 bg-rose-50 border border-rose-200/70 px-2 py-0.5 rounded text-[11px]">${pts} Poin</span>`;
          } else if (pts < 100) {
            pointBadge = `<span class="inline-flex items-center gap-1 font-mono font-semibold text-amber-700 bg-amber-50 border border-amber-200/70 px-2 py-0.5 rounded text-[11px]">${pts} Poin</span>`;
          }

          const isGuru = l.role === 'guru';
          const avatarColor = isGuru ? 'bg-amber-50 text-amber-700 border border-amber-200/60' : 'bg-blue-50 text-blue-700 border border-blue-200/60';

          return `<tr class="hover:bg-slate-50/80 transition-colors border-b border-slate-100 last:border-b-0">
            <td class="py-2.5 px-4">
              <div class="flex items-center gap-2.5">
                <div class="w-7 h-7 rounded-lg ${avatarColor} flex items-center justify-center font-bold text-xs shrink-0">
                  ${(l.name || '?')[0].toUpperCase()}
                </div>
                <div class="min-w-0">
                  <p class="font-semibold text-slate-900 text-xs truncate">${l.name}</p>
                  <p class="font-mono text-[10px] text-slate-400 truncate">${nisn}</p>
                </div>
              </div>
            </td>
            <td class="py-2.5 px-3">
              <span class="px-2 py-0.5 rounded bg-slate-50 border border-slate-200/80 text-slate-700 font-mono text-[10px] font-semibold">${l.className}</span>
            </td>
            <td class="py-2.5 px-3 font-mono text-slate-500 text-xs">${l.date}</td>
            <td class="py-2.5 px-3">
              <span class="capitalize font-medium text-slate-800 text-xs">${l.type}</span>
              <span class="text-slate-400 text-[11px] font-mono">(${l.time ? l.time.slice(0, 5) : "-"})</span>
            </td>
