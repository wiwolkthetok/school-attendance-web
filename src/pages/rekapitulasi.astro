    function populateBolosStudents(searchFilter: string = '') {
      const container = document.getElementById('bolos-student-list');
      const hint = document.getElementById('bolos-student-class-hint');
      const deptLabel = selectedBolosDept === 'rpl' ? 'RPL' : 'AKL';
      const classTitle = selectedBolosClass === 'all' ? `Semua Kelas ${deptLabel}` : `Kelas ${selectedBolosClass}`;
      if (hint) hint.textContent = `${classTitle} • Pilih siswa yang melakukan pelanggaran bolos`;
      if (!container) return;

      let students = cachedStudents.filter((s: any) => {
        if (s.role !== 'siswa') return false;
        if (s.className && (s.className.toLowerCase().includes('alumni') || s.className.toLowerCase().includes('lulus'))) return false;
        const sCategory = (s.category || '').toLowerCase();
        const sClass = (s.className || '').toUpperCase();
        
        const matchDept = selectedBolosDept === 'rpl' 
          ? (sCategory === 'rpl' || sClass.includes('RPL'))
          : (sCategory === 'akl' || sClass.includes('AKL'));
        if (!matchDept) return false;

        if (selectedBolosClass && selectedBolosClass !== 'all') {
          const cleanClass = sClass.replace(/\s*[12]$/, '').trim();
          return cleanClass === selectedBolosClass.toUpperCase() || sClass === selectedBolosClass.toUpperCase();
        }

        return true;
      });

      if (searchFilter.trim()) {
        const q = searchFilter.toLowerCase().trim();
        students = students.filter((s: any) => 
          (s.name || '').toLowerCase().includes(q) || 
          (s.identifier || '').toLowerCase().includes(q) ||
          (s.className || '').toLowerCase().includes(q)
        );
      }

      if (!students.length) {
        container.innerHTML = '<p class="text-xs text-slate-400 italic text-center py-6">Tidak ada data siswa ditemukan.</p>';
        return;
      }

      container.innerHTML = students.map((s: any) => {
        const pts = getStudentPoints(s.rfidUid, s.id, s.role);
        return `
          <button type="button" class="bolos-student-pick-btn w-full p-2.5 rounded-lg border border-slate-200/80 hover:border-rose-400 hover:bg-rose-50/40 bg-white transition flex items-center justify-between text-left cursor-pointer active:scale-[0.99]" data-id="${s.id}">
            <div class="flex items-center gap-2.5 min-w-0">
              <div class="w-8 h-8 rounded-lg bg-rose-50 text-rose-700 border border-rose-200/60 font-semibold text-xs flex items-center justify-center shrink-0">
                ${s.name.charAt(0)}
              </div>
              <div class="min-w-0">
                <p class="font-semibold text-xs text-slate-900 truncate">${s.name}</p>
                <p class="text-[10px] text-slate-400 font-mono">${s.className} • NISN: ${s.identifier || '-'}</p>
              </div>
            </div>
            <div class="text-right shrink-0">
              <span class="text-xs font-black font-mono ${pts < 75 ? 'text-rose-600' : 'text-slate-800'}">${pts} P</span>
              <span class="block text-[9px] text-slate-400">Pilih →</span>
            </div>
          </button>
        `;
      }).join('');

      container.querySelectorAll('.bolos-student-pick-btn').forEach((btn) => {
        btn.addEventListener('click', (e) => {
          const sid = (e.currentTarget as HTMLElement).dataset.id;
          selectedBolosStudent = cachedStudents.find((s: any) => s.id === sid);
          if (selectedBolosStudent) {
            bolosStep = 4;
            renderBolosStep();
            populateBolosConfirmation();
          }
        });
      });
    }

    function populateBolosConfirmation() {
