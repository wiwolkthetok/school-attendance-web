    // ==========================================
    // NATIVE HIGH-PERFORMANCE TREND CHART LOGIC
    // ==========================================
    let trendActiveRange: '7d' | '30d' = '7d';
    let trendHoveredIdx: number | null = null;
    let trend7dData: any[] = [];
    let trend30dData: any[] = [];

    async function calculateTrendData() {
      const siswaList = cachedStudents.filter((s: any) => s.role === 'siswa' && !s.className?.toLowerCase().includes('alumni') && !s.className?.toLowerCase().includes('lulus'));
      const totalStudents = siswaList.length || 7;

      let monthLogs: any[] = [];
      let activeTodayLogs: any[] = [];
      try {
        const [aRes, tRes] = await Promise.all([
          fetch('/api/attendance/archive?filter=month').catch(() => null),
          fetch('/api/attendance').catch(() => null),
        ]);
        if (aRes && aRes.ok) monthLogs = await aRes.json().catch(() => []);
        if (tRes && tRes.ok) activeTodayLogs = await tRes.json().catch(() => []);
      } catch {
        monthLogs = [];
        activeTodayLogs = [];
      }

      const allLogs: any[] = [];
      const seenIds = new Set<string>();
      [...(activeTodayLogs || []), ...(monthLogs || [])].forEach((l: any) => {
        const id = l.id || `${l.rfidUid}-${l.date}-${l.time}`;
        if (!seenIds.has(id)) {
          seenIds.add(id);
          allLogs.push(l);
        }
      });

      const dayNames = ['Min', 'Sen', 'Sel', 'Rab', 'Kam', 'Jum', 'Sab'];
      const monthNames = ['Jan', 'Feb', 'Mar', 'Apr', 'Mei', 'Jun', 'Jul', 'Agu', 'Sep', 'Okt', 'Nov', 'Des'];

      // 1. Generate 6 Hari Sekolah Terakhir (Lewati Hari Minggu)
      const pastSchoolDays: { iso: string; dayName: string; dateLabel: string }[] = [];
      const cursor = new Date();
      while (pastSchoolDays.length < 6) {
        const iso = cursor.toLocaleDateString('en-CA', { timeZone: 'Asia/Jakarta' });
        const dayOfWeek = cursor.getDay();
        if (dayOfWeek !== 0) {
          const dNum = String(cursor.getDate()).padStart(2, '0');
          const mName = monthNames[cursor.getMonth()];
          pastSchoolDays.unshift({
            iso,
            dayName: dayNames[dayOfWeek],
            dateLabel: `${dNum} ${mName}`,
          });
        }
        cursor.setDate(cursor.getDate() - 1);
      }

      trend7dData = pastSchoolDays.map((day) => {
        const dayLogs = allLogs.filter((l: any) => l.date === day.iso && (l.role === 'siswa' || !l.role));

        if (dayLogs.length > 0) {
          const presentUids = new Set<string>();
          let lateCount = 0;
          let alpaCount = 0;

          dayLogs.forEach((l: any) => {
            const key = (l.name || l.rfidUid || '').trim().toLowerCase();
            if (l.status === 'Hadir' || l.status === 'Pulang') {
              presentUids.add(key);
            } else if (l.status === 'Terlambat') {
              presentUids.add(key);
              lateCount++;
            } else if (l.status === 'Alpa' || l.status === 'Bolos') {
              alpaCount++;
            }
          });

          const hadir = presentUids.size;
          const pct = totalStudents > 0 ? Math.min(100, Math.round((hadir / totalStudents) * 100)) : 100;
          const calculatedAlpa = Math.max(alpaCount, totalStudents - hadir);

          return {
            date: day.dateLabel,
            dayName: day.dayName,
            fullDate: day.iso,
            hadir,
            terlambat: lateCount,
            alpa: calculatedAlpa,
            total: totalStudents,
            percentage: pct,
          };
        }

        return {
          date: day.dateLabel,
          dayName: day.dayName,
          fullDate: day.iso,
          hadir: 0,
          terlambat: 0,
          alpa: totalStudents,
          total: totalStudents,
          percentage: 0,
        };
      });

      // 2. Generate 4 Minggu Bulan Ini (30 Hari)
      const now = new Date();
      const currentMonth = now.getMonth();
      const currentYear = now.getFullYear();

      const weeks = [
        { label: 'Mgg 1', name: 'W1', start: 1, end: 7 },
        { label: 'Mgg 2', name: 'W2', start: 8, end: 14 },
        { label: 'Mgg 3', name: 'W3', start: 15, end: 21 },
        { label: 'Mgg 4', name: 'W4', start: 22, end: 31 },
      ];

      trend30dData = weeks.map((w) => {
        const weekLogs = allLogs.filter((l: any) => {
          if (!l.date) return false;
          const [y, m, d] = l.date.split('-').map(Number);
          return y === currentYear && (m - 1) === currentMonth && d >= w.start && d <= w.end && (l.role === 'siswa' || !l.role);
        });

        const daysInWeekCount = Math.min(6, Math.max(1, now.getDate() >= w.start ? Math.min(now.getDate(), w.end) - w.start + 1 : 6));
        const totalExpected = totalStudents * daysInWeekCount;

        if (weekLogs.length > 0) {
          const presentLogs = weekLogs.filter((l: any) => l.status === 'Hadir' || l.status === 'Pulang' || l.status === 'Terlambat');
          const lateLogs = weekLogs.filter((l: any) => l.status === 'Terlambat');
          const alpaLogs = weekLogs.filter((l: any) => l.status === 'Alpa' || l.status === 'Bolos');

          const hadir = Math.min(totalExpected, presentLogs.length);
          const pct = totalExpected > 0 ? Math.min(100, Math.round((hadir / totalExpected) * 100)) : 95;

          return {
            date: w.label,
            dayName: w.name,
            hadir,
            terlambat: lateLogs.length,
            alpa: Math.max(alpaLogs.length, totalExpected - hadir),
            total: totalExpected,
            percentage: pct,
          };
        }

        return {
          date: w.label,
          dayName: w.name,
          hadir: 0,
          terlambat: 0,
          alpa: totalExpected,
          total: totalExpected,
          percentage: 0,
        };
      });

      renderTrendChartUI();
    }

    function renderTrendChartUI() {
      const data = trendActiveRange === '7d' ? trend7dData : trend30dData;
      if (!data || !data.length) return;

      const sum = data.reduce((acc, curr) => acc + curr.percentage, 0);
      const avg = Math.round(sum / data.length);

      const activeIdx = trendHoveredIdx !== null && data[trendHoveredIdx] ? trendHoveredIdx : data.length - 1;
      const activePoint = data[activeIdx];

      const avgEl = document.getElementById('trend-metric-avg');
      const selPctEl = document.getElementById('trend-metric-selected-pct');
      const selDateEl = document.getElementById('trend-metric-selected-date');
      const hadirEl = document.getElementById('trend-metric-hadir');
      const hadirTotEl = document.getElementById('trend-metric-hadir-total');
      const issuesEl = document.getElementById('trend-metric-issues');
      const issuesDetEl = document.getElementById('trend-metric-issues-detail');

      if (avgEl) avgEl.textContent = `${avg}%`;
      if (selPctEl) selPctEl.textContent = `${activePoint.percentage}%`;
      if (selDateEl) selDateEl.textContent = `${activePoint.dayName}, ${activePoint.date}`;
      if (hadirEl) hadirEl.textContent = `${activePoint.hadir} Siswa`;
      if (hadirTotEl) hadirTotEl.textContent = `Dari total ${activePoint.total}`;
      if (issuesEl) issuesEl.textContent = `${activePoint.terlambat + activePoint.alpa} Kasus`;
      if (issuesDetEl) issuesDetEl.textContent = `${activePoint.terlambat} tunda, ${activePoint.alpa} alpa`;

      const barsContainer = document.getElementById('trend-bars-container');
      if (!barsContainer) return;

      barsContainer.innerHTML = data.map((item, idx) => {
        const isHighlighted = idx === activeIdx;
        return `
          <div
            class="flex-1 flex flex-col items-center gap-2 group cursor-pointer h-full justify-end trend-bar-item"
            data-idx="${idx}"
          >
            <div
              class="text-[10px] font-mono font-semibold transition-all ${
                isHighlighted ? 'text-blue-700 opacity-100 -translate-y-0.5' : 'text-slate-400 opacity-0 group-hover:opacity-100'
              }"
            >
              ${item.percentage}%
            </div>

            <div class="w-full max-w-[40px] bg-slate-100 rounded-t-md overflow-hidden flex flex-col justify-end h-28 relative">
              <div
                class="absolute inset-x-0 border-t border-dashed border-slate-300 z-10 pointer-events-none"
                style="bottom: 90%"
                title="Ambang Batas 90%"
              ></div>

              <div
                class="w-full rounded-t-md transition-all duration-300 ${
                  isHighlighted
                    ? 'bg-blue-600 shadow-xs'
                    : item.percentage >= 90
                    ? 'bg-slate-300 group-hover:bg-blue-400'
                    : 'bg-amber-300 group-hover:bg-amber-400'
                }"
                style="height: ${item.percentage}%"
              ></div>
            </div>

            <div class="text-center">
              <span
                class="block text-[11px] font-mono leading-tight transition-colors ${
                  isHighlighted ? 'text-slate-900 font-semibold' : 'text-slate-500'
                }"
              >
                ${item.dayName}
              </span>
              <span class="block text-[9px] text-slate-400 font-mono">
                ${item.date.split(' ')[0]}
              </span>
            </div>
          </div>
        `;
      }).join('');

      barsContainer.querySelectorAll('.trend-bar-item').forEach((bar) => {
        bar.addEventListener('mouseenter', (e) => {
          const idx = Number((e.currentTarget as HTMLElement).getAttribute('data-idx'));
          trendHoveredIdx = idx;
          renderTrendChartUI();
        });
        bar.addEventListener('mouseleave', () => {
          trendHoveredIdx = null;
          renderTrendChartUI();
        });
      });
    }

    function initTrendRangeSelector() {
      const btn7d = document.getElementById('trend-btn-7d');
      const btn30d = document.getElementById('trend-btn-30d');

      btn7d?.addEventListener('click', () => {
        trendActiveRange = '7d';
        trendHoveredIdx = null;
        btn7d.className = 'trend-range-btn px-2.5 py-1 rounded-md text-[11px] transition-colors cursor-pointer bg-white text-blue-700 shadow-xs font-semibold';
        btn30d?.setAttribute('class', 'trend-range-btn px-2.5 py-1 rounded-md text-[11px] transition-colors cursor-pointer text-slate-600 hover:text-slate-900 font-medium');
        renderTrendChartUI();
      });

      btn30d?.addEventListener('click', () => {
        trendActiveRange = '30d';
        trendHoveredIdx = null;
        btn30d.className = 'trend-range-btn px-2.5 py-1 rounded-md text-[11px] transition-colors cursor-pointer bg-white text-blue-700 shadow-xs font-semibold';
        btn7d?.setAttribute('class', 'trend-range-btn px-2.5 py-1 rounded-md text-[11px] transition-colors cursor-pointer text-slate-600 hover:text-slate-900 font-medium');
