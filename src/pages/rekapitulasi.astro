    // Inisialisasi Hak Akses Tombol Reset Poin (Khusus Kepsek & Waka)
    function initResetPointsAuth() {
      const authRaw = localStorage.getItem('auth_civitas');
      let civitas: any = null;
      try {
        if (authRaw) civitas = JSON.parse(authRaw);
      } catch {}
      const authRole = localStorage.getItem('auth_role') || civitas?.role || '';
      const civitasTag = civitas?.tag || '';
      const isKepsek = civitasTag === 'kepsek' || (civitas?.className && civitas.className.toLowerCase().includes('kepala sekolah'));
      const isWaka = civitasTag === 'waka' || (civitas?.className && civitas.className.toLowerCase().includes('waka'));
      const isAdmin = authRole === 'admin' || sessionStorage.getItem('bypass_login') === 'true';

      const canReset = isAdmin || isKepsek || isWaka;
      const btnReset = document.getElementById('btn-reset-points-action') as HTMLButtonElement | null;
      const authNote = document.getElementById('reset-points-auth-note');

      if (btnReset) {
        if (!canReset) {
          btnReset.disabled = true;
          btnReset.title = 'Akses ditolak: Hanya Kepala Sekolah atau Waka Kesiswaan yang dapat mereset poin.';
          if (authNote) authNote.textContent = 'Terkunci (Hanya Kepsek/Waka)';
        } else {
          btnReset.disabled = false;
        }
      }
    }

    document.getElementById('btn-reset-points-action')?.addEventListener('click', async () => {
      const authRaw = localStorage.getItem('auth_civitas');
      let civitas: any = null;
      try { if (authRaw) civitas = JSON.parse(authRaw); } catch {}
      const authRole = localStorage.getItem('auth_role') || civitas?.role || '';
      const civitasTag = civitas?.tag || '';
      const canReset = authRole === 'admin' || civitasTag === 'kepsek' || civitasTag === 'waka' || sessionStorage.getItem('bypass_login') === 'true';

      if (!canReset) {
        alert('Akses Ditolak: Fitur reset poin hanya dapat dijalankan oleh Kepala Sekolah (Kepsek) atau Waka Kesiswaan.');
        return;
      }

      if (!confirm('Apakah Anda yakin ingin mereset seluruh poin kedisiplinan siswa kembali ke 100 Poin penuh (Pemutihan)? Tindakan ini akan menghapus semua riwayat pemotongan poin aktif.')) {
        return;
      }

      try {
        const res = await fetch('/api/points', { method: 'DELETE' });
        const result = await res.json();
        alert('✅ ' + (result.message || 'Seluruh poin siswa berhasil direset ke 100 Poin default.'));
        await updateRekapStats();
      } catch (err: any) {
        alert('Gagal mereset poin: ' + err.message);
      }
    });

    // Inisialisasi Tab Switcher & Load Data (0ms cache first)
    setupRekapSubnav();
    initResetPointsAuth();
    initTrendRangeSelector();
    loadCachedRekap();
    window.addEventListener('attendance-updated', updateRekapStats);
    window.addEventListener('day-mode-changed', updateRekapStats);
    updateRekapStats();
    calculateTrendData();
    measureLatency();
  </script>
</Layout>
