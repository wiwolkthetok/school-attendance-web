---
/**
 * @file src/pages/rekapitulasi.astro
 * @description Halaman Rekapitulasi Presensi & Ekspor Laporan PDF Standar Dinas
 * Didesain ulang dengan tata letak modular menggunakan Sidebar Khusus (seperti profil civitas)
 * agar setiap fitur (Statistik, Dokumen Sah PDF, Riwayat Log Turso, dan Otomatisasi) terorganisir rapi tanpa sesak.
 */
export const prerender = false;

const authSession = Astro.cookies.get('auth_session')?.value;
if (!authSession) {
  return Astro.redirect('/login');
}
if (authSession === 'siswa' || authSession === 'guru') {
  return Astro.redirect('/profil-siswa');
}

import Layout from '../layouts/Layout.astro';
---

<Layout title="Rekapitulasi & PDF" activeNav="rekap">

  <!-- ========================================================
       1. SIDEBAR KHUSUS REKAPITULASI & EKSPOR LAPORAN
       (Menggantikan Sidebar Utama via slot="sidebar")
       ======================================================== -->
  <aside
    slot="sidebar"
    class="hidden md:flex md:w-64 lg:w-72 bg-white text-slate-700 flex-col justify-between shrink-0 select-none border-r border-slate-200/80 overflow-y-auto h-auto min-h-[920px] p-4 sm:p-5 space-y-6"
    aria-label="Sidebar Khusus Rekapitulasi & Laporan"
  >
    <div class="space-y-5">
      <!-- Tombol Kembali ke Dashboard Utama -->
      <div class="pb-3 border-b border-slate-100">
        <a
          href="/"
          class="inline-flex items-center gap-2 px-3 py-2 rounded-lg bg-slate-50 hover:bg-slate-100 text-slate-700 font-medium text-xs border border-slate-200/80 transition-colors w-full"
          title="Kembali ke Dashboard Utama"
        >
          <span class="material-symbols-outlined text-base text-slate-500">arrow_back</span>
          <span>Kembali ke Menu Utama</span>
        </a>
      </div>

      <!-- Header Info Modul Rekapitulasi di Sidebar -->
      <div class="p-3.5 rounded-xl bg-slate-50/80 border border-slate-200/80 space-y-2.5">
        <div class="flex items-center gap-3">
          <div class="w-8 h-8 rounded-lg bg-blue-50 text-blue-600 border border-blue-200/80 flex items-center justify-center shrink-0">
            <span class="material-symbols-outlined text-lg">description</span>
          </div>
          <div class="min-w-0 flex-1">
            <h3 class="font-bold text-xs text-slate-900 truncate">Rekap Presensi</h3>
            <p class="text-[11px] text-slate-500 truncate">SMK Ma'arif Padang Ratu</p>
          </div>
        </div>

        <div class="pt-2 border-t border-slate-200/60 space-y-1 text-[11px]">
          <div class="flex items-center justify-between">
            <span class="text-slate-500">Database:</span>
            <span class="px-1.5 py-0.5 rounded text-[10px] font-mono font-medium bg-emerald-50 text-emerald-700 border border-emerald-200">Online</span>
          </div>
          <div class="flex items-center justify-between">
            <span class="text-slate-500">Reset Harian:</span>
            <span class="px-1.5 py-0.5 rounded text-[10px] font-mono font-medium bg-slate-100 text-slate-600 border border-slate-200">23:00 WIB</span>
          </div>
        </div>
      </div>

      <!-- Navigasi Menu Modular Rekapitulasi -->
      <nav class="space-y-1" id="rekap-subnav" aria-label="Navigasi Menu Rekapitulasi">
        <!-- 1. Statistik Kehadiran -->
        <button
          type="button"
          data-target="sec-statistik"
          data-title="Statistik Kehadiran"
          data-desc="Data presensi hari ini tersinkronisasi otomatis dengan sensor RFID gerbang."
          class="rekap-nav-btn active w-full flex items-center justify-between px-3.5 py-2.5 rounded-lg text-xs font-semibold transition-colors text-left cursor-pointer bg-slate-100 text-slate-900 border border-slate-200/80 shadow-2xs"
        >
          <span class="flex items-center gap-2.5">
            <span class="material-symbols-outlined text-[17px] text-blue-600">query_stats</span>
            <span>Statistik</span>
          </span>
          <span class="material-symbols-outlined text-xs text-slate-400">chevron_right</span>
        </button>

        <!-- 2. Dokumen Sah & Cetak PDF -->
        <button
          type="button"
          data-target="sec-dokumen"
          data-title="Dokumen & Cetak PDF"
          data-desc="Laporan berita acara presensi resmi, siap dicetak ke format PDF."
          class="rekap-nav-btn w-full flex items-center justify-between px-3.5 py-2.5 rounded-lg text-xs font-medium transition-colors text-left cursor-pointer text-slate-600 hover:text-slate-900 hover:bg-slate-50"
        >
          <span class="flex items-center gap-2.5">
            <span class="material-symbols-outlined text-[17px] text-slate-500">picture_as_pdf</span>
            <span>Dokumen & PDF</span>
          </span>
          <span class="material-symbols-outlined text-xs text-slate-400">chevron_right</span>
        </button>

        <!-- 3. Riwayat Presensi & Arsip Log -->
        <button
          type="button"
          data-target="sec-riwayat"
          data-title="Riwayat Presensi & Log"
          data-desc="Catatan presensi realtime dan arsip historis dari database cloud."
          class="rekap-nav-btn w-full flex items-center justify-between px-3.5 py-2.5 rounded-lg text-xs font-medium transition-colors text-left cursor-pointer text-slate-600 hover:text-slate-900 hover:bg-slate-50"
        >
          <span class="flex items-center gap-2.5">
            <span class="material-symbols-outlined text-[17px] text-slate-500">table_chart</span>
            <span>Riwayat & Log</span>
          </span>
          <span class="material-symbols-outlined text-xs text-slate-400">chevron_right</span>
        </button>

        <!-- 4. Otomatisasi & Kontrol Operasional -->
        <button
          type="button"
          data-target="sec-otomatisasi"
          data-title="Pusat Otomatisasi"
          data-desc="Kontrol evaluasi bolos kepulangan (-10 poin) dan jadwal arsip harian 23:00 WIB."
          class="rekap-nav-btn w-full flex items-center justify-between px-3.5 py-2.5 rounded-lg text-xs font-medium transition-colors text-left cursor-pointer text-slate-600 hover:text-slate-900 hover:bg-slate-50"
        >
          <span class="flex items-center gap-2.5">
            <span class="material-symbols-outlined text-[17px] text-slate-500">tune</span>
            <span>Otomatisasi</span>
          </span>
          <span class="material-symbols-outlined text-xs text-slate-400">chevron_right</span>
        </button>
      </nav>
    </div>

    <!-- Quick Footer Actions di Sidebar -->
    <div class="pt-3 border-t border-slate-100 space-y-2">
      <button
        type="button"
        id="sidebar-btn-wa"
        class="w-full inline-flex items-center justify-center gap-2 py-2 px-3 rounded-lg bg-emerald-50 hover:bg-emerald-100 text-emerald-700 border border-emerald-200 font-semibold text-xs transition-colors cursor-pointer"
        title="Salin ringkasan presensi untuk dikirim ke grup WhatsApp"
      >
        <span class="material-symbols-outlined text-base">chat</span>
        <span>Salin Ringkasan WA</span>
      </button>
      <button
        type="button"
        id="sidebar-btn-excel"
        class="w-full inline-flex items-center justify-center gap-2 py-2 px-3 rounded-lg bg-white hover:bg-slate-50 text-slate-700 border border-slate-200/80 font-semibold text-xs transition-colors cursor-pointer shadow-2xs"
        title="Unduh seluruh data log terfilter dalam format Excel (CSV)"
      >
        <span class="material-symbols-outlined text-base">table_view</span>
        <span>Unduh Excel (CSV)</span>
      </button>
    </div>
  </aside>

  <!-- ========================================================
       NAVIGASI BAWAH KHUSUS REKAPITULASI (MOBILE / ANDROID)
       Menempel mentok di dasar layar, menggantikan bottom-nav umum
       ======================================================== -->
  <nav
    slot="bottom-nav"
    aria-label="Navigasi Rekapitulasi Mobile"
    class="fixed bottom-0 inset-x-0 z-40 w-full bg-white/95 backdrop-blur-xl border-t border-slate-200/90 shadow-[0_-4px_20px_rgba(0,0,0,0.05)] md:hidden select-none safe-bottom transition-all duration-200 touch-manipulation"
  >
    <div class="grid grid-cols-5 items-center px-1 py-1.5 w-full relative touch-manipulation" id="rekap-bottom-nav">
      <!-- 1. Statistik -->
      <button
        type="button"
        data-target="sec-statistik"
        data-index="0"
        class="rekap-bottom-nav-btn flex flex-col items-center justify-center py-1 px-0.5 rounded-xl transition-all duration-200 active:scale-95 group relative touch-manipulation cursor-pointer"
        aria-label="Tab Statistik"
      >
        <div class="bnav-icon-box w-11 h-7 rounded-full flex items-center justify-center transition-all duration-200 bg-blue-100 text-blue-700 shadow-2xs ease-[cubic-bezier(0.32,0.72,0,1)]">
          <span class="material-symbols-outlined text-[20px] font-bold">query_stats</span>
        </div>
        <span class="bnav-label text-[10px] tracking-tight leading-tight transition-colors duration-200 whitespace-nowrap text-blue-700 font-bold mt-1">Statistik</span>
      </button>

      <!-- 2. Dokumen -->
      <button
        type="button"
        data-target="sec-dokumen"
        data-index="1"
        class="rekap-bottom-nav-btn flex flex-col items-center justify-center py-1 px-0.5 rounded-xl transition-all duration-200 active:scale-95 group relative touch-manipulation cursor-pointer"
        aria-label="Tab Dokumen"
      >
        <div class="bnav-icon-box w-11 h-7 rounded-full flex items-center justify-center transition-all duration-200 text-slate-400 group-hover:text-slate-600 group-hover:bg-slate-100 ease-[cubic-bezier(0.32,0.72,0,1)]">
          <span class="material-symbols-outlined text-[20px]">picture_as_pdf</span>
        </div>
        <span class="bnav-label text-[10px] tracking-tight leading-tight transition-colors duration-200 whitespace-nowrap text-slate-500 font-medium group-hover:text-slate-700 mt-1">Dokumen</span>
      </button>

      <!-- 3. Riwayat -->
      <button
        type="button"
        data-target="sec-riwayat"
        data-index="2"
        class="rekap-bottom-nav-btn flex flex-col items-center justify-center py-1 px-0.5 rounded-xl transition-all duration-200 active:scale-95 group relative touch-manipulation cursor-pointer"
        aria-label="Tab Riwayat"
      >
        <div class="bnav-icon-box w-11 h-7 rounded-full flex items-center justify-center transition-all duration-200 text-slate-400 group-hover:text-slate-600 group-hover:bg-slate-100 ease-[cubic-bezier(0.32,0.72,0,1)]">
          <span class="material-symbols-outlined text-[20px]">table_chart</span>
        </div>
        <span class="bnav-label text-[10px] tracking-tight leading-tight transition-colors duration-200 whitespace-nowrap text-slate-500 font-medium group-hover:text-slate-700 mt-1">Riwayat</span>
      </button>

      <!-- 4. Otomasi -->
      <button
        type="button"
        data-target="sec-otomatisasi"
        data-index="3"
        class="rekap-bottom-nav-btn flex flex-col items-center justify-center py-1 px-0.5 rounded-xl transition-all duration-200 active:scale-95 group relative touch-manipulation cursor-pointer"
        aria-label="Tab Otomasi"
      >
        <div class="bnav-icon-box w-11 h-7 rounded-full flex items-center justify-center transition-all duration-200 text-slate-400 group-hover:text-slate-600 group-hover:bg-slate-100 ease-[cubic-bezier(0.32,0.72,0,1)]">
          <span class="material-symbols-outlined text-[20px]">tune</span>
        </div>
        <span class="bnav-label text-[10px] tracking-tight leading-tight transition-colors duration-200 whitespace-nowrap text-slate-500 font-medium group-hover:text-slate-700 mt-1">Otomasi</span>
      </button>

      <!-- 5. Menu Utama (Kembali) -->
      <a
        href="/"
        data-astro-prefetch="load"
        class="flex flex-col items-center justify-center py-1 px-0.5 rounded-xl transition-all duration-200 active:scale-95 group relative touch-manipulation cursor-pointer"
        title="Kembali ke Menu Utama"
      >
        <div class="w-11 h-7 rounded-full flex items-center justify-center transition-all duration-200 text-slate-400 group-hover:text-blue-600 group-hover:bg-slate-100 ease-[cubic-bezier(0.32,0.72,0,1)]">
          <span class="material-symbols-outlined text-[20px]">arrow_back</span>
        </div>
        <span class="text-[10px] tracking-tight leading-tight whitespace-nowrap text-slate-500 font-medium group-hover:text-blue-600 mt-1">Menu</span>
      </a>
    </div>
  </nav>

  <!-- ========================================================
       2. TAMPILAN KONTEN UTAMA (MODULAR & RAPI)
       ======================================================== -->
  <div class="print:hidden flex flex-col gap-6 max-w-7xl mx-auto w-full">
    
    <!-- Top Action Bar & Header Ramping (Ultra Clean & Professional) -->
    <div class="p-4 sm:p-5 bg-white rounded-xl shadow-xs border border-slate-200/80 flex flex-col md:flex-row md:items-center justify-between gap-3">
      <div>
        <div class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded text-[10px] font-mono font-medium bg-blue-50 text-blue-700 border border-blue-200/80 mb-1">
          <span class="w-1.5 h-1.5 rounded-full bg-blue-600 animate-pulse"></span>
          <span>Laporan Presensi Resmi</span>
        </div>
        <h1 id="rekap-current-tab-title" class="text-xl sm:text-2xl font-bold text-slate-900 tracking-tight">
          Statistik Kehadiran Siswa
        </h1>
        <p id="rekap-current-tab-desc" class="text-xs text-slate-500 mt-0.5">
          Ringkasan metrik presensi hari ini tersinkronisasi otomatis dengan sensor RFID & gerbang IoT.
        </p>
      </div>
    </div>

    <!-- ========================================================
         SECTION 1: STATISTIK KEHADIRAN (BERSIH & LEGA)
         ======================================================== -->
    <section id="sec-statistik" class="rekap-section space-y-4 sm:space-y-6">
      <!-- 6 Metric Cards -->
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-2.5 sm:gap-3.5">
        <!-- Hadir Tepat -->
        <div class="rounded-xl bg-white text-slate-900 p-3 sm:p-3.5 border border-slate-200/80 shadow-xs hover:border-slate-300 transition-all flex flex-col justify-between min-h-[92px] sm:min-h-[102px]">
          <div class="flex items-center justify-between gap-1 mb-1">
            <span class="px-1.5 py-0.5 rounded text-[10px] font-mono font-semibold uppercase tracking-wider bg-emerald-50 text-emerald-700 border border-emerald-200">Hadir</span>
            <span class="material-symbols-outlined text-[16px] text-emerald-600">check_circle</span>
          </div>
          <div>
            <p class="text-2xl sm:text-3xl font-semibold font-mono text-slate-900 tracking-tight" id="rekap-hadir">0</p>
            <p class="text-[10px] text-slate-400 mt-0.5">Tepat waktu</p>
          </div>
        </div>

        <!-- Terlambat -->
        <div class="rounded-xl bg-white text-slate-900 p-3 sm:p-3.5 border border-slate-200/80 shadow-xs hover:border-slate-300 transition-all flex flex-col justify-between min-h-[92px] sm:min-h-[102px]">
          <div class="flex items-center justify-between gap-1 mb-1">
            <span class="px-1.5 py-0.5 rounded text-[10px] font-mono font-semibold uppercase tracking-wider bg-amber-50 text-amber-700 border border-amber-200">Terlambat</span>
            <span class="material-symbols-outlined text-[16px] text-amber-600">schedule</span>
          </div>
          <div>
            <p class="text-2xl sm:text-3xl font-semibold font-mono text-slate-900 tracking-tight" id="rekap-terlambat">0</p>
            <p class="text-[10px] text-slate-400 mt-0.5">Lewat jam masuk</p>
          </div>
        </div>

        <!-- Bolos (-10P) -->
        <div class="rounded-xl bg-white text-slate-900 p-3 sm:p-3.5 border border-slate-200/80 shadow-xs hover:border-slate-300 transition-all flex flex-col justify-between min-h-[92px] sm:min-h-[102px]">
          <div class="flex items-center justify-between gap-1 mb-1">
            <span class="px-1.5 py-0.5 rounded text-[10px] font-mono font-semibold uppercase tracking-wider bg-rose-50 text-rose-700 border border-rose-200">Bolos (-10P)</span>
            <span class="material-symbols-outlined text-[16px] text-rose-600">dangerous</span>
          </div>
          <div>
            <p class="text-2xl sm:text-3xl font-semibold font-mono text-slate-900 tracking-tight" id="rekap-bolos">0</p>
            <p class="text-[10px] text-slate-400 mt-0.5">Tanpa tap pulang</p>
          </div>
        </div>

        <!-- Izin / Disp -->
        <div class="rounded-xl bg-white text-slate-900 p-3 sm:p-3.5 border border-slate-200/80 shadow-xs hover:border-slate-300 transition-all flex flex-col justify-between min-h-[92px] sm:min-h-[102px]">
          <div class="flex items-center justify-between gap-1 mb-1">
            <span class="px-1.5 py-0.5 rounded text-[10px] font-mono font-semibold uppercase tracking-wider bg-purple-50 text-purple-700 border border-purple-200">Izin / Disp</span>
            <span class="material-symbols-outlined text-[16px] text-purple-600">assignment_turned_in</span>
          </div>
          <div>
            <p class="text-2xl sm:text-3xl font-semibold font-mono text-slate-900 tracking-tight" id="rekap-izin">0</p>
            <p class="text-[10px] text-slate-400 mt-0.5">Disetujui sah</p>
          </div>
        </div>

        <!-- Alpa -->
        <div class="rounded-xl bg-white text-slate-900 p-3 sm:p-3.5 border border-slate-200/80 shadow-xs hover:border-slate-300 transition-all flex flex-col justify-between min-h-[92px] sm:min-h-[102px]">
          <div class="flex items-center justify-between gap-1 mb-1">
            <span class="px-1.5 py-0.5 rounded text-[10px] font-mono font-semibold uppercase tracking-wider bg-slate-100 text-slate-700 border border-slate-300">Alpa</span>
            <span class="material-symbols-outlined text-[16px] text-slate-500">event_busy</span>
          </div>
          <div>
            <p class="text-2xl sm:text-3xl font-semibold font-mono text-slate-900 tracking-tight" id="rekap-alpa">0</p>
            <p class="text-[10px] text-slate-400 mt-0.5">Tanpa keterangan</p>
          </div>
        </div>

        <!-- Belum Absen -->
        <div class="rounded-xl bg-white text-slate-900 p-3 sm:p-3.5 border border-slate-200/80 shadow-xs hover:border-slate-300 transition-all flex flex-col justify-between min-h-[92px] sm:min-h-[102px]">
          <div class="flex items-center justify-between gap-1 mb-1">
            <span class="px-1.5 py-0.5 rounded text-[10px] font-mono font-semibold uppercase tracking-wider bg-slate-50 text-slate-500 border border-slate-200">Belum</span>
            <span class="material-symbols-outlined text-[16px] text-slate-400">person_off</span>
          </div>
          <div>
            <p class="text-2xl sm:text-3xl font-semibold font-mono text-slate-900 tracking-tight" id="rekap-belum">0</p>
            <p class="text-[10px] text-slate-400 mt-0.5">Menunggu RFID</p>
          </div>
        </div>
      </div>

      <!-- 2 Kolom Interaktif: Perbandingan Kehadiran per Jurusan & Feed 5 Tap Kartu Terbaru -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-3.5 sm:gap-4">
        <!-- Kolom Kiri (7 Cols): Perbandingan Kehadiran per Jurusan & Guru -->
        <div class="lg:col-span-7 p-4 sm:p-5 rounded-xl bg-white border border-slate-200/80 shadow-xs flex flex-col justify-between space-y-3.5">
          <div class="space-y-3.5">
            <!-- Header Kartu -->
            <div class="flex items-start sm:items-center justify-between pb-3 border-b border-slate-100 gap-2">
              <div class="flex items-center gap-2 min-w-0">
                <span class="w-8 h-8 rounded-lg bg-blue-50 text-blue-600 border border-blue-200/60 flex items-center justify-center shrink-0">
                  <span class="material-symbols-outlined text-[18px]">bar_chart</span>
                </span>
                <div class="min-w-0">
                  <h3 class="font-bold text-slate-900 text-xs sm:text-sm truncate">Kehadiran Jurusan & Guru</h3>
                  <p class="text-[10px] sm:text-[11px] text-slate-400 truncate">Rasio presensi aktif kompetensi keahlian & tenaga pendidik</p>
                </div>
              </div>
              <span class="text-[10px] font-mono font-medium text-slate-600 bg-slate-100 border border-slate-200 px-2 py-0.5 rounded shrink-0">Target 90%</span>
            </div>

            <!-- KPI Summary Strip (2 Mini Boxes) -->
            <div class="grid grid-cols-2 gap-2.5">
              <div class="p-2.5 rounded-lg bg-slate-50 border border-slate-200/60 flex flex-col justify-between">
                <span class="text-[10px] font-medium text-slate-400 uppercase tracking-wide">Rata-rata Keseluruhan</span>
                <div class="flex items-baseline gap-2 mt-1">
                  <span id="jurusan-summary-pct" class="font-mono text-lg sm:text-xl font-bold text-slate-900">0%</span>
                  <span id="jurusan-summary-ratio" class="font-mono text-[10px] text-slate-500 truncate">0/0 Civitas</span>
                </div>
              </div>
              <div class="p-2.5 rounded-lg bg-slate-50 border border-slate-200/60 flex flex-col justify-between">
                <span class="text-[10px] font-medium text-slate-400 uppercase tracking-wide">Status Capaian</span>
                <div class="flex items-center justify-between mt-1">
                  <span id="jurusan-summary-target-badge" class="px-2 py-0.5 rounded text-[10px] font-mono font-semibold bg-slate-100 text-slate-600 border border-slate-200">
                    Memuat...
                  </span>
                  <span class="text-[10px] text-slate-400 hidden sm:inline">Standar BOSP</span>
                </div>
              </div>
            </div>

            <!-- 3 Mini Cards Jurusan & Guru -->
            <div class="space-y-2.5">
              <!-- AKL -->
              <div class="p-2.5 sm:p-3 rounded-lg bg-slate-50/70 hover:bg-slate-50 border border-slate-200/60 space-y-2 transition-colors">
                <div class="flex items-center justify-between gap-2">
                  <div class="flex items-center gap-2 min-w-0">
                    <span class="px-1.5 py-0.5 rounded text-[10px] font-mono font-bold bg-blue-50 text-blue-700 border border-blue-200 shrink-0">AKL</span>
                    <span class="text-xs font-semibold text-slate-800 truncate">Akuntansi & Keuangan Lembaga</span>
                  </div>
                  <div class="flex items-center gap-2 shrink-0">
                    <span id="jurusan-akl-ratio" class="font-mono text-[11px] text-slate-500">0/0 Siswa</span>
                    <span id="jurusan-akl-pct" class="font-mono text-xs font-bold text-blue-700">0%</span>
                  </div>
                </div>
                <div class="w-full h-1.5 bg-slate-200/70 rounded-full overflow-hidden">
                  <div id="jurusan-akl-bar" class="h-full bg-blue-600 rounded-full transition-all duration-500 w-0"></div>
                </div>
                <div class="flex items-center justify-between text-[10px] pt-0.5">
                  <span id="jurusan-akl-status" class="px-1.5 py-0.5 rounded text-[10px] font-mono font-medium bg-emerald-50 text-emerald-700 border border-emerald-200/80">Memenuhi Target</span>
