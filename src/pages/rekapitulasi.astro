      const name = document.getElementById('bolos-conf-name');
      const meta = document.getElementById('bolos-conf-meta');
      const currentPts = document.getElementById('bolos-conf-current-pts');

      const pts = getStudentPoints(selectedBolosStudent.rfidUid, selectedBolosStudent.id, selectedBolosStudent.role);

