    function renderBolosStep() {
      const line = document.getElementById('bolos-progress-line');
      if (line) line.style.width = `${((bolosStep - 1) / 3) * 100}%`;

      for (let s = 1; s <= 4; s++) {
        const badge = document.getElementById(`bolos-badge-${s}`);
        const label = document.getElementById(`bolos-label-${s}`);
        const panel = document.getElementById(`bolos-panel-${s}`);

        if (panel) {
          if (s === bolosStep) panel.classList.remove('hidden');
          else panel.classList.add('hidden');
        }

        if (badge && label) {
          if (s === bolosStep) {
            badge.className = 'w-6 h-6 rounded-full bg-rose-600 text-white font-semibold text-xs flex items-center justify-center shadow-xs transition-all';
            badge.textContent = String(s);
            label.className = 'text-[10px] font-semibold text-rose-700 whitespace-nowrap';
          } else if (s < bolosStep) {
            badge.className = 'w-6 h-6 rounded-full bg-emerald-500 text-white font-semibold text-xs flex items-center justify-center transition-all';
            badge.textContent = '✓';
            label.className = 'text-[10px] font-medium text-emerald-700 whitespace-nowrap';
          } else {
            badge.className = 'w-6 h-6 rounded-full bg-slate-100 text-slate-400 font-semibold text-xs flex items-center justify-center transition-all';
            badge.textContent = String(s);
            label.className = 'text-[10px] font-medium text-slate-400 whitespace-nowrap';
          }
        }
      }

      const backBtn = document.getElementById('btn-bolos-back');
      const submitBtn = document.getElementById('btn-bolos-submit');
      if (backBtn) {
        if (bolosStep > 1) backBtn.classList.remove('hidden');
        else backBtn.classList.add('hidden');
      }
      if (submitBtn) {
        if (bolosStep === 4) submitBtn.classList.remove('hidden');
        else submitBtn.classList.add('hidden');
      }
    }

