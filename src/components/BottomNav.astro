---
/**
 * @file src/components/BottomNav.astro
 * @description Master Docked Bottom Navigation Bar untuk Mobile & Android
 * Menggunakan sistem navigasi terpadu konsisten dengan estetika desktop & mobile,
 * tanpa pagination artifisial ("Menu 1"/"Menu 2"), dengan active-pill konsentris.
 */
interface Props {
  activeNav?:
    | "data-presensi"
    | "jadwal-agenda"
    | "izin-dispensasi"
    | "siswa-guru"
    | "rekap"
    | "pengaturan"
    | "profil-siswa"
    | "login";
}

const { activeNav = "data-presensi" } = Astro.props;

const authSession = Astro.cookies.get("auth_session")?.value;
const isGuruSession = authSession === "guru";

// Nav items terpadu untuk Admin / Waka / Kepsek (6 modul utama langsung 1-tap accessible)
const adminNavItems = [
  { id: "data-presensi", label: "Presensi", href: "/", icon: "dashboard" },
  { id: "jadwal-agenda", label: "Jadwal", href: "/jadwal", icon: "calendar_month" },
  { id: "izin-dispensasi", label: "Izin", href: "/izin-dispensasi", icon: "description" },
  { id: "siswa-guru", label: "Siswa", href: "/siswa-guru", icon: "group" },
  { id: "rekap", label: "Rekap", href: "/rekapitulasi", icon: "analytics" },
  { id: "pengaturan", label: "Pengaturan", href: "/pengaturan", icon: "settings" },
];

// Nav items untuk Dewan Guru
const guruNavItems = [
  { id: "jadwal-agenda", label: "Jadwal", href: "/jadwal", icon: "calendar_month" },
  { id: "profil-siswa", label: "Profil Guru", href: "/profil-siswa", icon: "badge" },
  { id: "logout", label: "Keluar", href: "#logout", icon: "logout", isLogout: true },
];

const items = isGuruSession ? guruNavItems : adminNavItems;
---

<nav
  aria-label="Navigasi Bawah Mobile"
  class="fixed bottom-0 inset-x-0 z-40 w-full bg-white/95 backdrop-blur-xl border-t border-slate-200/90 shadow-[0_-4px_20px_rgba(0,0,0,0.05)] md:hidden select-none safe-bottom transition-all duration-200 touch-manipulation"
  id="bottom-nav-root"
>
  <div class={`grid ${isGuruSession ? "grid-cols-3 max-w-sm mx-auto" : "grid-cols-6"} items-center px-1 py-1.5 w-full`}>
    {
      items.map((item) => {
        const isActive = activeNav === item.id;
        const isLogout = (item as any).isLogout;

        if (isLogout) {
          return (
            <button
              type="button"
              id="bnav-logout-btn"
              class="flex flex-col items-center justify-center py-1 px-0.5 rounded-xl transition-all duration-200 active:scale-95 group relative touch-manipulation cursor-pointer"
              title="Keluar dari Aplikasi"
            >
              <div class="w-11 h-7 rounded-full flex items-center justify-center transition-all duration-200 text-rose-500 group-hover:bg-rose-50 ease-[cubic-bezier(0.32,0.72,0,1)]">
                <span class="material-symbols-outlined text-[20px]">
                  {item.icon}
                </span>
              </div>
              <span class="text-[9.5px] tracking-tight leading-tight transition-colors duration-200 mt-1 whitespace-nowrap text-rose-500 font-bold">
                {item.label}
              </span>
            </button>
          );
        }

        return (
          <a
            href={item.href}
            data-astro-prefetch="load"
            class="flex flex-col items-center justify-center py-1 px-0.5 rounded-xl transition-all duration-200 active:scale-95 group relative touch-manipulation cursor-pointer"
            aria-current={isActive ? "page" : undefined}
          >
            <!-- Pill Container Konsentris -->
            <div
              class={`w-11 h-7 rounded-full flex items-center justify-center transition-all duration-200 ease-[cubic-bezier(0.32,0.72,0,1)] ${
                isActive
                  ? "bg-blue-100 text-blue-700 shadow-2xs"
                  : "text-slate-400 group-hover:text-slate-600 group-hover:bg-slate-100"
              }`}
            >
              <span class={`material-symbols-outlined text-[20px] transition-transform duration-200 ${isActive ? "scale-105 font-bold" : ""}`}>
                {item.icon}
              </span>
            </div>

            <!-- Label Menu Ringkas & Jelas -->
            <span
              class={`text-[9.5px] tracking-tight leading-tight transition-colors duration-200 mt-1 whitespace-nowrap ${
                isActive
                  ? "text-blue-700 font-bold"
                  : "text-slate-500 font-medium group-hover:text-slate-700"
              }`}
            >
              {item.label}
            </span>
          </a>
        );
      })
    }
  </div>
</nav>

<style>
  .safe-bottom {
    padding-bottom: max(0.5rem, env(safe-area-inset-bottom, 0.5rem));
  }
</style>

<script>
  // Pre-load semua rute navigasi di background agar perpindahan halaman seketika
  const targetRoutes = [
    "/",
    "/jadwal",
    "/izin-dispensasi",
    "/siswa-guru",
    "/rekapitulasi",
    "/pengaturan",
    "/profil-siswa",
  ];
  targetRoutes.forEach((route) => {
    const link = document.createElement("link");
    link.rel = "prefetch";
    link.href = route;
    document.head.appendChild(link);
  });

  // Tombol Logout Mobile
  const logoutBtn = document.getElementById("bnav-logout-btn");
  logoutBtn?.addEventListener("click", () => {
    if (typeof (window as any).performLogout === "function") {
      (window as any).performLogout();
    } else {
      localStorage.removeItem("auth_civitas");
      localStorage.removeItem("auth_role");
      sessionStorage.removeItem("auth_active");
      sessionStorage.removeItem("bypass_login");
      document.cookie =
        "auth_session=; Path=/; Max-Age=0; Expires=Thu, 01 Jan 1970 00:00:00 GMT; SameSite=Lax";
      window.location.replace("/login");
    }
  });
</script>
